# aura-forge environment configuration

# Server Configuration
PORT=8080
SESSION_SECRET=aura-forge-development-secret-key-32bytes

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/aura_forge?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=aura_forge
POSTGRES_PORT=5432

# EVE Online ESI Configuration
# Public ESI requires a descriptive User-Agent
ESI_USER_AGENT=aura-forge/1.0 (EVE Market & Industry Copilot; contact: pilot@new-eden.org)

# Optional Authenticated EVE SSO (OAuth2)
# Leave blank for default Public ESI / Manual mode.
# When provided, character wallet, orders, jobs, blueprints, and assets will auto-sync.
ESI_CLIENT_ID=
ESI_CLIENT_SECRET=
ESI_CALLBACK_URL=http://localhost:8080/auth/callback

# Optional Aura AI Copilot (OpenAI-Compatible API)
# Leave AI_API_KEY blank to disable AI features (the app runs 100% normally without it).
# Compatible with OpenAI, Gemini OpenAI-compat, DeepSeek, Groq, OpenRouter, LiteLLM, or local Ollama.
# Examples:
#   OpenAI   : AI_BASE_URL=https://api.openai.com/v1 | AI_MODEL=gpt-4.1-mini
#   Gemini   : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai | AI_MODEL=gemini-2.5-flash
#   DeepSeek : AI_BASE_URL=https://api.deepseek.com/v1 | AI_MODEL=deepseek-chat
#   Ollama   : AI_BASE_URL=http://host.docker.internal:11434/v1 | AI_API_KEY=ollama | AI_MODEL=qwen2.5:14b
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=60

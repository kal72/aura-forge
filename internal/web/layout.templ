package web

import "aura-forge/internal/service"

templ Layout(title string, activeNav string, mode service.ModeInfo) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — aura-forge // EVE Market &amp; Industry Copilot</title>
			<script>
				(function () {
					var saved = localStorage.getItem('af-theme');
					var isDark = saved === 'dark';
					document.documentElement.classList.toggle('dark', isDark);
				})();
			</script>
			<script src="https://cdn.tailwindcss.com"></script>
			<script>
				tailwind.config = {
					darkMode: 'class',
					theme: {
						extend: {
							fontFamily: {
								mono: ['JetBrains Mono', 'ui-monospace', 'SFMono-Regular', 'monospace'],
							}
						}
					}
				}
			</script>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script defer src="https://unpkg.com/alpinejs@3.14.8/dist/cdn.min.js"></script>
		</head>
		<body
			class="min-h-screen tactical-grid-bg antialiased"
			x-data="{
				sidebarOpen: false,
				isDark: document.documentElement.classList.contains('dark'),
				toggleTheme() {
					this.isDark = !this.isDark;
					document.documentElement.classList.toggle('dark', this.isDark);
					localStorage.setItem('af-theme', this.isDark ? 'dark' : 'light');
				}
			}"
		>
			<!-- Mobile Sidebar Backdrop -->
			<div
				x-show="sidebarOpen"
				x-transition.opacity
				@click="sidebarOpen = false"
				class="fixed inset-0 z-40 bg-slate-950/60 backdrop-blur-xs lg:hidden"
				style="display: none;"
			></div>

			<!-- Left Navigation Sidebar -->
			<aside
				class="af-sidebar fixed inset-y-0 left-0 z-50 flex w-64 flex-col overflow-y-auto overflow-x-hidden transition-transform duration-200 ease-in-out lg:translate-x-0"
				:class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'"
			>
				<!-- Illustrated Orbital Shipyard Backdrop (EVE Station + Planet Ring + Starfield) -->
				<svg
					class="pointer-events-none absolute inset-x-0 bottom-0 h-[340px] w-full select-none"
					viewBox="0 0 256 340"
					preserveAspectRatio="xMidYMax slice"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<!-- Starfield -->
					<circle cx="28" cy="64" r="1.2" fill="#fde68a" opacity="0.75"></circle>
					<circle cx="218" cy="48" r="1.4" fill="#e9d5ff" opacity="0.80"></circle>
					<circle cx="76" cy="96" r="0.9" fill="#ffffff" opacity="0.60"></circle>
					<circle cx="190" cy="108" r="1.1" fill="#fde68a" opacity="0.65"></circle>
					<circle cx="38" cy="148" r="1.0" fill="#c4b5fd" opacity="0.55"></circle>
					<circle cx="230" cy="156" r="1.2" fill="#ffffff" opacity="0.50"></circle>
					<circle cx="136" cy="72" r="0.9" fill="#fde68a" opacity="0.55"></circle>
					<!-- Luminous Planet Horizon & Orbital Rings -->
					<circle cx="226" cy="316" r="106" fill="url(#afPlanetGrad)" opacity="0.40"></circle>
					<ellipse cx="226" cy="316" rx="176" ry="34" transform="rotate(-18 226 316)" stroke="#fde68a" stroke-opacity="0.30" stroke-width="1.4"></ellipse>
					<ellipse cx="226" cy="316" rx="152" ry="26" transform="rotate(-18 226 316)" stroke="#a78bfa" stroke-opacity="0.28" stroke-width="1.0"></ellipse>
					<!-- Upwell-Style Orbital Shipyard / Foundry Silhouette -->
					<g opacity="0.52" stroke="#fde68a" stroke-width="1.1" fill="rgba(139,92,246,0.22)">
						<path d="M88 214 L128 164 L168 214 L148 214 L128 190 L108 214 Z"></path>
						<rect x="123" y="138" width="10" height="86" rx="1.5"></rect>
						<path d="M56 196 L200 196 M74 205 L182 205" stroke-opacity="0.72"></path>
						<path d="M128 124 L128 138" stroke-opacity="0.85"></path>
						<circle cx="128" cy="176" r="4.5" fill="#fde68a"></circle>
						<circle cx="68" cy="196" r="1.8" fill="#fde68a"></circle>
						<circle cx="188" cy="196" r="1.8" fill="#fde68a"></circle>
					</g>
					<defs>
						<radialGradient id="afPlanetGrad" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(190 258) rotate(50) scale(130)">
							<stop stop-color="#a78bfa"></stop>
							<stop offset="1" stop-color="#1e1b4b"></stop>
						</radialGradient>
					</defs>
				</svg>

				<!-- Royal Industrial Faction Banner (Brand + All Menus Unified) -->
				<div class="af-banner-wrap relative z-10 px-2 pt-0">
					<div class="af-banner-hazard rounded-t-xs"></div>
					<div class="af-sidebar-upper flex flex-col px-2.5 pt-2.5">
						<div class="af-banner-frame px-2 pb-2">
							<!-- Brand Crest Header -->
							<div class="flex items-center justify-between border-b border-amber-300/25 pb-3 pt-1">
								<a href="/" class="flex items-center gap-2.5 group">
									<div class="relative flex h-9 w-9 items-center justify-center rounded-lg border border-amber-300/50 bg-white/12 text-amber-200 shadow-[0_0_14px_rgba(251,191,36,0.22)]">
										<!-- Industrial Hex-Gear Emblem -->
										<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
											<path stroke-linecap="round" stroke-linejoin="round" d="M12 2.5l7.5 4.33v8.66L12 19.82l-7.5-4.33V6.83L12 2.5z"></path>
											<circle cx="12" cy="11.16" r="2.6"></circle>
											<path stroke-linecap="round" d="M12 6.5v2M12 13.8v2M7.8 8.8l1.7 1M14.5 12.6l1.7 1M16.2 8.8l-1.7 1M9.5 12.6l-1.7 1"></path>
										</svg>
									</div>
									<div>
										<div class="text-sm font-bold tracking-wider text-white uppercase leading-tight">aura-forge</div>
										<div class="text-[9.5px] font-mono tracking-widest text-amber-200/90 uppercase">Industrial Corps</div>
									</div>
								</a>
								<button
									type="button"
									@click="sidebarOpen = false"
									class="rounded-md p-1 text-violet-100 hover:bg-white/15 lg:hidden cursor-pointer"
									aria-label="Tutup Menu"
								>
									<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
									</svg>
								</button>
							</div>

							<!-- Unified Sidebar Menu (All Groups at Top) -->
							<nav class="py-3.5 space-y-4">
								<div>
									<div class="px-2.5 mb-1.5 flex items-center justify-between text-[10px] font-mono font-semibold uppercase tracking-widest text-amber-200/75">
										<span>Operations</span>
										<span class="text-[8px] opacity-60">01</span>
									</div>
									<div class="space-y-0.5">
										<a href="/" class={ NavLinkUpperClass(activeNav, "dashboard") }>
											<svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
											</svg>
											<span>Dashboard</span>
										</a>
										<a href="/catalog" class={ NavLinkUpperClass(activeNav, "catalog") }>
											<svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
											</svg>
											<span>Catalog &amp; Trap Guard</span>
										</a>
										<a href="/calculator" class={ NavLinkUpperClass(activeNav, "calculator") }>
											<svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
											</svg>
											<span>Profit Calculator</span>
										</a>
									</div>
								</div>

								<div>
									<div class="px-2.5 mb-1.5 flex items-center justify-between text-[10px] font-mono font-semibold uppercase tracking-widest text-amber-200/75">
										<span>Foundry &amp; Strategy</span>
										<span class="text-[8px] opacity-60">02</span>
									</div>
									<div class="space-y-0.5">
										<a href="/allocator" class={ NavLinkUpperClass(activeNav, "allocator") }>
											<svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
												<path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path>
											</svg>
											<span>Capital Allocator</span>
										</a>
										<a href="/planner" class={ NavLinkUpperClass(activeNav, "planner") }>
											<svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
											</svg>
											<span>Weekly Planner</span>
										</a>
										<a href="/tracker" class={ NavLinkUpperClass(activeNav, "tracker") }>
											<svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
											</svg>
											<span>Order &amp; Batch Tracker</span>
										</a>
									</div>
								</div>

								<div>
									<div class="px-2.5 mb-1.5 flex items-center justify-between text-[10px] font-mono font-semibold uppercase tracking-widest text-amber-200/75">
										<span>System</span>
										<span class="text-[8px] opacity-60">03</span>
									</div>
									<div class="space-y-0.5">
										<a href="/settings" class={ NavLinkUpperClass(activeNav, "settings") }>
											<svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
												<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
											</svg>
											<span>Settings &amp; EVE SSO</span>
										</a>
									</div>
								</div>
							</nav>

							<!-- Industrial Faction Crest at Banner Tip -->
							<div class="flex flex-col items-center gap-1 pt-2 border-t border-amber-300/20">
								<div class="flex items-center gap-2 text-amber-200/85">
									<span class="h-px w-6 bg-amber-300/40"></span>
									<svg class="h-4 w-4 drop-shadow-[0_0_6px_rgba(253,230,138,0.65)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
										<path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
										<circle cx="12" cy="12" r="3"></circle>
									</svg>
									<span class="h-px w-6 bg-amber-300/40"></span>
								</div>
								<span class="text-[8.5px] font-mono tracking-[0.22em] text-amber-200/70 uppercase">IND-FORGE // JITA-4</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Footer Only at Bottom (Over Orbital Shipyard Scene) -->
				<div class="relative z-10 mt-auto px-3.5 pb-4 pt-3 space-y-2.5">
					if mode.SSOConnected {
						<div title={ mode.StatusHint } class="flex items-center gap-2 rounded-lg border border-emerald-400/35 bg-emerald-500/20 backdrop-blur-xs px-3 py-2 text-[11px] font-mono font-medium text-emerald-200">
							<span class="h-2 w-2 shrink-0 rounded-full bg-emerald-400 animate-pulse"></span>
							<span class="truncate">EVE SSO: { mode.CharacterName }</span>
						</div>
					} else {
						<div title={ mode.StatusHint } class="flex items-center gap-2 rounded-lg border border-violet-400/35 bg-violet-500/20 backdrop-blur-xs px-3 py-2 text-[11px] font-mono font-medium text-violet-100">
							<span class="h-2 w-2 shrink-0 rounded-full bg-violet-300"></span>
							<span class="truncate">Public ESI Active</span>
						</div>
					}

					<button
						type="button"
						hx-post="/esi/sync-prices"
						hx-swap="none"
						hx-indicator="#global-sync-spinner"
						class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-amber-400/40 bg-amber-500/20 backdrop-blur-xs px-3 py-2 text-xs font-semibold text-amber-200 hover:bg-amber-500/30 transition cursor-pointer"
					>
						<span id="global-sync-spinner" class="htmx-indicator h-3 w-3 animate-spin rounded-full border-2 border-amber-300 border-t-transparent"></span>
						<span>Sync Jita Prices</span>
					</button>
				</div>
			</aside>

			<!-- Right Content Column -->
			<div class="flex min-h-screen flex-col lg:pl-64">
				<!-- Slim Top Bar -->
				<header class="af-topbar sticky top-0 z-30 backdrop-blur">
					<div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
						<div class="flex items-center gap-3">
							<button
								type="button"
								@click="sidebarOpen = true"
								class="inline-flex items-center justify-center rounded-md border border-slate-300 dark:border-violet-500/30 p-1.5 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 lg:hidden cursor-pointer"
								aria-label="Buka Menu"
							>
								<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
								</svg>
							</button>
							<div class="flex items-center gap-2 text-xs font-mono">
								<span class="hidden sm:inline text-slate-400 dark:text-slate-500">aura-forge /</span>
								<span class="font-semibold text-slate-900 dark:text-slate-100">{ title }</span>
							</div>
						</div>

						<div class="flex items-center gap-2">
							<!-- Day / Night Theme Toggle -->
							<button
								type="button"
								@click="toggleTheme()"
								class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-violet-500/35 bg-white dark:bg-slate-900 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition cursor-pointer"
								:title="isDark ? 'Ganti ke Day Mode' : 'Ganti ke Night Mode'"
							>
								<svg x-show="isDark" style="display: none;" class="h-4 w-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
								</svg>
								<svg x-show="!isDark" class="h-4 w-4 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
								</svg>
								<span x-text="isDark ? 'Day Mode' : 'Night Mode'"></span>
							</button>
						</div>
					</div>
				</header>

				<!-- Main Content -->
				<main class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6">
					{ children... }
				</main>

				<!-- Footer -->
				<footer class="border-t border-slate-200 dark:border-slate-800/80 py-4 text-center text-xs text-slate-500 font-mono">
					aura-forge // EVE Market &amp; Industry Copilot (2026) — Public ESI Default + Optional EVE SSO Plug-and-Play
				</footer>
			</div>

			<!-- Alpine.js Toast Notification Stack -->
			<div
				x-data="{
					toasts: [],
					add(detail) {
						const id = Date.now() + Math.random();
						this.toasts.push({ id, level: detail.level || 'info', message: detail.message || '' });
						setTimeout(() => { this.toasts = this.toasts.filter(t => t.id !== id); }, 5000);
					}
				}"
				@showToast.window="add($event.detail)"
				class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-md"
			>
				<template x-for="t in toasts" :key="t.id">
					<div
						x-transition
						class="rounded-lg border px-4 py-3 text-xs font-medium shadow-xl backdrop-blur"
						:class="{
							'border-emerald-500/50 bg-emerald-50 dark:bg-emerald-950/90 text-emerald-800 dark:text-emerald-200': t.level === 'success',
							'border-rose-500/50 bg-rose-50 dark:bg-rose-950/90 text-rose-800 dark:text-rose-200': t.level === 'error',
							'border-violet-500/45 bg-white dark:bg-slate-900/95 text-violet-900 dark:text-violet-200': t.level !== 'success' && t.level !== 'error'
						}"
					>
						<span x-text="t.message"></span>
					</div>
				</template>
			</div>
		</body>
	</html>
}

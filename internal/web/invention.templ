package web

import (
	"fmt"

	"aura-forge/internal/domain"
	"aura-forge/internal/service"
)

templ InventionPage(mode service.ModeInfo, settings domain.UserSettings) {
	@Layout("T2 Invention & Make-vs-Buy", "invention", mode) {
		<div class="space-y-6" x-data="{ tab: 'decryptor' }">
			<!-- Header & Tab Switcher -->
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-white">T2 Invention &amp; Make-vs-Buy Engine</h1>
					<p class="text-xs text-slate-300/80 mt-0.5">Scale from 1B to 100B+ ISK by optimizing all 9 T2 Decryptor strategies with live Jita ESI prices and auditing intermediate component Make-vs-Buy costs.</p>
				</div>

				<div class="inline-flex rounded-xl border border-violet-400/35 bg-slate-950/65 p-1 backdrop-blur">
					<button
						type="button"
						@click="tab = 'decryptor'"
						:class="tab === 'decryptor' ? 'bg-amber-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						T2 Decryptor Optimizer
					</button>
					<button
						type="button"
						@click="tab = 'makebuy'"
						:class="tab === 'makebuy' ? 'bg-sky-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						Make-vs-Buy Analyzer
					</button>
					<a
						href="/calculator?mode=blueprint"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide text-emerald-300 hover:bg-emerald-500/15 transition"
					>
						Recursive T2 Tree →
					</a>
				</div>
			</div>

			<!-- TAB 1: T2 DECRYPTOR OPTIMIZER -->
			<div x-show="tab === 'decryptor'" class="space-y-5">
				<div class="tactical-panel rounded-xl p-5 space-y-4">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<div>
							<h2 class="text-sm font-bold uppercase tracking-wider text-amber-300">9-Decryptor Live Profit Matrix</h2>
							<p class="text-xs text-slate-300/80 mt-0.5">Fetches live Jita prices for all 8 Decryptors, required Datacores, and the T2 product from Public ESI to pick the single most profitable Decryptor.</p>
						</div>
						<span class="text-[10px] font-mono text-slate-400">
							{ fmt.Sprintf("Broker %.2f%% • Tax %.2f%%", settings.BrokerFeePercent, settings.SalesTaxPercent) }
						</span>
					</div>

					<form
						hx-post="/invention/optimize"
						hx-target="#inv-result-panel"
						hx-swap="innerHTML"
						hx-indicator="#inv-opt-spinner"
						class="grid grid-cols-2 gap-3 sm:grid-cols-6"
					>
						<div class="col-span-2">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">T2 Product Preset</label>
							<select name="preset_key" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white">
								for _, p := range domain.DefaultT2Presets {
									<option value={ p.Key }>{ fmt.Sprintf("[%s] %s", p.Category, p.ProductName) }</option>
								}
							</select>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Encryption Skill (1–5)</label>
							<input type="number" name="encryption_skill" value="4" min="1" max="5" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-mono text-white"/>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Datacore 1 Skill (1–5)</label>
							<input type="number" name="datacore_1_skill" value="4" min="1" max="5" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-mono text-white"/>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Datacore 2 Skill (1–5)</label>
							<input type="number" name="datacore_2_skill" value="4" min="1" max="5" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-mono text-white"/>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Job Fee / Attempt (ISK)</label>
							<input type="number" step="1000" name="invention_job_fee" value="50000" min="0" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-mono text-white"/>
						</div>
						<div class="col-span-2 sm:col-span-3">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Base ME 0 T2 Build Cost / Run (0 = Preset Default)</label>
							<input type="number" step="1000" name="base_build_cost_per_run" value="0" min="0" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-mono text-white"/>
						</div>
						<div class="col-span-2 sm:col-span-3">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">T2 Product Sell Override (0 = Live Jita Sell)</label>
							<input type="number" step="100" name="product_sell_override" value="0" min="0" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-mono text-white"/>
						</div>
						<div class="col-span-2 sm:col-span-6 flex justify-end">
							<button
								type="submit"
								class="inline-flex items-center gap-2 rounded-lg bg-amber-400 px-5 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-amber-300 transition cursor-pointer"
							>
								<span id="inv-opt-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
								<span>Optimize All 9 Decryptors (Live ESI)</span>
							</button>
						</div>
					</form>
				</div>

				<div id="inv-result-panel">
					<div class="tactical-panel rounded-xl p-8 text-center text-xs text-slate-300/80">
						Choose a T2 product and click <strong>Optimize All 9 Decryptors</strong> to compare success chance, resulting ME/TE/Runs, live Decryptor prices, and true Net Profit per Unit.
					</div>
				</div>
			</div>

			<!-- TAB 2: MAKE-VS-BUY COMPONENT ANALYZER -->
			<div x-cloak x-show="tab === 'makebuy'" class="grid grid-cols-1 gap-6 lg:grid-cols-12">
				<div class="tactical-panel rounded-xl p-5 lg:col-span-6 space-y-4">
					<div>
						<h2 class="text-sm font-bold uppercase tracking-wider text-sky-300">Intermediate Component Make-vs-Buy</h2>
						<p class="text-xs text-slate-300/80 mt-0.5">Verify whether manufacturing an intermediate T2/Capital component in-house beats buying it off Jita market (after SCI { fmt.Sprintf("%.4f", settings.SystemCostIndex) } + Facility Tax { fmt.Sprintf("%.2f%%", settings.FacilityTaxPercent) }).</p>
					</div>

					<form
						hx-post="/invention/make-vs-buy"
						hx-target="#makebuy-result-panel"
						hx-swap="innerHTML"
						class="grid grid-cols-1 gap-3 sm:grid-cols-2"
					>
						<div class="sm:col-span-2">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Component Name</label>
							<input type="text" name="component_name" value="Construction Blocks" required class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-white"/>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Batch Quantity Needed</label>
							<input type="number" name="quantity" value="500" min="1" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Jita Unit Sell Price (ISK)</label>
							<input type="number" step="0.01" name="jita_unit_price" value="14500" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
						</div>
						<div class="sm:col-span-2">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">In-House Raw Material Cost / Unit (ISK)</label>
							<input type="number" step="0.01" name="raw_material_per_unit" value="11200" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
						</div>
						<div class="sm:col-span-2 pt-1">
							<button type="submit" class="w-full rounded-lg bg-sky-400 py-2.5 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-sky-300 transition cursor-pointer">
								Compare Make vs. Buy
							</button>
						</div>
					</form>
				</div>

				<div id="makebuy-result-panel" class="tactical-panel rounded-xl p-5 lg:col-span-6">
					<div class="py-10 text-center text-xs text-slate-300/80">
						Enter a component's Jita sell price and raw material build cost, then click <strong>Compare Make vs. Buy</strong>.
					</div>
				</div>
			</div>
		</div>
	}
}

templ InventionResultPartial(res *domain.InventionOptimizationResult, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl p-4 border-rose-400/40 text-xs text-rose-200">{ errMsg }</div>
	} else if res != nil {
		<div class="space-y-4">
			<!-- Winner Banner -->
			<div class="tactical-panel rounded-xl p-5 border-emerald-400/40 flex flex-wrap items-center justify-between gap-4">
				<div class="flex items-center gap-3.5">
					<img src={ EVEItemIconURL(res.Preset.ProductTypeID, 64) } alt={ res.Preset.ProductName } class="h-12 w-12 shrink-0 rounded-lg border border-emerald-400/45 bg-slate-950/80 p-0.5 object-contain" onerror="this.style.display='none'"/>
					<div>
						<div class="text-[10px] font-mono uppercase tracking-widest text-emerald-300">Recommended Optimal Decryptor</div>
						<div class="text-xl font-bold text-white mt-0.5">{ res.BestScenario.Decryptor.Name }</div>
						<div class="text-xs font-mono text-slate-300 mt-1">
							{ fmt.Sprintf("%s • Live Jita Sell: %s • Datacores/Try: %s", res.Preset.ProductName, FormatISK(res.ProductSellPrice), FormatISK(res.DatacoreCostPerTry)) }
						</div>
					</div>
				</div>
				<div class="flex flex-wrap gap-4 font-mono text-right">
					<div>
						<div class="text-[10px] uppercase text-slate-400">Net Profit / Unit</div>
						<div class={ "text-lg font-bold " + profitColor(res.BestScenario.NetProfitPerUnit) }>{ FormatISK(res.BestScenario.NetProfitPerUnit) }</div>
					</div>
					<div>
						<div class="text-[10px] uppercase text-slate-400">Net Profit / T2 BPC</div>
						<div class={ "text-lg font-bold " + profitColor(res.BestScenario.NetProfitPerBPC) }>{ FormatISK(res.BestScenario.NetProfitPerBPC) }</div>
					</div>
					<div>
						<div class="text-[10px] uppercase text-slate-400">Success / BPC Stats</div>
						<div class="text-sm font-bold text-amber-200">{ fmt.Sprintf("%.1f%% • ME %d / %d runs", res.BestScenario.SuccessChancePct, res.BestScenario.ResultME, res.BestScenario.ResultRuns) }</div>
					</div>
				</div>
			</div>

			<!-- All 9 Decryptors Matrix -->
			<div class="tactical-panel rounded-xl overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs font-mono">
						<thead class="bg-slate-950/50 text-[10px] uppercase tracking-wider text-slate-400 border-b border-violet-400/15">
							<tr>
								<th class="px-4 py-3">Decryptor</th>
								<th class="px-3 py-3 text-right">Chance</th>
								<th class="px-3 py-3 text-right">ME / TE / Runs</th>
								<th class="px-3 py-3 text-right">Decryptor Cost</th>
								<th class="px-3 py-3 text-right">Inv Cost / Unit</th>
								<th class="px-3 py-3 text-right">Total Cost / Unit</th>
								<th class="px-3 py-3 text-right">Net Profit / Unit</th>
								<th class="px-4 py-3 text-right">Profit / BPC (ROI)</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-violet-400/15">
							for _, sc := range res.Scenarios {
								<tr class={ "hover:bg-white/5 " + func() string { if sc.IsBest { return "bg-emerald-500/10" }; return "" }() }>
									<td class="px-4 py-2.5 font-sans">
										<div class="flex items-center gap-2">
											if sc.Decryptor.TypeID > 0 {
												<img src={ EVEItemIconURL(sc.Decryptor.TypeID, 32) } alt={ sc.Decryptor.Name } loading="lazy" class="h-6 w-6 shrink-0 rounded border border-violet-400/25 bg-slate-950/80 object-contain" onerror="this.style.display='none'"/>
											}
											<span class="font-semibold text-white">{ sc.Decryptor.Name }</span>
											if sc.IsBest {
												<span class="rounded border border-emerald-400/45 bg-emerald-500/20 px-1.5 py-0.5 font-mono text-[9px] font-bold text-emerald-200">BEST</span>
											}
										</div>
									</td>
									<td class="px-3 py-2.5 text-right text-sky-200">{ fmt.Sprintf("%.1f%%", sc.SuccessChancePct) }</td>
									<td class="px-3 py-2.5 text-right text-slate-200">{ fmt.Sprintf("%d%% / %d%% / %dr", sc.ResultME, sc.ResultTE, sc.ResultRuns) }</td>
									<td class="px-3 py-2.5 text-right text-slate-300">{ FormatISK(sc.DecryptorPrice) }</td>
									<td class="px-3 py-2.5 text-right text-amber-200">{ FormatISK(sc.InventionCostPerUnit) }</td>
									<td class="px-3 py-2.5 text-right text-slate-200">{ FormatISK(sc.TotalCostPerUnit) }</td>
									<td class={ "px-3 py-2.5 text-right font-bold " + profitColor(sc.NetProfitPerUnit) }>{ FormatISK(sc.NetProfitPerUnit) }</td>
									<td class="px-4 py-2.5 text-right">
										<span class={ "font-bold " + profitColor(sc.NetProfitPerBPC) }>{ FormatISK(sc.NetProfitPerBPC) }</span>
										<span class="text-slate-400 ml-1">({ FormatPercent(sc.ROIPercent) })</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

templ MakeVsBuyResultPartial(res *domain.MakeVsBuyResult, errMsg string) {
	if errMsg != "" {
		<div class="rounded-lg border border-rose-400/40 bg-rose-950/40 p-4 text-xs text-rose-200">{ errMsg }</div>
	} else if res != nil {
		<div class="space-y-4">
			<div class="flex items-center justify-between border-b border-violet-400/20 pb-3">
				<div>
					<div class="text-[10px] font-mono uppercase text-slate-400">Decision for { fmt.Sprintf("%dx %s", res.Quantity, res.ComponentName) }</div>
					<div class="text-xl font-bold text-white mt-0.5">{ res.Recommendation }</div>
				</div>
				if res.Recommendation == "MAKE COMPONENT" {
					<span class="rounded-full border border-emerald-400/45 bg-emerald-500/20 px-3 py-1 font-mono text-xs font-bold text-emerald-200">
						SAVE { FormatPercent(res.SavingsPercent) }
					</span>
				} else {
					<span class="rounded-full border border-sky-400/45 bg-sky-500/20 px-3 py-1 font-mono text-xs font-bold text-sky-200">
						BUY CHEAPER BY { FormatPercent(res.SavingsPercent) }
					</span>
				}
			</div>

			<div class="grid grid-cols-2 gap-3 font-mono">
				<div class="rounded-lg border border-slate-800 bg-slate-900/75 p-3">
					<div class="text-[10px] uppercase text-slate-400">Total Buy Cost (Jita)</div>
					<div class="mt-1 text-lg font-bold text-amber-200">{ FormatISK(res.TotalBuyCost) }</div>
				</div>
				<div class="rounded-lg border border-slate-800 bg-slate-900/75 p-3">
					<div class="text-[10px] uppercase text-slate-400">Total Make Cost (Raw + SCI)</div>
					<div class="mt-1 text-lg font-bold text-sky-200">{ FormatISK(res.TotalMakeCost) }</div>
				</div>
			</div>

			<div class="rounded-lg border border-slate-800 bg-slate-950/60 p-3.5 text-xs font-mono space-y-1.5">
				<div class="flex justify-between"><span class="text-slate-400">Job Install Cost (SCI + Facility Tax)</span><span class="text-slate-200">{ FormatISKExact(res.JobInstallTotal) }</span></div>
				<div class="flex justify-between font-bold border-t border-slate-800 pt-1.5">
					<span class="text-slate-300">Net ISK Difference (Buy − Make)</span>
					<span class={ profitColor(res.SavingsISK) }>{ FormatISKExact(res.SavingsISK) }</span>
				</div>
			</div>
		</div>
	}
}

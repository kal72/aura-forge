package web

import (
	"fmt"
	"net/url"

	"aura-forge/internal/domain"
	"aura-forge/internal/service"
)

func pulseSignalBadgeClass(signal string) string {
	switch signal {
	case "HOT":
		return "border-amber-400/60 bg-amber-500/25 text-amber-200"
	case "CHEAP":
		return "border-emerald-400/50 bg-emerald-500/20 text-emerald-200"
	case "HIGH":
		return "border-rose-400/50 bg-rose-500/20 text-rose-200"
	default:
		return "border-slate-500/40 bg-slate-700/35 text-slate-300"
	}
}

func pulseSparklineColor(signal string) string {
	switch signal {
	case "HOT":
		return "#fbbf24" // amber-400
	case "CHEAP":
		return "#34d399" // emerald-400
	case "HIGH":
		return "#fb7185" // rose-400
	default:
		return "#38bdf8" // sky-400
	}
}

func formatPulsePrice(v float64) string {
	if v < 1000 {
		return fmt.Sprintf("%.2f ISK", v)
	}
	return FormatISK(v)
}

func formatCompactVol(v float64) string {
	switch {
	case v >= 1_000_000:
		return fmt.Sprintf("%.1fM/d", v/1_000_000)
	case v >= 1_000:
		return fmt.Sprintf("%.1fK/d", v/1_000)
	default:
		return fmt.Sprintf("%.0f/d", v)
	}
}

func copilotPriorityBadgeClass(priority string) string {
	switch priority {
	case "URGENT":
		return "border-rose-400/50 bg-rose-500/20 text-rose-200"
	case "ACTION":
		return "border-amber-400/50 bg-amber-500/20 text-amber-200"
	case "OK":
		return "border-emerald-400/50 bg-emerald-500/20 text-emerald-200"
	default:
		return "border-sky-400/45 bg-sky-500/20 text-sky-200"
	}
}

func copilotActionBtnClass(priority string) string {
	switch priority {
	case "URGENT":
		return "border-rose-400/55 bg-rose-500/20 text-rose-100 hover:bg-rose-500/35"
	case "ACTION":
		return "border-amber-400/55 bg-amber-400/20 text-amber-100 hover:bg-amber-400/35"
	case "OK":
		return "border-emerald-400/50 bg-emerald-500/20 text-emerald-100 hover:bg-emerald-500/35"
	default:
		return "border-sky-400/45 bg-sky-500/20 text-sky-100 hover:bg-sky-500/35"
	}
}

func dashboardHubKey(hub domain.TradeHub) string {
	if hub.Key != "" {
		return hub.Key
	}
	return "jita"
}

func dashboardHubName(hub domain.TradeHub) string {
	if hub.Name != "" {
		return hub.Name
	}
	return "Jita 4-4"
}

templ DashboardPage(data *service.DashboardSummary) {
	@Layout("Dashboard", "dashboard", data.Mode) {
		<div class="space-y-6">
			<!-- Header & Quick Actions -->
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div>
					if data.Mode.IsAdmin() {
						<h1 class="text-2xl font-bold tracking-tight text-white">Command Center // Dashboard</h1>
						<p class="text-xs text-slate-300/80 mt-0.5">Summary of available capital, manufacturing slot capacity, realized profit, and daily copilot directives.</p>
					} else {
						<h1 class="text-2xl font-bold tracking-tight text-white">Market &amp; Research Dashboard</h1>
						<p class="text-xs text-slate-300/80 mt-0.5">Live New Eden Market Pulse across Minerals, Gas, PI, Macro, Hot Blueprints, and Global Movers, plus Quick Profit Calculator.</p>
					}
				</div>
				<div class="flex flex-wrap gap-2">
					if data.Mode.IsAdmin() {
						<a href="/scanner" class="rounded-md border border-amber-500/40 bg-amber-500/15 px-3 py-1.5 text-xs font-semibold text-amber-200 hover:bg-amber-500/25 transition">
							Opportunity Scanner
						</a>
						<a href="/manufacture" class="rounded-md border border-sky-500/40 bg-sky-500/15 px-3 py-1.5 text-xs font-semibold text-sky-200 hover:bg-sky-500/25 transition">
							Manufacture &amp; Profit
						</a>
						<a href="/wealth" class="rounded-md border border-emerald-500/40 bg-emerald-500/15 px-3 py-1.5 text-xs font-semibold text-emerald-200 hover:bg-emerald-500/25 transition">
							100B+ Roadmap
						</a>
					} else {
						<a href="/marketplace" class="rounded-md border border-sky-500/40 bg-sky-500/15 px-3 py-1.5 text-xs font-semibold text-sky-200 hover:bg-sky-500/25 transition">
							Marketplace
						</a>
						<a href="/scanner" class="rounded-md border border-amber-500/40 bg-amber-500/15 px-3 py-1.5 text-xs font-semibold text-amber-200 hover:bg-amber-500/25 transition">
							Opportunity Scanner
						</a>
						<a href="/manufacture" class="rounded-md border border-emerald-500/40 bg-emerald-500/15 px-3 py-1.5 text-xs font-semibold text-emerald-200 hover:bg-emerald-500/25 transition">
							Manufacture &amp; Profit
						</a>
					}
				</div>
			</div>

			<!-- Admin-Only Financial KPI Grid -->
			if data.Mode.IsAdmin() {
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
					<div class="tactical-panel rounded-xl p-4">
						<div class="text-[11px] font-mono uppercase tracking-wider text-slate-300">Available Capital</div>
						<div class="mt-2 text-2xl font-bold font-mono text-emerald-300">{ FormatISK(data.AvailableCapital) }</div>
						<div class="mt-1 text-[11px] text-slate-400">Source: { data.CapitalSource }</div>
					</div>

					<div class="tactical-panel rounded-xl p-4">
						<div class="text-[11px] font-mono uppercase tracking-wider text-slate-300">Locked Capital</div>
						<div class="mt-2 text-2xl font-bold font-mono text-amber-300">{ FormatISK(data.LockedCapital) }</div>
						<div class="mt-1 text-[11px] text-slate-400">{ fmt.Sprintf("%d active batches (%d undercut)", data.ActiveBatchesCount, data.UndercutBatchesCount) }</div>
					</div>

					<div class="tactical-panel rounded-xl p-4">
						<div class="text-[11px] font-mono uppercase tracking-wider text-slate-300">Realized Profit</div>
						<div class="mt-2 text-2xl font-bold font-mono text-sky-300">{ FormatISK(data.RealizedProfit) }</div>
						<div class="mt-1 text-[11px] text-slate-400">Accumulated from SOLD batches</div>
					</div>

					<div class="tactical-panel rounded-xl p-4">
						<div class="text-[11px] font-mono uppercase tracking-wider text-slate-300">Slot Capacity</div>
						<div class="mt-2 text-2xl font-bold font-mono text-white">
							{ fmt.Sprintf("%d / %d", data.MfgSlotsUsed, data.MfgSlotsTotal) }
							<span class="text-xs font-normal text-slate-400">MFG</span>
						</div>
						<div class="mt-1 text-[11px] text-slate-400">
							{ fmt.Sprintf("Science/Invention: %d / %d • Catalog: %d safe, %d traps", data.SciSlotsUsed, data.SciSlotsTotal, data.LayakItemsCount, data.JebakanItemsCount) }
						</div>
					</div>
				</div>
			}

			<!-- Live Market Pulse (Minerals, PI Benchmarks, Macro/Fuel, Hot Blueprints & Global Movers) -->
			<div
				class="tactical-panel rounded-xl p-4 space-y-3.5"
				x-data={ fmt.Sprintf(`{
					pulseCat: 'minerals',
					pulseHub: %q,
					pulseSort: 'demand',
					loadPulse() {
						htmx.ajax('GET', '/esi/minerals?category=' + this.pulseCat + '&hub=' + this.pulseHub + '&sort=' + this.pulseSort, {
							target: '#live-mineral-ticker',
							swap: 'innerHTML',
							indicator: '#pulse-spinner'
						});
					},
					setCat(c) {
						this.pulseCat = c;
						this.loadPulse();
					},
					setSort(s) {
						this.pulseSort = s;
						this.loadPulse();
					}
				}`, dashboardHubKey(data.ActiveHub)) }
			>
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div class="flex items-center gap-2">
						<span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
						<h2 class="text-xs font-bold uppercase tracking-wider text-amber-200">Live Market Pulse</h2>
						<span id="pulse-spinner" class="htmx-indicator h-3 w-3 animate-spin rounded-full border-2 border-amber-300 border-t-transparent"></span>
					</div>

					<div class="flex flex-wrap items-center gap-2 ml-auto">
						<!-- 6 Category Tabs -->
						<div class="inline-flex flex-wrap rounded-lg border border-violet-400/30 bg-slate-950/70 p-0.5">
							<button
								type="button"
								@click="setCat('minerals')"
								:class="pulseCat === 'minerals' ? 'bg-amber-400 text-slate-950 shadow-xs' : 'text-slate-300 hover:text-white'"
								class="rounded-md px-2.5 py-1 text-[11px] font-bold transition cursor-pointer"
							>
								Minerals (8)
							</button>
							<button
								type="button"
								@click="setCat('gas')"
								:class="pulseCat === 'gas' ? 'bg-teal-400 text-slate-950 shadow-xs' : 'text-slate-300 hover:text-white'"
								class="rounded-md px-2.5 py-1 text-[11px] font-bold transition cursor-pointer"
							>
								Gas (8)
							</button>
							<button
								type="button"
								@click="setCat('reactions')"
								:class="pulseCat === 'reactions' ? 'bg-cyan-400 text-slate-950 shadow-xs' : 'text-slate-300 hover:text-white'"
								class="rounded-md px-2.5 py-1 text-[11px] font-bold transition cursor-pointer"
							>
								Gas Reactions (8)
							</button>
							<button
								type="button"
								@click="setCat('pi')"
								:class="pulseCat === 'pi' ? 'bg-violet-500 text-white shadow-xs' : 'text-slate-300 hover:text-white'"
								class="rounded-md px-2.5 py-1 text-[11px] font-bold transition cursor-pointer"
							>
								PI (6)
							</button>
							<button
								type="button"
								@click="setCat('macro')"
								:class="pulseCat === 'macro' ? 'bg-sky-400 text-slate-950 shadow-xs' : 'text-slate-300 hover:text-white'"
								class="rounded-md px-2.5 py-1 text-[11px] font-bold transition cursor-pointer"
							>
								Macro &amp; Fuel (6)
							</button>
							<button
								type="button"
								@click="setCat('blueprints')"
								:class="pulseCat === 'blueprints' ? 'bg-emerald-400 text-slate-950 shadow-xs' : 'text-slate-300 hover:text-white'"
								class="rounded-md px-2.5 py-1 text-[11px] font-bold transition cursor-pointer"
							>
								Hot Blueprints
							</button>
						</div>

						<!-- Trade Hub Selector -->
						<select
							x-model="pulseHub"
							@change="loadPulse()"
							class="rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1 text-[11px] font-mono font-semibold text-amber-200 focus:border-amber-300/60 focus:outline-none"
						>
							for _, h := range domain.MajorTradeHubs {
								<option value={ h.Key }>{ h.Name }</option>
							}
						</select>

						<button
							type="button"
							@click="loadPulse()"
							class="rounded-lg border border-violet-400/35 bg-violet-500/15 px-2.5 py-1 text-[11px] font-semibold text-violet-200 hover:bg-violet-500/25 cursor-pointer"
						>
							Refresh
						</button>
					</div>
				</div>

				<!-- Dedicated Sub-Bar for Hot Blueprints Sort Toggle (prevents top tab row from shifting) -->
				<div
					x-cloak
					x-show="pulseCat === 'blueprints'"
					class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-emerald-400/25 bg-slate-950/60 px-3 py-1.5"
				>
					<div class="flex items-center gap-2 text-[11px] text-slate-300">
						<span class="font-mono text-[10px] font-bold uppercase tracking-wider text-emerald-300">Hot Blueprints</span>
						<span class="text-slate-500">•</span>
						<span class="text-slate-400">Sort manufactured items by 7d demand surge or price momentum</span>
					</div>
					<div class="inline-flex rounded-lg border border-emerald-400/35 bg-slate-950/80 p-0.5">
						<button
							type="button"
							@click="setSort('demand')"
							:class="pulseSort === 'demand' ? 'bg-amber-400 text-slate-950' : 'text-slate-300 hover:text-white'"
							class="rounded px-2.5 py-0.5 font-mono text-[10px] font-bold transition cursor-pointer"
						>
							Hot Demand
						</button>
						<button
							type="button"
							@click="setSort('price')"
							:class="pulseSort === 'price' ? 'bg-rose-400 text-slate-950' : 'text-slate-300 hover:text-white'"
							class="rounded px-2.5 py-0.5 font-mono text-[10px] font-bold transition cursor-pointer"
						>
							Price Rising ↑
						</button>
					</div>
				</div>

				<div
					id="live-mineral-ticker"
					hx-get={ fmt.Sprintf("/esi/minerals?category=minerals&hub=%s&sort=demand", dashboardHubKey(data.ActiveHub)) }
					hx-trigger="load"
					hx-swap="innerHTML"
					hx-indicator="#pulse-spinner"
					class="text-xs font-mono text-slate-400"
				>
					Loading Live Market Pulse from PostgreSQL cache / Public ESI...
				</div>
			</div>

			<!-- Background Top-Opportunities Radar (Auto-Sweeps up to 160 Blueprints across 6 Categories) -->
			<div
				id="dashboard-opportunity-radar"
				hx-get="/radar/top"
				hx-trigger="load"
				hx-swap="outerHTML"
				class="tactical-panel rounded-xl p-4"
			>
				<div class="flex items-center gap-2 text-xs font-mono text-slate-400">
					<span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
					<span>Loading Background Top-Opportunities Radar...</span>
				</div>
			</div>

			<!-- Two-Column Workspace: Daily Copilot Assistant (Admin Only) + Quick HTMX Calculator -->
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
				<!-- Daily Copilot Assistant (Admin Only) -->
				if data.Mode.IsAdmin() {
					<div class="tactical-panel rounded-xl p-5 lg:col-span-5 space-y-4">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<div>
								<h2 class="text-sm font-bold uppercase tracking-wider text-amber-300">Daily Copilot Assistant</h2>
								<p class="text-[11px] text-slate-400 mt-0.5">Prioritized next actions for <strong class="text-sky-200">{ dashboardHubName(data.ActiveHub) }</strong> — click to execute.</p>
							</div>
							<div class="flex items-center gap-2">
								if data.Mode.AI.Enabled {
									<button
										type="button"
										@click="window.dispatchEvent(new CustomEvent('open-aura-ai', { detail: { prompt: 'Give me my prioritized daily pilot briefing for today based on my live capital, idle slots, catalog, and best opportunities.' } }))"
										class="rounded-md border border-violet-400/50 bg-violet-500/20 px-2.5 py-1 text-[10px] font-bold text-violet-100 hover:bg-violet-500/35 transition cursor-pointer"
									>
										⚡ Ask Aura Briefing
									</button>
								}
								<span class="rounded-full border border-amber-400/40 bg-amber-500/15 px-2.5 py-0.5 font-mono text-[10px] font-bold text-amber-200">
									{ fmt.Sprintf("%d BRIEFING", len(data.CopilotActions)) }
								</span>
							</div>
						</div>

						<div class="space-y-2.5">
							for _, act := range data.CopilotActions {
								<div class="rounded-lg border border-slate-800/90 bg-slate-900/65 p-3 space-y-2">
									<div class="flex items-start justify-between gap-2">
										<div class="space-y-0.5 min-w-0">
											<div class="flex items-center gap-2">
												<span class={ "rounded border px-1.5 py-0.5 font-mono text-[9px] font-bold " + copilotPriorityBadgeClass(act.Priority) }>
													{ act.Priority }
												</span>
												<span class="text-xs font-bold text-white">{ act.Title }</span>
											</div>
											<p class="text-[11px] text-slate-300 leading-relaxed">{ act.Detail }</p>
										</div>
									</div>
									<div class="flex justify-end">
										if act.ActionPost != "" {
											<button
												type="button"
												hx-post={ act.ActionPost }
												hx-swap="none"
												class={ "rounded-md border px-2.5 py-1 text-[11px] font-bold transition cursor-pointer " + copilotActionBtnClass(act.Priority) }
											>
												{ act.ActionLabel }
											</button>
										} else if act.ActionURL != "" {
											<a
												href={ templ.SafeURL(act.ActionURL) }
												class={ "rounded-md border px-2.5 py-1 text-[11px] font-bold transition " + copilotActionBtnClass(act.Priority) }
											>
												{ act.ActionLabel }
											</a>
										}
									</div>
								</div>
							}
						</div>

						if data.ActivePlan != nil {
							<div class="rounded-lg border border-emerald-500/30 bg-emerald-950/20 p-3.5">
								<div class="text-[11px] font-mono uppercase text-emerald-400">Active Weekly Plan</div>
								<div class="mt-1 font-semibold text-white">{ data.ActivePlan.Title }</div>
								<div class="mt-1 text-xs text-slate-300">
									Est. Profit: <span class="font-mono text-emerald-300">{ FormatISK(data.ActivePlan.TotalEstimatedProfit) }</span>
									({ FormatPercent(data.ActivePlan.ProjectedROI) } ROI)
								</div>
								<a href="/planner" class="mt-2 inline-block text-xs font-semibold text-sky-300 hover:underline">Open Day 1–7 Schedule &amp; Shopping List →</a>
							</div>
						}
					</div>
				}

				<!-- Quick HTMX Profit Calculator -->
				<div
					class={ func() string {
						if data.Mode.IsAdmin() {
							return "tactical-panel rounded-xl p-5 lg:col-span-7 space-y-4"
						}
						return "tactical-panel rounded-xl p-5 lg:col-span-12 space-y-4"
					}() }
					x-data={ fmt.Sprintf(`{
						itemName: 'Hobgoblin I',
						sellPrice: 14500,
						esiHint: '',
						async fetchHubPrice() {
							if (!this.itemName) return;
							this.esiHint = 'Looking up Public ESI...';
							try {
								const r = await fetch('/esi/lookup?name=' + encodeURIComponent(this.itemName));
								const d = await r.json();
								if (!r.ok) { this.esiHint = d.error || 'Item not found'; return; }
								if (d.lowest_sell > 0) this.sellPrice = d.lowest_sell;
								this.esiHint = 'Live ' + (d.hub_name || %q) + ' Sell: ' + Number(d.lowest_sell).toLocaleString() + ' ISK • Vol: ' + Number(d.daily_volume).toLocaleString() + '/day';
							} catch (e) { this.esiHint = 'Failed to reach Public ESI'; }
						}
					}`, dashboardHubName(data.ActiveHub)) }
				>
					<div class="flex items-center justify-between">
						<h2 class="text-sm font-bold uppercase tracking-wider text-amber-300">Quick Profit Calculator</h2>
						<a href="/manufacture" class="text-xs text-sky-300 hover:underline">Manufacture &amp; Profit →</a>
					</div>

					<form
						hx-post="/calculator/compute"
						hx-target="#quick-calc-result"
						hx-swap="innerHTML"
						class="grid grid-cols-1 gap-3 sm:grid-cols-2"
					>
						<div class="sm:col-span-2">
							<label class="block text-[11px] font-mono uppercase text-slate-300">Item Name (Auto-Fill { dashboardHubName(data.ActiveHub) } Price via Public ESI)</label>
							<div class="mt-1 flex gap-2">
								<input type="text" name="item_name" x-model="itemName" class="flex-1 rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-white focus:border-sky-400 focus:outline-none"/>
								<button type="button" @click="fetchHubPrice()" class="rounded-md border border-amber-400/40 bg-amber-500/15 px-3 py-2 text-xs font-semibold text-amber-200 hover:bg-amber-500/25 cursor-pointer">
									Fetch { dashboardHubName(data.ActiveHub) } ESI
								</button>
							</div>
							<div x-show="esiHint" x-text="esiHint" class="mt-1 text-[11px] font-mono text-emerald-300"></div>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-400">Output Qty / Batch</label>
							<input type="number" name="output_qty" value="500" min="1" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white focus:border-sky-400 focus:outline-none"/>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-400">Jita Sell Price / Unit (ISK)</label>
							<input type="number" step="0.01" name="unit_sell_price" x-model="sellPrice" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white focus:border-sky-400 focus:outline-none"/>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-400">Material Cost / Batch (ISK)</label>
							<input type="number" step="0.01" name="material_cost" value="4900000" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white focus:border-sky-400 focus:outline-none"/>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-400">Extra BPC / Decryptor Cost</label>
							<input type="number" step="0.01" name="extra_setup_cost" value="0" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white focus:border-sky-400 focus:outline-none"/>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-400">Target Batches / Week</label>
							<input type="number" name="batches_per_week" value="4" min="1" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white focus:border-sky-400 focus:outline-none"/>
						</div>
						<div class="flex items-end justify-end">
							<button type="submit" class="w-full rounded-md bg-sky-500 px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-950 hover:bg-sky-400 transition cursor-pointer">
								Calculate Net Profit &amp; Break-Even
							</button>
						</div>
					</form>

					<div id="quick-calc-result" class="rounded-lg border border-slate-800 bg-slate-950/60 p-3 text-xs text-slate-400">
						Click above to compute Net Profit, Jita Taxes, Break-Even Unit Price, and Weekly Projection in real time.
					</div>
				</div>
			</div>
		</div>
	}
}

templ MineralTickerPartial(pulse service.MarketPulseResponse) {
	if pulse.Category == service.PulseCategoryGlobal && len(pulse.Quotes) == 0 {
		<div class="rounded-xl border border-violet-400/25 bg-slate-950/65 p-5 flex flex-wrap items-center justify-between gap-4">
			<div class="space-y-1 max-w-2xl">
				<div class="flex items-center gap-2">
					<span class="rounded border border-amber-400/45 bg-amber-500/15 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-200">GLOBAL SNAPSHOT BASELINE</span>
					if pulse.GlobalStats != nil && pulse.GlobalStats.LatestItems > 0 {
						<span class="font-mono text-[11px] text-emerald-300">{ fmt.Sprintf("%d EVE items recorded", pulse.GlobalStats.LatestItems) }</span>
					}
				</div>
				<p class="text-xs text-slate-300 leading-relaxed">
					if pulse.GlobalStats != nil && pulse.GlobalStats.DaysAvailable == 1 {
						Day 1 baseline from <code class="text-amber-200">GET /markets/prices/</code> (1 cached ESI call) is saved in PostgreSQL. Day-over-day <strong>Top Global Movers</strong> across all ~15,000+ EVE items will activate automatically once Day 2's snapshot is recorded.
					} else {
						Waiting for the first background <code class="text-amber-200">GET /markets/prices/</code> snapshot (runs automatically within ~15s after server start, or click <strong>Sync Prices</strong> in the sidebar).
					}
				</p>
			</div>
			<button
				type="button"
				hx-post="/esi/sync-prices"
				hx-swap="none"
				class="rounded-lg border border-amber-400/45 bg-amber-500/15 px-3 py-1.5 text-xs font-semibold text-amber-200 hover:bg-amber-500/25 cursor-pointer"
			>
				Capture Snapshot Now
			</button>
		</div>
	} else if len(pulse.Quotes) == 0 {
		<div class="rounded-xl border border-violet-400/20 bg-slate-950/60 p-5 text-center text-xs text-slate-400">
			No market data available yet for this tab. Click <strong>Refresh</strong> or wait for the background Jita sync cycle.
		</div>
	} else {
		<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
			for _, m := range pulse.Quotes {
				<div class="group relative rounded-xl border border-violet-400/20 bg-slate-950/65 p-3 hover:border-amber-300/55 hover:bg-slate-900/80 transition">
					<!-- Top Row: Official EVE Icon + Name + Signal Badge -->
					<div class="flex items-start justify-between gap-2">
						<a
							href={ templ.SafeURL(fmt.Sprintf("/marketplace?hub=%s&q=%s", m.HubKey, url.QueryEscape(m.Name))) }
							title={ fmt.Sprintf("Open %s order book in %s Marketplace", m.Name, m.HubName) }
							class="flex items-center gap-2.5 min-w-0 flex-1"
						>
							<img
								src={ EVEItemIconURL(m.TypeID, 64) }
								alt={ m.Name }
								loading="lazy"
								class="h-9 w-9 shrink-0 rounded-lg border border-violet-400/30 bg-slate-900 p-0.5 object-contain"
								onerror="this.style.display='none'"
							/>
							<div class="min-w-0">
								<div class="text-xs font-bold text-white truncate group-hover:text-amber-200 transition">{ m.Name }</div>
								<div class="flex items-center gap-1.5 text-[9.5px] font-mono text-slate-400">
									if m.BlueprintCategory != "" {
										<span class="text-violet-300">{ m.BlueprintCategory }</span>
										<span>•</span>
									}
									<span>{ m.HubName }</span>
									if m.IsLive {
										<span class="text-emerald-400">• LIVE</span>
									} else {
										<span class="text-amber-300">• EST</span>
									}
								</div>
							</div>
						</a>

						<span
							title="Market trend signal: HOT (7d volume surge ≥1.25× vs 30d), CHEAP (≤-3% vs 7d), HIGH (≥+3% vs 7d), FAIR (normal)"
							class={ "shrink-0 rounded-md border px-1.5 py-0.5 font-mono text-[9px] font-bold leading-tight text-right " + pulseSignalBadgeClass(m.Signal) }
						>
							if m.Signal == "HOT" && m.VolumeRatio > 0 {
								{ fmt.Sprintf("%.2f× HOT", m.VolumeRatio) }
							} else if m.Avg7dPrice > 0 {
								{ fmt.Sprintf("%+.1f%% %s", m.Change7dPercent, m.Signal) }
							} else {
								{ m.Signal }
							}
						</span>
					</div>

					<!-- Middle Row: Lowest Sell + 7d Mini Sparkline -->
					<div class="mt-2.5 flex items-end justify-between gap-2">
						<div>
							<div class="text-[9.5px] font-mono uppercase text-slate-400">
								if m.IsGlobalMover && !m.IsLive {
									Global Avg
								} else {
									Lowest Sell
								}
							</div>
							<div class="text-sm font-mono font-bold text-amber-200 leading-tight">{ formatPulsePrice(m.LowestSell) }</div>
						</div>
						if m.SparklinePoints != "" {
							<svg width="72" height="20" viewBox="0 0 72 20" class="shrink-0 overflow-visible" aria-hidden="true">
								<polyline
									fill="none"
									stroke={ pulseSparklineColor(m.Signal) }
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									points={ m.SparklinePoints }
								></polyline>
							</svg>
						}
					</div>

					<!-- Bottom Row: Volume / Buy / Spread + Action Shortcut -->
					<div class="mt-2 pt-2 border-t border-violet-400/15 flex items-center justify-between gap-2 font-mono text-[10px] text-slate-400">
						if m.BlueprintID > 0 || m.IsGlobalMover {
							<span class="truncate">
								if m.DailyVolume7d > 0 {
									Vol <strong class="text-emerald-300">{ formatCompactVol(m.DailyVolume7d) }</strong>
								} else {
									Buy <strong class="text-slate-200">{ formatPulsePrice(m.HighestBuy) }</strong>
								}
							</span>
						} else {
							<span class="truncate">Buy: <strong class="text-slate-200">{ formatPulsePrice(m.HighestBuy) }</strong></span>
						}

						<div class="flex items-center gap-2 shrink-0">
							if m.BlueprintID > 0 && m.Change7dPercent != 0 {
								<span class={ func() string {
									if m.Change7dPercent > 0 {
										return "text-emerald-300"
									}
									return "text-rose-300"
								}() }>{ fmt.Sprintf("%+.1f%%", m.Change7dPercent) }</span>
							} else if m.SpreadPercent > 0 {
								<span class="text-sky-300" title="Sell vs Buy spread">Spd { fmt.Sprintf("%.1f%%", m.SpreadPercent) }</span>
							}

							if m.IsPI {
								<a
									href={ templ.SafeURL(fmt.Sprintf("/pi?type_id=%d&hub=%s", m.TypeID, m.HubKey)) }
									class="rounded border border-amber-400/40 bg-amber-500/15 px-1.5 py-0.5 text-[9px] font-bold text-amber-200 hover:bg-amber-500/30 transition"
								>
									Tree →
								</a>
							} else if m.BlueprintID > 0 {
								<a
									href={ templ.SafeURL(fmt.Sprintf("/manufacture?bp_id=%d&hub=%s", m.BlueprintID, m.HubKey)) }
									title={ "Open " + m.Name + " in Manufacture & Profit" }
									class="rounded border border-emerald-400/40 bg-emerald-500/15 px-1.5 py-0.5 text-[9px] font-bold text-emerald-200 hover:bg-emerald-500/30 transition"
								>
									Craft →
								</a>
							}
						</div>
					</div>
				</div>
			}
		</div>
	}
}


templ DashboardRadarPartial(snap service.RadarSnapshot) {
	<div
		id="dashboard-opportunity-radar"
		if snap.Running {
			hx-get="/radar/top"
			hx-trigger="every 3s"
			hx-swap="outerHTML"
		}
		class="tactical-panel rounded-xl p-4 space-y-3"
	>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div class="flex flex-wrap items-center gap-2">
				if snap.Running {
					<span class="h-2.5 w-2.5 animate-spin rounded-full border-2 border-amber-300 border-t-transparent"></span>
				} else {
					<span class="h-2 w-2 rounded-full bg-amber-400"></span>
				}
				<h2 class="text-xs font-bold uppercase tracking-wider text-amber-200">Top Opportunities Radar</h2>
				if snap.EvaluatedCount > 0 {
					<span class="rounded border border-emerald-400/35 bg-emerald-500/15 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-200">
						{ fmt.Sprintf("%d Blueprints Scanned • %d Profitable", snap.EvaluatedCount, snap.ProfitableCount) }
					</span>
				}
				if snap.HubName != "" {
					<span class="font-mono text-[10px] text-slate-400">
						{ snap.HubName } • { service.FormatRadarAge(snap.UpdatedAt) }
					</span>
				}
			</div>

			<div class="flex items-center gap-2">
				<button
					type="button"
					hx-post="/radar/refresh"
					hx-target="#dashboard-opportunity-radar"
					hx-swap="outerHTML"
					disabled?={ snap.Running }
					class="rounded-lg border border-amber-400/40 bg-amber-500/15 px-2.5 py-1 text-[11px] font-semibold text-amber-200 hover:bg-amber-500/25 disabled:opacity-50 cursor-pointer"
				>
					if snap.Running {
						Scanning 160 BPs...
					} else {
						Rescan Now
					}
				</button>
				<a
					href="/scanner"
					class="rounded-lg border border-violet-400/35 bg-violet-500/15 px-2.5 py-1 text-[11px] font-semibold text-violet-200 hover:bg-violet-500/25"
				>
					Full Scanner →
				</a>
			</div>
		</div>

		if snap.LastError != "" && len(snap.TopOpportunities) == 0 {
			<div class="rounded-lg border border-rose-400/30 bg-slate-950/60 p-3 text-xs text-rose-200">
				{ snap.LastError }
			</div>
		} else if len(snap.TopOpportunities) == 0 {
			<div class="rounded-lg border border-violet-400/20 bg-slate-950/60 p-4 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-300">
				if snap.Running {
					<span>Sweeping up to <strong>160 blueprints</strong> across Drones, Ammo, Ships, Modules, Rigs &amp; Components using cache-first ESI — results will appear automatically in a few seconds...</span>
				} else {
					<span>Background 160-blueprint sweep runs automatically ~25s after server startup (every 30m), or click <strong>Rescan Now</strong> to run immediately.</span>
				}
			</div>
		} else {
			<div class="overflow-x-auto rounded-lg border border-violet-400/15 bg-slate-950/55">
				<table class="w-full text-left text-xs">
					<thead class="bg-slate-950/60 font-mono uppercase text-[9.5px] tracking-wider text-slate-400 border-b border-violet-400/15">
						<tr>
							<th class="px-3 py-2">Blueprint / Auto-Sizing</th>
							<th class="px-2.5 py-2 text-right">Daily Vol</th>
							<th class="px-2.5 py-2 text-right">Rec. Sell / Floor</th>
							<th class="px-2.5 py-2 text-right">Net Profit</th>
							<th class="px-2.5 py-2 text-right">Margin</th>
							<th class="px-2.5 py-2 text-right">ISK / Hour</th>
							<th class="px-2.5 py-2">Verdict</th>
							<th class="px-3 py-2 text-right">Action</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-violet-400/10">
						for _, r := range snap.TopOpportunities {
							<tr class="hover:bg-white/5">
								<td class="px-3 py-2">
									<div class="flex items-center gap-2">
										<img src={ EVEItemIconURL(r.ProductTypeID, 32) } alt={ r.ProductName } loading="lazy" class="h-7 w-7 shrink-0 rounded border border-violet-400/25 bg-slate-900 object-contain" onerror="this.style.display='none'"/>
										<div class="min-w-0">
											<div class="flex flex-wrap items-center gap-1">
												<span class="font-semibold text-white truncate">{ r.ProductName }</span>
												<span class="rounded bg-slate-800 px-1 font-mono text-[9px] text-amber-300">T{ fmt.Sprintf("%d", r.TechLevel) }</span>
												<span class="rounded border border-violet-400/30 bg-violet-500/15 px-1 font-mono text-[9px] text-violet-200">{ fmt.Sprintf("ME%d/TE%d", r.ME, r.TE) }</span>
												if r.OwnedBPO {
													<span class="rounded border border-emerald-400/40 bg-emerald-500/20 px-1 font-mono text-[8.5px] font-bold text-emerald-200">OWNED</span>
												}
											</div>
											<div class="font-mono text-[9.5px] text-slate-400">
												{ fmt.Sprintf("%s • %dx runs (%d u) • %s", r.Category, r.Runs, r.OutputQty, r.DurationFormatted) }
												if r.RunSizingReason != "" {
													<span class="text-amber-300/85"> • { r.RunSizingReason }</span>
												}
											</div>
										</div>
									</div>
								</td>
								<td class="px-2.5 py-2 text-right font-mono text-sky-200 whitespace-nowrap">{ FormatVolume(r.DailyVolume7d) }</td>
								<td class="px-2.5 py-2 text-right font-mono whitespace-nowrap">
									<div class="text-amber-200 font-semibold">{ FormatISK(r.RecommendedSell) }</div>
									if r.BreakEvenSell > 0 {
										<div class="text-[9px] text-slate-400">Floor { FormatISK(r.BreakEvenSell) }</div>
									}
								</td>
								<td class={ "px-2.5 py-2 text-right font-mono font-bold whitespace-nowrap " + profitColor(r.NetProfit) }>{ FormatISK(r.NetProfit) }</td>
								<td class="px-2.5 py-2 text-right font-mono text-slate-200 whitespace-nowrap">{ FormatPercent(r.NetMarginPercent) }</td>
								<td class={ "px-2.5 py-2 text-right font-mono font-bold whitespace-nowrap " + profitColor(r.ISKPerHour) }>{ FormatISK(r.ISKPerHour) }/h</td>
								<td class="px-2.5 py-2 whitespace-nowrap">
									<span class={ "inline-block rounded border px-1.5 py-0.5 font-mono text-[9.5px] font-bold " + verdictBadgeClass(r.Verdict) }>
										{ string(r.Verdict) }
									</span>
								</td>
								<td class="px-3 py-2 text-right whitespace-nowrap">
									<div class="inline-flex items-center gap-1">
										<a
											href={ templ.SafeURL(fmt.Sprintf("/manufacture?bp_id=%d&me=%d&te=%d&runs=%d&hub=%s", r.BlueprintTypeID, r.ME, r.TE, r.Runs, r.HubKey)) }
											class="rounded border border-emerald-400/35 bg-emerald-500/15 px-2 py-0.5 text-[10px] font-semibold text-emerald-200 hover:bg-emerald-500/25"
										>
											Craft →
										</a>
										<a
											href={ templ.SafeURL("/marketplace?hub=" + r.HubKey + "&q=" + url.QueryEscape(r.ProductName)) }
											class="rounded border border-violet-400/35 bg-violet-500/15 px-2 py-0.5 text-[10px] font-semibold text-violet-100 hover:bg-violet-500/25"
										>
											Market
										</a>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

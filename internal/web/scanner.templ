package web

import (
	"fmt"
	"net/url"

	"aura-forge/internal/domain"
	"aura-forge/internal/service"
)

func verdictBadgeClass(v domain.OpportunityVerdict) string {
	switch v {
	case domain.VerdictStrong:
		return "border-emerald-400/45 bg-emerald-500/20 text-emerald-200"
	case domain.VerdictModerate:
		return "border-sky-400/40 bg-sky-500/15 text-sky-200"
	case domain.VerdictWeak:
		return "border-amber-400/40 bg-amber-500/15 text-amber-200"
	default:
		return "border-rose-400/40 bg-rose-500/15 text-rose-200"
	}
}

templ ScannerPage(mode service.ModeInfo, settings domain.UserSettings) {
	@Layout("Opportunity Scanner", "scanner", mode) {
		<div class="space-y-6" x-data="{ tab: 'manufacturing' }">
			<!-- Header -->
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-white">Opportunity Scanner</h1>
					<p class="text-xs text-slate-300/80 mt-0.5">Discover the highest-margin items to manufacture, station-trade in Jita, or haul between major trade hubs — using live Public ESI data.</p>
				</div>

				<!-- 3-Mode Scanner Switcher -->
				<div class="inline-flex flex-wrap rounded-xl border border-violet-400/35 bg-slate-950/65 p-1 backdrop-blur">
					<button
						type="button"
						@click="tab = 'manufacturing'"
						:class="tab === 'manufacturing' ? 'bg-amber-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						Manufacturing ISK/hr
					</button>
					<button
						type="button"
						@click="tab = 'station'"
						:class="tab === 'station' ? 'bg-sky-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						Jita Station Trading
					</button>
					<button
						type="button"
						@click="tab = 'arbitrage'"
						:class="tab === 'arbitrage' ? 'bg-emerald-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						Inter-Hub Arbitrage
					</button>
				</div>
			</div>

			<!-- TAB 1: MANUFACTURING MARGIN SCANNER -->
			<div x-show="tab === 'manufacturing'" class="space-y-5">
				<div class="tactical-panel rounded-xl p-5 space-y-4">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<div>
							<h2 class="text-sm font-bold uppercase tracking-wider text-amber-300">SDE Manufacturing Margin Scanner</h2>
							<p class="text-xs text-slate-300/80 mt-0.5">Scans all EVE SDE blueprints against live Jita mineral &amp; product prices, ranking by true ISK/Hour per slot after taxes, SCI, and freight.</p>
						</div>
						<span class="text-[10px] font-mono text-slate-400">
							{ fmt.Sprintf("Broker %.2f%% • Tax %.2f%% • SCI %.4f", settings.BrokerFeePercent, settings.SalesTaxPercent, settings.SystemCostIndex) }
						</span>
					</div>

					<form
						hx-post="/scanner/manufacturing"
						hx-target="#scan-mfg-results"
						hx-swap="innerHTML"
						hx-indicator="#scan-mfg-spinner"
						class="grid grid-cols-2 gap-3 sm:grid-cols-6"
					>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Category</label>
							<select name="category" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-2 text-xs text-white">
								<option value="">All Blueprints</option>
								<option value="Drones">Drones</option>
								<option value="Ammunition">Ammunition</option>
								<option value="Ships">Ships</option>
								<option value="Modules">Modules</option>
							</select>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Runs</label>
							<input type="number" name="runs" value="10" min="1" max="1000" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-2 text-xs font-mono text-white"/>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">ME (0–10)</label>
							<input type="number" name="me" value="10" min="0" max="10" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-2 text-xs font-mono text-white"/>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">TE (0–20)</label>
							<input type="number" name="te" value="20" min="0" max="20" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-2 text-xs font-mono text-white"/>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Structure</label>
							<select name="structure_key" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-2 text-xs text-white">
								for _, st := range domain.DefaultStructureProfiles {
									<option value={ st.Key }>{ st.Name }</option>
								}
							</select>
						</div>
						<div>
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Material Cost</label>
							<select name="material_price_source" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-2 text-xs text-white">
								<option value="jita_sell">Jita Sell</option>
								<option value="jita_buy">Jita Buy</option>
							</select>
						</div>
						<div class="col-span-2 sm:col-span-6 flex justify-end">
							<button
								type="submit"
								class="inline-flex items-center gap-2 rounded-lg bg-amber-400 px-5 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-amber-300 transition cursor-pointer"
							>
								<span id="scan-mfg-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
								<span>Run Manufacturing Scan (Live ESI)</span>
							</button>
						</div>
					</form>
				</div>

				<div id="scan-mfg-results">
					<div class="tactical-panel rounded-xl p-8 text-center text-xs text-slate-300/80">
						Click <strong>Run Manufacturing Scan</strong> to evaluate all SDE blueprints against live Jita Public ESI prices and rank the top ISK/Hour builds.
					</div>
				</div>
			</div>

			<!-- TAB 2: JITA STATION TRADING SCANNER -->
			<div x-cloak x-show="tab === 'station'" class="space-y-5">
				<div class="tactical-panel rounded-xl p-5 space-y-4">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<div>
							<h2 class="text-sm font-bold uppercase tracking-wider text-sky-300">Jita 4-4 Station Trading Spread Scanner</h2>
							<p class="text-xs text-slate-300/80 mt-0.5">Finds profitable Buy Order → Sell Order flips after deducting <strong>2× Broker Fee + Sales Tax</strong> so you never fall for false spreads.</p>
						</div>
						<span class="text-[10px] font-mono text-slate-400">
							{ fmt.Sprintf("Round-Trip Fees: %.2f%%", settings.BrokerFeePercent*2+settings.SalesTaxPercent) }
						</span>
					</div>

					<form
						hx-post="/scanner/station-trading"
						hx-target="#scan-station-results"
						hx-swap="innerHTML"
						hx-indicator="#scan-station-spinner"
						class="flex flex-wrap items-end gap-3"
					>
						<div class="w-56">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Category Filter</label>
							<select name="category" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white">
								<option value="">All Liquid Items</option>
								<option value="Modules">Modules</option>
								<option value="Drones">Drones</option>
								<option value="Ships">Ships</option>
								<option value="Commodities">Commodities</option>
							</select>
						</div>
						<button
							type="submit"
							class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-5 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-sky-300 transition cursor-pointer"
						>
							<span id="scan-station-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
							<span>Scan Jita Spreads (Live ESI)</span>
						</button>
					</form>
				</div>

				<div id="scan-station-results">
					<div class="tactical-panel rounded-xl p-8 text-center text-xs text-slate-300/80">
						Click <strong>Scan Jita Spreads</strong> to find net-profitable station trading flips in Jita 4-4.
					</div>
				</div>
			</div>

			<!-- TAB 3: INTER-HUB ARBITRAGE SCANNER -->
			<div x-cloak x-show="tab === 'arbitrage'" class="space-y-5">
				<div class="tactical-panel rounded-xl p-5 space-y-4">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<div>
							<h2 class="text-sm font-bold uppercase tracking-wider text-emerald-300">Inter-Hub Hauling &amp; Arbitrage Scanner</h2>
							<p class="text-xs text-slate-300/80 mt-0.5">Compares compact, high-demand items between Empire hubs after deducting destination taxes and hauling freight ({ FormatISK(settings.FreightCostPerM3) }/m³).</p>
						</div>
					</div>

					<form
						hx-post="/scanner/arbitrage"
						hx-target="#scan-arb-results"
						hx-swap="innerHTML"
						hx-indicator="#scan-arb-spinner"
						class="flex flex-wrap items-end gap-3"
					>
						<div class="w-52">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Buy At (Origin Hub)</label>
							<select name="origin_hub" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white">
								for _, h := range domain.MajorTradeHubs {
									<option value={ h.Key } selected?={ h.Key == "jita" }>{ h.Name } ({ h.RegionName })</option>
								}
							</select>
						</div>
						<div class="w-52">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Sell At (Destination Hub)</label>
							<select name="dest_hub" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white">
								for _, h := range domain.MajorTradeHubs {
									<option value={ h.Key } selected?={ h.Key == "amarr" }>{ h.Name } ({ h.RegionName })</option>
								}
							</select>
						</div>
						<button
							type="submit"
							class="inline-flex items-center gap-2 rounded-lg bg-emerald-400 px-5 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-emerald-300 transition cursor-pointer"
						>
							<span id="scan-arb-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
							<span>Scan Arbitrage Route (Live ESI)</span>
						</button>
					</form>
				</div>

				<div id="scan-arb-results">
					<div class="tactical-panel rounded-xl p-8 text-center text-xs text-slate-300/80">
						Choose an Origin and Destination hub and click <strong>Scan Arbitrage Route</strong> to find profitable hauling spreads.
					</div>
				</div>
			</div>
		</div>
	}
}

templ ScannerManufacturingPartial(results []domain.ManufacturingOpportunity, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl p-4 border-rose-400/40 text-xs text-rose-200">{ errMsg }</div>
	} else if len(results) == 0 {
		<div class="tactical-panel rounded-xl p-8 text-center text-xs text-slate-400">No blueprint opportunities found for the selected filter.</div>
	} else {
		<div class="tactical-panel rounded-xl overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs">
					<thead class="bg-slate-950/50 font-mono uppercase text-[10px] tracking-wider text-slate-400 border-b border-violet-400/15">
						<tr>
							<th class="px-4 py-3">Product / Category</th>
							<th class="px-4 py-3 text-right">Material Cost</th>
							<th class="px-4 py-3 text-right">Jita Sell / Unit</th>
							<th class="px-4 py-3 text-right">Net Profit</th>
							<th class="px-4 py-3 text-right">Margin / ROI</th>
							<th class="px-4 py-3 text-right">ISK / Hour</th>
							<th class="px-4 py-3">Verdict</th>
							<th class="px-4 py-3 text-right">Action</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-violet-400/15">
						for _, r := range results {
							<tr class="hover:bg-white/5">
								<td class="px-4 py-3">
									<div class="font-semibold text-white">{ r.ProductName }</div>
									<div class="font-mono text-[10px] text-slate-400">{ fmt.Sprintf("%s • %dx runs (%d u) • %s", r.Category, r.Runs, r.OutputQty, r.DurationFormatted) }</div>
								</td>
								<td class="px-4 py-3 text-right font-mono text-slate-200">{ FormatISK(r.MaterialCost) }</td>
								<td class="px-4 py-3 text-right font-mono text-amber-200">{ FormatISK(r.ProductUnitSell) }</td>
								<td class={ "px-4 py-3 text-right font-mono font-bold " + profitColor(r.NetProfit) }>{ FormatISK(r.NetProfit) }</td>
								<td class="px-4 py-3 text-right font-mono text-slate-200">{ FormatPercent(r.NetMarginPercent) } / { FormatPercent(r.ROIPercent) }</td>
								<td class={ "px-4 py-3 text-right font-mono font-bold " + profitColor(r.ISKPerHour) }>{ FormatISK(r.ISKPerHour) }/h</td>
								<td class="px-4 py-3">
									<span class={ "inline-block rounded border px-2 py-0.5 font-mono text-[10px] font-bold " + verdictBadgeClass(r.Verdict) }>
										{ string(r.Verdict) }
									</span>
								</td>
								<td class="px-4 py-3 text-right">
									<div class="inline-flex items-center gap-1.5">
										<a href={ templ.SafeURL("/marketplace?q=" + url.QueryEscape(r.ProductName)) } class="rounded border border-violet-400/35 bg-violet-500/15 px-2 py-1 text-[10px] font-semibold text-violet-100 hover:bg-violet-500/25">
											Market
										</a>
										<form hx-post="/calculator/blueprint/save-catalog" hx-swap="none">
											<input type="hidden" name="product_type_id" value={ fmt.Sprintf("%d", r.ProductTypeID) }/>
											<input type="hidden" name="product_name" value={ r.ProductName }/>
											<input type="hidden" name="category" value={ r.Category }/>
											<input type="hidden" name="output_qty" value={ fmt.Sprintf("%d", r.OutputQty) }/>
											<input type="hidden" name="unit_sell_price" value={ fmt.Sprintf("%.2f", r.ProductUnitSell) }/>
											<input type="hidden" name="material_cost" value={ fmt.Sprintf("%.2f", r.MaterialCost) }/>
											<button type="submit" class="rounded bg-emerald-500 px-2 py-1 text-[10px] font-bold text-slate-950 hover:bg-emerald-400 cursor-pointer">
												+ Catalog
											</button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ ScannerStationTradingPartial(results []domain.StationTradeOpportunity, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl p-4 border-rose-400/40 text-xs text-rose-200">{ errMsg }</div>
	} else if len(results) == 0 {
		<div class="tactical-panel rounded-xl p-8 text-center text-xs text-slate-400">No station trading items returned from Public ESI.</div>
	} else {
		<div class="tactical-panel rounded-xl overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs">
					<thead class="bg-slate-950/50 font-mono uppercase text-[10px] tracking-wider text-slate-400 border-b border-violet-400/15">
						<tr>
							<th class="px-4 py-3">Item</th>
							<th class="px-4 py-3 text-right">Highest Buy</th>
							<th class="px-4 py-3 text-right">Lowest Sell</th>
							<th class="px-4 py-3 text-right">Gross Spread</th>
							<th class="px-4 py-3 text-right">Net Flip Profit / Unit</th>
							<th class="px-4 py-3 text-right">Net Margin</th>
							<th class="px-4 py-3">Verdict</th>
							<th class="px-4 py-3 text-right">Action</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-violet-400/15 font-mono">
						for _, r := range results {
							<tr class="hover:bg-white/5">
								<td class="px-4 py-3 font-sans">
									<div class="font-semibold text-white">{ r.Name }</div>
									<div class="font-mono text-[10px] text-slate-400">{ fmt.Sprintf("%s • %d sell / %d buy orders", r.Category, r.SellOrdersCount, r.BuyOrdersCount) }</div>
								</td>
								<td class="px-4 py-3 text-right text-sky-200">{ FormatISK(r.HighestBuy) }</td>
								<td class="px-4 py-3 text-right text-amber-200">{ FormatISK(r.LowestSell) }</td>
								<td class="px-4 py-3 text-right text-slate-300">{ FormatPercent(r.GrossSpreadPct) }</td>
								<td class={ "px-4 py-3 text-right font-bold " + profitColor(r.NetFlipProfitUnit) }>{ FormatISK(r.NetFlipProfitUnit) }</td>
								<td class={ "px-4 py-3 text-right font-bold " + profitColor(r.NetFlipMarginPct) }>{ FormatPercent(r.NetFlipMarginPct) }</td>
								<td class="px-4 py-3">
									<span class={ "inline-block rounded border px-2 py-0.5 text-[10px] font-bold " + verdictBadgeClass(r.Verdict) }>
										{ string(r.Verdict) }
									</span>
								</td>
								<td class="px-4 py-3 text-right font-sans">
									<a href={ templ.SafeURL("/marketplace?q=" + url.QueryEscape(r.Name)) } class="rounded border border-sky-400/35 bg-sky-500/15 px-2.5 py-1 text-[10px] font-semibold text-sky-200 hover:bg-sky-500/25">
										Order Book →
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ ScannerArbitragePartial(results []domain.ArbitrageOpportunity, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl p-4 border-rose-400/40 text-xs text-rose-200">{ errMsg }</div>
	} else if len(results) == 0 {
		<div class="tactical-panel rounded-xl p-8 text-center text-xs text-slate-400">No arbitrage opportunities found on this route.</div>
	} else {
		<div class="tactical-panel rounded-xl overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs">
					<thead class="bg-slate-950/50 font-mono uppercase text-[10px] tracking-wider text-slate-400 border-b border-violet-400/15">
						<tr>
							<th class="px-4 py-3">Item</th>
							<th class="px-4 py-3 text-right">Origin Sell (Buy Here)</th>
							<th class="px-4 py-3 text-right">Dest Sell (List Here)</th>
							<th class="px-4 py-3 text-right">Haul / Unit</th>
							<th class="px-4 py-3 text-right">Net Profit / Unit</th>
							<th class="px-4 py-3 text-right">Net Margin</th>
							<th class="px-4 py-3">Verdict</th>
							<th class="px-4 py-3 text-right">Action</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-violet-400/15 font-mono">
						for _, r := range results {
							<tr class="hover:bg-white/5">
								<td class="px-4 py-3 font-sans">
									<div class="font-semibold text-white">{ r.Name }</div>
									<div class="font-mono text-[10px] text-slate-400">{ r.OriginHub.Name } → { r.DestHub.Name }</div>
								</td>
								<td class="px-4 py-3 text-right text-emerald-200">{ FormatISK(r.OriginBuyPrice) }</td>
								<td class="px-4 py-3 text-right text-amber-200">{ FormatISK(r.DestSellPrice) }</td>
								<td class="px-4 py-3 text-right text-slate-400">{ FormatISK(r.HaulCostPerUnit) }</td>
								<td class={ "px-4 py-3 text-right font-bold " + profitColor(r.NetProfitUnit) }>{ FormatISK(r.NetProfitUnit) }</td>
								<td class={ "px-4 py-3 text-right font-bold " + profitColor(r.NetMarginPct) }>{ FormatPercent(r.NetMarginPct) }</td>
								<td class="px-4 py-3">
									<span class={ "inline-block rounded border px-2 py-0.5 text-[10px] font-bold " + verdictBadgeClass(r.Verdict) }>
										{ string(r.Verdict) }
									</span>
								</td>
								<td class="px-4 py-3 text-right font-sans">
									<a href={ templ.SafeURL("/marketplace?q=" + url.QueryEscape(r.Name) + "&hub=" + r.DestHub.Key) } class="rounded border border-emerald-400/35 bg-emerald-500/15 px-2.5 py-1 text-[10px] font-semibold text-emerald-200 hover:bg-emerald-500/25">
										Inspect Hub →
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

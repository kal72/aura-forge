package web

import (
	"fmt"

	"aura-forge/internal/domain"
	"aura-forge/internal/service"
)

func countUsersByRoleAndStatus(users []domain.AppUser) (admins, activeUsers, inactive int) {
	for _, u := range users {
		if u.Role == domain.RoleAdmin {
			admins++
		}
		if u.IsActive {
			activeUsers++
		} else {
			inactive++
		}
	}
	return admins, activeUsers, inactive
}

templ UsersPage(mode service.ModeInfo, users []domain.AppUser, flashMsg string, flashErr string) {
	@Layout("User Management", "users", mode) {
		<div class="space-y-6" x-data="{ showCreate: false }">
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-white">User Management</h1>
					<p class="text-xs text-slate-300/80 mt-0.5">Manage operator and administrator accounts. No public registration — only Admins can create and manage access.</p>
				</div>
				<button
					type="button"
					@click="showCreate = !showCreate"
					class="rounded-lg bg-amber-400 px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-950 hover:bg-amber-300 transition cursor-pointer"
				>
					+ Add User Account
				</button>
			</div>

			if flashMsg != "" {
				<div class="rounded-xl border border-emerald-400/40 bg-emerald-950/45 px-4 py-3 text-xs text-emerald-200">
					{ flashMsg }
				</div>
			}
			if flashErr != "" {
				<div class="rounded-xl border border-rose-400/40 bg-rose-950/45 px-4 py-3 text-xs text-rose-200">
					{ flashErr }
				</div>
			}

			<!-- KPI Summary Strip -->
			{{ admins, activeUsers, inactive := countUsersByRoleAndStatus(users) }}
			<div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-slate-400">Total Accounts</div>
					<div class="mt-1 text-2xl font-mono font-bold text-white">{ fmt.Sprintf("%d", len(users)) }</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-amber-300/80">Administrators</div>
					<div class="mt-1 text-2xl font-mono font-bold text-amber-300">{ fmt.Sprintf("%d", admins) }</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-emerald-300/80">Active Accounts</div>
					<div class="mt-1 text-2xl font-mono font-bold text-emerald-300">{ fmt.Sprintf("%d", activeUsers) }</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-rose-300/80">Inactive</div>
					<div class="mt-1 text-2xl font-mono font-bold text-rose-300">{ fmt.Sprintf("%d", inactive) }</div>
				</div>
			</div>

			<!-- Create User Form Panel -->
			<div x-cloak x-show="showCreate" x-transition class="tactical-panel rounded-xl p-5 space-y-4">
				<h2 class="text-sm font-bold uppercase tracking-wider text-amber-300">Create New User Account</h2>
				<form hx-post="/admin/users" hx-swap="none" class="grid grid-cols-1 gap-4 sm:grid-cols-4">
					<div>
						<label class="block text-[11px] font-mono uppercase text-slate-300">Username</label>
						<input type="text" name="username" required minlength="3" maxlength="40" placeholder="pilot.jita" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-900/90 px-3 py-2 text-sm font-mono text-white"/>
					</div>
					<div>
						<label class="block text-[11px] font-mono uppercase text-slate-300">Display Name</label>
						<input type="text" name="display_name" required placeholder="Caldari Trader" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-900/90 px-3 py-2 text-sm text-white"/>
					</div>
					<div>
						<label class="block text-[11px] font-mono uppercase text-slate-300">Initial Password</label>
						<input type="password" name="password" required minlength="6" placeholder="Min. 6 characters" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-900/90 px-3 py-2 text-sm text-white"/>
					</div>
					<div>
						<label class="block text-[11px] font-mono uppercase text-slate-300">Role</label>
						<select name="role" class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-900/90 px-3 py-2 text-sm text-white">
							<option value="user">User (Operator)</option>
							<option value="admin">Admin (Full Access)</option>
						</select>
					</div>
					<div class="sm:col-span-4 flex justify-end gap-2">
						<button type="button" @click="showCreate = false" class="rounded-lg border border-slate-600 px-3.5 py-2 text-xs text-slate-300 hover:bg-slate-800 cursor-pointer">
							Cancel
						</button>
						<button type="submit" class="rounded-lg bg-amber-400 px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-950 hover:bg-amber-300 cursor-pointer">
							Create Account
						</button>
					</div>
				</form>
			</div>

			<!-- Users Table -->
			<div class="tactical-panel rounded-xl overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs">
						<thead class="border-b border-violet-400/20 bg-slate-950/50 font-mono uppercase text-[10px] tracking-wider text-slate-300">
							<tr>
								<th class="px-4 py-3">Account</th>
								<th class="px-4 py-3">Role</th>
								<th class="px-4 py-3">Status</th>
								<th class="px-4 py-3">Last Login</th>
								<th class="px-4 py-3 text-right">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-violet-400/15">
							for _, u := range users {
								{{ isSelf := mode.CurrentUser != nil && mode.CurrentUser.ID == u.ID }}
								<tr x-data="{ editing: false, resetting: false }" class="hover:bg-white/5 align-top">
									<td class="px-4 py-3.5">
										<div class="flex items-center gap-2">
											<span class="font-semibold text-white text-sm">{ u.DisplayName }</span>
											if isSelf {
												<span class="rounded border border-violet-300/40 bg-violet-500/25 px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase text-violet-100">YOU</span>
											}
										</div>
										<div class="font-mono text-[11px] text-slate-400 mt-0.5">{ "@" + u.Username }</div>

										<!-- Inline Edit Form -->
										<form
											x-cloak
											x-show="editing"
											hx-post={ fmt.Sprintf("/admin/users/%d/update", u.ID) }
											hx-swap="none"
											class="mt-3 rounded-lg border border-violet-400/25 bg-slate-950/60 p-3 space-y-2.5 max-w-md"
										>
											<div class="text-[10px] font-mono uppercase tracking-wider text-amber-300">Edit Account</div>
											<div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
												<input type="text" name="display_name" value={ u.DisplayName } required class="rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white"/>
												<select name="role" class="rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white">
													<option value="user" selected?={ u.Role == domain.RoleUser }>user</option>
													<option value="admin" selected?={ u.Role == domain.RoleAdmin }>admin</option>
												</select>
											</div>
											<label class="inline-flex items-center gap-2 text-xs text-slate-200">
												<input type="checkbox" name="is_active" value="true" checked?={ u.IsActive } class="rounded border-slate-600 bg-slate-800"/>
												<span>Account Active</span>
											</label>
											<div class="flex gap-2">
												<button type="submit" class="rounded bg-sky-500 px-3 py-1 text-[11px] font-bold text-slate-950 hover:bg-sky-400 cursor-pointer">Save</button>
												<button type="button" @click="editing = false" class="rounded border border-slate-700 px-3 py-1 text-[11px] text-slate-300 cursor-pointer">Cancel</button>
											</div>
										</form>

										<!-- Inline Reset Password Form -->
										<form
											x-cloak
											x-show="resetting"
											hx-post={ fmt.Sprintf("/admin/users/%d/reset-password", u.ID) }
											hx-swap="none"
											class="mt-3 rounded-lg border border-amber-400/30 bg-slate-950/60 p-3 space-y-2 max-w-sm"
										>
											<div class="text-[10px] font-mono uppercase tracking-wider text-amber-300">Reset Password</div>
											<div class="flex gap-2">
												<input type="password" name="new_password" required minlength="6" placeholder="New password (min. 6)" class="flex-1 rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white"/>
												<button type="submit" class="rounded bg-amber-400 px-3 py-1 text-[11px] font-bold text-slate-950 hover:bg-amber-300 cursor-pointer">Reset</button>
												<button type="button" @click="resetting = false" class="rounded border border-slate-700 px-2.5 py-1 text-[11px] text-slate-300 cursor-pointer">Close</button>
											</div>
										</form>
									</td>
									<td class="px-4 py-3.5">
										if u.Role == domain.RoleAdmin {
											<span class="inline-block rounded-md border border-amber-400/45 bg-amber-500/20 px-2 py-0.5 font-mono text-[10px] font-bold uppercase text-amber-200">
												ADMIN
											</span>
										} else {
											<span class="inline-block rounded-md border border-sky-400/35 bg-sky-500/15 px-2 py-0.5 font-mono text-[10px] font-bold uppercase text-sky-200">
												USER
											</span>
										}
									</td>
									<td class="px-4 py-3.5">
										if u.IsActive {
											<span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/35 bg-emerald-500/15 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-emerald-200">
												<span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
												ACTIVE
											</span>
										} else {
											<span class="inline-flex items-center gap-1.5 rounded-full border border-rose-400/35 bg-rose-500/15 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-rose-200">
												<span class="h-1.5 w-1.5 rounded-full bg-rose-400"></span>
												INACTIVE
											</span>
										}
									</td>
									<td class="px-4 py-3.5 font-mono text-[11px] text-slate-300">
										if u.LastLoginAt != nil {
											{ u.LastLoginAt.Format("2006-01-02 15:04") }
										} else {
											<span class="text-slate-500">Never</span>
										}
									</td>
									<td class="px-4 py-3.5 text-right">
										<div class="inline-flex flex-wrap justify-end gap-1.5">
											<button
												type="button"
												@click="editing = !editing; resetting = false"
												class="rounded border border-violet-400/35 bg-violet-500/15 px-2.5 py-1 text-[11px] font-semibold text-violet-100 hover:bg-violet-500/25 cursor-pointer"
											>
												Edit
											</button>
											<button
												type="button"
												@click="resetting = !resetting; editing = false"
												class="rounded border border-amber-400/35 bg-amber-500/15 px-2.5 py-1 text-[11px] font-semibold text-amber-200 hover:bg-amber-500/25 cursor-pointer"
											>
												Reset PW
											</button>
											if !isSelf {
												<button
													type="button"
													hx-delete={ fmt.Sprintf("/admin/users/%d", u.ID) }
													hx-confirm={ fmt.Sprintf("Permanently delete account '%s'?", u.Username) }
													hx-swap="none"
													class="rounded border border-rose-400/35 bg-rose-500/15 px-2.5 py-1 text-[11px] font-semibold text-rose-200 hover:bg-rose-500/25 cursor-pointer"
												>
													Delete
												</button>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

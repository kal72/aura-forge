package web

import (
	"fmt"
	"math"
	"strings"

	"aura-forge/internal/domain"
	"aura-forge/internal/service"
)

func buildHistorySparklinePoints(history []domain.MarketHistoryPoint) string {
	if len(history) < 2 {
		return ""
	}
	minVal := math.MaxFloat64
	maxVal := 0.0
	for _, h := range history {
		if h.Average > 0 && h.Average < minVal {
			minVal = h.Average
		}
		if h.Average > maxVal {
			maxVal = h.Average
		}
	}
	if maxVal <= 0 || minVal == math.MaxFloat64 {
		return ""
	}
	span := maxVal - minVal
	if span == 0 {
		span = 1
	}

	const width = 560.0
	const height = 110.0
	const padY = 12.0

	pts := make([]string, 0, len(history))
	stepX := width / float64(len(history)-1)
	for i, h := range history {
		x := float64(i) * stepX
		norm := (h.Average - minVal) / span
		y := (height - padY) - norm*(height-2*padY)
		pts = append(pts, fmt.Sprintf("%.1f,%.1f", x, y))
	}
	return strings.Join(pts, " ")
}

func findBestHubPrices(hubs []domain.HubPriceSummary) (bestSell, bestBuy float64) {
	bestSell = math.MaxFloat64
	for _, h := range hubs {
		if h.LowestSell > 0 && h.LowestSell < bestSell {
			bestSell = h.LowestSell
		}
		if h.HighestBuy > bestBuy {
			bestBuy = h.HighestBuy
		}
	}
	if bestSell == math.MaxFloat64 {
		bestSell = 0
	}
	return bestSell, bestBuy
}

func recentHistoryDesc(history []domain.MarketHistoryPoint, limit int) []domain.MarketHistoryPoint {
	if len(history) == 0 {
		return nil
	}
	out := make([]domain.MarketHistoryPoint, 0, limit)
	for i := len(history) - 1; i >= 0 && len(out) < limit; i-- {
		out = append(out, history[i])
	}
	return out
}

func formatInt64(v int64) string {
	if v >= 1_000_000_000 {
		return fmt.Sprintf("%.2fB", float64(v)/1_000_000_000)
	}
	if v >= 1_000_000 {
		return fmt.Sprintf("%.2fM", float64(v)/1_000_000)
	}
	if v >= 1_000 {
		return fmt.Sprintf("%.1fK", float64(v)/1_000)
	}
	return fmt.Sprintf("%d", v)
}

templ MarketplacePage(mode service.ModeInfo, query string, hubKey string, presets []service.MarketplacePreset, snap *domain.MarketplaceSnapshot, errMsg string) {
	@Layout("Marketplace", "marketplace", mode) {
		<div class="space-y-6">
			<!-- Header -->
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-white">New Eden Marketplace Browser</h1>
					<p class="text-xs text-slate-300/80 mt-0.5">Explore live Order Books, 5-hub price comparisons (Jita, Amarr, Dodixie, Rens, Hek), and 30-day price history directly from Public ESI.</p>
				</div>
				<span class="rounded-full border border-emerald-400/35 bg-emerald-500/15 px-3 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider text-emerald-200">
					Public ESI • Cached PostgreSQL
				</span>
			</div>

			<!-- Search & Trade Hub Filter Panel -->
			<div class="tactical-panel rounded-xl p-5 space-y-4">
				<form
					hx-get="/marketplace/search"
					hx-target="#marketplace-results"
					hx-swap="innerHTML"
					hx-indicator="#mp-search-spinner"
					class="grid grid-cols-1 gap-3 sm:grid-cols-12"
				>
					<div class="sm:col-span-7">
						<label class="block text-[10px] font-mono uppercase tracking-wider text-slate-300 mb-1">Exact EVE Online Item Name or Type ID</label>
						<input
							id="mp-query-input"
							type="text"
							name="q"
							value={ query }
							required
							placeholder="e.g. PLEX, Tritanium, Hobgoblin II, Venture, Catalyst..."
							class="w-full rounded-lg border border-slate-700 bg-slate-900/90 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-300/70 focus:outline-none"
						/>
					</div>
					<div class="sm:col-span-3">
						<label class="block text-[10px] font-mono uppercase tracking-wider text-slate-300 mb-1">Primary Trade Hub</label>
						<select name="hub" class="w-full rounded-lg border border-slate-700 bg-slate-900/90 px-3 py-2.5 text-sm text-white">
							for _, h := range domain.MajorTradeHubs {
								<option value={ h.Key } selected?={ hubKey == h.Key }>{ h.Name } ({ h.RegionName })</option>
							}
						</select>
					</div>
					<div class="sm:col-span-2 flex items-end">
						<button
							type="submit"
							class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-amber-400 px-4 py-2.5 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-amber-300 transition cursor-pointer"
						>
							<span id="mp-search-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
							<span>Search Market</span>
						</button>
					</div>
				</form>

				<!-- 1-Click Popular Item Presets -->
				<div class="flex flex-wrap items-center gap-1.5 pt-1 border-t border-violet-400/15">
					<span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 mr-1">Quick:</span>
					for _, p := range presets {
						<button
							type="button"
							hx-get={ "/marketplace/search?q=" + p.Name + "&hub=" + hubKey }
							hx-target="#marketplace-results"
							hx-swap="innerHTML"
							hx-indicator="#mp-search-spinner"
							onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('mp-query-input').value=%q", p.Name)} }
							class="rounded-md border border-violet-400/30 bg-violet-500/15 px-2.5 py-1 text-[11px] font-medium text-violet-100 hover:border-amber-300/50 hover:bg-amber-400/15 hover:text-amber-200 transition cursor-pointer"
						>
							{ p.Name }
						</button>
					}
				</div>
			</div>

			<!-- Live Marketplace Results Container -->
			<div id="marketplace-results">
				@MarketplaceResultsPartial(snap, errMsg)
			</div>
		</div>
	}
}

templ MarketplaceResultsPartial(snap *domain.MarketplaceSnapshot, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl p-5 border-rose-400/40 text-sm text-rose-200">
			<div class="font-bold text-rose-300 mb-1">Marketplace Lookup Failed</div>
			<p class="text-xs">{ errMsg }</p>
		</div>
	} else if snap == nil {
		<div class="tactical-panel rounded-xl p-10 text-center space-y-2">
			<div class="text-sm font-semibold text-white">Select a popular preset above or enter any EVE Online item name</div>
			<div class="text-xs text-slate-300/80">Instantly inspect Top 20 Sell/Buy Order Books, 5-hub price comparisons, and 30-day price history from Public ESI.</div>
		</div>
	} else {
		<div class="space-y-6">
			<!-- Item Title Banner + 1-Click Actions -->
			<div class="tactical-panel rounded-xl p-5 flex flex-wrap items-center justify-between gap-4">
				<div class="flex items-center gap-3.5">
					<img src={ EVEItemIconURL(snap.TypeID, 64) } alt={ snap.TypeName } class="h-12 w-12 shrink-0 rounded-lg border border-amber-300/45 bg-slate-950/80 p-0.5 shadow-[0_0_16px_rgba(251,191,36,0.2)] object-contain" onerror="this.style.display='none'"/>
					<div>
						<div class="flex flex-wrap items-center gap-2.5">
							<h2 class="text-xl font-bold text-white">{ snap.TypeName }</h2>
							<span class="rounded border border-violet-400/35 bg-violet-500/20 px-2 py-0.5 font-mono text-[10px] text-violet-200">
								TypeID #{ fmt.Sprintf("%d", snap.TypeID) }
							</span>
							<span class="rounded border border-amber-400/35 bg-amber-500/15 px-2 py-0.5 font-mono text-[10px] text-amber-200">
								{ snap.SelectedHub.Name } ({ snap.SelectedHub.RegionName })
							</span>
						</div>
						<div class="text-[11px] font-mono text-slate-400 mt-1">
							Updated: { snap.UpdatedAt.Format("15:04:05") } • { fmt.Sprintf("%d sell orders • %d buy orders", snap.SellOrdersCount, snap.BuyOrdersCount) }
						</div>
					</div>
				</div>

				<div class="flex flex-wrap items-center gap-2">
					<form hx-post="/marketplace/add-catalog" hx-swap="none">
						<input type="hidden" name="type_id" value={ fmt.Sprintf("%d", snap.TypeID) }/>
						<input type="hidden" name="name" value={ snap.TypeName }/>
						<input type="hidden" name="category" value="Other"/>
						<input type="hidden" name="sell_price" value={ fmt.Sprintf("%.2f", snap.LowestSell) }/>
						<input type="hidden" name="buy_price" value={ fmt.Sprintf("%.2f", snap.HighestBuy) }/>
						<input type="hidden" name="daily_volume" value={ fmt.Sprintf("%.0f", snap.AvgDailyVolume7d) }/>
						<button
							type="submit"
							class="rounded-lg bg-emerald-500 px-3.5 py-2 text-xs font-bold text-slate-950 hover:bg-emerald-400 transition cursor-pointer"
						>
							+ Add to Catalog
						</button>
					</form>
					<a
						href="/calculator"
						class="rounded-lg border border-sky-400/40 bg-sky-500/15 px-3.5 py-2 text-xs font-semibold text-sky-200 hover:bg-sky-500/25 transition"
					>
						Open in Calculator →
					</a>
				</div>
			</div>

			<!-- 4 KPI Cards -->
			<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-amber-300/85">Lowest Sell ({ snap.SelectedHub.Name })</div>
					<div class="mt-1 text-xl font-mono font-bold text-amber-200">{ FormatISK(snap.LowestSell) }</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">Supply: { formatInt64(snap.TotalSellVolume) } units</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-sky-300/85">Highest Buy ({ snap.SelectedHub.Name })</div>
					<div class="mt-1 text-xl font-mono font-bold text-sky-200">{ FormatISK(snap.HighestBuy) }</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">Demand: { formatInt64(snap.TotalBuyVolume) } units</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-emerald-300/85">Spread (Sell − Buy)</div>
					<div class="mt-1 text-xl font-mono font-bold text-emerald-200">{ FormatPercent(snap.SpreadPercent) }</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">{ FormatISK(snap.SpreadISK) } / unit</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-violet-300/85">Daily Volume (7d Avg)</div>
					<div class="mt-1 text-xl font-mono font-bold text-white">{ formatInt64(int64(snap.AvgDailyVolume7d)) } u/day</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">Est. Turnover: { FormatISK(snap.EstimatedDailyISK) }/day</div>
				</div>
			</div>

			<!-- Multi-Hub Comparison Table -->
			if len(snap.HubComparisons) > 0 {
				{{ bestSell, bestBuy := findBestHubPrices(snap.HubComparisons) }}
				<div class="tactical-panel rounded-xl overflow-hidden">
					<div class="px-5 py-3.5 border-b border-violet-400/20 flex items-center justify-between">
						<h3 class="text-xs font-bold uppercase tracking-wider text-amber-300">5 Major Trade Hub Comparison (Arbitrage &amp; Spread)</h3>
						<span class="text-[10px] font-mono text-slate-400">Green = Lowest Sell • Blue = Highest Buy</span>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full text-left text-xs">
							<thead class="bg-slate-950/50 font-mono uppercase text-[10px] tracking-wider text-slate-400 border-b border-violet-400/15">
								<tr>
									<th class="px-4 py-2.5">Trade Hub</th>
									<th class="px-4 py-2.5 text-right">Lowest Sell</th>
									<th class="px-4 py-2.5 text-right">Highest Buy</th>
									<th class="px-4 py-2.5 text-right">Spread</th>
									<th class="px-4 py-2.5 text-right">Sell Vol / Orders</th>
									<th class="px-4 py-2.5 text-right">Buy Vol / Orders</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-violet-400/15 font-mono">
								for _, h := range snap.HubComparisons {
									<tr class={ "hover:bg-white/5 " + func() string { if h.Hub.Key == snap.SelectedHub.Key { return "bg-violet-500/10" }; return "" }() }>
										<td class="px-4 py-2.5 font-sans">
											<span class="font-semibold text-white">{ h.Hub.Name }</span>
											<span class="ml-1.5 text-[10px] text-slate-400">{ h.Hub.RegionName }</span>
										</td>
										<td class="px-4 py-2.5 text-right">
											if h.LowestSell > 0 {
												<span class={ func() string { if h.LowestSell == bestSell { return "font-bold text-emerald-300" }; return "text-amber-200" }() }>
													{ FormatISK(h.LowestSell) }
												</span>
											} else {
												<span class="text-slate-500">—</span>
											}
										</td>
										<td class="px-4 py-2.5 text-right">
											if h.HighestBuy > 0 {
												<span class={ func() string { if h.HighestBuy == bestBuy { return "font-bold text-sky-300" }; return "text-slate-200" }() }>
													{ FormatISK(h.HighestBuy) }
												</span>
											} else {
												<span class="text-slate-500">—</span>
											}
										</td>
										<td class="px-4 py-2.5 text-right text-slate-300">
											if h.SpreadPercent > 0 {
												{ FormatPercent(h.SpreadPercent) }
											} else {
												<span class="text-slate-500">—</span>
											}
										</td>
										<td class="px-4 py-2.5 text-right text-slate-300">
											{ formatInt64(h.SellVolume) } <span class="text-slate-500">({ fmt.Sprintf("%d", h.SellOrdersCount) })</span>
										</td>
										<td class="px-4 py-2.5 text-right text-slate-300">
											{ formatInt64(h.BuyVolume) } <span class="text-slate-500">({ fmt.Sprintf("%d", h.BuyOrdersCount) })</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

			<!-- 30-Day Price History Trend -->
			if len(snap.History) > 0 {
				{{ sparkPoints := buildHistorySparklinePoints(snap.History) }}
				<div class="tactical-panel rounded-xl p-5 space-y-4">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<h3 class="text-xs font-bold uppercase tracking-wider text-violet-200">30-Day Average Price Trend ({ snap.SelectedHub.RegionName })</h3>
						<span class="text-[11px] font-mono text-slate-400">
							Avg 30d Vol: { formatInt64(int64(snap.AvgDailyVolume30d)) } u/day
						</span>
					</div>
					if sparkPoints != "" {
						<div class="rounded-lg border border-violet-400/20 bg-slate-950/50 p-3">
							<svg viewBox="0 0 560 110" class="w-full h-28 overflow-visible" preserveAspectRatio="none">
								<polyline
									fill="none"
									stroke="#fbbf24"
									stroke-width="2.2"
									stroke-linejoin="round"
									stroke-linecap="round"
									points={ sparkPoints }
								></polyline>
							</svg>
						</div>
					}
					<div class="overflow-x-auto">
						<table class="w-full text-left text-[11px] font-mono">
							<thead class="text-slate-400 border-b border-violet-400/15 uppercase text-[10px]">
								<tr>
									<th class="py-1.5 pr-3">Date</th>
									<th class="py-1.5 px-3 text-right">Average</th>
									<th class="py-1.5 px-3 text-right">Highest</th>
									<th class="py-1.5 px-3 text-right">Lowest</th>
									<th class="py-1.5 pl-3 text-right">Volume</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-violet-400/10">
								for _, pt := range recentHistoryDesc(snap.History, 7) {
									<tr class="hover:bg-white/5">
										<td class="py-1.5 pr-3 text-slate-300">{ pt.Date }</td>
										<td class="py-1.5 px-3 text-right text-amber-200 font-semibold">{ FormatISK(pt.Average) }</td>
										<td class="py-1.5 px-3 text-right text-emerald-300">{ FormatISK(pt.Highest) }</td>
										<td class="py-1.5 px-3 text-right text-rose-300">{ FormatISK(pt.Lowest) }</td>
										<td class="py-1.5 pl-3 text-right text-slate-200">{ formatInt64(pt.Volume) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

			<!-- Live Order Book Split View: Sell Orders vs Buy Orders -->
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
				<!-- Top Sell Orders -->
				<div class="tactical-panel rounded-xl overflow-hidden">
					<div class="px-5 py-3 border-b border-amber-400/20 flex items-center justify-between">
						<h3 class="text-xs font-bold uppercase tracking-wider text-amber-300">Top Sell Orders (Lowest)</h3>
						<span class="text-[10px] font-mono text-slate-400">{ fmt.Sprintf("Showing top %d", len(snap.SellOrders)) }</span>
					</div>
					if len(snap.SellOrders) == 0 {
						<div class="p-6 text-center text-xs text-slate-400">No active sell orders at this hub.</div>
					} else {
						<div class="overflow-x-auto">
							<table class="w-full text-left text-xs font-mono">
								<thead class="bg-slate-950/50 text-[10px] uppercase text-slate-400 border-b border-violet-400/15">
									<tr>
										<th class="px-4 py-2">Price (ISK)</th>
										<th class="px-4 py-2 text-right">Qty Remain</th>
										<th class="px-4 py-2 text-right">Total Value</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-violet-400/10">
									for _, o := range snap.SellOrders {
										<tr class="hover:bg-white/5">
											<td class="px-4 py-2 font-semibold text-amber-200">{ FormatISK(o.Price) }</td>
											<td class="px-4 py-2 text-right text-slate-200">{ fmt.Sprintf("%d", o.VolumeRemain) }</td>
											<td class="px-4 py-2 text-right text-slate-400">{ FormatISK(o.Price * float64(o.VolumeRemain)) }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Top Buy Orders -->
				<div class="tactical-panel rounded-xl overflow-hidden">
					<div class="px-5 py-3 border-b border-sky-400/20 flex items-center justify-between">
						<h3 class="text-xs font-bold uppercase tracking-wider text-sky-300">Top Buy Orders (Highest)</h3>
						<span class="text-[10px] font-mono text-slate-400">{ fmt.Sprintf("Showing top %d", len(snap.BuyOrders)) }</span>
					</div>
					if len(snap.BuyOrders) == 0 {
						<div class="p-6 text-center text-xs text-slate-400">No active buy orders at this hub.</div>
					} else {
						<div class="overflow-x-auto">
							<table class="w-full text-left text-xs font-mono">
								<thead class="bg-slate-950/50 text-[10px] uppercase text-slate-400 border-b border-violet-400/15">
									<tr>
										<th class="px-4 py-2">Price (ISK)</th>
										<th class="px-4 py-2 text-right">Qty Wanted</th>
										<th class="px-4 py-2 text-right">Total Value</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-violet-400/10">
									for _, o := range snap.BuyOrders {
										<tr class="hover:bg-white/5">
											<td class="px-4 py-2 font-semibold text-sky-200">{ FormatISK(o.Price) }</td>
											<td class="px-4 py-2 text-right text-slate-200">{ fmt.Sprintf("%d", o.VolumeRemain) }</td>
											<td class="px-4 py-2 text-right text-slate-400">{ FormatISK(o.Price * float64(o.VolumeRemain)) }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>
		</div>
	}
}

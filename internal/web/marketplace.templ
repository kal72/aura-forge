package web

import (
	"fmt"
	"math"
	"net/url"
	"strings"

	"aura-forge/internal/domain"
	"aura-forge/internal/i18n"
	"aura-forge/internal/service"
)

func buildHistorySparklinePoints(history []domain.MarketHistoryPoint) string {
	if len(history) < 2 {
		return ""
	}
	minVal, maxVal := historyMinMax(history)
	if maxVal <= 0 || minVal == math.MaxFloat64 {
		return ""
	}
	span := maxVal - minVal
	if span == 0 {
		span = 1
	}

	const width = 560.0
	const height = 110.0
	const padY = 12.0

	pts := make([]string, 0, len(history))
	stepX := width / float64(len(history)-1)
	for i, h := range history {
		x := float64(i) * stepX
		norm := (h.Average - minVal) / span
		y := (height - padY) - norm*(height-2*padY)
		pts = append(pts, fmt.Sprintf("%.1f,%.1f", x, y))
	}
	return strings.Join(pts, " ")
}

func historyMinMax(history []domain.MarketHistoryPoint) (minVal, maxVal float64) {
	minVal = math.MaxFloat64
	for _, h := range history {
		if h.Average > 0 && h.Average < minVal {
			minVal = h.Average
		}
		if h.Average > maxVal {
			maxVal = h.Average
		}
	}
	if minVal == math.MaxFloat64 {
		minVal = 0
	}
	return minVal, maxVal
}

func historyAvg30d(history []domain.MarketHistoryPoint) float64 {
	sum := 0.0
	cnt := 0
	for _, h := range history {
		if h.Average > 0 {
			sum += h.Average
			cnt++
		}
	}
	if cnt == 0 {
		return 0
	}
	return sum / float64(cnt)
}

func findBestHubPrices(hubs []domain.HubPriceSummary) (bestSell, bestBuy float64) {
	bestSell = math.MaxFloat64
	for _, h := range hubs {
		if h.LowestSell > 0 && h.LowestSell < bestSell {
			bestSell = h.LowestSell
		}
		if h.HighestBuy > bestBuy {
			bestBuy = h.HighestBuy
		}
	}
	if bestSell == math.MaxFloat64 {
		bestSell = 0
	}
	return bestSell, bestBuy
}

func recentHistoryDesc(history []domain.MarketHistoryPoint, limit int) []domain.MarketHistoryPoint {
	if len(history) == 0 {
		return nil
	}
	out := make([]domain.MarketHistoryPoint, 0, limit)
	for i := len(history) - 1; i >= 0 && len(out) < limit; i-- {
		out = append(out, history[i])
	}
	return out
}

func formatInt64(v int64) string {
	if v >= 1_000_000_000 {
		return fmt.Sprintf("%.2fB", float64(v)/1_000_000_000)
	}
	if v >= 1_000_000 {
		return fmt.Sprintf("%.2fM", float64(v)/1_000_000)
	}
	if v >= 1_000 {
		return fmt.Sprintf("%.1fK", float64(v)/1_000)
	}
	return fmt.Sprintf("%d", v)
}

type orderDepthRow struct {
	Order      domain.MarketOrderBookEntry
	CumQty     int64
	DepthPct   float64
	TotalValue float64
}

func buildOrderDepthRows(orders []domain.MarketOrderBookEntry) []orderDepthRow {
	rows := make([]orderDepthRow, 0, len(orders))
	var cum int64
	for _, o := range orders {
		cum += int64(o.VolumeRemain)
		rows = append(rows, orderDepthRow{
			Order:      o,
			CumQty:     cum,
			TotalValue: o.Price * float64(o.VolumeRemain),
		})
	}
	if cum > 0 {
		for i := range rows {
			rows[i].DepthPct = math.Min(100, (float64(rows[i].CumQty)/float64(cum))*100.0)
		}
	}
	return rows
}

func marketplaceSignalClass(sig string) string {
	switch sig {
	case "SPIKE":
		return "border-amber-400/60 bg-amber-500/25 text-amber-200"
	case "HIGH":
		return "border-rose-400/50 bg-rose-500/20 text-rose-200"
	case "CHEAP":
		return "border-emerald-400/50 bg-emerald-500/20 text-emerald-200"
	default:
		return "border-slate-500/40 bg-slate-700/35 text-slate-200"
	}
}

templ MarketplacePage(mode service.ModeInfo, query string, hubKey string, presets []service.MarketplacePreset, snap *domain.MarketplaceSnapshot, errMsg string) {
	@Layout("Marketplace", "marketplace", mode) {
		<div
			class="space-y-6"
			x-data={ fmt.Sprintf(`{
				isAdmin: %t,
				aiEnabled: %t,
				mpTab: new URLSearchParams(window.location.search).get('tab') || 'orderbook',
				bpcQuery: %q,
				bpcHub: %q,
				appraisalText: '',
				queryText: %q,
				selectedHub: %q,
				loadAppraisalSample() {
					this.appraisalText = "Tritanium\t50,000\tMineral\nPyerite\t20,000\tMineral\nHobgoblin II\t15\tLight Scout Drone\nDamage Control II\t4\tDamage Control\nCoolant\t800\tRefined Commodities";
				},
				inspectFromAppraisal(name) {
					this.mpTab = 'orderbook';
					this.runSearch(name, this.selectedHub);
				},
				suggestions: [],
				showSuggest: false,
				suggestTimer: null,
				showBrowse: false,
				browseLoading: false,
				browseQuery: '',
				browseCat: '',
				browseGroup: '',
				browsePage: 1,
				browseTotal: 0,
				browseTotalPages: 1,
				browseCategories: [],
				browseGroups: [],
				browseItems: [],
				browseTimer: null,
				debounceSuggest() {
					clearTimeout(this.suggestTimer);
					const q = (this.queryText || '').trim();
					if (q.length < 2) {
						this.suggestions = [];
						this.showSuggest = false;
						return;
					}
					this.suggestTimer = setTimeout(async () => {
						try {
							const r = await fetch('/marketplace/autocomplete?q=' + encodeURIComponent(q));
							if (r.ok) {
								this.suggestions = await r.json();
								this.showSuggest = this.suggestions.length > 0;
							}
						} catch (e) {}
					}, 160);
				},
				openBrowseModal() {
					this.showBrowse = true;
					if (this.browseItems.length === 0) {
						this.loadBrowse(1);
					}
				},
				selectBrowseCat(cat) {
					this.browseCat = cat;
					this.browseGroup = '';
					this.loadBrowse(1);
				},
				debounceBrowse() {
					clearTimeout(this.browseTimer);
					this.browseTimer = setTimeout(() => this.loadBrowse(1), 200);
				},
				async loadBrowse(page) {
					this.browseLoading = true;
					this.browsePage = page;
					try {
						const params = new URLSearchParams({
							q: this.browseQuery,
							category: this.browseCat,
							group: this.browseGroup,
							page: String(page),
							limit: '24'
						});
						const r = await fetch('/marketplace/browse?' + params.toString());
						if (r.ok) {
							const d = await r.json();
							this.browseItems = d.items || [];
							this.browseTotal = d.total || 0;
							this.browseTotalPages = d.total_pages || 1;
							if (d.categories && d.categories.length) this.browseCategories = d.categories;
							this.browseGroups = d.groups || [];
						}
					} finally {
						this.browseLoading = false;
					}
				},
				itemIconURL(it) {
					if (!it || !it.type_id) return '';
					const cat = (it.category || '').toLowerCase();
					const name = (it.name || '').toLowerCase();
					if (cat === 'blueprints' || name.endsWith(' blueprint') || name.endsWith(' reaction formula')) {
						return 'https://images.evetech.net/types/' + it.type_id + '/bp?size=64';
					}
					return 'https://images.evetech.net/types/' + it.type_id + '/icon?size=64';
				},
				handleIconError(img, it) {
					const step = img.dataset.fallbackStep || '0';
					if (step === '0' && it && it.type_id) {
						img.dataset.fallbackStep = '1';
						img.src = img.src.includes('/bp?')
							? 'https://images.evetech.net/types/' + it.type_id + '/icon?size=64'
							: 'https://images.evetech.net/types/' + it.type_id + '/render?size=64';
						return;
					}
					img.style.display = 'none';
					if (img.nextElementSibling) img.nextElementSibling.style.display = 'flex';
				},
				pickBrowseItem(item) {
					if (!item || !item.name) return;
					this.showBrowse = false;
					this.runSearch(item.name, this.selectedHub);
				},
				runSearch(name, hub) {
					if (name) this.queryText = name;
					if (hub) this.selectedHub = hub;
					this.showSuggest = false;
					const q = (this.queryText || '').trim();
					if (!q) return;
					htmx.ajax('GET', '/marketplace/search?q=' + encodeURIComponent(q) + '&hub=' + encodeURIComponent(this.selectedHub), {
						target: '#marketplace-results',
						swap: 'innerHTML',
						indicator: '#mp-search-spinner'
					});
				},
				copyPrice(val, label) {
					if (!val) return;
					navigator.clipboard.writeText(String(val)).then(() => {
						window.dispatchEvent(new CustomEvent('showToast', { detail: { level: 'success', message: label + ' copied (' + Number(val).toLocaleString() + ' ISK)' } }));
					});
				}
			}`, mode.IsAdmin(), mode.AI.Enabled, query, hubKey, query, hubKey) }
			@keydown.escape.window="showBrowse = false"
			@mp-switch-hub.window="runSearch($event.detail.name, $event.detail.hub)"
			@mp-copy-price.window="copyPrice($event.detail.val, $event.detail.label)"
		>
			<!-- Header -->
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-white">New Eden Marketplace Browser</h1>
					<p class="text-xs text-slate-300/80 mt-0.5">{ i18n.L(ctx, "Live SDE autocomplete, parallel 5-hub comparisons (Jita, Amarr, Dodixie, Rens, Hek), bulk clipboard Appraisal, and Order Book depth.", "Pencarian otomatis SDE live, perbandingan 5 Trade Hub paralel (Jita, Amarr, Dodixie, Rens, Hek), Appraisal clipboard massal, dan kedalaman Order Book.") }</p>
				</div>
				<div class="inline-flex flex-wrap rounded-xl border border-violet-400/35 bg-slate-950/65 p-1 backdrop-blur">
					<button
						type="button"
						@click="mpTab = 'orderbook'"
						:class="mpTab === 'orderbook' ? 'bg-amber-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						Item Order Book
					</button>
					<button
						type="button"
						@click="mpTab = 'bpc'"
						:class="mpTab === 'bpc' ? 'bg-sky-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						BPC &amp; BPO Contracts
					</button>
					<button
						type="button"
						@click="mpTab = 'appraisal'"
						:class="mpTab === 'appraisal' ? 'bg-emerald-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						Appraisal
					</button>
				</div>
			</div>

			<!-- TAB 2: BPC & BPO CONTRACTS FINDER -->
			<div x-cloak x-show="mpTab === 'bpc'" class="space-y-6">
				<div class="tactical-panel rounded-xl p-5 space-y-4">
					<div>
						<h2 class="text-sm font-bold uppercase tracking-wider text-sky-300">
							{ i18n.L(ctx, "BPC & BPO Contract Finder (Public ESI + NPC BPO + LP Store)", "Pencari Kontrak BPC & BPO (Public ESI + NPC BPO + LP Store)") }
						</h2>
						<p class="text-xs text-slate-300/80 mt-0.5">
							{ i18n.L(ctx, "Find where to buy BPCs on live Public Item Exchange Contracts, compare ISK per run & ME/TE, and check if an official NPC BPO or LP Store offer is cheaper.", "Cari lokasi dan harga beli BPC di kontrak publik EVE Online, bandingkan ISK per run & ME/TE, serta cek apakah BPO NPC atau LP Store lebih murah.") }
						</p>
					</div>
					<form
						hx-get="/marketplace/bpc"
						hx-target="#marketplace-bpc-results"
						hx-swap="innerHTML"
						hx-indicator="#mp-bpc-spinner"
						class="grid grid-cols-1 gap-3 sm:grid-cols-12 items-end"
					>
						<div class="sm:col-span-6">
							<label class="block text-[10px] font-mono uppercase tracking-wider text-slate-300 mb-1">
								{ i18n.L(ctx, "Item or Blueprint Name", "Nama Item atau Blueprint") }
							</label>
							<input
								type="text"
								name="q"
								x-model="bpcQuery"
								required
								placeholder={ i18n.L(ctx, "e.g. Hobgoblin II, Caracal, Venture, Caldari Navy Hookbill...", "mis. Hobgoblin II, Caracal, Venture, Caldari Navy Hookbill...") }
								class="w-full rounded-lg border border-slate-700 bg-slate-900/90 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-sky-400/70 focus:outline-none"
							/>
						</div>
						<div class="sm:col-span-3">
							<label class="block text-[10px] font-mono uppercase tracking-wider text-slate-300 mb-1">
								{ i18n.L(ctx, "Contract Region / Hub", "Region / Trade Hub Kontrak") }
							</label>
							<select name="hub" x-model="bpcHub" class="w-full rounded-lg border border-slate-700 bg-slate-900/90 px-3 py-2.5 text-sm text-white">
								for _, h := range domain.MajorTradeHubs {
									<option value={ h.Key } selected?={ hubKey == h.Key }>{ h.Name } ({ h.RegionName })</option>
								}
							</select>
						</div>
						<div class="sm:col-span-3">
							<button
								type="submit"
								class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-sky-400 px-4 py-2.5 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-sky-300 transition cursor-pointer"
							>
								<span id="mp-bpc-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
								<span>{ i18n.L(ctx, "Find BPC & BPO", "Cari BPC & BPO") }</span>
							</button>
						</div>
					</form>
				</div>

				<div id="marketplace-bpc-results">
					<div class="tactical-panel rounded-xl p-10 text-center space-y-2">
						<div class="text-sm font-bold text-white">{ i18n.L(ctx, "Search Live BPC Contracts, NPC BPOs & LP Stores", "Cari Kontrak BPC Live, BPO NPC & LP Store") }</div>
						<p class="text-xs text-slate-400 max-w-lg mx-auto">
							{ i18n.L(ctx, "Enter any ship, module, drone, or ammo name above and choose a region (Jita / The Forge has the largest BPC selection; Amarr / Domain scans fastest).", "Masukkan nama kapal, modul, drone, atau amunisi di atas lalu pilih region (Jita / The Forge punya pilihan BPC terbanyak; Amarr / Domain paling cepat dipindai).") }
						</p>
					</div>
				</div>
			</div>

			<!-- TAB 1: ITEM ORDER BOOK -->
			<div x-show="mpTab === 'orderbook'" class="space-y-6">
			<!-- Search & Trade Hub Filter Panel -->
			<div class="tactical-panel relative z-30 rounded-xl p-5 space-y-4">
				<form
					@submit.prevent="runSearch(queryText, selectedHub)"
					class="grid grid-cols-1 gap-3 sm:grid-cols-12"
				>
					<div class="sm:col-span-7 relative" @click.outside="showSuggest = false">
						<label class="block text-[10px] font-mono uppercase tracking-wider text-slate-300 mb-1">Search Any EVE Online Item (Live SDE Autocomplete, Browse Catalog, or Type ID)</label>
						<div class="flex gap-2">
							<input
								id="mp-query-input"
								type="text"
								name="q"
								x-model="queryText"
								@input="debounceSuggest()"
								@focus="if (suggestions.length > 0) showSuggest = true"
								autocomplete="off"
								required
								placeholder={ i18n.L(ctx, "Type partial name e.g. hobgob, shield extender, venture, plex...", "Ketik sebagian nama item, mis. hobgob, shield extender, venture, plex...") }
								class="flex-1 min-w-0 rounded-lg border border-slate-700 bg-slate-900/90 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-300/70 focus:outline-none"
							/>
							<button
								type="button"
								@click="openBrowseModal()"
								class="shrink-0 rounded-lg border border-violet-400/50 bg-violet-500/20 px-3.5 py-2.5 text-xs font-bold text-violet-100 hover:bg-violet-500/35 hover:border-amber-300/60 transition cursor-pointer"
							>
								{ i18n.L(ctx, "Browse Catalog", "Jelajahi Katalog") }
							</button>
						</div>
						<!-- Live Autocomplete Dropdown -->
						<div
							x-cloak
							x-show="showSuggest && suggestions.length > 0"
							class="absolute left-0 right-0 top-full z-50 mt-1 max-h-72 overflow-y-auto rounded-xl border border-violet-400/40 bg-[#121329]/95 shadow-2xl backdrop-blur"
						>
							<template x-for="item in suggestions" :key="item.type_id + '-' + item.name">
								<button
									type="button"
									@click="runSearch(item.name, selectedHub)"
									class="flex w-full items-center gap-2.5 border-b border-violet-400/10 px-3 py-2 text-left hover:bg-violet-500/20 transition cursor-pointer"
								>
									<img
										x-show="item.type_id > 0"
										:src="itemIconURL(item)"
										:alt="item.name"
										class="h-6 w-6 shrink-0 rounded border border-violet-400/25 bg-slate-950 object-contain"
										@error="handleIconError($el, item)"
									/>
									<div style="display:none" class="h-6 w-6 shrink-0 items-center justify-center rounded border border-violet-400/25 bg-slate-900 font-mono text-[8px] font-bold text-violet-300" x-text="(item.category || 'EV').slice(0,2).toUpperCase()"></div>
									<div class="min-w-0 flex-1">
										<div class="truncate text-xs font-semibold text-white" x-text="item.name"></div>
										<div class="text-[10px] font-mono text-slate-400" x-text="(item.category || 'Item') + (item.group_name ? ' • ' + item.group_name : '')"></div>
									</div>
									<span x-show="item.type_id > 0" class="font-mono text-[10px] text-slate-500" x-text="'#' + item.type_id"></span>
								</button>
							</template>
						</div>
					</div>
					<div class="sm:col-span-3">
						<label class="block text-[10px] font-mono uppercase tracking-wider text-slate-300 mb-1">{ i18n.L(ctx, "Primary Trade Hub", "Trade Hub Utama") }</label>
						<select name="hub" x-model="selectedHub" @change="if ((queryText || '').trim()) runSearch(queryText, selectedHub)" class="w-full rounded-lg border border-slate-700 bg-slate-900/90 px-3 py-2.5 text-sm text-white">
							for _, h := range domain.MajorTradeHubs {
								<option value={ h.Key } selected?={ hubKey == h.Key }>{ h.Name } ({ h.RegionName })</option>
							}
						</select>
					</div>
					<div class="sm:col-span-2 flex items-end">
						<button
							type="submit"
							class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-amber-400 px-4 py-2.5 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-amber-300 transition cursor-pointer"
						>
							<span id="mp-search-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
							<span>{ i18n.L(ctx, "Search Market", "Cari Market") }</span>
						</button>
					</div>
				</form>

				<!-- 1-Click Popular Item Presets (Always respects selectedHub!) -->
				<div class="flex flex-wrap items-center gap-1.5 pt-1 border-t border-violet-400/15">
					<span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 mr-1">Quick:</span>
					for _, p := range presets {
						<button
							type="button"
							data-name={ p.Name }
							@click="runSearch($el.dataset.name, selectedHub)"
							class="rounded-md border border-violet-400/30 bg-violet-500/15 px-2.5 py-1 text-[11px] font-medium text-violet-100 hover:border-amber-300/50 hover:bg-amber-400/15 hover:text-amber-200 transition cursor-pointer"
						>
							{ p.Name }
						</button>
					}
				</div>
			</div>

			<!-- Live Marketplace Results Container -->
			<div id="marketplace-results">
				@MarketplaceResultsPartial(snap, errMsg)
			</div>
			</div>

			<!-- TAB 2: APPRAISAL (EVE CLIPBOARD PASTE PRICE CHECK) -->
			<div x-cloak x-show="mpTab === 'appraisal'" class="space-y-6">
				<div class="tactical-panel rounded-xl p-5 space-y-4">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<div>
							<h2 class="text-sm font-bold uppercase tracking-wider text-emerald-300">EVE Online Bulk Appraisal (Paste from Game)</h2>
							<p class="text-xs text-slate-300/80 mt-0.5">{ i18n.L(ctx, "Press Ctrl+A → Ctrl+C in your EVE Hangar, Ship Cargo, Loot, Epithal, Contract, Multibuy, or EFT Fit and paste below for instant 5-Hub valuation.", "Tekan Ctrl+A → Ctrl+C di EVE Hangar, Ship Cargo, Loot, Epithal, Contract, Multibuy, atau EFT Fit lalu tempel di bawah untuk valuasi 5-Hub instan.") }</p>
						</div>
						<div class="flex items-center gap-2">
							<button
								type="button"
								@click="loadAppraisalSample()"
								class="rounded-md border border-violet-400/40 bg-violet-500/15 px-2.5 py-1 text-[11px] font-semibold text-violet-200 hover:bg-violet-500/25 transition cursor-pointer"
							>
								Load Sample
							</button>
							<button
								type="button"
								@click="appraisalText = ''"
								class="rounded-md border border-slate-700 bg-slate-900 px-2.5 py-1 text-[11px] text-slate-300 hover:text-white transition cursor-pointer"
							>
								Clear
							</button>
						</div>
					</div>

					<form
						hx-post="/marketplace/appraise"
						hx-target="#marketplace-appraisal-results"
						hx-swap="innerHTML"
						hx-indicator="#mp-appraise-spinner"
						class="space-y-3"
					>
						<textarea
							name="paste_text"
							x-model="appraisalText"
							rows="7"
							required
							placeholder="Paste items copied from EVE Online here...&#10;&#10;Examples:&#10;Tritanium&#9;50,000&#9;Mineral&#10;10x Hobgoblin II&#10;Damage Control II x4&#10;[Caracal, PvP Fit]"
							class="w-full rounded-xl border border-slate-700 bg-slate-950/90 p-3.5 font-mono text-xs text-emerald-200 placeholder-slate-500 focus:border-emerald-400/70 focus:outline-none"
						></textarea>

						<div class="grid grid-cols-1 gap-3 sm:grid-cols-12 items-end">
							<div class="sm:col-span-5">
								<label class="block text-[10px] font-mono uppercase text-sky-300 mb-1">Price Hub</label>
								<select
									name="hub"
									x-model="selectedHub"
									class="w-full rounded-lg border border-sky-500/40 bg-slate-900 px-3 py-2.5 text-xs font-semibold text-amber-200"
								>
									for _, h := range domain.MajorTradeHubs {
										<option value={ h.Key }>{ h.Name } ({ h.RegionName })</option>
									}
								</select>
							</div>
							<div class="sm:col-span-3">
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Buyback / Split (%)</label>
								<input
									type="number"
									name="buyback_pct"
									value="90"
									min="1"
									max="100"
									step="1"
									class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2.5 text-xs font-mono text-white"
								/>
							</div>
							<div class="sm:col-span-4">
								<button
									type="submit"
									class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-400 px-4 py-2.5 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-emerald-300 transition cursor-pointer"
								>
									<span id="mp-appraise-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
									<span>Appraise (Live ESI)</span>
								</button>
							</div>
						</div>
					</form>
				</div>

				<div id="marketplace-appraisal-results">
					<div class="tactical-panel rounded-xl p-10 text-center space-y-2">
						<div class="text-sm font-bold text-white">{ i18n.L(ctx, "Ready to Appraise Your EVE Online Items", "Siap Menilai (Appraise) Item EVE Online Anda") }</div>
						<p class="text-xs text-slate-400 max-w-md mx-auto">
							{ i18n.L(ctx, "Paste any list of items copied from EVE Online above and click Appraise (Live ESI) to see Total Sell, Instant Buy, post-tax net ISK, Buyback value, and cargo volume.", "Tempel daftar item yang disalin dari EVE Online di atas lalu klik Appraise (Live ESI) untuk melihat Total Sell, Instant Buy, ISK bersih setelah pajak, nilai Buyback, dan volume kargo.") }
						</p>
					</div>
				</div>
			</div>

			<!-- EVE Online Market Catalog Modal Popup (0 ESI calls — local PostgreSQL sde_types) -->
			<template x-teleport="body">
				<div x-cloak x-show="showBrowse" class="fixed inset-0 z-[100] flex items-center justify-center p-4" style="margin-top: 0;">
					<div class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm" @click="showBrowse = false"></div>
					<div class="relative z-10 tactical-panel w-full max-w-5xl max-h-[88vh] flex flex-col rounded-2xl border border-violet-400/45 bg-[#121329]/95 shadow-2xl overflow-hidden">
					<!-- Modal Header -->
					<div class="flex items-center justify-between gap-3 border-b border-violet-400/20 px-5 py-4">
						<div>
							<h2 class="text-sm font-bold uppercase tracking-wider text-amber-300">EVE Online Market Catalog (Browse by Type)</h2>
							<p class="text-[11px] text-slate-400 mt-0.5">{ i18n.L(ctx, "Browse all published CCP SDE market items by category & sub-group (0 ESI calls) — click any item to inspect its live Order Book.", "Jelajahi semua item market CCP SDE berdasarkan kategori & sub-grup (0 panggilan ESI) — klik item apa saja untuk melihat Order Book live.") }</p>
						</div>
						<button type="button" @click="showBrowse = false" class="rounded-lg border border-slate-700 px-2.5 py-1 text-xs text-slate-300 hover:text-white cursor-pointer">✕</button>
					</div>

					<!-- Search, Sub-Group & Category Pills -->
					<div class="border-b border-violet-400/15 bg-slate-950/40 px-5 py-3.5 space-y-3">
						<div class="grid grid-cols-1 gap-2.5 sm:grid-cols-12">
							<div class="sm:col-span-7">
								<input
									type="text"
									x-model="browseQuery"
									@input="debounceBrowse()"
									placeholder="Search item or group (e.g. Scourge, Blueprint, Frigate, Shield, Veldspar, PLEX)..."
									class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white placeholder-slate-500 focus:border-amber-300/70 focus:outline-none"
								/>
							</div>
							<div class="sm:col-span-5">
								<select
									x-model="browseGroup"
									@change="loadBrowse(1)"
									:disabled="browseGroups.length === 0"
									class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white disabled:opacity-50"
								>
									<option value="" x-text="browseCat ? 'All Sub-Groups in ' + browseCat : 'Select a Category to filter Sub-Groups'"></option>
									<template x-for="g in browseGroups" :key="g">
										<option :value="g" x-text="g"></option>
									</template>
								</select>
							</div>
						</div>

						<!-- Category Pills -->
						<div class="flex flex-wrap gap-1.5 max-h-24 overflow-y-auto pr-1">
							<button
								type="button"
								@click="selectBrowseCat('')"
								:class="browseCat === '' ? 'bg-amber-400 text-slate-950 border-amber-300 font-bold' : 'bg-slate-900/70 text-slate-300 border-slate-700 hover:text-white'"
								class="rounded-md border px-2.5 py-1 text-[10.5px] transition cursor-pointer"
							>
								All Types
							</button>
							<template x-for="c in browseCategories" :key="c.category">
								<button
									type="button"
									@click="selectBrowseCat(c.category)"
									:class="browseCat === c.category ? 'bg-violet-600 text-white border-violet-300 font-bold' : 'bg-slate-900/70 text-slate-300 border-slate-700 hover:text-white'"
									class="rounded-md border px-2.5 py-1 text-[10.5px] transition cursor-pointer"
								>
									<span x-text="c.category"></span>
									<span class="ml-1 font-mono text-[9.5px] opacity-75" x-text="'(' + c.count.toLocaleString() + ')'"></span>
								</button>
							</template>
						</div>
					</div>

					<!-- Scrollable Results Grid -->
					<div class="flex-1 overflow-y-auto p-4">
						<div x-show="browseLoading" class="py-12 text-center text-xs font-mono text-amber-300">Loading market items...</div>
						<div x-show="!browseLoading && browseItems.length === 0" class="py-12 text-center text-xs text-slate-400">
							No items match this filter. Try another category or run <strong>Re-Sync Official CCP SDE</strong> in Settings to load all ~16,000+ market items.
						</div>
						<div x-show="!browseLoading && browseItems.length > 0" class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
							<template x-for="it in browseItems" :key="it.type_id + '-' + it.name">
								<button
									type="button"
									@click="pickBrowseItem(it)"
									class="flex items-center gap-2.5 rounded-xl border border-violet-400/20 bg-slate-900/75 p-2.5 text-left hover:border-amber-300/60 hover:bg-violet-500/15 transition cursor-pointer"
								>
									<img
										x-show="it.type_id > 0"
										:src="itemIconURL(it)"
										:alt="it.name"
										loading="lazy"
										class="h-8 w-8 shrink-0 rounded-lg border border-violet-400/25 bg-slate-950 p-0.5 object-contain"
										@error="handleIconError($el, it)"
									/>
									<div style="display:none" class="h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-violet-400/25 bg-slate-900 font-mono text-[9px] font-bold text-violet-300" x-text="(it.category || 'EV').slice(0,2).toUpperCase()"></div>
									<div class="min-w-0 flex-1">
										<div class="truncate text-xs font-bold text-white" x-text="it.name"></div>
										<div class="mt-0.5 truncate font-mono text-[10px] text-slate-400" x-text="(it.group_name || it.category || 'Item') + (it.volume_m3 > 0 ? ' • ' + it.volume_m3 + ' m³' : '')"></div>
									</div>
								</button>
							</template>
						</div>
					</div>

					<!-- Pagination Footer -->
					<div class="flex items-center justify-between border-t border-violet-400/20 bg-slate-950/60 px-5 py-3 text-xs font-mono text-slate-300">
						<span x-text="browseTotal.toLocaleString() + ' items found • Page ' + browsePage + ' of ' + browseTotalPages"></span>
						<div class="flex gap-2">
							<button type="button" @click="if (browsePage > 1) loadBrowse(browsePage - 1)" :disabled="browsePage <= 1" class="rounded-lg border border-slate-700 px-3 py-1 disabled:opacity-40 hover:border-amber-300/60 cursor-pointer">Prev</button>
							<button type="button" @click="if (browsePage < browseTotalPages) loadBrowse(browsePage + 1)" :disabled="browsePage >= browseTotalPages" class="rounded-lg border border-slate-700 px-3 py-1 disabled:opacity-40 hover:border-amber-300/60 cursor-pointer">Next</button>
						</div>
					</div>
				</div>
				</div>
			</template>
		</div>
	}
}

templ MarketplaceResultsPartial(snap *domain.MarketplaceSnapshot, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl p-5 border-rose-400/40 text-sm text-rose-200">
			<div class="font-bold text-rose-300 mb-1">Marketplace Lookup Failed</div>
			<p class="text-xs">{ errMsg }</p>
		</div>
	} else if snap == nil {
		<div class="tactical-panel rounded-xl p-10 text-center space-y-2">
			<div class="text-sm font-semibold text-white">Start typing any EVE Online item name above or click a Quick preset</div>
			<div class="text-xs text-slate-300/80">Instantly inspect Top 20 Sell/Buy Order Books with Sell Wall depth bars, parallel 5-hub arbitrage comparison, Net Station Flip profit, and 30-day price history.</div>
		</div>
	} else {
		<div class="space-y-6">
			<!-- Item Title Banner + 1-Click Actions -->
			<div class="tactical-panel rounded-xl p-5 flex flex-wrap items-center justify-between gap-4">
				<div class="flex items-center gap-3.5">
					<img
						src={ func() string {
							low := strings.ToLower(snap.TypeName)
							if strings.HasSuffix(low, " blueprint") || strings.HasSuffix(low, " reaction formula") {
								return fmt.Sprintf("https://images.evetech.net/types/%d/bp?size=64", snap.TypeID)
							}
							return EVEItemIconURL(snap.TypeID, 64)
						}() }
						alt={ snap.TypeName }
						class="h-12 w-12 shrink-0 rounded-lg border border-amber-300/45 bg-slate-950/80 p-0.5 shadow-[0_0_16px_rgba(251,191,36,0.2)] object-contain"
						onerror="if(!this.dataset.fb){this.dataset.fb='1';this.src=this.src.replace('/icon?','/render?');}else{this.style.display='none';}"
					/>
					<div>
						<div class="flex flex-wrap items-center gap-2">
							<h2 class="text-xl font-bold text-white">{ snap.TypeName }</h2>
							<span class="rounded border border-violet-400/35 bg-violet-500/20 px-2 py-0.5 font-mono text-[10px] text-violet-200">
								TypeID #{ fmt.Sprintf("%d", snap.TypeID) }
							</span>
							<span class="rounded border border-amber-400/35 bg-amber-500/15 px-2 py-0.5 font-mono text-[10px] text-amber-200">
								{ snap.SelectedHub.Name } ({ snap.SelectedHub.RegionName })
							</span>
							if snap.Avg7dPrice > 0 {
								<span class={ "rounded border px-2 py-0.5 font-mono text-[10px] font-bold " + marketplaceSignalClass(snap.PriceSignal) }>
									{ fmt.Sprintf("%s (%+.1f%% vs 7d)", snap.PriceSignal, snap.Change7dPct) }
								</span>
							}
						</div>
						<div class="text-[11px] font-mono text-slate-400 mt-1">
							Updated: { snap.UpdatedAt.Format("15:04:05") } • { fmt.Sprintf("%d sell orders • %d buy orders", snap.SellOrdersCount, snap.BuyOrdersCount) }
							if snap.Avg7dPrice > 0 {
								<span> • 7d Range: { FormatISK(snap.Low7dPrice) } – { FormatISK(snap.High7dPrice) } (Avg { FormatISK(snap.Avg7dPrice) })</span>
							}
						</div>
					</div>
				</div>

				<div class="flex flex-wrap items-center gap-2">
					<button
						type="button"
						x-show="aiEnabled"
						@click={ fmt.Sprintf("window.dispatchEvent(new CustomEvent('open-aura-ai', { detail: { prompt: %q } }))", fmt.Sprintf("Analyze %s at %s (check sell walls, 7d/30d price trend, 5-hub spread, and whether to Station Trade, Craft, or Avoid).", snap.TypeName, snap.SelectedHub.Name)) }
						class="rounded-lg border border-violet-400/50 bg-violet-500/20 px-3 py-1.5 text-xs font-bold text-violet-100 hover:bg-violet-500/35 transition cursor-pointer"
					>
						⚡ Ask Aura: Analyze
					</button>
					<form x-show="isAdmin" hx-post="/marketplace/add-catalog" hx-swap="none">
						<input type="hidden" name="type_id" value={ fmt.Sprintf("%d", snap.TypeID) }/>
						<input type="hidden" name="name" value={ snap.TypeName }/>
						<input type="hidden" name="category" value="Other"/>
						<input type="hidden" name="sell_price" value={ fmt.Sprintf("%.2f", snap.LowestSell) }/>
						<input type="hidden" name="buy_price" value={ fmt.Sprintf("%.2f", snap.HighestBuy) }/>
						<input type="hidden" name="daily_volume" value={ fmt.Sprintf("%.0f", snap.AvgDailyVolume7d) }/>
						<button
							type="submit"
							class="rounded-lg bg-emerald-500 px-3.5 py-2 text-xs font-bold text-slate-950 hover:bg-emerald-400 transition cursor-pointer"
						>
							+ { i18n.L(ctx, "Add to Catalog", "Tambah ke Catalog") }
						</button>
					</form>
					if snap.HasBlueprint {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/manufacture?bp_id=%d&hub=%s", snap.BlueprintTypeID, snap.SelectedHub.Key)) }
							class="rounded-lg border border-amber-400/45 bg-amber-500/15 px-3.5 py-2 text-xs font-semibold text-amber-200 hover:bg-amber-500/25 transition"
						>
							Manufacture &amp; Profit →
						</a>
					} else {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/manufacture?product_id=%d&q=%s&hub=%s", snap.TypeID, url.QueryEscape(snap.TypeName), snap.SelectedHub.Key)) }
							class="rounded-lg border border-sky-400/40 bg-sky-500/15 px-3.5 py-2 text-xs font-semibold text-sky-200 hover:bg-sky-500/25 transition"
						>
							{ i18n.L(ctx, "Open in Manufacture →", "Buka di Manufacture →") }
						</a>
					}
				</div>
			</div>

			<!-- 4 Primary KPI Cards -->
			<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-amber-300/85">{ i18n.L(ctx, "Lowest Sell", "Sell Order Terendah") } ({ snap.SelectedHub.Name })</div>
					<div class="mt-1 text-xl font-mono font-bold text-amber-200">{ FormatISK(snap.LowestSell) }</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">{ i18n.L(ctx, "Supply", "Stok Jual") }: { formatInt64(snap.TotalSellVolume) } { i18n.L(ctx, "units", "unit") }</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-sky-300/85">{ i18n.L(ctx, "Highest Buy", "Buy Order Tertinggi") } ({ snap.SelectedHub.Name })</div>
					<div class="mt-1 text-xl font-mono font-bold text-sky-200">{ FormatISK(snap.HighestBuy) }</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">{ i18n.L(ctx, "Demand", "Permintaan") }: { formatInt64(snap.TotalBuyVolume) } { i18n.L(ctx, "units", "unit") }</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-emerald-300/85">{ i18n.L(ctx, "Net Flip Margin (After", "Net Flip Margin (Setelah") } { FormatPercent(snap.RoundTripFeePct) } { i18n.L(ctx, "Fees)", "Biaya)") }</div>
					<div class={ "mt-1 text-xl font-mono font-bold " + profitColor(snap.NetFlipMarginPct) }>
						{ FormatPercent(snap.NetFlipMarginPct) }
					</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">
						{ FormatISK(snap.NetFlipProfitUnit) }/{ i18n.L(ctx, "unit", "unit") } • { i18n.L(ctx, "Gross Spread", "Spread Kotor") } { FormatPercent(snap.SpreadPercent) }
					</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase tracking-wider text-violet-300/85">{ i18n.L(ctx, "Daily Volume (7-Day Average)", "Volume Harian (Rata-rata 7 Hari)") }</div>
					<div class="mt-1 text-xl font-mono font-bold text-white">{ formatInt64(int64(snap.AvgDailyVolume7d)) } { i18n.L(ctx, "units/day", "unit/hari") }</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">{ i18n.L(ctx, "Estimated Turnover", "Estimasi Perputaran") }: { FormatISK(snap.EstimatedDailyISK) }/{ i18n.L(ctx, "day", "hari") }</div>
				</div>
			</div>

			<!-- Buyer Activity & Regional Demand Breakdown (Latest Day, 7d Avg, 7d Total, 7-Week / 49d Total) -->
			if snap.LatestDayDate != "" || snap.Total49dOrders > 0 {
				<div class="tactical-panel rounded-xl p-4 space-y-2.5">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<div class="text-[10px] font-mono font-bold uppercase tracking-wider text-cyan-300">
							{ i18n.L(ctx, "Buyer Activity & Regional Demand", "Aktivitas Pembeli & Permintaan Region") } ({ snap.SelectedHub.RegionName })
						</div>
						<div class="text-[10px] text-slate-400">
							{ i18n.L(ctx, "CCP ESI daily history (completed market orders; latest UTC day:", "Riwayat harian CCP ESI (transaksi market selesai; hari UTC terbaru:") } <span class="font-mono text-sky-200">{ snap.LatestDayDate }</span>)
						</div>
					</div>
					<div class="grid grid-cols-2 gap-2.5 lg:grid-cols-4 font-mono text-xs">
						<div class="rounded-lg border border-slate-700/70 bg-slate-950/60 px-3 py-2">
							<div class="text-[9.5px] uppercase text-slate-400">{ i18n.L(ctx, "Latest Day", "Hari Terbaru") } ({ snap.LatestDayDate })</div>
							<div class="mt-0.5 text-sm font-bold text-white">{ formatInt64(snap.LatestDayOrders) } { i18n.L(ctx, "orders", "transaksi") }</div>
							<div class="text-[10.5px] text-sky-300">{ formatInt64(snap.LatestDayVolume) } { i18n.L(ctx, "units", "unit") }</div>
						</div>
						<div class="rounded-lg border border-slate-700/70 bg-slate-950/60 px-3 py-2">
							<div class="text-[9.5px] uppercase text-slate-400">{ i18n.L(ctx, "Daily Average (7-Day)", "Rata-rata Harian (7 Hari)") }</div>
							<div class="mt-0.5 text-sm font-bold text-emerald-300">{ fmt.Sprintf("%.1f", snap.AvgDailyOrders7d) } { i18n.L(ctx, "orders/day", "transaksi/hari") }</div>
							<div class="text-[10.5px] text-sky-300">{ formatInt64(int64(snap.AvgDailyVolume7d)) } { i18n.L(ctx, "units/day", "unit/hari") }</div>
						</div>
						<div class="rounded-lg border border-slate-700/70 bg-slate-950/60 px-3 py-2">
							<div class="text-[9.5px] uppercase text-slate-400">{ i18n.L(ctx, "7-Day Total (1 Week)", "Total 7 Hari (1 Minggu)") }</div>
							<div class="mt-0.5 text-sm font-bold text-amber-200">{ formatInt64(snap.Total7dOrders) } { i18n.L(ctx, "orders", "transaksi") }</div>
							<div class="text-[10.5px] text-sky-300">{ formatInt64(snap.Total7dVolume) } { i18n.L(ctx, "units", "unit") }</div>
						</div>
						<div class="rounded-lg border border-slate-700/70 bg-slate-950/60 px-3 py-2">
							<div class="text-[9.5px] uppercase text-slate-400">{ i18n.L(ctx, "7-Week Total (49 Days)", "Total 7 Minggu (49 Hari)") }</div>
							<div class="mt-0.5 text-sm font-bold text-violet-200">{ formatInt64(snap.Total49dOrders) } { i18n.L(ctx, "orders", "transaksi") }</div>
							<div class="text-[10.5px] text-sky-300">{ formatInt64(snap.Total49dVolume) } { i18n.L(ctx, "units", "unit") }</div>
						</div>
					</div>
				</div>
			}

			<!-- v2 Trading & Pricing Intelligence Banner -->
			<div class="grid grid-cols-1 gap-3 lg:grid-cols-3">
				<!-- Recommended Order Prices (with 1-click Copy) -->
				<div class="tactical-panel rounded-xl p-4 flex flex-col justify-between gap-2">
					<div class="text-[10px] font-mono font-bold uppercase tracking-wider text-sky-300">Recommended Order Prices (EVE 4-Sig-Fig)</div>
					<div class="grid grid-cols-2 gap-2 font-mono text-xs">
						<div class="rounded-lg border border-sky-400/25 bg-slate-950/60 p-2">
							<div class="text-[9px] uppercase text-slate-400">Place Buy Order</div>
							<div class="mt-0.5 font-bold text-sky-200">{ FormatISK(snap.RecommendedBuyOrder) }</div>
							if snap.RecommendedBuyOrder > 0 {
								<button
									type="button"
									data-val={ fmt.Sprintf("%.2f", snap.RecommendedBuyOrder) }
									@click="$dispatch('mp-copy-price', { val: $el.dataset.val, label: 'Buy Order Price' })"
									class="mt-1 text-[9.5px] text-sky-300 hover:text-white underline cursor-pointer"
								>
									Copy Price
								</button>
							}
						</div>
						<div class="rounded-lg border border-amber-400/25 bg-slate-950/60 p-2">
							<div class="text-[9px] uppercase text-slate-400">Place Sell Order</div>
							<div class="mt-0.5 font-bold text-amber-200">{ FormatISK(snap.RecommendedSellOrder) }</div>
							if snap.RecommendedSellOrder > 0 {
								<button
									type="button"
									data-val={ fmt.Sprintf("%.2f", snap.RecommendedSellOrder) }
									@click="$dispatch('mp-copy-price', { val: $el.dataset.val, label: 'Sell Order Price' })"
									class="mt-1 text-[9.5px] text-amber-300 hover:text-white underline cursor-pointer"
								>
									Copy Price
								</button>
							}
						</div>
					</div>
				</div>

				<!-- Best 5-Hub Arbitrage Route -->
				<div class="tactical-panel rounded-xl p-4 flex flex-col justify-between gap-2">
					<div class="text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-300">Best Inter-Hub Arbitrage (5 Hubs)</div>
					if snap.BestArbOriginSell > 0 && snap.BestArbDestSell > 0 {
						<div class="space-y-1">
							<div class="text-xs font-bold text-white">
								Buy <span class="text-emerald-300">{ snap.BestArbOriginHub.Name }</span>
								<span class="mx-1 text-slate-500">→</span>
								Sell <span class="text-amber-300">{ snap.BestArbDestHub.Name }</span>
							</div>
							<div class="font-mono text-[11px] text-slate-300">
								{ FormatISK(snap.BestArbOriginSell) } → { FormatISK(snap.BestArbDestSell) }
							</div>
							<div class={ "font-mono text-xs font-bold " + profitColor(snap.BestArbNetMarginPct) }>
								{ fmt.Sprintf("%+.2f%% net margin (before freight)", snap.BestArbNetMarginPct) }
							</div>
						</div>
					} else {
						<div class="text-xs text-slate-400">Insufficient multi-hub sell orders to calculate arbitrage spread.</div>
					}
				</div>

				<!-- SDE Manufacturing Craft Cost vs Buy -->
				<div class="tactical-panel rounded-xl p-4 flex flex-col justify-between gap-2">
					<div class="text-[10px] font-mono font-bold uppercase tracking-wider text-amber-300">CCP SDE Craft vs. Market Buy</div>
					if snap.HasBlueprint && snap.EstCraftUnitCost > 0 {
						<div class="space-y-1">
							<div class="flex items-baseline justify-between font-mono text-xs">
								<span class="text-slate-400">Estimated BOM Craft / unit:</span>
								<strong class="text-white">{ FormatISK(snap.EstCraftUnitCost) }</strong>
							</div>
							<div class="flex items-baseline justify-between font-mono text-xs">
								<span class="text-slate-400">Market Sell / u:</span>
								<strong class="text-amber-200">{ FormatISK(snap.LowestSell) }</strong>
							</div>
							<div class={ "font-mono text-xs font-bold " + profitColor(snap.CraftSavingsPct) }>
								if snap.CraftSavingsPct > 0 {
									{ fmt.Sprintf("Crafting saves %.1f%% vs buying (before taxes/SCI)", snap.CraftSavingsPct) }
								} else {
									{ fmt.Sprintf("Buying is %.1f%% cheaper than crafting", -snap.CraftSavingsPct) }
								}
							</div>
						</div>
					} else if snap.HasBlueprint {
						<div class="text-xs text-slate-300">Blueprint available in SDE — open <strong>Blueprint Calculator</strong> for exact ME/TE &amp; recursive tree cost.</div>
					} else {
						<div class="text-xs text-slate-400">Non-manufacturable commodity, raw material, or faction drop (trade/haul only).</div>
					}
				</div>
			</div>

			<!-- Multi-Hub Comparison Table (Clickable rows to switch Order Book Hub!) -->
			if len(snap.HubComparisons) > 0 {
				{{ bestSell, bestBuy := findBestHubPrices(snap.HubComparisons) }}
				<div class="tactical-panel rounded-xl overflow-hidden">
					<div class="px-5 py-3.5 border-b border-violet-400/20 flex flex-wrap items-center justify-between gap-2">
						<h3 class="text-xs font-bold uppercase tracking-wider text-amber-300">5 Major Trade Hub Comparison (Click Any Hub Row to Inspect Its Order Book)</h3>
						<span class="text-[10px] font-mono text-slate-400">Green = Lowest Sell • Blue = Highest Buy</span>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full text-left text-xs">
							<thead class="bg-slate-950/50 font-mono uppercase text-[10px] tracking-wider text-slate-400 border-b border-violet-400/15">
								<tr>
									<th class="px-4 py-2.5">Trade Hub</th>
									<th class="px-4 py-2.5 text-right">Lowest Sell</th>
									<th class="px-4 py-2.5 text-right">Highest Buy</th>
									<th class="px-4 py-2.5 text-right">Spread</th>
									<th class="px-4 py-2.5 text-right">Sell Vol / Orders</th>
									<th class="px-4 py-2.5 text-right">Buy Vol / Orders</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-violet-400/15 font-mono">
								for _, h := range snap.HubComparisons {
									<tr
										data-name={ snap.TypeName }
										data-hub={ h.Hub.Key }
										@click="$dispatch('mp-switch-hub', { name: $el.dataset.name, hub: $el.dataset.hub })"
										class={ "hover:bg-violet-500/15 transition cursor-pointer " + func() string { if h.Hub.Key == snap.SelectedHub.Key { return "bg-violet-500/15 ring-1 ring-inset ring-amber-400/35" }; return "" }() }
									>
										<td class="px-4 py-2.5 font-sans">
											<span class="font-semibold text-white">{ h.Hub.Name }</span>
											<span class="ml-1.5 text-[10px] text-slate-400">{ h.Hub.RegionName }</span>
											if h.Hub.Key == snap.SelectedHub.Key {
												<span class="ml-1.5 rounded bg-amber-400/20 px-1.5 py-0.2 font-mono text-[9px] font-bold text-amber-200">VIEWING</span>
											}
										</td>
										<td class="px-4 py-2.5 text-right">
											if h.LowestSell > 0 {
												<span class={ func() string { if h.LowestSell == bestSell { return "font-bold text-emerald-300" }; return "text-amber-200" }() }>
													{ FormatISK(h.LowestSell) }
												</span>
											} else {
												<span class="text-slate-500">—</span>
											}
										</td>
										<td class="px-4 py-2.5 text-right">
											if h.HighestBuy > 0 {
												<span class={ func() string { if h.HighestBuy == bestBuy { return "font-bold text-sky-300" }; return "text-slate-200" }() }>
													{ FormatISK(h.HighestBuy) }
												</span>
											} else {
												<span class="text-slate-500">—</span>
											}
										</td>
										<td class="px-4 py-2.5 text-right text-slate-300">
											if h.SpreadPercent > 0 {
												{ FormatPercent(h.SpreadPercent) }
											} else {
												<span class="text-slate-500">—</span>
											}
										</td>
										<td class="px-4 py-2.5 text-right text-slate-300">
											{ formatInt64(h.SellVolume) } <span class="text-slate-500">({ fmt.Sprintf("%d", h.SellOrdersCount) })</span>
										</td>
										<td class="px-4 py-2.5 text-right text-slate-300">
											{ formatInt64(h.BuyVolume) } <span class="text-slate-500">({ fmt.Sprintf("%d", h.BuyOrdersCount) })</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

			<!-- 30-Day Price History Trend with Axis Labels -->
			if len(snap.History) > 0 {
				{{ sparkPoints := buildHistorySparklinePoints(snap.History) }}
				{{ min30, max30 := historyMinMax(snap.History) }}
				{{ avg30 := historyAvg30d(snap.History) }}
				<div class="tactical-panel rounded-xl p-5 space-y-4">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<h3 class="text-xs font-bold uppercase tracking-wider text-violet-200">30-Day Average Price Trend ({ snap.SelectedHub.RegionName })</h3>
						<div class="flex flex-wrap items-center gap-3 text-[11px] font-mono text-slate-300">
							<span>30d Low: <strong class="text-emerald-300">{ FormatISK(min30) }</strong></span>
							<span>30-Day Average: <strong class="text-amber-200">{ FormatISK(avg30) }</strong></span>
							<span>30d High: <strong class="text-rose-300">{ FormatISK(max30) }</strong></span>
							<span class="text-slate-400">Avg Vol: { formatInt64(int64(snap.AvgDailyVolume30d)) }/d</span>
						</div>
					</div>
					if sparkPoints != "" {
						<div class="rounded-lg border border-violet-400/20 bg-slate-950/50 p-3 space-y-1.5">
							<svg viewBox="0 0 560 110" class="w-full h-28 overflow-visible" preserveAspectRatio="none">
								<line x1="0" y1="12" x2="560" y2="12" stroke="rgba(148,163,184,0.18)" stroke-dasharray="4 4"></line>
								<line x1="0" y1="55" x2="560" y2="55" stroke="rgba(148,163,184,0.15)" stroke-dasharray="4 4"></line>
								<line x1="0" y1="98" x2="560" y2="98" stroke="rgba(148,163,184,0.18)" stroke-dasharray="4 4"></line>
								<polyline
									fill="none"
									stroke="#fbbf24"
									stroke-width="2.2"
									stroke-linejoin="round"
									stroke-linecap="round"
									points={ sparkPoints }
								></polyline>
							</svg>
							<div class="flex items-center justify-between font-mono text-[10px] text-slate-400">
								<span>{ snap.History[0].Date }</span>
								<span>30-Day Regional Daily Average</span>
								<span>{ snap.History[len(snap.History)-1].Date }</span>
							</div>
						</div>
					}
					<div class="overflow-x-auto">
						<table class="w-full text-left text-[11px] font-mono">
							<thead class="text-slate-400 border-b border-violet-400/15 uppercase text-[10px]">
								<tr>
									<th class="py-1.5 pr-3">Date</th>
									<th class="py-1.5 px-3 text-right">Average</th>
									<th class="py-1.5 px-3 text-right">Highest</th>
									<th class="py-1.5 px-3 text-right">Lowest</th>
									<th class="py-1.5 pl-3 text-right">Volume</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-violet-400/10">
								for _, pt := range recentHistoryDesc(snap.History, 7) {
									<tr class="hover:bg-white/5">
										<td class="py-1.5 pr-3 text-slate-300">{ pt.Date }</td>
										<td class="py-1.5 px-3 text-right text-amber-200 font-semibold">{ FormatISK(pt.Average) }</td>
										<td class="py-1.5 px-3 text-right text-emerald-300">{ FormatISK(pt.Highest) }</td>
										<td class="py-1.5 px-3 text-right text-rose-300">{ FormatISK(pt.Lowest) }</td>
										<td class="py-1.5 pl-3 text-right text-slate-200">{ formatInt64(pt.Volume) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

			<!-- Live Order Book Split View with Visual Depth Bars & Cumulative Qty -->
			{{ sellDepth := buildOrderDepthRows(snap.SellOrders) }}
			{{ buyDepth := buildOrderDepthRows(snap.BuyOrders) }}
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
				<!-- Top Sell Orders -->
				<div class="tactical-panel rounded-xl overflow-hidden">
					<div class="px-5 py-3 border-b border-amber-400/20 flex items-center justify-between">
						<h3 class="text-xs font-bold uppercase tracking-wider text-amber-300">{ i18n.L(ctx, "Top Sell Orders (Lowest — Watch for Sell Walls)", "Top Sell Orders (Termurah — Waspadai Sell Wall)") }</h3>
						<span class="text-[10px] font-mono text-slate-400">{ fmt.Sprintf("Top %d", len(sellDepth)) }</span>
					</div>
					if len(sellDepth) == 0 {
						<div class="p-6 text-center text-xs text-slate-400">{ i18n.L(ctx, "No active Sell Orders at", "Tidak ada Sell Order aktif di") } { snap.SelectedHub.Name }.</div>
					} else {
						<div class="overflow-x-auto">
							<table class="w-full text-left text-xs font-mono">
								<thead class="bg-slate-950/50 text-[10px] uppercase text-slate-400 border-b border-violet-400/15">
									<tr>
										<th class="px-4 py-2">{ i18n.L(ctx, "Price (ISK)", "Harga (ISK)") }</th>
										<th class="px-3 py-2 text-right">{ i18n.L(ctx, "Quantity", "Jumlah") }</th>
										<th class="px-3 py-2 text-right">{ i18n.L(ctx, "Cumulative", "Kumulatif") }</th>
										<th class="px-4 py-2 text-right">{ i18n.L(ctx, "Order Value", "Nilai Order") }</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-violet-400/10">
									for _, row := range sellDepth {
										<tr
											style={ fmt.Sprintf("background: linear-gradient(to left, rgba(251, 191, 36, 0.13) %.1f%%, transparent %.1f%%);", row.DepthPct, row.DepthPct) }
											class="hover:bg-white/5"
										>
											<td class="px-4 py-2 font-semibold text-amber-200">{ FormatISK(row.Order.Price) }</td>
											<td class="px-3 py-2 text-right text-slate-200">{ formatInt64(int64(row.Order.VolumeRemain)) }</td>
											<td class="px-3 py-2 text-right text-slate-400">{ formatInt64(row.CumQty) }</td>
											<td class="px-4 py-2 text-right text-slate-300">{ FormatISK(row.TotalValue) }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>

				<!-- Top Buy Orders -->
				<div class="tactical-panel rounded-xl overflow-hidden">
					<div class="px-5 py-3 border-b border-sky-400/20 flex items-center justify-between">
						<h3 class="text-xs font-bold uppercase tracking-wider text-sky-300">{ i18n.L(ctx, "Top Buy Orders (Highest — Instant Demand)", "Top Buy Orders (Tertinggi — Permintaan Instan)") }</h3>
						<span class="text-[10px] font-mono text-slate-400">{ fmt.Sprintf("Top %d", len(buyDepth)) }</span>
					</div>
					if len(buyDepth) == 0 {
						<div class="p-6 text-center text-xs text-slate-400">{ i18n.L(ctx, "No active Buy Orders at", "Tidak ada Buy Order aktif di") } { snap.SelectedHub.Name }.</div>
					} else {
						<div class="overflow-x-auto">
							<table class="w-full text-left text-xs font-mono">
								<thead class="bg-slate-950/50 text-[10px] uppercase text-slate-400 border-b border-violet-400/15">
									<tr>
										<th class="px-4 py-2">{ i18n.L(ctx, "Price (ISK)", "Harga (ISK)") }</th>
										<th class="px-3 py-2 text-right">{ i18n.L(ctx, "Quantity", "Jumlah") }</th>
										<th class="px-3 py-2 text-right">{ i18n.L(ctx, "Cumulative", "Kumulatif") }</th>
										<th class="px-4 py-2 text-right">{ i18n.L(ctx, "Order Value", "Nilai Order") }</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-violet-400/10">
									for _, row := range buyDepth {
										<tr
											style={ fmt.Sprintf("background: linear-gradient(to left, rgba(56, 189, 248, 0.13) %.1f%%, transparent %.1f%%);", row.DepthPct, row.DepthPct) }
											class="hover:bg-white/5"
										>
											<td class="px-4 py-2 font-semibold text-sky-200">{ FormatISK(row.Order.Price) }</td>
											<td class="px-3 py-2 text-right text-slate-200">{ formatInt64(int64(row.Order.VolumeRemain)) }</td>
											<td class="px-3 py-2 text-right text-slate-400">{ formatInt64(row.CumQty) }</td>
											<td class="px-4 py-2 text-right text-slate-300">{ FormatISK(row.TotalValue) }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>
		</div>
	}
}

templ MarketplaceAppraisalPartial(res *domain.AppraisalResult, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl border-rose-500/40 bg-rose-950/30 p-4 text-xs text-rose-200">
			<strong>Appraisal Error:</strong> { errMsg }
		</div>
	} else if res != nil {
		<div
			class="space-y-5"
			x-data={ fmt.Sprintf(`{
				copiedMB: false,
				mbText: %q,
				copyAppraisalMB() {
					if (!this.mbText) return;
					navigator.clipboard.writeText(this.mbText).then(() => {
						this.copiedMB = true;
						window.dispatchEvent(new CustomEvent('showToast', { detail: { level: 'success', message: 'Appraisal items copied as EVE Multibuy!' } }));
						setTimeout(() => this.copiedMB = false, 2200);
					});
				}
			}`, res.MultibuyText) }
		>
			if len(res.UnmatchedLines) > 0 {
				<div class="rounded-xl border border-amber-400/40 bg-amber-950/30 px-4 py-3 text-xs text-amber-200">
					<strong>Unrecognized lines ({ fmt.Sprintf("%d", len(res.UnmatchedLines)) }):</strong> { strings.Join(res.UnmatchedLines, ", ") }
				</div>
			}

			<!-- 4 Top Valuation KPI Cards -->
			<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
				<div class="tactical-panel rounded-xl p-4 border-emerald-400/35">
					<div class="text-[10px] font-mono uppercase text-emerald-300/90">Total Sell ({ res.Hub.Name })</div>
					<div class="mt-1 text-2xl font-mono font-bold text-white">{ FormatISK(res.TotalSell) }</div>
					<div class="mt-0.5 text-[10.5px] font-mono text-emerald-300">
						Net after fees: { FormatISK(res.NetSellAfterFees) }
					</div>
				</div>

				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-sky-300/90">Total Buy / Instant ({ res.Hub.Name })</div>
					<div class="mt-1 text-2xl font-mono font-bold text-sky-200">{ FormatISK(res.TotalBuy) }</div>
					<div class="mt-0.5 text-[10.5px] font-mono text-slate-300">
						Net after tax: { FormatISK(res.NetBuyAfterFees) }
					</div>
				</div>

				<div class="tactical-panel rounded-xl p-4">
					<div class="flex items-center justify-between gap-1">
						<span class="text-[10px] font-mono uppercase text-violet-300/90">Volume &amp; Density</span>
						if res.GankRiskWarning {
							<span class="rounded border border-rose-400/55 bg-rose-500/20 px-1.5 py-0.5 font-mono text-[9px] font-bold text-rose-200">GANK RISK</span>
						}
					</div>
					<div class="mt-1 text-2xl font-mono font-bold text-violet-200">{ fmt.Sprintf("%.1f m³", res.TotalVolumeM3) }</div>
					<div class="mt-0.5 text-[10.5px] font-mono text-slate-400">
						{ FormatISK(res.ISKPerM3) }/m³ • { fmt.Sprintf("%d items", res.TotalDistinct) }
					</div>
				</div>

				<div class="tactical-panel rounded-xl p-4 flex flex-col justify-between gap-2">
					<div>
						<div class="text-[10px] font-mono uppercase text-amber-300/90">Buyback ({ fmt.Sprintf("%.0f%%", res.BuybackPercent) } Buy)</div>
						<div class="mt-1 text-xl font-mono font-bold text-amber-200">{ FormatISK(res.BuybackValue) }</div>
					</div>
					<div class="flex gap-1.5">
						<button
							type="button"
							@click="copyAppraisalMB()"
							class="flex-1 rounded-md border border-emerald-400/45 bg-emerald-500/15 px-2.5 py-1.5 text-[11px] font-bold text-emerald-200 hover:bg-emerald-500/25 transition cursor-pointer"
						>
							<span x-show="!copiedMB">Copy Multibuy</span>
							<span x-cloak x-show="copiedMB">Copied!</span>
						</button>
						<button
							type="button"
							x-show="aiEnabled"
							@click={ fmt.Sprintf("window.dispatchEvent(new CustomEvent('open-aura-ai', { detail: { prompt: %q } }))", fmt.Sprintf("Audit this EVE appraisal at %s: Total Sell %s (Net %s), Total Buy %s (Net %s), Volume %.1f m3, %d distinct items. Should I Sell Order, Instant Sell, or haul to another hub? Check Gank Risk.", res.Hub.Name, FormatISK(res.TotalSell), FormatISK(res.NetSellAfterFees), FormatISK(res.TotalBuy), FormatISK(res.NetBuyAfterFees), res.TotalVolumeM3, res.TotalDistinct)) }
							class="rounded-md border border-violet-400/50 bg-violet-500/20 px-2.5 py-1.5 text-[11px] font-bold text-violet-100 hover:bg-violet-500/35 transition cursor-pointer"
						>
							⚡ Aura
						</button>
					</div>
				</div>
			</div>

			<!-- Per-Item Valuation Breakdown Table -->
			<div class="tactical-panel rounded-xl overflow-hidden">
				<div class="px-4 py-2.5 border-b border-violet-400/20 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-slate-300">
					<span>
						Appraised <strong class="text-white">{ fmt.Sprintf("%d", res.TotalDistinct) }</strong> item(s) • <strong class="text-amber-200">{ formatInt64(res.TotalUnits) }</strong> total units
					</span>
					<span>
						Hub: <strong class="text-sky-300">{ res.Hub.Name }</strong> •
						{ fmt.Sprintf("Broker %.2f%% • Sales Tax %.2f%%", res.BrokerFeePercent, res.SalesTaxPercent) }
					</span>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs">
						<thead class="bg-slate-950/50 font-mono uppercase text-[10px] text-slate-400 border-b border-violet-400/15">
							<tr>
								<th class="px-4 py-3">Item (Click to Open Order Book)</th>
								<th class="px-3 py-3 text-right">Quantity</th>
								<th class="px-3 py-3 text-right">Volume</th>
								<th class="px-3 py-3 text-right">Unit Buy</th>
								<th class="px-3 py-3 text-right">Unit Sell</th>
								<th class="px-3 py-3 text-right">Total Buy</th>
								<th class="px-4 py-3 text-right">Total Sell</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-violet-400/15 font-mono">
							for _, ln := range res.Lines {
								<tr class="hover:bg-white/5">
									<td class="px-4 py-2.5 font-sans">
										<button
											type="button"
											@click={ fmt.Sprintf("inspectFromAppraisal(%q)", ln.Name) }
											class="flex items-center gap-2.5 text-left group cursor-pointer"
										>
											<img
												src={ func() string {
													low := strings.ToLower(ln.Name)
													if strings.HasSuffix(low, " blueprint") || strings.HasSuffix(low, " reaction formula") {
														return fmt.Sprintf("https://images.evetech.net/types/%d/bp?size=32", ln.TypeID)
													}
													return EVEItemIconURL(ln.TypeID, 32)
												}() }
												alt={ ln.Name }
												loading="lazy"
												class="h-7 w-7 shrink-0 rounded border border-violet-400/25 bg-slate-950/80 object-contain"
												onerror="if(!this.dataset.fb){this.dataset.fb='1';this.src=this.src.replace('/icon?','/render?');}else{this.style.display='none';}"
											/>
											<div>
												<div class="font-semibold text-white group-hover:text-amber-300 transition">{ ln.Name }</div>
												<div class="text-[10px] font-mono text-slate-400">{ ln.Category }</div>
											</div>
										</button>
									</td>
									<td class="px-3 py-2.5 text-right text-amber-200">{ formatInt64(ln.Quantity) }</td>
									<td class="px-3 py-2.5 text-right text-slate-400">{ fmt.Sprintf("%.1f m³", ln.TotalVolumeM3) }</td>
									<td class="px-3 py-2.5 text-right text-slate-300">{ FormatISK(ln.UnitBuy) }</td>
									<td class="px-3 py-2.5 text-right text-slate-300">{ FormatISK(ln.UnitSell) }</td>
									<td class="px-3 py-2.5 text-right text-sky-200">{ FormatISK(ln.TotalBuy) }</td>
									<td class="px-4 py-2.5 text-right font-bold text-emerald-200">{ FormatISK(ln.TotalSell) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

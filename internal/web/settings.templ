package web

import (
	"fmt"

	"aura-forge/internal/domain"
	"aura-forge/internal/i18n"
	"aura-forge/internal/service"
)

templ SettingsPage(mode service.ModeInfo, settings domain.UserSettings, sdeStatus service.SDEImportStatus, pilotMem *domain.AIPilotMemory, saved bool) {
	@Layout("Settings", "settings", mode) {
		<div class="space-y-6">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-white">Settings &amp; EVE Online ESI Mode</h1>
					<p class="text-xs text-slate-300/80 mt-0.5">{ i18n.L(ctx, "Configure starting capital, Primary Trade Hub, market taxes, character slot capacity, and optional EVE SSO OAuth2 integration.", "Atur modal awal, Primary Trade Hub, pajak market, kapasitas slot karakter, dan integrasi opsional EVE SSO OAuth2.") }</p>
				</div>
				<a
					href="/wiki#settings-guide"
					class="inline-flex items-center gap-1.5 rounded-lg border border-sky-400/40 bg-sky-500/15 px-3 py-1.5 text-xs font-semibold text-sky-200 hover:bg-sky-500/25 transition"
				>
					<span>{ i18n.L(ctx, "Settings Field Guide (Wiki) →", "Panduan Pengaturan (Wiki) →") }</span>
				</a>
			</div>

			if saved {
				<div class="rounded-lg border border-emerald-500/40 bg-emerald-950/40 p-3 text-xs text-emerald-200">
					{ i18n.L(ctx, "Settings saved successfully to PostgreSQL.", "Pengaturan berhasil disimpan ke PostgreSQL.") }
				</div>
			}

			<div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-start">
				<!-- Left Column: Tax, Capital & Slots + Official CCP SDE Importer -->
				<div class="lg:col-span-7 space-y-6">
					<div class="tactical-panel rounded-xl p-5 space-y-4">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<h2 class="text-sm font-bold uppercase tracking-wider text-sky-300">Industry &amp; Jita Tax Parameters</h2>
						<form hx-post="/esi/sync-sci" hx-swap="none" class="flex items-center gap-2">
							<select name="solar_system_id" class="rounded border border-slate-700 bg-slate-900 px-2 py-1 text-[11px] font-mono text-white">
								<option value="30000142">Jita (The Forge)</option>
								<option value="30000144">Perimeter</option>
								<option value="30002187">Amarr (Domain)</option>
								<option value="30002659">Dodixie (Sinq Laison)</option>
								<option value="30002053">Hek (Metropolis)</option>
								<option value="30002510">Rens (Heimatar)</option>
							</select>
							<button type="submit" class="rounded border border-amber-400/40 bg-amber-500/15 px-2.5 py-1 text-[11px] font-semibold text-amber-200 hover:bg-amber-500/25 cursor-pointer">
								Sync Live SCI (Public ESI)
							</button>
						</form>
					</div>

					<form hx-post="/settings" hx-swap="none" autocomplete="off" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-300">Manual Starting Capital (ISK)</label>
							<input type="number" step="0.01" name="starting_capital" value={ fmt.Sprintf("%.2f", settings.StartingCapital) } class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
							<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "Dedicated working capital for industry & trading (separate from personal wallet).", "Modal kerja khusus untuk industri & trading (terpisah dari wallet pribadi).") }</p>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-300">Primary Trade Hub (Catalog &amp; Trap Guard)</label>
							<select name="default_trade_hub" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-white">
								for _, th := range domain.MajorTradeHubs {
									<option value={ th.Key } selected?={ settings.ActiveTradeHub().Key == th.Key }>{ th.Name } ({ th.RegionName })</option>
								}
							</select>
							<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "Default sell hub for Catalog, Radar, Scanner, and Background Price Updater.", "Trade Hub jual default untuk Catalog, Radar, Scanner, dan Background Price Updater.") }</p>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-300">Manufacturing Slots</label>
							<input type="number" name="manufacturing_slots" value={ fmt.Sprintf("%d", settings.ManufacturingSlots) } min="1" max="50" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
							<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "In-game: Industry (Alt+S) → Jobs → max Manufacturing slots.", "Di game: Industry (Alt+S) → Jobs → batas maksimal slot Manufacturing.") }</p>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-300">Science / Invention Slots</label>
							<input type="number" name="science_slots" value={ fmt.Sprintf("%d", settings.ScienceSlots) } min="0" max="50" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
							<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "In-game: Industry (Alt+S) → Jobs → max Science / Research slots.", "Di game: Industry (Alt+S) → Jobs → batas maksimal slot Science / Research.") }</p>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-300">Broker Fee (%)</label>
							<input type="number" step="0.01" name="broker_fee_percent" value={ fmt.Sprintf("%.2f", settings.BrokerFeePercent) } class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
							<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "In-game: Right-click item → Sell (3 Months) → Broker's Fee (3.00% base; ~1.50% Lv V).", "Di game: Klik kanan item → Sell (3 Months) → Broker Fee (3.00% dasar; ~1.50% Lv V).") }</p>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-300">Sales Tax (%)</label>
							<input type="number" step="0.01" name="sales_tax_percent" value={ fmt.Sprintf("%.2f", settings.SalesTaxPercent) } class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
							<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "In-game: Sell window → Sales Tax (7.50% Lv 0; 4.20% Lv 4; 3.38% Accounting V).", "Di game: jendela Sell → Sales Tax (7.50% Lv 0; 4.20% Lv 4; 3.38% Accounting V).") }</p>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-300">Relist Fee (%)</label>
							<input type="number" step="0.01" name="relist_fee_percent" value={ fmt.Sprintf("%.2f", settings.RelistFeePercent) } class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
							<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "Order modify fee: Broker Fee × 50% (Lv 0) down to × 20% (Adv. Broker V).", "Biaya ubah harga order: Broker Fee × 50% (Lv 0) hingga × 20% (Adv. Broker V).") }</p>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-300">System Cost Index (Decimal)</label>
							<input type="number" step="0.0001" name="system_cost_index" value={ fmt.Sprintf("%.4f", settings.SystemCostIndex) } class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
							<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "Factory congestion tax in decimal (4.50% = 0.0450). Use Sync Live SCI above.", "Pajak kepadatan sistem dalam desimal (4.50% = 0.0450). Gunakan Sync Live SCI di atas.") }</p>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-300">Facility Tax (%)</label>
							<input type="number" step="0.01" name="facility_tax_percent" value={ fmt.Sprintf("%.2f", settings.FacilityTaxPercent) } class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
							<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "NPC station: 0.25%. Player Raitaru/Azbel: check Industry → Facilities.", "Stasiun NPC: 0.25%. Raitaru/Azbel pemain: cek di Industry → Facilities.") }</p>
						</div>
						<div>
							<label class="block text-[11px] font-mono uppercase text-slate-300">Freight Cost (ISK / m³)</label>
							<input type="number" step="0.01" name="freight_cost_per_m3" value={ fmt.Sprintf("%.2f", settings.FreightCostPerM3) } class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
							<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "Set 0 if building & selling locally; 300–800 for High-Sec courier contracts.", "Isi 0 jika produksi & jual lokal; 300–800 untuk kontrak kurir High-Sec.") }</p>
						</div>

						<div class="sm:col-span-2 pt-2">
							<button type="submit" class="w-full rounded-md bg-sky-500 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-950 hover:bg-sky-400 transition cursor-pointer">
								Save Settings
							</button>
						</div>
					</form>
					</div>

					<!-- Official EVE Online SDE (CCP JSONL) 1-Click Importer Card -->
					@SDEStatusPartial(sdeStatus)
				</div>

				<!-- Right Column: Display Timezone + Background Jita Price Updater + Optional EVE SSO -->
				<div class="lg:col-span-5 space-y-6">
					<!-- Display Timezone Preference Card -->
					<div class="tactical-panel rounded-xl p-5 space-y-3">
						<div class="flex items-center justify-between gap-3">
							<div>
								<h2 class="text-sm font-bold uppercase tracking-wider text-sky-300">{ i18n.L(ctx, "Display Timezone", "Zona Waktu Tampilan") }</h2>
								<p class="text-xs text-slate-300/80 mt-0.5">
									{ i18n.L(ctx, "Choose how timestamps (PI extractor timers, order dates, price sync) are displayed across the app.", "Pilih zona waktu tampilan untuk seluruh jadwal (timer extractor PI, tanggal order, sinkron harga).") }
								</p>
							</div>
						</div>
						<div class="inline-flex items-center rounded-lg border border-violet-400/35 bg-slate-950/70 p-1 text-xs font-mono font-bold">
							<form method="POST" action="/timezone" hx-boost="false" class="inline">
								<input type="hidden" name="tz" value="wib"/>
								<button
									type="submit"
									class={ "rounded-md px-3 py-1.5 transition cursor-pointer " + func() string {
										if !i18n.IsUTC(ctx) {
											return "bg-sky-400/25 text-sky-200 border border-sky-300/50"
										}
										return "text-slate-300 hover:text-white"
									}() }
								>UTC+7 (WIB)</button>
							</form>
							<form method="POST" action="/timezone" hx-boost="false" class="inline">
								<input type="hidden" name="tz" value="utc"/>
								<button
									type="submit"
									class={ "rounded-md px-3 py-1.5 transition cursor-pointer " + func() string {
										if i18n.IsUTC(ctx) {
											return "bg-sky-400/25 text-sky-200 border border-sky-300/50"
										}
										return "text-slate-300 hover:text-white"
									}() }
								>EVE Time (UTC)</button>
							</form>
						</div>
					</div>

					<!-- Background Trade Hub Price Updater Card -->
					<div class="tactical-panel rounded-xl p-5 space-y-4">
						<div class="flex items-center justify-between gap-2">
							<h2 class="text-sm font-bold uppercase tracking-wider text-emerald-300">Background Trade Hub Price Updater</h2>
							if mode.PriceSync.IsRunning {
								<span class="rounded-full border border-amber-400/45 bg-amber-500/20 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-200 animate-pulse">SYNCING</span>
							} else if settings.AutoPriceSyncEnabled {
								<span class="rounded-full border border-emerald-400/45 bg-emerald-500/20 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-200">AUTO • { fmt.Sprintf("%dm", settings.AutoPriceSyncIntervalMinutes) }</span>
							} else {
								<span class="rounded-full border border-slate-500/45 bg-slate-700/40 px-2 py-0.5 font-mono text-[10px] font-bold text-slate-300">MANUAL • { fmt.Sprintf("%dm", settings.AutoPriceSyncIntervalMinutes) }</span>
							}
						</div>

						<p class="text-xs text-slate-300 leading-relaxed">
							Keeps dynamic <strong>{ settings.ActiveTradeHub().Name }</strong> prices warm in PostgreSQL <code class="text-amber-200">esi_cache</code> for your active business scope (<strong>Catalog + 68 PI P1–P4 + SDE Blueprints</strong>) so PI Hub, Scanner, Calculator, Manufacture, and Marketplace load instantly. Static recipes &amp; planet catalogs never call ESI; other trade hubs remain on-demand.
						</p>

						<!-- Live Sync Telemetry -->
						<div class="grid grid-cols-2 gap-2 rounded-lg border border-slate-700/70 bg-slate-900/60 p-3 text-[11px] font-mono">
							<div>
								<div class="text-slate-400 text-[10px] uppercase">Status</div>
								<div class="text-white font-semibold mt-0.5">{ mode.PriceSync.FreshnessLabel() }</div>
							</div>
							<div>
								<div class="text-slate-400 text-[10px] uppercase">Next Scheduled Sync</div>
								if mode.PriceSync.NextSyncAt != nil {
									<div class="text-sky-300 font-semibold mt-0.5">
										{ FormatTimeCtx(ctx, *mode.PriceSync.NextSyncAt, "15:04:05") }
									</div>
								} else {
									<div class="text-slate-400 mt-0.5">—</div>
								}
							</div>
							if mode.PriceSync.LastError != "" {
								<div class="col-span-2 text-rose-300 text-[10px] pt-1 border-t border-slate-800">
									Last warning: { mode.PriceSync.LastError }
								</div>
							}
						</div>

						<form hx-post="/settings" hx-swap="none" autocomplete="off" class="space-y-3">
							<input type="hidden" name="form_section" value="price_updater"/>
							<label class="flex items-center gap-2.5 cursor-pointer select-none rounded-lg border border-slate-700/80 bg-slate-900/50 px-3 py-2.5">
								<input
									type="checkbox"
									name="auto_price_sync_enabled"
									autocomplete="off"
									checked?={ settings.AutoPriceSyncEnabled }
									class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-emerald-500 focus:ring-emerald-400"
								/>
								<span class="text-xs font-medium text-white">Enable automatic { settings.ActiveTradeHub().Name } background sync</span>
							</label>

							<div>
								<label class="block text-[11px] font-mono uppercase text-slate-300">Sync Interval</label>
								<select name="auto_price_sync_interval_minutes" autocomplete="off" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-mono text-white">
									<option value="5" selected?={ settings.AutoPriceSyncIntervalMinutes == 5 }>Every 5 minutes (High Frequency)</option>
									<option value="10" selected?={ settings.AutoPriceSyncIntervalMinutes == 10 }>Every 10 minutes</option>
									<option value="15" selected?={ settings.AutoPriceSyncIntervalMinutes == 15 }>Every 15 minutes (Recommended)</option>
									<option value="30" selected?={ settings.AutoPriceSyncIntervalMinutes == 30 }>Every 30 minutes (Light ESI)</option>
									<option value="60" selected?={ settings.AutoPriceSyncIntervalMinutes == 60 }>Every 60 minutes (Minimal ESI)</option>
								</select>
								<p class="mt-1 text-[10px] text-slate-400">{ i18n.L(ctx, "15 min is balanced for active trading; use 30–60 min for minimal background ESI traffic.", "15 menit seimbang untuk trading aktif; gunakan 30–60 menit untuk trafik ESI minimal.") }</p>
							</div>

							<div class="flex flex-wrap gap-2 pt-1">
								<button type="submit" class="flex-1 rounded-md bg-emerald-500 py-2 text-xs font-bold uppercase tracking-wider text-slate-950 hover:bg-emerald-400 transition cursor-pointer">
									Save Updater Schedule
								</button>
								<button
									type="button"
									hx-post="/esi/sync-prices"
									hx-target="#price-sync-result"
									hx-swap="innerHTML"
									hx-indicator="#price-sync-spinner"
									hx-disabled-elt="this"
									class="inline-flex items-center gap-2 rounded-md border border-amber-400/45 bg-amber-500/15 px-3 py-2 text-xs font-semibold text-amber-200 hover:bg-amber-500/25 disabled:opacity-50 transition cursor-pointer"
								>
									<span id="price-sync-spinner" class="htmx-indicator h-3 w-3 animate-spin rounded-full border-2 border-amber-200 border-t-transparent"></span>
									<span>Run Sync Now</span>
								</button>
							</div>
							<div id="price-sync-result"></div>
						</form>
					</div>

					<!-- Optional EVE SSO Plug-and-Play Card -->
					<div class="tactical-panel rounded-xl p-5 space-y-4">
						<h2 class="text-sm font-bold uppercase tracking-wider text-amber-300">EVE Online SSO OAuth2 (Optional)</h2>

						if mode.SSOConnected {
							<div class="rounded-lg border border-emerald-500/40 bg-emerald-950/30 p-4 space-y-3">
								<div class="flex items-center gap-2 text-sm font-bold text-emerald-300">
									<span class="h-2.5 w-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
									Connected: { mode.CharacterName }
								</div>
								<p class="text-xs text-slate-300">{ i18n.L(ctx, "Auto-Sync for wallet balance, active market orders, industry jobs, blueprints, and hangar stock deduction is active.", "Sinkronisasi otomatis untuk saldo wallet, order aktif, job industri, Blueprint, dan potongan stok hangar aktif.") }</p>
								<div class="flex flex-wrap gap-2">
									<button type="button" hx-post="/auth/sync" hx-swap="none" class="rounded bg-emerald-500 px-3 py-1.5 text-xs font-bold text-slate-950 hover:bg-emerald-400 cursor-pointer">
										Sync Character Now
									</button>
									<button type="button" hx-post="/auth/disconnect" hx-swap="none" class="rounded border border-rose-500/40 bg-rose-500/15 px-3 py-1.5 text-xs font-semibold text-rose-200 hover:bg-rose-500/25 cursor-pointer">
										Disconnect EVE SSO
									</button>
								</div>
							</div>
						} else if mode.SSOEnabled {
							<div class="rounded-lg border border-sky-500/40 bg-sky-950/30 p-4 space-y-3">
								<div class="text-sm font-bold text-sky-300">EVE SSO Credentials Detected in .env</div>
								<p class="text-xs text-slate-300">{ i18n.L(ctx, "Click below to connect your EVE Online character and enable Auto-Sync for Wallet, Orders, Jobs, Blueprints & Hangar Assets.", "Klik di bawah untuk menghubungkan karakter EVE Online Anda dan mengaktifkan Auto-Sync Wallet, Orders, Jobs, Blueprints & Hangar.") }</p>
								<a href="/auth/login" hx-boost="false" class="inline-block rounded-md bg-amber-500 px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-950 hover:bg-amber-400 transition">
									Connect EVE SSO →
								</a>
							</div>
						} else {
							<div class="rounded-lg border border-slate-700 bg-slate-900/70 p-4 space-y-3">
								<div class="inline-block rounded-full border border-amber-400/40 bg-amber-500/15 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-amber-300">
									Optional: Set ESI_CLIENT_ID &amp; SECRET in .env for Character Auto-Sync
								</div>
								<p class="text-xs text-slate-300 leading-relaxed">
									Running <strong>100% out-of-the-box in Standard Mode (Public ESI + Manual/Import)</strong> with no CCP developer registration required.
								</p>
								<div class="rounded bg-slate-950 p-3 font-mono text-[11px] text-slate-300 space-y-1">
									<div class="text-slate-500"># Add to .env when you want to enable EVE SSO:</div>
									<div>ESI_CLIENT_ID=<span class="text-sky-300">your_client_id</span></div>
									<div>ESI_CLIENT_SECRET=<span class="text-sky-300">your_client_secret</span></div>
									<div>ESI_CALLBACK_URL=<span class="text-sky-300">http://localhost:8080/auth/callback</span></div>
								</div>
							</div>
						}
					</div>

					<!-- Aura AI Level-4 Agentic Copilot (OpenAI-Compatible) Card -->
					<div class="tactical-panel rounded-xl p-5 space-y-4">
						<div class="flex items-center justify-between gap-2">
							<h2 class="text-sm font-bold uppercase tracking-wider text-violet-300">Aura AI Copilot (OpenAI-Compatible)</h2>
							if mode.AI.Enabled {
								<span class="rounded-full border border-emerald-400/45 bg-emerald-500/20 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-200">
									ACTIVE
								</span>
							} else {
								<span class="rounded-full border border-slate-500/45 bg-slate-700/40 px-2.5 py-0.5 font-mono text-[10px] font-bold text-slate-300">
									OPTIONAL / OFF
								</span>
							}
						</div>

						if mode.AI.Enabled {
							<div class="rounded-lg border border-violet-400/30 bg-slate-900/65 p-3 font-mono text-[11px] space-y-1">
								<div class="flex justify-between gap-2">
									<span class="text-slate-400">Active Model</span>
									<span class="text-amber-200 font-bold truncate">{ mode.AI.Model }</span>
								</div>
								<div class="flex justify-between gap-2">
									<span class="text-slate-400">Base URL</span>
									<span class="text-sky-300 truncate">{ mode.AI.BaseURL }</span>
								</div>
							</div>
							<form hx-post="/ai/model" hx-swap="none" autocomplete="off" class="space-y-1.5">
								<label class="block text-[10px] font-mono uppercase text-slate-400">Runtime Model Override (In-Memory)</label>
								<div class="flex gap-2">
									<input
										type="text"
										name="ai_model"
										list="ai-model-presets"
										value={ mode.AI.Model }
										required
										autocomplete="off"
										placeholder="e.g. gemini-3.5-flash-lite, gpt-4.1-mini"
										class="min-w-0 flex-1 rounded-md border border-slate-700 bg-slate-900 px-2.5 py-1.5 font-mono text-xs text-white focus:border-amber-400 focus:outline-none"
									/>
									<datalist id="ai-model-presets">
										<option value="gemini-3.5-flash-lite"></option>
										<option value="gemini-3.1-flash-lite"></option>
										<option value="gemini-3.5-flash"></option>
										<option value="gemini-2.5-flash-lite"></option>
										<option value="gemini-2.5-pro"></option>
										<option value="gpt-4.1-mini"></option>
										<option value="gpt-4.1"></option>
										<option value="deepseek-chat"></option>
									</datalist>
									<button
										type="submit"
										class="shrink-0 rounded-md bg-amber-400 px-3 py-1.5 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-amber-300 transition cursor-pointer"
									>
										Apply
									</button>
								</div>
								<p class="text-[10px] text-slate-400">{ i18n.L(ctx, "Overrides AI_MODEL in memory immediately (not saved to DB; resets on restart).", "Langsung mengganti AI_MODEL di memori (tidak disimpan ke DB; reset saat restart).") }</p>
							</form>
							<div class="flex flex-wrap items-center gap-2">
								<button
									type="button"
									hx-post="/ai/test"
									hx-target="#ai-test-result"
									hx-swap="innerHTML"
									hx-indicator="#ai-test-spinner"
									class="inline-flex items-center gap-2 rounded-md border border-emerald-400/45 bg-emerald-500/15 px-3 py-1.5 text-xs font-bold text-emerald-200 hover:bg-emerald-500/25 transition cursor-pointer"
								>
									<span id="ai-test-spinner" class="htmx-indicator h-3 w-3 animate-spin rounded-full border-2 border-emerald-200 border-t-transparent"></span>
									<span>Test AI Connection</span>
								</button>
								<button
									type="button"
									@click="window.dispatchEvent(new CustomEvent('open-aura-ai', { detail: {} }))"
									class="rounded-md border border-amber-400/45 bg-amber-500/15 px-3 py-1.5 text-xs font-bold text-amber-200 hover:bg-amber-500/25 transition cursor-pointer"
								>
									Open Ask Aura Drawer
								</button>
							</div>
							<div id="ai-test-result"></div>
						} else {
							<div class="rounded-lg border border-slate-700 bg-slate-900/70 p-3.5 space-y-2.5">
								<p class="text-xs text-slate-300 leading-relaxed">
									Enable Level-4 Agentic AI Copilot (with live 5-Hub market, SDE recipe, PI, and Appraisal tool calling) by adding any <strong>OpenAI-compatible</strong> provider to <code class="text-amber-200">.env</code> and restarting Docker:
								</p>
								<div class="rounded bg-slate-950 p-3 font-mono text-[11px] text-slate-300 space-y-1">
									<div>AI_BASE_URL=<span class="text-sky-300">https://api.openai.com/v1</span></div>
									<div>AI_API_KEY=<span class="text-amber-300">your_api_key</span></div>
									<div>AI_MODEL=<span class="text-emerald-300">gpt-4.1-mini</span></div>
								</div>
							</div>
						}

						<!-- Pilot Playbook Memory (Used by Aura AI across every session) -->
						<form hx-post="/ai/memory" hx-swap="none" class="space-y-3 border-t border-slate-800 pt-3.5">
							<div class="text-[11px] font-mono uppercase tracking-wider text-amber-300">Pilot Playbook Memory</div>
							<p class="text-[10px] text-slate-400 -mt-1.5">{ i18n.L(ctx, "Saved in PostgreSQL and automatically injected into every Aura AI chat session.", "Disimpan di PostgreSQL dan otomatis disertakan di setiap sesi chat Aura AI.") }</p>
							<div class="grid grid-cols-2 gap-2.5">
								<div>
									<label class="block text-[10px] font-mono uppercase text-slate-400 mb-1">Risk Tolerance</label>
									<select name="risk_tolerance" class="w-full rounded-md border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white">
										<option value="conservative" selected?={ pilotMem != nil && pilotMem.RiskTolerance == "conservative" }>Conservative (Safety First)</option>
										<option value="balanced" selected?={ pilotMem == nil || pilotMem.RiskTolerance == "" || pilotMem.RiskTolerance == "balanced" }>Balanced (Recommended)</option>
										<option value="aggressive" selected?={ pilotMem != nil && pilotMem.RiskTolerance == "aggressive" }>Aggressive (Fast Scaling)</option>
									</select>
								</div>
								<div>
									<label class="block text-[10px] font-mono uppercase text-slate-400 mb-1">Daily Playtime</label>
									<input
										type="text"
										name="daily_playtime"
										value={ func() string {
											if pilotMem != nil && pilotMem.DailyPlaytime != "" {
												return pilotMem.DailyPlaytime
											}
											return "1-2 hours/day"
										}() }
										placeholder="e.g. 1 hour/day, weekend active"
										class="w-full rounded-md border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white"
									/>
								</div>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-400 mb-1">Playstyle Notes (Hub, Ships, Goals, Limits)</label>
								<textarea
									name="playstyle_notes"
									rows="2"
									placeholder="e.g. Operating mostly in Amarr VIII, avoid hauling >150M ISK in T1 hauler, prefer fast T1 drones + PI..."
									class="w-full rounded-md border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white placeholder-slate-500"
								>{ func() string {
									if pilotMem != nil {
										return pilotMem.PlaystyleNotes
									}
									return ""
								}() }</textarea>
							</div>
							<button type="submit" class="w-full rounded-md border border-violet-400/50 bg-violet-500/20 py-2 text-xs font-bold text-violet-100 hover:bg-violet-500/35 transition cursor-pointer">
								Save Pilot Playbook Memory
							</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	}
}

templ SDEStatusPartial(status service.SDEImportStatus) {
	<div
		id="sde-status-card"
		if status.IsRunning {
			hx-get="/settings/sde/status"
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
		class="tactical-panel rounded-xl p-5 space-y-4"
	>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<h2 class="text-sm font-bold uppercase tracking-wider text-amber-300">Official EVE Online SDE (CCP JSONL)</h2>
				<p class="text-[11px] text-slate-300/80 mt-0.5">{ i18n.L(ctx, "Static blueprint & item recipes downloaded directly from CCP's official portal (0 ESI API calls).", "Resep Blueprint & item statis yang diunduh langsung dari portal resmi CCP (0 panggilan ESI).") }</p>
			</div>
			if status.IsRunning {
				<span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/50 bg-amber-500/20 px-2.5 py-0.5 font-mono text-[10px] font-bold text-amber-200 animate-pulse">
					<span class="h-2 w-2 rounded-full bg-amber-300"></span>
					IMPORTING
				</span>
			} else if status.Metadata != nil && status.Metadata.Source == "ccp_jsonl" {
				<span class="rounded-full border border-emerald-400/50 bg-emerald-500/20 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-200">
					FULL CCP SDE
				</span>
			} else {
				<span class="rounded-full border border-violet-400/45 bg-violet-500/20 px-2.5 py-0.5 font-mono text-[10px] font-bold text-violet-200">
					STARTER SET
				</span>
			}
		</div>

		<!-- Installed SDE Counts -->
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 font-mono text-xs">
			<div class="rounded-lg border border-slate-700/70 bg-slate-900/60 p-3">
				<div class="text-[10px] uppercase text-slate-400">Blueprints</div>
				<div class="mt-0.5 text-base font-bold text-amber-200">
					if status.Metadata != nil {
						{ fmt.Sprintf("%d", status.Metadata.BlueprintsCount) }
					} else {
						0
					}
				</div>
			</div>
			<div class="rounded-lg border border-slate-700/70 bg-slate-900/60 p-3">
				<div class="text-[10px] uppercase text-slate-400">T2 Inventions</div>
				<div class="mt-0.5 text-base font-bold text-emerald-300">
					if status.Metadata != nil {
						{ fmt.Sprintf("%d", status.Metadata.InventionsCount) }
					} else {
						0
					}
				</div>
			</div>
			<div class="rounded-lg border border-slate-700/70 bg-slate-900/60 p-3">
				<div class="text-[10px] uppercase text-slate-400">SDE Types</div>
				<div class="mt-0.5 text-base font-bold text-white">
					if status.Metadata != nil {
						{ fmt.Sprintf("%d", status.Metadata.TypesCount) }
					} else {
						0
					}
				</div>
			</div>
			<div class="rounded-lg border border-slate-700/70 bg-slate-900/60 p-3">
				<div class="text-[10px] uppercase text-slate-400">CCP Build</div>
				<div class="mt-0.5 text-sm font-bold text-sky-300 truncate">
					if status.Metadata != nil && status.Metadata.BuildNumber > 0 {
						#{ fmt.Sprintf("%d", status.Metadata.BuildNumber) }
					} else {
						Starter
					}
				</div>
			</div>
		</div>

		<!-- Live Progress or Completion Message -->
		if status.IsRunning {
			<div class="flex items-center gap-2.5 rounded-lg border border-amber-400/40 bg-amber-950/30 px-3.5 py-2.5 text-xs font-mono text-amber-200">
				<span class="h-3.5 w-3.5 shrink-0 animate-spin rounded-full border-2 border-amber-300 border-t-transparent"></span>
				<span>{ status.ProgressText }</span>
			</div>
		} else if status.Stage == "error" && status.LastError != "" {
			<div class="rounded-lg border border-rose-500/40 bg-rose-950/35 px-3.5 py-2.5 text-xs text-rose-200">
				<strong>Import Error:</strong> { status.LastError }
			</div>
		} else if status.Stage == "done" && status.ProgressText != "" {
			<div class="rounded-lg border border-emerald-500/40 bg-emerald-950/35 px-3.5 py-2.5 text-xs text-emerald-200">
				{ status.ProgressText } ({ fmt.Sprintf("%.1fs", float64(status.DurationMs)/1000.0) })
			</div>
		}

		<div class="flex flex-wrap items-center justify-between gap-3 pt-1">
			<div class="text-[11px] text-slate-400">
				Source: <code class="text-slate-300">developers.eveonline.com/static-data/</code> (Manufacturing &amp; Reactions)
			</div>
			<button
				type="button"
				hx-post="/settings/sde/import"
				hx-target="#sde-status-card"
				hx-swap="outerHTML"
				disabled?={ status.IsRunning }
				class="rounded-md bg-amber-400 px-4 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-amber-300 disabled:opacity-50 transition cursor-pointer"
			>
				if status.IsRunning {
					Importing SDE...
				} else if status.Metadata != nil && status.Metadata.Source == "ccp_jsonl" {
					Re-Sync Latest CCP SDE
				} else {
					Import Full Official CCP SDE (~5,000+ BPs)
				}
			</button>
		</div>
	</div>
}

package web

import (
	"fmt"
	"net/url"
	"strings"

	"aura-forge/internal/domain"
	"aura-forge/internal/i18n"
)

func compareGridColsClass(n int) string {
	switch n {
	case 1:
		return "grid-cols-1"
	case 2:
		return "grid-cols-1 md:grid-cols-2"
	default:
		return "grid-cols-1 md:grid-cols-3"
	}
}

func compareSectionAccent(color string) string {
	switch color {
	case "amber":
		return "text-amber-300 border-amber-400/25"
	case "sky":
		return "text-sky-300 border-sky-400/25"
	case "emerald":
		return "text-emerald-300 border-emerald-400/25"
	case "violet":
		return "text-violet-300 border-violet-400/25"
	default:
		return "text-cyan-300 border-cyan-400/25"
	}
}

func compareBarColor(color string, isBest bool) string {
	if isBest {
		return "bg-emerald-400"
	}
	switch color {
	case "amber":
		return "bg-amber-400/75"
	case "sky":
		return "bg-sky-400/75"
	case "emerald":
		return "bg-emerald-400/75"
	case "violet":
		return "bg-violet-400/75"
	default:
		return "bg-cyan-400/75"
	}
}

func cheapestComparePrice(items []domain.ItemSpecDetail) float64 {
	if len(items) < 2 {
		return 0
	}
	best := 0.0
	for _, it := range items {
		if it.LiveSellPrice > 0 && (best == 0 || it.LiveSellPrice < best) {
			best = it.LiveSellPrice
		}
	}
	return best
}

func anyItemHasResists(items []domain.ItemSpecDetail) bool {
	for _, it := range items {
		if it.ShieldResists.HasAny() || it.ArmorResists.HasAny() {
			return true
		}
	}
	return false
}

func anyItemHasSkills(items []domain.ItemSpecDetail) bool {
	for _, it := range items {
		if len(it.RequiredSkills) > 0 {
			return true
		}
	}
	return false
}

func slotPips(count int) []int {
	if count <= 0 {
		return nil
	}
	if count > 8 {
		count = 8
	}
	out := make([]int, count)
	for i := range out {
		out[i] = i
	}
	return out
}

func totalBaseTankHP(it domain.ItemSpecDetail) float64 {
	return it.Attributes[263] + it.Attributes[265] + it.Attributes[9]
}

// eveAttrIcon renders a crisp vector icon matching the EVE attribute type (Shield, Armor, CPU, PG, Cap, Speed, Cargo, Target, Drone, etc.).
templ eveAttrIcon(label string) {
	{{ l := strings.ToLower(label) }}
	if strings.Contains(l, "shield") {
		<svg class="h-4 w-4 shrink-0 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V7l7-4z"></path>
		</svg>
	} else if strings.Contains(l, "armor") || strings.Contains(l, "structure") {
		<svg class="h-4 w-4 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M4 6l8-3 8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"></path>
		</svg>
	} else if strings.Contains(l, "cpu") || strings.Contains(l, "calibration") {
		<svg class="h-4 w-4 shrink-0 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<rect x="7" y="7" width="10" height="10" rx="2"></rect>
			<path stroke-linecap="round" d="M9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4"></path>
		</svg>
	} else if strings.Contains(l, "powergrid") || strings.Contains(l, "capacitor") || strings.Contains(l, "cap ") || strings.Contains(l, "activation") {
		<svg class="h-4 w-4 shrink-0 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"></path>
		</svg>
	} else if strings.Contains(l, "velocity") || strings.Contains(l, "warp") || strings.Contains(l, "speed") || strings.Contains(l, "inertia") {
		<svg class="h-4 w-4 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
		</svg>
	} else if strings.Contains(l, "cargo") || strings.Contains(l, "volume") {
		<svg class="h-4 w-4 shrink-0 text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
		</svg>
	} else if strings.Contains(l, "drone") {
		<svg class="h-4 w-4 shrink-0 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<circle cx="12" cy="12" r="3"></circle>
			<path stroke-linecap="round" d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
		</svg>
	} else if strings.Contains(l, "target") || strings.Contains(l, "range") || strings.Contains(l, "falloff") || strings.Contains(l, "scan") || strings.Contains(l, "signature") {
		<svg class="h-4 w-4 shrink-0 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<circle cx="12" cy="12" r="7"></circle>
			<circle cx="12" cy="12" r="2"></circle>
			<path stroke-linecap="round" d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
		</svg>
	} else {
		<svg class="h-4 w-4 shrink-0 text-violet-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
		</svg>
	}
}

templ resistMiniBar(label string, pct float64, barCls string, txtCls string) {
	<div class="flex items-center gap-2 text-[10.5px] font-mono">
		<span class={ "inline-flex items-center gap-1 w-11 shrink-0 font-bold " + txtCls }>
			<span class={ "h-2 w-2 rounded-full " + barCls }></span>
			<span>{ label }</span>
		</span>
		<div class="flex-1 h-2 rounded-full bg-slate-900 overflow-hidden border border-slate-800">
			<div class={ "h-full rounded-full transition-all " + barCls } style={ fmt.Sprintf("width: %.1f%%", pct) }></div>
		</div>
		<span class="w-10 text-right text-slate-200">{ fmt.Sprintf("%.0f%%", pct) }</span>
	</div>
}

templ eveSkillLevelPips(level int) {
	<div class="inline-flex items-center gap-0.5" title={ fmt.Sprintf("Required Level %d / 5", level) }>
		for i := 1; i <= 5; i++ {
			if i <= level {
				<span class="h-2.5 w-2.5 rounded-xs bg-amber-400 border border-amber-300/80"></span>
			} else {
				<span class="h-2.5 w-2.5 rounded-xs bg-slate-800 border border-slate-700"></span>
			}
		}
	</div>
}

templ MarketplaceComparePartial(res *domain.ItemCompareResult, errMsg string) {
	if errMsg != "" {
		<div class="rounded-xl border border-rose-500/40 bg-rose-950/40 p-4 text-xs text-rose-200">
			<strong>{ i18n.L(ctx, "Show Info Lookup Failed:", "Pencarian Show Info Gagal:") }</strong> { errMsg }
		</div>
	} else if res != nil && len(res.Items) > 0 {
		{{ cheapest := cheapestComparePrice(res.Items) }}
		{{ isComparing := len(res.Items) > 1 }}
		<div
			class="space-y-4"
			x-data={ fmt.Sprintf("{ infoTab: %q }", func() string {
				if isComparing {
					return "attributes"
				}
				return "overview"
			}()) }
		>
			<!-- 1. EVE SHOW INFO HEADER CARDS (3D Render / Icon + Meta + Live Price) -->
			<div class={ "grid gap-3 " + compareGridColsClass(len(res.Items)) }>
				for _, it := range res.Items {
					<div class="rounded-xl border border-violet-400/30 bg-gradient-to-br from-violet-950/50 via-slate-950/90 to-[#0d1021] p-3.5 flex items-center justify-between gap-3">
						<div class="flex items-center gap-3 min-w-0">
							if it.IsShip {
								<img
									src={ fmt.Sprintf("https://images.evetech.net/types/%d/render?size=256", it.TypeID) }
									data-fallback={ EVEItemIconURL(it.TypeID, 64) }
									alt={ it.Name }
									class="h-16 w-16 shrink-0 rounded-xl border border-amber-300/45 bg-slate-950 object-cover shadow-lg"
									onerror="if(this.dataset.fallback && this.src!==this.dataset.fallback){this.src=this.dataset.fallback}else{this.style.display='none'}"
								/>
							} else {
								<img
									src={ EVEItemIconURL(it.TypeID, 64) }
									alt={ it.Name }
									class="h-14 w-14 shrink-0 rounded-xl border border-sky-400/45 bg-slate-950 p-1 object-contain shadow-lg"
									onerror="this.style.display='none'"
								/>
							}
							<div class="min-w-0">
								<div class="flex flex-wrap items-center gap-1.5">
									<span class="rounded border border-violet-400/45 bg-violet-500/20 px-1.5 py-0.5 font-mono text-[9.5px] font-bold text-violet-200">
										T{ fmt.Sprintf("%d", it.TechLevel) }
									</span>
									if it.MetaLevel > 0 {
										<span class="rounded border border-amber-400/40 bg-amber-500/15 px-1.5 py-0.5 font-mono text-[9.5px] font-bold text-amber-200">
											Meta { fmt.Sprintf("%d", it.MetaLevel) }
										</span>
									}
									if cheapest > 0 && it.LiveSellPrice == cheapest {
										<span class="rounded border border-emerald-400/50 bg-emerald-500/20 px-1.5 py-0.5 font-mono text-[9px] font-bold text-emerald-200">
											BEST PRICE
										</span>
									}
								</div>
								<h3 class="text-base font-bold text-white leading-tight truncate mt-0.5" title={ it.Name }>{ it.Name }</h3>
								<div class="text-[11px] text-slate-400 truncate">
									{ it.GroupName }
									if it.LiveSellPrice > 0 {
										<span class="ml-1.5 font-mono font-bold text-amber-200">• { FormatISK(it.LiveSellPrice) }</span>
									}
								</div>
							</div>
						</div>
						<div class="flex flex-col items-end gap-1.5 shrink-0">
							<div class="flex items-center gap-1.5">
								<a
									href={ templ.SafeURL("/marketplace?hub=" + res.Hub.Key + "&q=" + url.QueryEscape(it.Name)) }
									class="rounded border border-sky-400/35 bg-sky-500/15 px-2.5 py-1 text-[10.5px] font-semibold text-sky-200 hover:bg-sky-500/25 transition"
								>
									Market
								</a>
								if it.BlueprintTypeID > 0 {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/manufacture?bp_id=%d&hub=%s", it.BlueprintTypeID, res.Hub.Key)) }
										class="rounded border border-emerald-400/35 bg-emerald-500/15 px-2.5 py-1 text-[10.5px] font-semibold text-emerald-200 hover:bg-emerald-500/25 transition"
									>
										Craft →
									</a>
								}
							</div>
						</div>
					</div>
				}
			</div>

			<!-- 2. EVE-STYLE INNER POPUP TABS (Overview | Attributes | Requirements) -->
			<div class="flex flex-wrap items-center gap-1.5 border-b border-violet-400/25 pb-2">
				<button
					type="button"
					@click="infoTab = 'overview'"
					:class="infoTab === 'overview' ? 'bg-amber-400/20 border-amber-300/60 text-amber-200' : 'border-slate-800 bg-slate-900/50 text-slate-300 hover:text-white'"
					class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-bold transition cursor-pointer"
				>
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					<span>Overview</span>
				</button>
				<button
					type="button"
					@click="infoTab = 'attributes'"
					:class="infoTab === 'attributes' ? 'bg-sky-400/20 border-sky-300/60 text-sky-200' : 'border-slate-800 bg-slate-900/50 text-slate-300 hover:text-white'"
					class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-bold transition cursor-pointer"
				>
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
					</svg>
					<span>Attributes</span>
				</button>
				if anyItemHasSkills(res.Items) {
					<button
						type="button"
						@click="infoTab = 'requirements'"
						:class="infoTab === 'requirements' ? 'bg-violet-500/25 border-violet-300/60 text-violet-200' : 'border-slate-800 bg-slate-900/50 text-slate-300 hover:text-white'"
						class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-bold transition cursor-pointer"
					>
						<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
						</svg>
						<span>Requirements</span>
					</button>
				}
			</div>

			<!-- TAB A: OVERVIEW (Visual KPIs + Slot Rack + Hull Bonuses & Description) -->
			<div x-show="infoTab === 'overview'" class="space-y-4">
				<div class={ "grid gap-4 " + compareGridColsClass(len(res.Items)) }>
					for _, it := range res.Items {
						<div class="rounded-xl border border-violet-400/20 bg-slate-950/60 p-4 space-y-4">
							<!-- Quick Visual KPI Strip -->
							<div class="grid grid-cols-2 gap-2 text-xs font-mono">
								<div class="rounded-lg border border-slate-800 bg-slate-900/70 p-2.5 flex items-center gap-2.5">
									<svg class="h-5 w-5 shrink-0 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
									<div class="min-w-0">
										<div class="text-[9.5px] uppercase text-slate-400">{ res.Hub.Name } Sell</div>
										<div class="font-bold text-amber-200 truncate">
											if it.LiveSellPrice > 0 {
												{ FormatISK(it.LiveSellPrice) }
											} else {
												—
											}
										</div>
									</div>
								</div>
								<div class="rounded-lg border border-slate-800 bg-slate-900/70 p-2.5 flex items-center gap-2.5">
									<svg class="h-5 w-5 shrink-0 text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
									</svg>
									<div class="min-w-0">
										<div class="text-[9.5px] uppercase text-slate-400">
											if it.Capacity > 0 {
												Cargo / Pack
											} else {
												Volume
											}
										</div>
										<div class="font-bold text-emerald-200 truncate">
											if it.Capacity > 0 {
												{ fmt.Sprintf("%.0f m³", it.Capacity) }
											} else if it.PackagedVolume > 0 {
												{ fmt.Sprintf("%.1f m³", it.PackagedVolume) }
											} else {
												{ fmt.Sprintf("%.1f m³", it.Volume) }
											}
										</div>
									</div>
								</div>
								if totalBaseTankHP(it) > 0 {
									<div class="rounded-lg border border-slate-800 bg-slate-900/70 p-2.5 flex items-center gap-2.5">
										<svg class="h-5 w-5 shrink-0 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V7l7-4z"></path>
										</svg>
										<div class="min-w-0">
											<div class="text-[9.5px] uppercase text-slate-400">Total Base HP</div>
											<div class="font-bold text-sky-200">{ fmt.Sprintf("%.0f HP", totalBaseTankHP(it)) }</div>
										</div>
									</div>
								}
								if it.Attributes[37] > 0 {
									<div class="rounded-lg border border-slate-800 bg-slate-900/70 p-2.5 flex items-center gap-2.5">
										<svg class="h-5 w-5 shrink-0 text-violet-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
										</svg>
										<div class="min-w-0">
											<div class="text-[9.5px] uppercase text-slate-400">Max Velocity</div>
											<div class="font-bold text-violet-200">{ fmt.Sprintf("%.0f m/s", it.Attributes[37]) }</div>
										</div>
									</div>
								}
							</div>

							<!-- Visual Fitting Slot Rack (for Ships) -->
							if it.Slots.HasSlots() {
								<div class="space-y-2">
									<div class="flex items-center justify-between text-[10px] font-mono uppercase text-slate-400">
										<span>Slot Layout</span>
										if it.Slots.TurretSlots > 0 || it.Slots.LauncherSlots > 0 {
											<span class="text-amber-200">{ fmt.Sprintf("%d Turret • %d Launcher", it.Slots.TurretSlots, it.Slots.LauncherSlots) }</span>
										}
									</div>
									<div class="grid grid-cols-2 gap-2 text-[10.5px] font-mono">
										<div class="flex items-center justify-between rounded-lg border border-amber-400/20 bg-slate-900/60 px-2.5 py-1.5">
											<span class="text-amber-300 font-bold">HIGH</span>
											<div class="flex items-center gap-1">
												for range slotPips(it.Slots.HighSlots) {
													<span class="h-2.5 w-2.5 rounded-sm bg-amber-400"></span>
												}
												<span class="ml-1 text-white font-bold">{ fmt.Sprintf("%d", it.Slots.HighSlots) }</span>
											</div>
										</div>
										<div class="flex items-center justify-between rounded-lg border border-sky-400/20 bg-slate-900/60 px-2.5 py-1.5">
											<span class="text-sky-300 font-bold">MID</span>
											<div class="flex items-center gap-1">
												for range slotPips(it.Slots.MidSlots) {
													<span class="h-2.5 w-2.5 rounded-sm bg-sky-400"></span>
												}
												<span class="ml-1 text-white font-bold">{ fmt.Sprintf("%d", it.Slots.MidSlots) }</span>
											</div>
										</div>
										<div class="flex items-center justify-between rounded-lg border border-emerald-400/20 bg-slate-900/60 px-2.5 py-1.5">
											<span class="text-emerald-300 font-bold">LOW</span>
											<div class="flex items-center gap-1">
												for range slotPips(it.Slots.LowSlots) {
													<span class="h-2.5 w-2.5 rounded-sm bg-emerald-400"></span>
												}
												<span class="ml-1 text-white font-bold">{ fmt.Sprintf("%d", it.Slots.LowSlots) }</span>
											</div>
										</div>
										<div class="flex items-center justify-between rounded-lg border border-violet-400/20 bg-slate-900/60 px-2.5 py-1.5">
											<span class="text-violet-300 font-bold">RIG</span>
											<div class="flex items-center gap-1">
												for range slotPips(it.Slots.RigSlots) {
													<span class="h-2.5 w-2.5 rounded-sm bg-violet-400"></span>
												}
												<span class="ml-1 text-white font-bold">{ fmt.Sprintf("%d", it.Slots.RigSlots) }</span>
											</div>
										</div>
									</div>
								</div>
							}

							<!-- Description & Hull Bonuses -->
							if it.Description != "" {
								<div class="space-y-1.5 border-t border-violet-400/15 pt-3">
									<div class="text-[10px] font-mono uppercase text-amber-300 font-bold">
										{ i18n.L(ctx, "Description & Hull Bonuses", "Deskripsi & Bonus Hull") }
									</div>
									<div class="text-xs text-slate-300/90 whitespace-pre-line leading-relaxed">{ it.Description }</div>
								</div>
							}
						</div>
					}
				</div>
			</div>

			<!-- TAB B: ATTRIBUTES (Resistance Bars + Icon-Enhanced Comparison Bars) -->
			<div x-cloak x-show="infoTab === 'attributes'" class="space-y-4">
				if anyItemHasResists(res.Items) {
					<div class="rounded-xl border border-sky-400/25 bg-slate-950/60 overflow-hidden">
						<div class="px-4 py-2.5 border-b border-sky-400/20 flex items-center justify-between">
							<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-sky-300">
								<svg class="h-4 w-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V7l7-4z"></path>
								</svg>
								<span>{ i18n.L(ctx, "Base Resistance Profile", "Profil Resistensi Dasar") }</span>
							</div>
							<span class="text-[10px] font-mono text-slate-400">EM • Thermal • Kinetic • Explosive</span>
						</div>
						<div class={ "grid divide-y md:divide-y-0 md:divide-x divide-violet-400/15 " + compareGridColsClass(len(res.Items)) }>
							for _, it := range res.Items {
								<div class="p-4 space-y-3">
									if isComparing {
										<div class="text-xs font-bold text-white truncate">{ it.Name }</div>
									}
									if it.ShieldResists.HasAny() {
										<div class="space-y-1.5">
											<div class="text-[10px] font-mono uppercase text-sky-300 font-bold">Shield</div>
											@resistMiniBar("EM", it.ShieldResists.EM, "bg-sky-400", "text-sky-300")
											@resistMiniBar("THM", it.ShieldResists.Thermal, "bg-rose-400", "text-rose-300")
											@resistMiniBar("KIN", it.ShieldResists.Kinetic, "bg-slate-300", "text-slate-300")
											@resistMiniBar("EXP", it.ShieldResists.Explosive, "bg-amber-400", "text-amber-300")
										</div>
									}
									if it.ArmorResists.HasAny() {
										<div class="space-y-1.5 pt-1">
											<div class="text-[10px] font-mono uppercase text-amber-300 font-bold">Armor</div>
											@resistMiniBar("EM", it.ArmorResists.EM, "bg-sky-400", "text-sky-300")
											@resistMiniBar("THM", it.ArmorResists.Thermal, "bg-rose-400", "text-rose-300")
											@resistMiniBar("KIN", it.ArmorResists.Kinetic, "bg-slate-300", "text-slate-300")
											@resistMiniBar("EXP", it.ArmorResists.Explosive, "bg-amber-400", "text-amber-300")
										</div>
									}
								</div>
							}
						</div>
					</div>
				}

				for _, sec := range res.Sections {
					<div class="rounded-xl border border-violet-400/20 bg-slate-950/60 overflow-hidden">
						<div class={ "px-4 py-2.5 border-b flex items-center justify-between " + compareSectionAccent(sec.Color) }>
							<h4 class="text-xs font-bold uppercase tracking-wider">{ sec.Title }</h4>
							if isComparing {
								<span class="text-[10px] font-mono text-emerald-300">★ = { i18n.L(ctx, "Best", "Terbaik") }</span>
							}
						</div>
						<div class="divide-y divide-violet-400/10">
							for _, row := range sec.Rows {
								<div class="px-4 py-2.5 grid grid-cols-1 lg:grid-cols-12 gap-2.5 items-center hover:bg-white/5 transition">
									<div class="lg:col-span-4 flex items-center gap-2">
										@eveAttrIcon(row.Label)
										<span class="text-xs font-semibold text-slate-200">{ row.Label }</span>
										if row.LowerIsBetter {
											<span class="text-[9.5px] font-mono text-slate-500" title="Lower value is better">↓</span>
										}
									</div>
									<div class={ "lg:col-span-8 grid gap-3 " + compareGridColsClass(len(res.Items)) }>
										for idx, cell := range row.Cells {
											<div class="space-y-1">
												<div class="flex items-center justify-between text-xs font-mono">
													if isComparing {
														<span class="text-[10px] text-slate-500 truncate max-w-[110px]">{ res.Items[idx].Name }</span>
													} else {
														<span></span>
													}
													if cell.HasValue {
														<span class={ func() string {
															if cell.IsBest {
																return "font-extrabold text-emerald-300"
															}
															return "font-semibold text-white"
														}() }>
															if cell.IsBest {
																<span>★ </span>
															}
															{ cell.Formatted }
														</span>
													} else {
														<span class="text-slate-600">—</span>
													}
												</div>
												if cell.HasValue && isComparing {
													<div class="h-1.5 w-full rounded-full bg-slate-900 overflow-hidden border border-slate-800">
														<div
															class={ "h-full rounded-full transition-all " + compareBarColor(sec.Color, cell.IsBest) }
															style={ fmt.Sprintf("width: %.1f%%", cell.BarPercent) }
														></div>
													</div>
												}
											</div>
										}
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>

			<!-- TAB C: REQUIREMENTS (EVE 5-Pip Skill Bars) -->
			if anyItemHasSkills(res.Items) {
				<div x-cloak x-show="infoTab === 'requirements'" class={ "grid gap-4 " + compareGridColsClass(len(res.Items)) }>
					for _, it := range res.Items {
						<div class="rounded-xl border border-violet-400/20 bg-slate-950/60 p-4 space-y-3">
							<div class="flex items-center gap-2 border-b border-violet-400/15 pb-2">
								<svg class="h-4 w-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
								</svg>
								<span class="text-xs font-bold text-white truncate">{ it.Name }</span>
							</div>
							if len(it.RequiredSkills) == 0 {
								<div class="text-xs text-slate-400">{ i18n.L(ctx, "No skill prerequisites.", "Tidak memerlukan skill khusus.") }</div>
							} else {
								<div class="space-y-2.5">
									for _, sk := range it.RequiredSkills {
										<div class="flex items-center justify-between gap-2 rounded-lg border border-slate-800 bg-slate-900/70 px-3 py-2">
											<div class="min-w-0">
												<div class="text-xs font-semibold text-white truncate">{ sk.SkillName }</div>
												<div class="text-[10px] font-mono text-slate-400">Level { fmt.Sprintf("%d", sk.Level) }</div>
											</div>
											@eveSkillLevelPips(sk.Level)
										</div>
									}
								</div>
							}
						</div>
					}
				</div>
			}
		</div>
	}
}

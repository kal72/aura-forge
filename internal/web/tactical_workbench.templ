package web

import (
	"aura-forge/internal/service"
)

// TacticalPage renders the full interactive Aura Tactical Ship Fitting & Combat Studio (/tactical).
templ TacticalPage(data *service.TacticalViewData) {
	@TacticalLayout("Aura Tactical Studio", data.Mode) {
		@templ.JSONScript("af-tactical-boot", data)
		<div
			x-data="afTacticalStudio()"
			x-cloak
			class="flex min-h-screen flex-col text-slate-100"
		>
			<!-- =============================================================
			     TOP TACTICAL COMMAND BAR (48px Smoked Glass)
			     ============================================================= -->
			<header class="sticky top-0 z-40 border-b border-violet-500/25 bg-slate-950/75 backdrop-blur-md">
				<div class="tac-shell flex flex-wrap items-center justify-between gap-2 px-3 py-2 sm:px-4">
					<!-- Left: Studio Switcher + Brand -->
					<div class="flex items-center gap-2.5">
						<a
							href="/"
							class="inline-flex items-center gap-1.5 rounded-lg border border-violet-400/35 bg-violet-500/15 px-2.5 py-1.5 text-xs font-semibold text-violet-200 hover:bg-violet-500/25 hover:text-white transition"
							title="Return to Aura Forge Industry & Market Studio"
						>
							<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
							</svg>
							<span class="hidden sm:inline">Aura Forge</span>
						</a>
						<div class="flex items-center gap-2">
							<div class="flex h-7 w-7 items-center justify-center rounded-lg border border-amber-400/50 bg-amber-500/15 text-amber-300 shadow-[0_0_12px_rgba(251,191,36,0.22)]">
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<circle cx="12" cy="12" r="9"></circle>
									<circle cx="12" cy="12" r="3"></circle>
									<path stroke-linecap="round" d="M12 3v3M12 18v3M3 12h3M18 12h3"></path>
								</svg>
							</div>
							<div>
								<div class="text-xs font-bold tracking-widest text-white uppercase leading-none">Aura Tactical</div>
								<div class="text-[9.5px] font-mono text-amber-300/80 uppercase tracking-wider">Orbital Fitting Studio</div>
							</div>
						</div>
					</div>

					<!-- Center: Workspace Mode Switcher -->
					<div class="flex items-center gap-1 rounded-xl border border-slate-700/70 bg-slate-900/80 p-1">
						<button
							type="button"
							@click="activeMode = 'wheel'"
							:class="activeMode === 'wheel' ? 'bg-violet-600 text-white shadow-[0_0_12px_rgba(124,58,237,0.45)]' : 'text-slate-300 hover:text-white'"
							class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1 text-xs font-semibold transition cursor-pointer"
						>
							<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="8"></circle>
								<circle cx="12" cy="12" r="3"></circle>
							</svg>
							<span>Fitting Wheel</span>
						</button>
						<button
							type="button"
							@click="activeMode = 'radar'"
							:class="activeMode === 'radar' ? 'bg-sky-600 text-white shadow-[0_0_12px_rgba(14,165,233,0.45)]' : 'text-slate-300 hover:text-white'"
							class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1 text-xs font-semibold transition cursor-pointer"
						>
							<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 0v10l6 4"></path>
							</svg>
							<span>Combat Arena</span>
						</button>
						<button
							type="button"
							@click="activeMode = 'intel'"
							:class="activeMode === 'intel' ? 'bg-rose-600 text-white shadow-[0_0_12px_rgba(225,29,72,0.45)]' : 'text-slate-300 hover:text-white'"
							class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1 text-xs font-semibold transition cursor-pointer"
						>
							<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
							</svg>
							<span>Intel &amp; Autopsy</span>
						</button>
						<button
							type="button"
							@click="activeMode = 'doctrines'"
							:class="activeMode === 'doctrines' ? 'bg-amber-600 text-white shadow-[0_0_12px_rgba(217,119,6,0.45)]' : 'text-slate-300 hover:text-white'"
							class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1 text-xs font-semibold transition cursor-pointer"
						>
							<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
							</svg>
							<span>Doctrines</span>
						</button>
					</div>

					<!-- Right: Fit Actions, Live Cost, Skill Profile -->
					<div class="flex flex-wrap items-center gap-1.5">
						<!-- Live Trade Hub Fit Cost Pill -->
						<div class="hidden xl:flex items-center gap-1.5 rounded-lg border border-amber-400/35 bg-amber-500/10 px-2.5 py-1 text-xs font-mono">
							<span class="text-[10px] text-amber-300/80 uppercase" x-text="(sim && sim.hub_name) || 'Jita 4-4'"></span>
							<span class="font-bold text-amber-200" x-text="sim ? formatISK(sim.total_fit_cost_isk) : '...'"></span>
						</div>

						<!-- Skill Profile Pill (Lv III / Lv IV / Lv V / Live EVE SSO Pilot) -->
						<div class="flex items-center rounded-lg border border-slate-700/80 bg-slate-900/80 p-0.5 text-[11px] font-mono">
							<button type="button" @click="setSkillProfile('beginner')" :class="fit.skill_profile === 'beginner' ? 'bg-emerald-500/25 text-emerald-200 border-emerald-400/40' : 'text-slate-400 border-transparent hover:text-white'" class="rounded border px-2 py-0.5 cursor-pointer transition" title="Beginner Pilot (All Level III)">Lv III</button>
							<button type="button" @click="setSkillProfile('intermediate')" :class="fit.skill_profile === 'intermediate' ? 'bg-sky-500/25 text-sky-200 border-sky-400/40' : 'text-slate-400 border-transparent hover:text-white'" class="rounded border px-2 py-0.5 cursor-pointer transition" title="Intermediate Pilot (All Level IV)">Lv IV</button>
							<button type="button" @click="setSkillProfile('maxed')" :class="fit.skill_profile === 'maxed' ? 'bg-violet-500/30 text-violet-200 border-violet-400/40' : 'text-slate-400 border-transparent hover:text-white'" class="rounded border px-2 py-0.5 cursor-pointer transition" title="Maxed Pilot (All Level V)">Lv V</button>
							<button
								type="button"
								@click="ssoConnected ? setSkillProfile('pilot_live') : notify('Connect EVE SSO in Aura Forge sidebar to use Live Pilot Skills')"
								:class="fit.skill_profile === 'pilot_live' ? 'bg-amber-500/30 text-amber-200 border-amber-400/50' : (ssoConnected ? 'text-amber-300/80 border-transparent hover:text-amber-200' : 'text-slate-500 border-transparent')"
								class="rounded border px-2 py-0.5 cursor-pointer transition"
								:title="ssoConnected ? ('Use Live EVE SSO Skills: ' + ssoCharName) : 'Connect EVE SSO to simulate with your real character skills'"
							>
								Pilot SSO
							</button>
						</div>

						<button
							type="button"
							@click="runFlyToday()"
							:disabled="flyTodayRunning"
							title="Downgrade Tech 2 modules into beginner-accessible Compact/Meta/T1 equivalents (0 ESI calls)"
							class="rounded-lg border border-violet-400/50 bg-violet-500/20 px-2.5 py-1 text-xs font-semibold text-violet-100 hover:bg-violet-500/30 transition cursor-pointer disabled:opacity-50"
						>
							<span x-text="flyTodayRunning ? 'Adapting...' : 'Fly Today'"></span>
						</button>
						<button
							type="button"
							@click="eftModalOpen = true; eftError = ''"
							class="rounded-lg border border-sky-400/40 bg-sky-500/15 px-2.5 py-1 text-xs font-semibold text-sky-200 hover:bg-sky-500/25 transition cursor-pointer"
						>
							Import EFT
						</button>
						<button
							type="button"
							@click="copyToClipboard(sim && sim.eft_export, 'EFT Fitting')"
							class="rounded-lg border border-slate-600/60 bg-slate-800/70 px-2.5 py-1 text-xs font-semibold text-slate-200 hover:bg-slate-700 transition cursor-pointer"
						>
							Copy EFT
						</button>
						<button
							type="button"
							@click="copyToClipboard(sim && sim.multibuy_text, 'EVE Multibuy')"
							class="rounded-lg border border-amber-400/40 bg-amber-500/15 px-2.5 py-1 text-xs font-semibold text-amber-200 hover:bg-amber-500/25 transition cursor-pointer"
						>
							Multibuy
						</button>
						<button
							type="button"
							@click="saveFitting()"
							:disabled="savingFit"
							class="rounded-lg border border-emerald-400/50 bg-emerald-500/20 px-3 py-1 text-xs font-bold text-emerald-200 hover:bg-emerald-500/30 transition cursor-pointer disabled:opacity-50"
						>
							<span x-text="savingFit ? 'Saving...' : 'Save Fit'"></span>
						</button>
					</div>
				</div>
			</header>

			<!-- Floating Toast Notification -->
			<div
				x-show="toastMsg"
				x-transition
				class="fixed bottom-5 left-1/2 z-50 -translate-x-1/2 rounded-xl border border-amber-400/50 bg-slate-950/95 px-4 py-2 text-xs font-semibold text-amber-200 shadow-[0_0_24px_rgba(251,191,36,0.28)] backdrop-blur"
				x-text="toastMsg"
			></div>

			<!-- =============================================================
			     MAIN 3-COLUMN HOLOGRAPHIC COCKPIT
			     ============================================================= -->
			<main class="tac-shell tac-cockpit-grid flex-1 p-3">
				<!-- =========================================================
				     LEFT WING: SMART HANGAR & MODULE DRAWER
				     ========================================================= -->
				<aside class="tactical-panel tac-left-wing flex flex-col rounded-2xl p-3 overflow-hidden">
					<!-- Drawer Tabs -->
					<div class="grid grid-cols-3 gap-1 rounded-xl border border-slate-700/60 bg-slate-950/55 p-1 mb-3">
						<button type="button" @click="leftTab = 'modules'" :class="leftTab === 'modules' ? 'bg-violet-600/80 text-white' : 'text-slate-300 hover:text-white'" class="rounded-lg py-1.5 text-[11px] font-bold transition cursor-pointer">Modules</button>
						<button type="button" @click="leftTab = 'hulls'" :class="leftTab === 'hulls' ? 'bg-violet-600/80 text-white' : 'text-slate-300 hover:text-white'" class="rounded-lg py-1.5 text-[11px] font-bold transition cursor-pointer">Ship Hulls</button>
						<button type="button" @click="leftTab = 'saved'" :class="leftTab === 'saved' ? 'bg-violet-600/80 text-white' : 'text-slate-300 hover:text-white'" class="rounded-lg py-1.5 text-[11px] font-bold transition cursor-pointer">
							Saved (<span x-text="savedFittings.length"></span>)
						</button>
					</div>

					<!-- TAB 1: CONTEXT-AWARE MODULE BROWSER -->
					<div x-show="leftTab === 'modules'" class="flex flex-1 flex-col min-h-0">
						<!-- Slot Filter Pills -->
						<div class="flex flex-wrap gap-1 mb-2.5">
							<template x-for="sk in ['high','mid','low','rig','drone']" :key="sk">
								<button
									type="button"
									@click="activeSlotFilter = sk; fetchModules()"
									:class="activeSlotFilter === sk ? 'border-amber-400/70 bg-amber-500/20 text-amber-200' : 'border-slate-700/70 bg-slate-900/50 text-slate-300 hover:border-slate-500'"
									class="rounded-md border px-2 py-1 text-[10.5px] font-mono font-semibold uppercase cursor-pointer transition"
									x-text="sk"
								></button>
							</template>
						</div>

						<!-- Search Box -->
						<div class="relative mb-2.5">
							<input
								type="text"
								x-model="moduleQuery"
								@input.debounce.220ms="fetchModules()"
								placeholder="Search modules, rigs, drones..."
								class="w-full rounded-xl border border-violet-400/30 bg-slate-950/70 px-3 py-2 text-xs text-white placeholder-slate-400 focus:border-amber-400/70 focus:outline-none"
							/>
							<span x-show="loadingModules" class="absolute right-2.5 top-2.5 h-3.5 w-3.5 animate-spin rounded-full border-2 border-amber-300 border-t-transparent"></span>
						</div>

						<div class="mb-2 text-[10.5px] text-slate-300/80 flex items-center justify-between">
							<span>Drag onto wheel or click <strong class="text-amber-300">+ Fit</strong></span>
							<span class="font-mono text-[10px] text-violet-300" x-show="selectedSlot" x-text="selectedSlot ? ('Target: ' + selectedSlot.kind.toUpperCase() + ' #' + (selectedSlot.index + 1)) : ''"></span>
						</div>

						<!-- Scrollable Module List -->
						<div class="flex-1 overflow-y-auto space-y-1.5 pr-1">
							<template x-for="mod in moduleResults" :key="mod.type_id">
								<div
									draggable="true"
									@dragstart="onDragStartModule(mod, $event)"
									@dragend="draggingModule = null; dragOverSlotKey = ''"
									class="group flex items-center gap-2.5 rounded-xl border border-slate-700/60 bg-slate-950/55 p-2 hover:border-amber-400/55 hover:bg-slate-900/85 transition cursor-grab active:cursor-grabbing"
								>
									<img :src="itemIconURL(mod.type_id)" :alt="mod.name" class="h-8 w-8 shrink-0 rounded-lg border border-slate-700/80 bg-slate-900 object-contain"/>
									<div class="min-w-0 flex-1">
										<div class="truncate text-xs font-semibold text-white group-hover:text-amber-200" x-text="mod.name"></div>
										<div class="truncate text-[10px] text-slate-400" x-text="mod.group_name"></div>
									</div>
									<button
										type="button"
										@click="equipModuleToSlot(mod, activeSlotFilter)"
										class="shrink-0 rounded-lg border border-emerald-400/40 bg-emerald-500/15 px-2 py-1 text-[10.5px] font-bold text-emerald-200 hover:bg-emerald-500/30 transition cursor-pointer"
									>
										+ Fit
									</button>
								</div>
							</template>
							<div x-show="!loadingModules && moduleResults.length === 0" class="py-8 text-center text-xs text-slate-400">
								No matching modules found. Try another keyword.
							</div>
						</div>
					</div>

					<!-- TAB 2: VISUAL SHIP HULL GALLERY -->
					<div x-show="leftTab === 'hulls'" class="flex flex-1 flex-col min-h-0">
						<div class="flex flex-wrap gap-1 mb-2.5">
							<template x-for="hc in ['all','frigate','destroyer','cruiser','battlecruiser','battleship','hauler']" :key="hc">
								<button
									type="button"
									@click="hullClassFilter = hc; fetchShips()"
									:class="hullClassFilter === hc ? 'border-sky-400/70 bg-sky-500/20 text-sky-200' : 'border-slate-700/70 bg-slate-900/50 text-slate-300 hover:border-slate-500'"
									class="rounded-md border px-2 py-0.5 text-[10px] font-mono uppercase cursor-pointer transition"
									x-text="hc"
								></button>
							</template>
						</div>
						<input
							type="text"
							x-model="shipQuery"
							@input.debounce.220ms="fetchShips()"
							placeholder="Search ship hull (Omen, Caracal, Gila)..."
							class="mb-2.5 w-full rounded-xl border border-violet-400/30 bg-slate-950/70 px-3 py-2 text-xs text-white placeholder-slate-400 focus:border-sky-400/70 focus:outline-none"
						/>
						<div class="flex-1 overflow-y-auto grid grid-cols-2 gap-2 pr-1">
							<template x-for="ship in shipResults" :key="ship.type_id">
								<button
									type="button"
									@click="selectShip(ship)"
									:class="fit.ship_type_id === ship.type_id ? 'border-amber-400 bg-amber-500/15' : 'border-slate-700/60 bg-slate-950/60 hover:border-violet-400/60'"
									class="group flex flex-col items-center rounded-xl border p-2 text-center transition cursor-pointer"
								>
									<img :src="shipRenderURL(ship.type_id)" :alt="ship.name" loading="lazy" class="h-16 w-16 rounded-lg object-cover mb-1.5 group-hover:scale-105 transition"/>
									<div class="w-full truncate text-xs font-bold text-white" x-text="ship.name"></div>
									<div class="w-full truncate text-[9.5px] text-slate-400" x-text="ship.group_name"></div>
								</button>
							</template>
						</div>
					</div>

					<!-- TAB 3: SAVED FITTINGS & STARTER PRESETS -->
					<div x-show="leftTab === 'saved'" class="flex flex-1 flex-col min-h-0 overflow-y-auto space-y-2 pr-1">
						<div class="text-[10px] font-mono uppercase tracking-wider text-amber-300/80">Starter Doctrines</div>
						<template x-for="pr in presets" :key="pr.key">
							<button
								type="button"
								@click="loadPreset(pr)"
								class="flex w-full items-center gap-2.5 rounded-xl border border-slate-700/60 bg-slate-950/60 p-2 text-left hover:border-amber-400/60 transition cursor-pointer"
							>
								<img :src="shipRenderURL(pr.ship_type_id)" class="h-10 w-10 rounded-lg object-cover shrink-0 border border-slate-700"/>
								<div class="min-w-0 flex-1">
									<div class="truncate text-xs font-bold text-white" x-text="pr.name"></div>
									<div class="truncate text-[10px] text-slate-400" x-text="pr.summary"></div>
								</div>
							</button>
						</template>

						<div class="pt-2 text-[10px] font-mono uppercase tracking-wider text-emerald-300/80">Your Saved Fittings</div>
						<template x-for="sf in savedFittings" :key="sf.id">
							<div class="flex items-center gap-2 rounded-xl border border-slate-700/60 bg-slate-950/60 p-2 hover:border-emerald-400/50 transition">
								<button type="button" @click="loadSavedFitting(sf)" class="flex flex-1 items-center gap-2 min-w-0 text-left cursor-pointer">
									<img :src="shipRenderURL(sf.ship_type_id)" class="h-9 w-9 rounded-lg object-cover shrink-0"/>
									<div class="min-w-0 flex-1">
										<div class="truncate text-xs font-bold text-white" x-text="sf.name"></div>
										<div class="text-[10px] font-mono text-slate-400">
											<span x-text="formatNum(sf.ehp) + ' EHP'"></span> •
											<span x-text="formatNum(sf.dps, 0) + ' DPS'"></span>
										</div>
									</div>
								</button>
								<button type="button" @click="deleteSavedFitting(sf.id)" class="rounded p-1 text-slate-400 hover:bg-rose-500/20 hover:text-rose-300 cursor-pointer" title="Delete Fit">
									<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
									</svg>
								</button>
							</div>
						</template>
						<div x-show="savedFittings.length === 0" class="rounded-xl border border-dashed border-slate-700/70 p-4 text-center text-[11px] text-slate-400">
							No saved fits yet. Customize your wheel and click <strong class="text-emerald-300">Save Fit</strong>.
						</div>
					</div>
				</aside>

				<!-- =========================================================
				     CENTER STAGE: INTERACTIVE ORBITAL WHEEL / 2D RADAR / DOCTRINES
				     ========================================================= -->
				<section class="flex flex-col gap-3 min-w-0">
					<!-- Editable Fit Title Bar -->
					<div class="tactical-panel flex flex-wrap items-center justify-between gap-2 rounded-2xl px-4 py-2.5">
						<div class="flex items-center gap-2.5 min-w-0 flex-1">
							<span class="rounded-md border border-amber-400/40 bg-amber-500/15 px-2 py-0.5 text-[10.5px] font-mono font-bold uppercase text-amber-200" x-text="fit.hull_class || 'Ship'"></span>
							<input
								type="text"
								x-model="fit.name"
								class="min-w-0 flex-1 bg-transparent text-sm font-bold text-white focus:outline-none border-b border-transparent focus:border-amber-400/60"
								aria-label="Fitting Name"
							/>
						</div>
						<div class="flex items-center gap-2">
							<select x-model="fit.tag" class="rounded-lg border border-slate-700 bg-slate-900/90 px-2 py-1 text-[11px] font-semibold text-slate-200 focus:outline-none">
								<option value="PvE">PvE</option>
								<option value="PvP">PvP</option>
								<option value="Hauling">Hauling</option>
								<option value="Abyssal">Abyssal</option>
							</select>
							<span x-show="simulating" class="h-3.5 w-3.5 animate-spin rounded-full border-2 border-amber-300 border-t-transparent"></span>
							<span
								x-show="sim"
								:class="{
									'border-emerald-400/60 bg-emerald-500/20 text-emerald-200': sim && (sim.readiness_grade === 'S' || sim.readiness_grade === 'A'),
									'border-amber-400/60 bg-amber-500/20 text-amber-200': sim && (sim.readiness_grade === 'B' || sim.readiness_grade === 'C'),
									'border-rose-400/70 bg-rose-500/25 text-rose-200 animate-pulse': sim && sim.readiness_grade === 'RISK'
								}"
								class="rounded-lg border px-2.5 py-0.5 text-xs font-mono font-extrabold"
								x-text="sim ? ('GRADE ' + sim.readiness_grade) : ''"
							></span>
						</div>
					</div>

					<!-- MODE 1: INTERACTIVE ORBITAL SHIP FITTING WHEEL -->
					<div x-show="activeMode === 'wheel'" class="tactical-panel relative flex flex-col items-center justify-center rounded-2xl p-3 sm:p-5 overflow-hidden">
						<!-- Radial Wheel Container (Responsive 560x560 Coordinate Space) -->
						<div
							@mousemove="handleWheelParallax($event)"
							@mouseleave="resetParallax()"
							class="tac-wheel-stage select-none"
						>
							<!-- Outer SVG Layer: Rings, Segmented Gauges (Calibration, CPU, Powergrid), Hardpoint Pips -->
							<svg viewBox="0 0 560 560" class="pointer-events-none absolute inset-0 h-full w-full" x-html="wheelOuterSVG()"></svg>

							<!-- Center Ship Hologram Circular Viewport -->
							<div
								class="tac-hologram-core absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 items-center justify-center overflow-hidden rounded-full border border-amber-300/25"
								:style="'background: ' + factionTheme().nebula + '; box-shadow: 0 0 42px ' + factionTheme().glow + ', inset 0 0 40px rgba(0,0,0,0.85);'"
							>
								<!-- Hologram Ship Render with Subtle 3D Parallax -->
								<img
									:src="shipRenderURL(fit.ship_type_id)"
									:alt="fit.ship_name"
									class="h-[92%] w-[92%] object-contain drop-shadow-[0_14px_28px_rgba(0,0,0,0.85)] transition-transform duration-150 ease-out"
									:style="'transform: perspective(700px) rotateX(' + tiltX + 'deg) rotateY(' + tiltY + 'deg) scale(1.04);'"
								/>
								<!-- Center Ship Name Overlay -->
								<div class="pointer-events-none absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full border border-white/15 bg-slate-950/75 px-3 py-0.5 text-[11px] font-mono font-bold tracking-wider text-amber-200 backdrop-blur-xs">
									<span x-text="fit.ship_name"></span>
								</div>
							</div>

							<!-- Interactive Radial Slot Hit-Targets & Upright Icons (Centered inside Curved Trapezoid SVG Wedges) -->
							<template x-for="slot in radialSlots()" :key="slot.key">
								<div
									@click="clickSlot(slot)"
									@dblclick.stop="cycleModuleState(slot.kind, slot.index)"
									@mouseenter="hoverSlotKey = slot.key"
									@mouseleave="if (hoverSlotKey === slot.key) hoverSlotKey = ''"
									@dragover.prevent="dragOverSlotKey = slot.key"
									@dragleave="if (dragOverSlotKey === slot.key) dragOverSlotKey = ''"
									@drop.prevent="onDropOnSlot(slot)"
									:style="'left: ' + slot.pctX + '%; top: ' + slot.pctY + '%; transform: translate(-50%, -50%) scale(' + ((dragOverSlotKey === slot.key || (selectedSlot && selectedSlot.kind === slot.kind && selectedSlot.index === slot.index)) ? 1.1 : 1) + ');'"
									:class="{
										'z-30': selectedSlot && selectedSlot.kind === slot.kind && selectedSlot.index === slot.index,
										'tac-slot-offline': slot.module && slot.module.state === 'offline'
									}"
									:title="slot.module ? (slot.module.name + (slot.module.charge_name ? ' [' + slot.module.charge_name + ']' : '') + ' — Click for options, Double-click to toggle state') : ('Empty ' + slot.kind.toUpperCase() + ' slot — Click to browse or Drop module')"
									class="tac-radial-socket absolute z-20 flex items-center justify-center transition-transform duration-150 cursor-pointer"
								>
									<template x-if="slot.module">
										<div class="relative h-full w-full">
											<img :src="itemIconURL(slot.module.type_id)" :alt="slot.module.name" class="h-full w-full rounded object-contain drop-shadow-[0_2px_6px_rgba(0,0,0,0.85)]"/>
											<!-- Loaded Charge Mini-Icon -->
											<img
												x-show="slot.module.charge_type_id > 0"
												:src="itemIconURL(slot.module.charge_type_id)"
												class="absolute -top-1 -left-1 h-3.5 w-3.5 rounded-full border border-amber-300/60 bg-slate-950"
											/>
											<!-- Missing Skill Lock Badge -->
											<span
												x-show="isSlotLocked(slot.key)"
												title="Skill prerequisite missing for active pilot profile"
												class="absolute -bottom-1 -right-1 flex h-3.5 w-3.5 items-center justify-center rounded-full border border-rose-400 bg-rose-600 text-[8px] font-bold text-white"
											>!</span>
										</div>
									</template>
									<template x-if="!slot.module">
										<span class="text-[8.5px] font-mono font-semibold uppercase text-slate-400/60" x-text="slot.kind[0]"></span>
									</template>
								</div>
							</template>
						</div>

						<!-- Selected Slot Quick Action Ribbon (Appears when clicking a fitted slot) -->
						<div
							x-show="selectedSlot && getModuleAt(selectedSlot.kind, selectedSlot.index)"
							x-transition
							class="mt-2 flex flex-wrap items-center justify-center gap-2 rounded-xl border border-amber-400/40 bg-slate-950/90 px-3 py-2 text-xs shadow-lg"
						>
							<template x-if="selectedSlot && getModuleAt(selectedSlot.kind, selectedSlot.index)">
								<div class="flex flex-wrap items-center gap-2">
									<img :src="itemIconURL(getModuleAt(selectedSlot.kind, selectedSlot.index).type_id)" class="h-6 w-6 rounded border border-slate-700"/>
									<span class="font-bold text-white" x-text="getModuleAt(selectedSlot.kind, selectedSlot.index).name"></span>
									<span class="font-mono text-[11px] text-amber-300" x-text="formatISK(getModuleAt(selectedSlot.kind, selectedSlot.index).unit_price_isk)"></span>
									<div class="h-4 w-px bg-slate-700"></div>
									<button type="button" @click="setModuleState(selectedSlot.kind, selectedSlot.index, 'active')" class="rounded border border-emerald-400/40 bg-emerald-500/15 px-2 py-0.5 text-[11px] font-semibold text-emerald-200 hover:bg-emerald-500/30 cursor-pointer">Active</button>
									<button type="button" @click="setModuleState(selectedSlot.kind, selectedSlot.index, 'overheated')" class="rounded border border-rose-400/40 bg-rose-500/15 px-2 py-0.5 text-[11px] font-semibold text-rose-200 hover:bg-rose-500/30 cursor-pointer">Overheat</button>
									<button type="button" @click="setModuleState(selectedSlot.kind, selectedSlot.index, 'offline')" class="rounded border border-slate-500/50 bg-slate-700/40 px-2 py-0.5 text-[11px] font-semibold text-slate-300 hover:bg-slate-700 cursor-pointer">Offline</button>
									<button type="button" @click="removeModule(selectedSlot.kind, selectedSlot.index)" class="rounded border border-rose-500/50 bg-rose-600/25 px-2 py-0.5 text-[11px] font-bold text-rose-200 hover:bg-rose-600/40 cursor-pointer">Remove</button>

									<!-- Interactive Ammo / Charge Picker for Fitted Weapons -->
									<template x-if="suggestedChargesForModule(getModuleAt(selectedSlot.kind, selectedSlot.index)).length > 0">
										<div class="mt-1.5 flex w-full flex-wrap items-center gap-1.5 border-t border-slate-700/70 pt-1.5">
											<span class="text-[10px] font-mono uppercase text-amber-300">Ammo:</span>
											<template x-for="ch in suggestedChargesForModule(getModuleAt(selectedSlot.kind, selectedSlot.index))" :key="ch.type_id">
												<button
													type="button"
													@click="loadChargeOnSlot(selectedSlot.kind, selectedSlot.index, ch, true)"
													:class="getModuleAt(selectedSlot.kind, selectedSlot.index).charge_type_id === ch.type_id ? 'border-amber-400 bg-amber-500/25 text-amber-100' : 'border-slate-700 bg-slate-900/80 text-slate-300 hover:border-amber-300/60'"
													class="inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-[10.5px] cursor-pointer transition"
													:title="'Load ' + ch.name + ' (' + ch.tag + ') into all matching weapons'"
												>
													<img :src="itemIconURL(ch.type_id)" class="h-3.5 w-3.5 rounded-sm"/>
													<span x-text="ch.name"></span>
												</button>
											</template>
											<button
												type="button"
												x-show="getModuleAt(selectedSlot.kind, selectedSlot.index).charge_type_id > 0"
												@click="loadChargeOnSlot(selectedSlot.kind, selectedSlot.index, null, true)"
												class="rounded-md border border-slate-600 px-1.5 py-0.5 text-[10px] text-slate-300 hover:bg-slate-800 cursor-pointer"
											>
												Unload
											</button>
										</div>
									</template>
								</div>
							</template>
						</div>

						<!-- Live Resource Margin Strip Directly Below Wheel -->
						<div class="mt-3 grid w-full grid-cols-3 gap-2">
							<div class="rounded-xl border border-sky-400/25 bg-slate-950/65 px-3 py-2">
								<div class="flex items-center justify-between text-[10px] font-mono uppercase">
									<span class="text-sky-300 font-bold">CPU Output</span>
									<span :class="sim && sim.cpu && sim.cpu.overloaded ? 'text-rose-400 font-bold' : 'text-slate-300'" x-text="sim ? (sim.cpu.percent.toFixed(0) + '%') : '0%'"></span>
								</div>
								<div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-slate-800">
									<div class="h-full rounded-full transition-all duration-300" :class="sim && sim.cpu && sim.cpu.overloaded ? 'bg-rose-500' : 'bg-sky-400'" :style="'width:' + Math.min(100, (sim && sim.cpu && sim.cpu.percent) || 0) + '%'"></div>
								</div>
								<div class="mt-1 text-[10.5px] font-mono text-slate-300" x-text="sim ? (formatNum(sim.cpu.used, 1) + ' / ' + formatNum(sim.cpu.total, 0) + ' tf') : '—'"></div>
							</div>

							<div class="rounded-xl border border-rose-400/25 bg-slate-950/65 px-3 py-2">
								<div class="flex items-center justify-between text-[10px] font-mono uppercase">
									<span class="text-rose-300 font-bold">Powergrid</span>
									<span :class="sim && sim.powergrid && sim.powergrid.overloaded ? 'text-rose-400 font-bold' : 'text-slate-300'" x-text="sim ? (sim.powergrid.percent.toFixed(0) + '%') : '0%'"></span>
								</div>
								<div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-slate-800">
									<div class="h-full rounded-full transition-all duration-300" :class="sim && sim.powergrid && sim.powergrid.overloaded ? 'bg-rose-600' : 'bg-rose-400'" :style="'width:' + Math.min(100, (sim && sim.powergrid && sim.powergrid.percent) || 0) + '%'"></div>
								</div>
								<div class="mt-1 text-[10.5px] font-mono text-slate-300" x-text="sim ? (formatNum(sim.powergrid.used, 1) + ' / ' + formatNum(sim.powergrid.total, 0) + ' MW') : '—'"></div>
							</div>

							<div class="rounded-xl border border-slate-400/25 bg-slate-950/65 px-3 py-2">
								<div class="flex items-center justify-between text-[10px] font-mono uppercase">
									<span class="text-slate-200 font-bold">Calibration</span>
									<span :class="sim && sim.calibration && sim.calibration.overloaded ? 'text-rose-400 font-bold' : 'text-slate-300'" x-text="sim ? (sim.calibration.percent.toFixed(0) + '%') : '0%'"></span>
								</div>
								<div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-slate-800">
									<div class="h-full rounded-full transition-all duration-300" :class="sim && sim.calibration && sim.calibration.overloaded ? 'bg-rose-500' : 'bg-slate-200'" :style="'width:' + Math.min(100, (sim && sim.calibration && sim.calibration.percent) || 0) + '%'"></div>
								</div>
								<div class="mt-1 text-[10.5px] font-mono text-slate-300" x-text="sim ? (formatNum(sim.calibration.used, 0) + ' / ' + formatNum(sim.calibration.total, 0) + ' pts') : '—'"></div>
							</div>
						</div>
					</div>

					<!-- MODE 2: INTERACTIVE 2D TACTICAL RANGE & ORBIT RADAR SANDBOX -->
					<div x-show="activeMode === 'radar'" class="tactical-panel flex flex-col rounded-2xl p-4">
						<div class="flex flex-wrap items-center justify-between gap-2 mb-3">
							<div>
								<h2 class="text-sm font-bold text-white">Interactive 2D Tactical Range &amp; Orbit Radar</h2>
								<p class="text-[11px] text-slate-300">Drag the red target blip across Optimal, Falloff, Scram (9 km), and Disruptor (24 km) rings to test live Applied DPS.</p>
							</div>
							<div class="flex items-center gap-2">
								<div class="rounded-xl border border-emerald-400/40 bg-emerald-500/15 px-3 py-1.5 text-center">
									<div class="text-[9.5px] font-mono uppercase text-emerald-300">Applied DPS</div>
									<div class="text-base font-mono font-extrabold text-white" x-text="radarAppliedDPS().dps"></div>
								</div>
								<div class="rounded-xl border border-sky-400/40 bg-sky-500/15 px-3 py-1.5 text-center">
									<div class="text-[9.5px] font-mono uppercase text-sky-300">Hit Quality</div>
									<div class="text-base font-mono font-extrabold text-white" x-text="radarAppliedDPS().hitPct + '%'"></div>
								</div>
								<div class="rounded-xl border border-amber-400/40 bg-amber-500/15 px-3 py-1.5 text-center">
									<div class="text-[9.5px] font-mono uppercase text-amber-300">Est. TTK</div>
									<div class="text-base font-mono font-extrabold text-white" x-text="radarAppliedDPS().ttk"></div>
								</div>
							</div>
						</div>

						<div class="tac-radar-box overflow-hidden rounded-xl border border-violet-500/30 bg-slate-950/85">
							<canvas
								x-ref="radarCanvas"
								@pointerdown="handleRadarPointer($event, true)"
								@pointermove="handleRadarPointer($event, false)"
								@pointerup="radarDragging = false"
								@pointerleave="radarDragging = false"
								class="h-full w-full cursor-crosshair touch-none"
							></canvas>
						</div>

						<!-- Interactive Target Sliders -->
						<div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
							<div class="rounded-xl border border-slate-700/60 bg-slate-950/60 p-2.5">
								<div class="flex justify-between text-[11px] font-mono mb-1">
									<span class="text-slate-300">Target Distance</span>
									<span class="text-amber-300 font-bold" x-text="radarTargetDistKM + ' km'"></span>
								</div>
								<input type="range" min="1" max="60" x-model.number="radarTargetDistKM" class="w-full accent-amber-400"/>
							</div>
							<div class="rounded-xl border border-slate-700/60 bg-slate-950/60 p-2.5">
								<div class="flex justify-between text-[11px] font-mono mb-1">
									<span class="text-slate-300">Target Orbit Speed</span>
									<span class="text-sky-300 font-bold" x-text="radarTargetSpeedMS + ' m/s'"></span>
								</div>
								<input type="range" min="0" max="1500" step="25" x-model.number="radarTargetSpeedMS" class="w-full accent-sky-400"/>
							</div>
							<div class="rounded-xl border border-slate-700/60 bg-slate-950/60 p-2.5">
								<div class="flex justify-between text-[11px] font-mono mb-1">
									<span class="text-slate-300">Target Signature</span>
									<span class="text-violet-300 font-bold" x-text="radarTargetSigM + ' m'"></span>
								</div>
								<input type="range" min="30" max="400" step="5" x-model.number="radarTargetSigM" class="w-full accent-violet-400"/>
							</div>
						</div>

						<!-- Synced Applied DPS vs Distance (0–80 km) SVG Area Chart -->
						<div class="mt-3 rounded-xl border border-sky-400/25 bg-slate-950/75 p-2.5">
							<div class="flex items-center justify-between text-[10.5px] font-mono mb-1">
								<span class="text-sky-300 font-bold uppercase">Applied DPS vs Distance (0–80 km)</span>
								<span class="text-amber-300" x-text="'Crosshair synced to Radar: ' + radarTargetDistKM + ' km'"></span>
							</div>
							<svg viewBox="0 0 560 128" class="w-full h-32" x-html="rangeCurveSVG()"></svg>
						</div>

						<!-- PHASE 3: SECOND-BY-SECOND 1v1 DUEL & BOSS TIMELINE SCRUBBER -->
						<div class="mt-4 border-t border-violet-500/25 pt-4">
							<div class="flex flex-wrap items-center justify-between gap-2 mb-3">
								<div>
									<h3 class="text-xs font-bold uppercase tracking-wider text-amber-300">1v1 Duel &amp; Boss Combat Timeline (180s)</h3>
									<p class="text-[11px] text-slate-300">Simulate second-by-second Shield/Armor/Capacitor survival against PvE bosses or PvP archetypes.</p>
								</div>
								<button
									type="button"
									@click="runDuelSim()"
									:disabled="duelRunning"
									class="rounded-lg border border-amber-400/50 bg-amber-500/20 px-3 py-1.5 text-xs font-bold text-amber-100 hover:bg-amber-500/30 cursor-pointer transition disabled:opacity-50"
								>
									<span x-text="duelRunning ? 'Simulating...' : 'Run 1v1 Simulation'"></span>
								</button>
							</div>

							<!-- Opponent Archetype Chips + EWAR Toggles -->
							<div class="flex flex-wrap items-center gap-1.5 mb-3">
								<template x-for="op in duelOpponents" :key="op.key">
									<button
										type="button"
										@click="duelOpponentKey = op.key; duelRangeKM = op.optimal_km; runDuelSim()"
										:class="duelOpponentKey === op.key ? 'border-rose-400 bg-rose-500/20 text-white' : 'border-slate-700 bg-slate-950/60 text-slate-300 hover:border-slate-500'"
										class="rounded-lg border px-2.5 py-1 text-[11px] font-semibold cursor-pointer transition"
										x-text="op.name"
									></button>
								</template>
							</div>
							<div class="flex flex-wrap items-center gap-3 mb-3 text-[11px] font-mono">
								<label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-200">
									<input type="checkbox" x-model="duelEnemyWeb" @change="runDuelSim()" class="accent-sky-400"/>
									<span>Enemy Web (-60% Speed)</span>
								</label>
								<label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-200">
									<input type="checkbox" x-model="duelEnemyScram" @change="runDuelSim()" class="accent-amber-400"/>
									<span>Enemy Scram</span>
								</label>
								<label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-200">
									<input type="checkbox" x-model="duelEnemyNeut" @change="runDuelSim()" class="accent-rose-400"/>
									<span>Energy Neutralizer</span>
								</label>
								<div class="flex items-center gap-2 ml-auto">
									<span class="text-slate-400">Range:</span>
									<input type="range" min="2" max="50" x-model.number="duelRangeKM" @change="runDuelSim()" class="w-24 accent-amber-400"/>
									<span class="text-amber-300 font-bold" x-text="duelRangeKM + ' km'"></span>
								</div>
							</div>

							<!-- Timeline Verdict & Interactive SVG Dual-Curve Chart -->
							<div x-show="duelResult" class="rounded-xl border border-slate-700/70 bg-slate-950/75 p-3">
								<div class="flex flex-wrap items-center justify-between gap-2 mb-2">
									<div class="flex items-center gap-2">
										<span
											:class="{
												'bg-emerald-500/20 text-emerald-200 border-emerald-400/50': duelResult && duelResult.verdict === 'VICTORY',
												'bg-rose-500/20 text-rose-200 border-rose-400/50': duelResult && duelResult.verdict === 'DEFEAT',
												'bg-amber-500/20 text-amber-200 border-amber-400/50': duelResult && duelResult.verdict === 'STALEMATE'
											}"
											class="rounded-md border px-2 py-0.5 text-xs font-mono font-extrabold"
											x-text="duelResult ? duelResult.verdict : ''"
										></span>
										<span class="text-xs text-slate-200" x-text="duelResult ? duelResult.verdict_detail : ''"></span>
									</div>
									<div class="flex items-center gap-3 text-[10.5px] font-mono">
										<span class="text-emerald-300">● Your HP</span>
										<span class="text-rose-300">● Enemy HP</span>
										<span class="text-amber-300">┄ Your Cap</span>
									</div>
								</div>

								<svg viewBox="0 0 560 170" class="w-full h-44" x-html="duelTimelineSVG()"></svg>

								<!-- Draggable Time Scrubber -->
								<div class="mt-2 flex items-center gap-3">
									<span class="text-[10.5px] font-mono text-slate-400">Scrub Time:</span>
									<input
										type="range"
										min="0"
										:max="Math.max(0, (duelResult && duelResult.points ? duelResult.points.length - 1 : 0))"
										x-model.number="duelScrubIdx"
										class="flex-1 accent-violet-400"
									/>
									<div x-show="duelScrubPoint()" class="flex items-center gap-2 text-[10.5px] font-mono">
										<span class="text-white font-bold" x-text="'t=' + (duelScrubPoint() ? duelScrubPoint().second : 0) + 's'"></span>
										<span class="text-emerald-300" x-text="'You ' + (duelScrubPoint() ? duelScrubPoint().pilot_hp_pct : 0) + '%'"></span>
										<span class="text-rose-300" x-text="'Enemy ' + (duelScrubPoint() ? duelScrubPoint().enemy_hp_pct : 0) + '%'"></span>
										<span class="text-amber-300" x-text="'Cap ' + (duelScrubPoint() ? duelScrubPoint().pilot_cap_pct : 0) + '%'"></span>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- MODE 3: PHASE 5 INTEL & AUTOPSY STUDIO (D-SCAN THREAT RADAR + COMBAT LOG POST-MORTEM) -->
					<div x-show="activeMode === 'intel'" class="grid grid-cols-1 gap-3 xl:grid-cols-2">
						<!-- D-Scan Instant Threat Analyzer -->
						<div class="tactical-panel flex flex-col rounded-2xl p-4">
							<div class="flex items-center justify-between mb-2">
								<div>
									<h2 class="text-sm font-bold text-white">D-Scan Instant Threat Radar</h2>
									<p class="text-[11px] text-slate-300">Paste from EVE Directional Scanner (Ctrl+A → Ctrl+C) — 0 ESI calls.</p>
								</div>
								<button type="button" @click="loadSampleDScan()" class="rounded-lg border border-slate-600 bg-slate-800/80 px-2.5 py-1 text-[10.5px] font-semibold text-slate-200 hover:bg-slate-700 cursor-pointer">Load Sample</button>
							</div>
							<textarea
								x-model="dscanInput"
								rows="5"
								placeholder="16240&#9;Pilot Ship&#9;Catalyst&#9;0.4 AU&#10;17918&#9;Combat Scanner Probe&#9;Combat Scanner Probe&#9;1,200 km"
								class="w-full rounded-xl border border-violet-400/30 bg-slate-950/80 p-2.5 font-mono text-[11px] text-slate-100 placeholder-slate-500 focus:border-rose-400 focus:outline-none"
							></textarea>
							<div class="mt-2 flex items-center justify-between">
								<span x-show="dscanError" class="text-xs text-rose-300" x-text="dscanError"></span>
								<button type="button" @click="runDScan()" :disabled="dscanRunning" class="ml-auto rounded-lg border border-rose-400/50 bg-rose-500/20 px-3.5 py-1.5 text-xs font-bold text-rose-100 hover:bg-rose-500/30 cursor-pointer transition">
									<span x-text="dscanRunning ? 'Scanning...' : 'Analyze D-Scan'"></span>
								</button>
							</div>

							<div x-show="dscanResult" class="mt-3 space-y-2.5">
								<div
									:class="{
										'border-rose-500/70 bg-rose-500/20 text-rose-100': dscanResult && (dscanResult.threat_level === 'GANK ALERT' || dscanResult.threat_level === 'GATECAMP DANGER'),
										'border-amber-400/60 bg-amber-500/15 text-amber-100': dscanResult && dscanResult.threat_level === 'CAUTION',
										'border-emerald-400/50 bg-emerald-500/15 text-emerald-100': dscanResult && dscanResult.threat_level === 'SAFE'
									}"
									class="rounded-xl border p-3"
								>
									<div class="flex items-center justify-between">
										<span class="text-xs font-mono font-extrabold uppercase tracking-wider" x-text="dscanResult ? dscanResult.threat_level : ''"></span>
										<span class="text-[11px] font-mono opacity-85" x-text="dscanResult ? (dscanResult.total_objects + ' contacts') : ''"></span>
									</div>
									<div class="mt-1 text-xs font-bold text-white" x-text="dscanResult ? dscanResult.headline : ''"></div>
									<div class="mt-0.5 text-[11px] opacity-90" x-text="dscanResult ? dscanResult.recommendation : ''"></div>
								</div>

								<div class="grid grid-cols-2 gap-2">
									<template x-for="r in (dscanResult && dscanResult.roles) || []" :key="r.role">
										<div class="rounded-xl border border-slate-700/70 bg-slate-950/70 p-2.5">
											<div class="flex items-center justify-between mb-1">
												<span class="text-[11px] font-bold text-white" x-text="r.role"></span>
												<span class="rounded bg-violet-500/25 px-1.5 py-0.5 text-[10px] font-mono font-bold text-violet-200" x-text="r.count"></span>
											</div>
											<div class="text-[10.5px] font-mono text-slate-300" x-text="(r.ships || []).join(', ')"></div>
										</div>
									</template>
								</div>
							</div>
						</div>

						<!-- Combat Log Post-Mortem Autopsy -->
						<div class="tactical-panel flex flex-col rounded-2xl p-4">
							<div class="flex items-center justify-between mb-2">
								<div>
									<h2 class="text-sm font-bold text-white">Combat Log Post-Mortem Autopsy</h2>
									<p class="text-[11px] text-slate-300">Paste EVE Online Gamelogs/*.txt — 100% deterministic Go parser (0 tokens).</p>
								</div>
								<button type="button" @click="loadSampleCombatLog()" class="rounded-lg border border-slate-600 bg-slate-800/80 px-2.5 py-1 text-[10.5px] font-semibold text-slate-200 hover:bg-slate-700 cursor-pointer">Load Sample</button>
							</div>
							<textarea
								x-model="combatLogInput"
								rows="5"
								placeholder="[ 2026.11.27 14:22:01 ] (combat) 340 from Sansha's Centurion - Penetrates"
								class="w-full rounded-xl border border-violet-400/30 bg-slate-950/80 p-2.5 font-mono text-[11px] text-slate-100 placeholder-slate-500 focus:border-sky-400 focus:outline-none"
							></textarea>
							<div class="mt-2 flex items-center justify-between">
								<span x-show="combatLogError" class="text-xs text-rose-300" x-text="combatLogError"></span>
								<button type="button" @click="runCombatLog()" :disabled="combatLogRunning" class="ml-auto rounded-lg border border-sky-400/50 bg-sky-500/20 px-3.5 py-1.5 text-xs font-bold text-sky-100 hover:bg-sky-500/30 cursor-pointer transition">
									<span x-text="combatLogRunning ? 'Parsing...' : 'Run Log Autopsy'"></span>
								</button>
							</div>

							<div x-show="combatLogResult" class="mt-3 space-y-2.5">
								<div class="grid grid-cols-2 gap-2 font-mono">
									<div class="rounded-xl border border-rose-400/35 bg-rose-500/15 p-2.5">
										<div class="text-[9.5px] uppercase text-rose-300">Incoming Damage</div>
										<div class="text-base font-extrabold text-white" x-text="combatLogResult ? formatNum(combatLogResult.incoming_damage) : '0'"></div>
										<div class="text-[10px] text-rose-200" x-text="combatLogResult ? ('~' + combatLogResult.estimated_in_dps + ' DPS') : ''"></div>
									</div>
									<div class="rounded-xl border border-emerald-400/35 bg-emerald-500/15 p-2.5">
										<div class="text-[9.5px] uppercase text-emerald-300">Outgoing Damage</div>
										<div class="text-base font-extrabold text-white" x-text="combatLogResult ? formatNum(combatLogResult.outgoing_damage) : '0'"></div>
										<div class="text-[10px] text-emerald-200" x-text="combatLogResult ? ('~' + combatLogResult.estimated_out_dps + ' DPS') : ''"></div>
									</div>
								</div>

								<!-- Hit Quality Distribution Spectrum -->
								<div class="rounded-xl border border-slate-700/70 bg-slate-950/70 p-2.5">
									<div class="text-[10px] font-mono uppercase text-slate-400 mb-1.5">Hit Quality Distribution</div>
									<div class="flex flex-wrap gap-1.5 text-[10.5px] font-mono">
										<template x-for="qk in ['Miss','Glances Off','Hits','Penetrates','Smashes','Wrecks']" :key="qk">
											<span x-show="combatLogResult && combatLogResult.hit_quality_counts && combatLogResult.hit_quality_counts[qk] > 0" class="rounded bg-slate-800 px-2 py-0.5 text-slate-200" x-text="qk + ': ' + (combatLogResult && combatLogResult.hit_quality_pct[qk]) + '%'"></span>
										</template>
									</div>
								</div>

								<!-- Top Threat Sources -->
								<div class="space-y-1.5">
									<template x-for="th in (combatLogResult && combatLogResult.top_threats) || []" :key="th.source_name">
										<div class="rounded-lg border border-slate-700/60 bg-slate-950/65 px-2.5 py-1.5">
											<div class="flex justify-between text-[11px]">
												<span class="font-bold text-white" x-text="th.source_name"></span>
												<span class="font-mono text-rose-300" x-text="formatNum(th.total_dmg) + ' dmg (' + th.share_pct + '%)'"></span>
											</div>
											<div class="mt-1 h-1 w-full rounded-full bg-slate-800 overflow-hidden">
												<div class="h-full bg-rose-400" :style="'width:' + Math.min(100, th.share_pct) + '%'"></div>
											</div>
										</div>
									</template>
								</div>

								<div class="rounded-xl border border-amber-400/35 bg-amber-500/10 p-2.5 text-[11px] text-amber-100" x-text="combatLogResult ? combatLogResult.key_takeaway : ''"></div>
							</div>
						</div>
					</div>

					<!-- MODE 4: VISUAL DOCTRINES GALLERY + SIDE-BY-SIDE FIT COMPARE + FLEET BUILDER -->
					<div x-show="activeMode === 'doctrines'" class="space-y-3">
						<!-- Side-by-Side Fit Comparison Matrix -->
						<div class="tactical-panel rounded-2xl p-4">
							<div class="flex flex-wrap items-center justify-between gap-2 mb-3">
								<div>
									<h2 class="text-sm font-bold text-white">Side-by-Side Fit Comparison</h2>
									<p class="text-[11px] text-slate-300">Compare any two Starter Doctrines or Saved Fittings concurrently.</p>
								</div>
								<button
									type="button"
									@click="runFitComparison()"
									:disabled="compareRunning"
									class="rounded-lg border border-sky-400/50 bg-sky-500/20 px-3 py-1.5 text-xs font-bold text-sky-100 hover:bg-sky-500/30 cursor-pointer transition disabled:opacity-50"
								>
									<span x-text="compareRunning ? 'Comparing...' : 'Compare Fits'"></span>
								</button>
							</div>
							<div class="grid grid-cols-1 gap-2 sm:grid-cols-2 mb-3">
								<select x-model="compareKeyA" class="rounded-xl border border-violet-400/35 bg-slate-950/80 px-3 py-2 text-xs font-semibold text-white focus:outline-none">
									<template x-for="opt in allDoctrineOptions()" :key="'ca-' + opt.id">
										<option :value="opt.id" x-text="opt.label"></option>
									</template>
								</select>
								<select x-model="compareKeyB" class="rounded-xl border border-amber-400/35 bg-slate-950/80 px-3 py-2 text-xs font-semibold text-white focus:outline-none">
									<template x-for="opt in allDoctrineOptions()" :key="'cb-' + opt.id">
										<option :value="opt.id" x-text="opt.label"></option>
									</template>
								</select>
							</div>

							<div x-show="compareResult" class="overflow-x-auto rounded-xl border border-slate-700/70 bg-slate-950/75">
								<table class="w-full text-xs font-mono">
									<thead class="border-b border-slate-700/70 text-[10.5px] uppercase text-slate-400">
										<tr>
											<th class="px-3 py-2 text-left">Metric</th>
											<th class="px-3 py-2 text-right text-violet-200" x-text="compareResult ? compareResult.fit_a.fit.name : ''"></th>
											<th class="px-3 py-2 text-right text-amber-200" x-text="compareResult ? compareResult.fit_b.fit.name : ''"></th>
										</tr>
									</thead>
									<tbody class="divide-y divide-slate-800/70">
										<tr>
											<td class="px-3 py-2 text-slate-300">Effective HP (EHP)</td>
											<td class="px-3 py-2 text-right" :class="compareResult && compareResult.fit_a.total_ehp >= compareResult.fit_b.total_ehp ? 'text-emerald-300 font-bold' : 'text-slate-200'" x-text="compareResult ? formatNum(compareResult.fit_a.total_ehp) : ''"></td>
											<td class="px-3 py-2 text-right" :class="compareResult && compareResult.fit_b.total_ehp > compareResult.fit_a.total_ehp ? 'text-emerald-300 font-bold' : 'text-slate-200'" x-text="compareResult ? formatNum(compareResult.fit_b.total_ehp) : ''"></td>
										</tr>
										<tr>
											<td class="px-3 py-2 text-slate-300">Sustained Tank (EHP/s)</td>
											<td class="px-3 py-2 text-right" :class="compareResult && compareResult.fit_a.sustained_tank_ehps >= compareResult.fit_b.sustained_tank_ehps ? 'text-emerald-300 font-bold' : 'text-slate-200'" x-text="compareResult ? (compareResult.fit_a.sustained_tank_ehps + ' EHP/s') : ''"></td>
											<td class="px-3 py-2 text-right" :class="compareResult && compareResult.fit_b.sustained_tank_ehps > compareResult.fit_a.sustained_tank_ehps ? 'text-emerald-300 font-bold' : 'text-slate-200'" x-text="compareResult ? (compareResult.fit_b.sustained_tank_ehps + ' EHP/s') : ''"></td>
										</tr>
										<tr>
											<td class="px-3 py-2 text-slate-300">Total Offense (DPS)</td>
											<td class="px-3 py-2 text-right" :class="compareResult && compareResult.fit_a.offense.total_dps >= compareResult.fit_b.offense.total_dps ? 'text-emerald-300 font-bold' : 'text-slate-200'" x-text="compareResult ? (compareResult.fit_a.offense.total_dps + ' DPS') : ''"></td>
											<td class="px-3 py-2 text-right" :class="compareResult && compareResult.fit_b.offense.total_dps > compareResult.fit_a.offense.total_dps ? 'text-emerald-300 font-bold' : 'text-slate-200'" x-text="compareResult ? (compareResult.fit_b.offense.total_dps + ' DPS') : ''"></td>
										</tr>
										<tr>
											<td class="px-3 py-2 text-slate-300">Align Time (Lower Wins)</td>
											<td class="px-3 py-2 text-right" :class="compareResult && compareResult.fit_a.navigation.align_time_seconds <= compareResult.fit_b.navigation.align_time_seconds ? 'text-emerald-300 font-bold' : 'text-slate-200'" x-text="compareResult ? (compareResult.fit_a.navigation.align_time_seconds + ' s') : ''"></td>
											<td class="px-3 py-2 text-right" :class="compareResult && compareResult.fit_b.navigation.align_time_seconds < compareResult.fit_a.navigation.align_time_seconds ? 'text-emerald-300 font-bold' : 'text-slate-200'" x-text="compareResult ? (compareResult.fit_b.navigation.align_time_seconds + ' s') : ''"></td>
										</tr>
										<tr>
											<td class="px-3 py-2 text-slate-300">Total Fit Cost (Lower Wins)</td>
											<td class="px-3 py-2 text-right" :class="compareResult && compareResult.fit_a.total_fit_cost_isk <= compareResult.fit_b.total_fit_cost_isk ? 'text-emerald-300 font-bold' : 'text-slate-200'" x-text="compareResult ? formatISK(compareResult.fit_a.total_fit_cost_isk) : ''"></td>
											<td class="px-3 py-2 text-right" :class="compareResult && compareResult.fit_b.total_fit_cost_isk < compareResult.fit_a.total_fit_cost_isk ? 'text-emerald-300 font-bold' : 'text-slate-200'" x-text="compareResult ? formatISK(compareResult.fit_b.total_fit_cost_isk) : ''"></td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>

						<!-- Starter & Personal Ship Doctrines Gallery -->
						<div class="tactical-panel rounded-2xl p-4">
							<h2 class="text-sm font-bold text-white mb-3">Starter Ship Doctrines</h2>
							<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
								<template x-for="pr in presets" :key="'doc-' + pr.key">
									<div class="flex items-center gap-3 rounded-2xl border border-violet-400/25 bg-slate-950/65 p-3 hover:border-amber-400/60 transition">
										<img :src="shipRenderURL(pr.ship_type_id)" class="h-20 w-20 rounded-xl object-cover border border-slate-700 shrink-0"/>
										<div class="min-w-0 flex-1">
											<div class="flex items-center gap-1.5">
												<span class="rounded bg-amber-500/20 px-1.5 py-0.5 text-[9.5px] font-mono font-bold text-amber-200 uppercase" x-text="pr.tag"></span>
												<span class="text-[10px] font-mono text-slate-400" x-text="pr.hull_class"></span>
											</div>
											<div class="mt-1 truncate text-sm font-bold text-white" x-text="pr.name"></div>
											<p class="mt-0.5 text-[11px] text-slate-300 line-clamp-2" x-text="pr.summary"></p>
											<button type="button" @click="loadPreset(pr)" class="mt-2 rounded-lg border border-amber-400/50 bg-amber-500/15 px-3 py-1 text-[11px] font-bold text-amber-200 hover:bg-amber-500/30 cursor-pointer transition">
												Load into Wheel
											</button>
										</div>
									</div>
								</template>
							</div>
						</div>
					</div>

					<!-- BOTTOM RIBBON: DRONE BAY + HULL BONUSES (TRAITS) + READINESS DIAGNOSTICS -->
					<div class="grid grid-cols-1 gap-3 xl:grid-cols-2">
						<!-- Drone Bay Tray -->
						<div class="tactical-panel rounded-2xl p-3">
							<div class="flex items-center justify-between mb-2">
								<div class="text-xs font-bold text-white uppercase tracking-wider">Drone Bay</div>
								<div class="text-[10.5px] font-mono text-sky-300" x-text="sim ? (sim.navigation.drone_bandwidth_used + '/' + sim.navigation.drone_bandwidth + ' Mbit/s • ' + sim.navigation.drone_bay_used_m3 + '/' + sim.navigation.drone_bay_m3 + ' m³') : '—'"></div>
							</div>
							<div class="flex flex-wrap gap-2">
								<template x-for="(dr, idx) in (fit.drones || [])" :key="dr.type_id + '-' + idx">
									<div :class="dr.active ? 'border-emerald-400/55 bg-emerald-500/15' : 'border-slate-700 bg-slate-950/60 opacity-65'" class="flex items-center gap-2 rounded-xl border px-2.5 py-1.5 text-xs">
										<img :src="itemIconURL(dr.type_id)" class="h-6 w-6 rounded"/>
										<div>
											<div class="font-semibold text-white leading-tight" x-text="dr.name + ' ×' + dr.quantity"></div>
											<button type="button" @click="toggleDrone(idx)" class="text-[10px] font-mono text-emerald-300 hover:underline cursor-pointer" x-text="dr.active ? 'Active in Space' : 'In Bay (Click to Launch)'"></button>
										</div>
										<button type="button" @click="removeDrone(idx)" class="ml-1 text-slate-400 hover:text-rose-300 cursor-pointer">×</button>
									</div>
								</template>
								<button
									type="button"
									@click="leftTab = 'modules'; activeSlotFilter = 'drone'; fetchModules()"
									class="rounded-xl border border-dashed border-slate-600 px-3 py-2 text-[11px] font-semibold text-slate-300 hover:border-amber-400/60 hover:text-amber-200 cursor-pointer transition"
								>
									+ Add Drones
								</button>
							</div>
						</div>

						<!-- Beginner Readiness Diagnostics, Embedded AI Strategist & Hull Traits -->
						<div class="tactical-panel rounded-2xl p-3">
							<div class="flex flex-wrap items-center justify-between gap-2 mb-2">
								<div class="text-xs font-bold text-white uppercase tracking-wider">Tactical Strategist</div>
								<div class="flex items-center gap-2">
									<button
										type="button"
										@click="runAIAudit()"
										:disabled="aiAuditing"
										class="rounded-lg border border-violet-400/60 bg-violet-600/30 px-2.5 py-0.5 text-[10.5px] font-bold text-violet-100 hover:bg-violet-500/40 cursor-pointer transition disabled:opacity-50"
									>
										<span x-text="aiAuditing ? 'Auditing...' : '⚡ AI Audit & Swaps'"></span>
									</button>
									<button
										type="button"
										x-show="sim && sim.traits"
										@click="traitsExpanded = !traitsExpanded"
										class="text-[10.5px] font-mono text-amber-300 hover:underline cursor-pointer"
										x-text="traitsExpanded ? 'Hide Traits' : 'Hull Traits'"
									></button>
								</div>
							</div>

							<!-- Skill Prerequisite Gap Alert (Live SSO or Selected Skill Profile) -->
							<div x-show="sim && sim.missing_skills && sim.missing_skills.length > 0 && !traitsExpanded" class="mb-2 rounded-xl border border-rose-400/45 bg-rose-500/15 px-3 py-2 text-[11px]">
								<div class="flex items-center justify-between gap-2 mb-1">
									<span class="font-bold text-rose-200" x-text="'Skill Prerequisites Missing (' + (sim && sim.missing_skills ? sim.missing_skills.length : 0) + ')'"></span>
									<button type="button" @click="runFlyToday()" class="rounded border border-amber-400/50 bg-amber-500/20 px-2 py-0.5 text-[10px] font-bold text-amber-100 hover:bg-amber-500/30 cursor-pointer">
										Adapt to Fly Today
									</button>
								</div>
								<div class="flex flex-wrap gap-1 font-mono text-[10px]">
									<template x-for="(sk, idx) in (sim && sim.missing_skills || []).slice(0, 6)" :key="'sk-' + idx">
										<span class="rounded bg-slate-950/75 px-1.5 py-0.5 text-rose-100" x-text="sk.skill_name + ' Lv ' + sk.required_level + ' (You: ' + sk.pilot_level + ')'"></span>
									</template>
								</div>
							</div>

							<!-- Embedded AI Audit Result Card (Structured JSON + 1-Click Module Swaps) -->
							<div x-show="aiAudit && !traitsExpanded" class="mb-2.5 space-y-2 rounded-xl border border-violet-400/40 bg-violet-950/35 p-2.5">
								<div class="flex items-center justify-between">
									<span class="text-xs font-bold text-white" x-text="aiAudit ? aiAudit.summary : ''"></span>
									<span class="shrink-0 ml-2 rounded bg-violet-500/30 px-1.5 py-0.5 text-[9.5px] font-mono uppercase text-violet-200" x-text="aiAudit ? aiAudit.source : ''"></span>
								</div>
								<!-- 1-Click Recommended Module Swaps -->
								<template x-for="(sw, idx) in (aiAudit && aiAudit.recommended_swaps) || []" :key="'sw-' + idx">
									<div class="flex items-center justify-between gap-2 rounded-lg border border-amber-400/35 bg-slate-950/75 px-2.5 py-1.5">
										<div class="min-w-0">
											<div class="flex items-center gap-1.5 text-[11px]">
												<span class="font-bold text-amber-200" x-text="sw.suggested_module"></span>
												<span class="rounded bg-emerald-500/20 px-1.5 py-0.5 text-[9.5px] font-mono text-emerald-200" x-text="sw.impact_badge"></span>
											</div>
											<div class="text-[10.5px] text-slate-300" x-text="sw.reason"></div>
										</div>
										<button
											type="button"
											@click="applyAISwap(sw)"
											class="shrink-0 rounded-lg border border-emerald-400/50 bg-emerald-500/20 px-2.5 py-1 text-[10.5px] font-bold text-emerald-100 hover:bg-emerald-500/35 cursor-pointer transition"
										>
											Apply Swap
										</button>
									</div>
								</template>
								<!-- Compact 4-Step Playbook -->
								<div x-show="aiAudit && aiAudit.playbook" class="grid grid-cols-1 gap-1 sm:grid-cols-2 text-[10.5px] pt-1">
									<div class="rounded bg-slate-950/55 px-2 py-1"><strong class="text-sky-300">Pre-Warp:</strong> <span class="text-slate-200" x-text="aiAudit && aiAudit.playbook.pre_warp"></span></div>
									<div class="rounded bg-slate-950/55 px-2 py-1"><strong class="text-emerald-300">Position:</strong> <span class="text-slate-200" x-text="aiAudit && aiAudit.playbook.positioning"></span></div>
									<div class="rounded bg-slate-950/55 px-2 py-1"><strong class="text-amber-300">Priority:</strong> <span class="text-slate-200" x-text="aiAudit && aiAudit.playbook.threat_priority"></span></div>
									<div class="rounded bg-slate-950/55 px-2 py-1"><strong class="text-rose-300">Disengage:</strong> <span class="text-slate-200" x-text="aiAudit && aiAudit.playbook.disengage_trigger"></span></div>
								</div>
							</div>

							<div class="space-y-1.5" x-show="!traitsExpanded && !aiAudit">
								<template x-for="(f, i) in (sim && sim.findings) || []" :key="'find-' + i">
									<div
										:class="{
											'border-rose-500/50 bg-rose-500/15 text-rose-100': f.severity === 'critical',
											'border-amber-400/45 bg-amber-500/15 text-amber-100': f.severity === 'warn',
											'border-emerald-400/45 bg-emerald-500/15 text-emerald-100': f.severity === 'ok'
										}"
										class="rounded-xl border px-3 py-1.5"
									>
										<div class="text-xs font-bold" x-text="f.title"></div>
										<div class="text-[11px] opacity-85" x-text="f.detail"></div>
									</div>
								</template>
							</div>
							<!-- Official SDE Ship Hull Bonuses -->
							<div x-show="traitsExpanded && sim && sim.traits" class="space-y-2 text-[11px] max-h-40 overflow-y-auto pr-1">
								<template x-for="sg in (sim && sim.traits && sim.traits.skill_bonuses) || []" :key="sg.skill_name">
									<div>
										<div class="font-bold text-amber-300" x-text="sg.skill_name + ' bonuses (per skill level):'"></div>
										<template x-for="b in sg.bonuses" :key="b.text">
											<div class="text-slate-200 pl-2">• <strong class="text-white" x-text="b.prefix"></strong> <span x-text="b.text"></span></div>
										</template>
									</div>
								</template>
								<template x-if="sim && sim.traits && sim.traits.role_bonuses && sim.traits.role_bonuses.length > 0">
									<div>
										<div class="font-bold text-sky-300">Role Bonuses:</div>
										<template x-for="rb in sim.traits.role_bonuses" :key="rb.text">
											<div class="text-slate-200 pl-2">• <strong class="text-white" x-text="rb.prefix"></strong> <span x-text="rb.text"></span></div>
										</template>
									</div>
								</template>
							</div>
						</div>
					</div>
				</section>

				<!-- =========================================================
				     RIGHT WING: VISUAL TELEMETRY HUD (ZERO WALL OF TEXT)
				     ========================================================= -->
				<aside class="flex flex-col gap-3">
					<!-- 1. CAPACITOR CORE RING + OFFENSE POWER SPECTRUM -->
					<div class="tactical-panel rounded-2xl p-3.5">
						<div class="tac-cap-grid">
							<!-- Circular Capacitor SVG Gauge -->
							<div class="relative flex h-24 w-24 items-center justify-center">
								<svg viewBox="0 0 100 100" class="h-full w-full -rotate-90">
									<circle cx="50" cy="50" r="40" fill="none" stroke="rgba(148,163,184,0.16)" stroke-width="9"></circle>
									<circle
										cx="50" cy="50" r="40" fill="none"
										:stroke="sim && sim.capacitor && sim.capacitor.stable ? '#34d399' : '#f59e0b'"
										stroke-width="9"
										stroke-linecap="round"
										stroke-dasharray="251.2"
										:stroke-dashoffset="251.2 - (251.2 * (sim && sim.capacitor ? (sim.capacitor.stable ? sim.capacitor.stable_percent : 35) : 0) / 100)"
										class="transition-all duration-500"
									></circle>
								</svg>
								<div class="absolute inset-0 flex flex-col items-center justify-center text-center">
									<div class="text-[9px] font-mono uppercase text-slate-400">Capacitor</div>
									<div class="text-xs font-mono font-extrabold" :class="sim && sim.capacitor && sim.capacitor.stable ? 'text-emerald-300' : 'text-amber-300'" x-text="sim ? sim.capacitor.formatted_time : '—'"></div>
								</div>
							</div>

							<!-- Offense DPS & Volley -->
							<div>
								<div class="flex items-baseline justify-between">
									<span class="text-[10px] font-mono uppercase tracking-wider text-slate-400">Total Offense</span>
									<span class="text-[10.5px] font-mono text-amber-300" x-text="sim ? ('Volley ' + formatNum(sim.offense.alpha_volley)) : ''"></span>
								</div>
								<div class="text-2xl font-mono font-extrabold text-white leading-tight">
									<span x-text="sim ? formatNum(sim.offense.total_dps, 1) : '0.0'"></span>
									<span class="text-xs font-semibold text-amber-300 ml-1">DPS</span>
								</div>
								<div class="mt-1 flex flex-wrap gap-1 text-[10px] font-mono">
									<span class="rounded bg-slate-900/80 px-1.5 py-0.5 text-sky-300" x-text="'Turret ' + (sim ? sim.offense.turret_dps : 0)"></span>
									<span class="rounded bg-slate-900/80 px-1.5 py-0.5 text-amber-300" x-text="'Missile ' + (sim ? sim.offense.missile_dps : 0)"></span>
									<span class="rounded bg-slate-900/80 px-1.5 py-0.5 text-emerald-300" x-text="'Drone ' + (sim ? sim.offense.drone_dps : 0)"></span>
								</div>
								<!-- 4-Color Damage Type Spectrum Bar -->
								<div class="mt-2 flex h-2 w-full overflow-hidden rounded-full bg-slate-900" title="Damage Mix: EM / Thermal / Kinetic / Explosive">
									<div class="bg-cyan-400 transition-all" :style="'width:' + ((sim && sim.offense.damage_mix.em) || 25) + '%'"></div>
									<div class="bg-rose-400 transition-all" :style="'width:' + ((sim && sim.offense.damage_mix.thermal) || 25) + '%'"></div>
									<div class="bg-sky-400 transition-all" :style="'width:' + ((sim && sim.offense.damage_mix.kinetic) || 25) + '%'"></div>
									<div class="bg-amber-400 transition-all" :style="'width:' + ((sim && sim.offense.damage_mix.explosive) || 25) + '%'"></div>
								</div>
							</div>
						</div>
					</div>

					<!-- 2. DEFENSE EHP & 3x4 RESISTANCE HEATMAP -->
					<div class="tactical-panel rounded-2xl p-3.5">
						<div class="flex items-baseline justify-between mb-2">
							<div>
								<div class="text-[10px] font-mono uppercase tracking-wider text-slate-400">Effective Hit Points</div>
								<div class="text-xl font-mono font-extrabold text-white">
									<span x-text="sim ? formatNum(sim.total_ehp) : '0'"></span>
									<span class="text-xs font-semibold text-sky-300 ml-1">EHP</span>
								</div>
							</div>
							<div class="text-right">
								<div class="text-[10px] font-mono uppercase text-slate-400">Sustained Tank</div>
								<div class="text-sm font-mono font-bold text-emerald-300" x-text="sim ? (formatNum(sim.sustained_tank_ehps, 1) + ' EHP/s') : '—'"></div>
							</div>
						</div>

						<!-- 3x4 Resistance Visual Heatmap Matrix -->
						<div class="tac-resist-grid text-center text-[10px] font-mono mt-2">
							<div></div>
							<div class="font-bold text-cyan-300">EM</div>
							<div class="font-bold text-rose-300">THERM</div>
							<div class="font-bold text-sky-300">KIN</div>
							<div class="font-bold text-amber-300">EXP</div>

							<!-- Shield Row -->
							<div class="flex items-center text-left text-[10px] font-bold text-sky-300">Shield</div>
							<template x-for="rk in ['em','thermal','kinetic','explosive']" :key="'sh-' + rk">
								<div
									:class="(sim && sim.shield.resists[rk] < 25 && sim.target_faction.incoming_damage[rk] >= 0.25) ? 'border-rose-400 bg-rose-500/35 text-white animate-pulse' : 'border-sky-400/25 bg-sky-500/15 text-sky-100'"
									class="rounded-md border py-1 font-bold"
									x-text="sim ? (Math.round(sim.shield.resists[rk]) + '%') : '0%'"
								></div>
							</template>

							<!-- Armor Row -->
							<div class="flex items-center text-left text-[10px] font-bold text-amber-300">Armor</div>
							<template x-for="rk in ['em','thermal','kinetic','explosive']" :key="'ar-' + rk">
								<div
									:class="(sim && sim.armor.resists[rk] < 25 && sim.target_faction.incoming_damage[rk] >= 0.25) ? 'border-rose-400 bg-rose-500/35 text-white animate-pulse' : 'border-amber-400/25 bg-amber-500/15 text-amber-100'"
									class="rounded-md border py-1 font-bold"
									x-text="sim ? (Math.round(sim.armor.resists[rk]) + '%') : '0%'"
								></div>
							</template>

							<!-- Structure Row -->
							<div class="flex items-center text-left text-[10px] font-bold text-slate-300">Hull</div>
							<template x-for="rk in ['em','thermal','kinetic','explosive']" :key="'st-' + rk">
								<div class="rounded-md border border-slate-600/40 bg-slate-800/60 py-1 text-slate-200" x-text="sim ? (Math.round(sim.structure.resists[rk]) + '%') : '33%'"></div>
							</template>
						</div>
					</div>

					<!-- 3. PvE PIRATE FACTION TARGET MATRIX -->
					<div class="tactical-panel rounded-2xl p-3.5">
						<div class="flex items-center justify-between mb-2">
							<div class="text-[10.5px] font-mono font-bold uppercase tracking-wider text-amber-300">PvE Target Profile</div>
							<span class="text-[10px] font-mono text-slate-400" x-text="sim ? ('Benchmark ' + sim.target_faction.benchmark_dps + ' DPS') : ''"></span>
						</div>
						<div class="grid grid-cols-3 gap-1.5">
							<template x-for="fac in factions" :key="fac.key">
								<button
									type="button"
									@click="setTargetFaction(fac.key)"
									:class="fit.target_preset === fac.key ? 'border-amber-400 bg-amber-500/20 text-white shadow-[0_0_10px_rgba(251,191,36,0.22)]' : 'border-slate-700/70 bg-slate-950/55 text-slate-300 hover:border-slate-500'"
									class="rounded-xl border px-2 py-1.5 text-[11px] font-bold transition cursor-pointer"
									x-text="fac.short_label"
								></button>
							</template>
						</div>
						<div x-show="sim && sim.target_faction" class="mt-2.5 rounded-xl border border-violet-400/25 bg-slate-950/60 p-2 text-[10.5px]">
							<div class="flex items-center justify-between text-slate-200">
								<span>Weak to: <strong class="text-emerald-300" x-text="(sim && sim.target_faction.weak_against || []).join(' / ')"></strong></span>
							</div>
							<div class="mt-0.5 text-amber-200/90" x-show="sim && sim.target_faction.ewar_warning" x-text="'EWAR: ' + (sim && sim.target_faction.ewar_warning)"></div>
						</div>
					</div>

					<!-- 4. NAVIGATION & AGILITY DIAL -->
					<div class="tactical-panel rounded-2xl p-3.5">
						<div class="flex items-center justify-between mb-2">
							<div class="text-[10.5px] font-mono font-bold uppercase tracking-wider text-sky-300">Navigation &amp; Agility</div>
							<span
								x-show="sim"
								:class="{
									'bg-emerald-500/20 text-emerald-200 border-emerald-400/40': sim && (sim.navigation.align_rating === 'INSTA-WARP' || sim.navigation.align_rating === 'AGILE'),
									'bg-sky-500/20 text-sky-200 border-sky-400/40': sim && sim.navigation.align_rating === 'STANDARD',
									'bg-amber-500/20 text-amber-200 border-amber-400/40': sim && sim.navigation.align_rating === 'HEAVY'
								}"
								class="rounded border px-1.5 py-0.5 text-[9.5px] font-mono font-bold"
								x-text="sim ? sim.navigation.align_rating : ''"
							></span>
						</div>
						<div class="grid grid-cols-2 gap-2 text-xs font-mono">
							<div class="rounded-xl border border-slate-700/60 bg-slate-950/60 p-2">
								<div class="text-[9.5px] text-slate-400 uppercase">Max Velocity</div>
								<div class="font-bold text-white" x-text="sim ? (formatNum(sim.navigation.max_velocity_ms) + ' m/s') : '—'"></div>
							</div>
							<div class="rounded-xl border border-slate-700/60 bg-slate-950/60 p-2">
								<div class="text-[9.5px] text-slate-400 uppercase">Align Time</div>
								<div class="font-bold text-white" x-text="sim ? (sim.navigation.align_time_seconds.toFixed(2) + ' s') : '—'"></div>
							</div>
							<div class="rounded-xl border border-slate-700/60 bg-slate-950/60 p-2">
								<div class="text-[9.5px] text-slate-400 uppercase">Warp Speed</div>
								<div class="font-bold text-white" x-text="sim ? (sim.navigation.warp_speed_aus.toFixed(2) + ' AU/s') : '—'"></div>
							</div>
							<div class="rounded-xl border border-slate-700/60 bg-slate-950/60 p-2">
								<div class="text-[9.5px] text-slate-400 uppercase">Signature / Cargo</div>
								<div class="font-bold text-white" x-text="sim ? (sim.navigation.signature_radius_m + 'm • ' + formatNum(sim.navigation.cargo_capacity_m3) + ' m³') : '—'"></div>
							</div>
						</div>
					</div>

					<!-- 5. COMBAT ROI & PAYBACK BRIDGE (CONNECTED TO AURA FORGE 100B+ ISK MISSION) -->
					<div class="tactical-panel rounded-2xl p-3.5">
						<div class="flex items-center justify-between mb-2">
							<div class="text-[10.5px] font-mono font-bold uppercase tracking-wider text-amber-300">Combat ROI &amp; Payback</div>
							<span
								:class="{
									'bg-emerald-500/20 text-emerald-200 border-emerald-400/40': roiMetrics().risk === 'SAFE',
									'bg-amber-500/20 text-amber-200 border-amber-400/40': roiMetrics().risk === 'MODERATE',
									'bg-rose-500/20 text-rose-200 border-rose-400/40': roiMetrics().risk === 'HIGH EXPOSURE'
								}"
								class="rounded border px-1.5 py-0.5 text-[9.5px] font-mono font-bold"
								x-text="roiMetrics().risk"
							></span>
						</div>
						<select x-model="roiActivityKey" class="mb-2 w-full rounded-lg border border-slate-700 bg-slate-950/80 px-2.5 py-1.5 text-[11px] font-semibold text-slate-200 focus:outline-none">
							<template x-for="act in roiActivities" :key="act.key">
								<option :value="act.key" x-text="act.label + ' (~' + formatISK(act.iskPerHour) + '/hr)'"></option>
							</template>
						</select>
						<div class="flex items-baseline justify-between font-mono text-xs">
							<span class="text-slate-300">Est. Payback Time</span>
							<span class="text-base font-extrabold text-amber-200" x-text="roiMetrics().paybackHours + ' hrs'"></span>
						</div>
						<div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-slate-800">
							<div
								class="h-full rounded-full transition-all duration-300"
								:class="roiMetrics().risk === 'SAFE' ? 'bg-emerald-400' : (roiMetrics().risk === 'MODERATE' ? 'bg-amber-400' : 'bg-rose-500')"
								:style="'width:' + roiMetrics().barPct + '%'"
							></div>
						</div>
						<div class="mt-2.5 grid grid-cols-2 gap-1.5">
							<a
								:href="'/marketplace?q=' + encodeURIComponent(fit.ship_name || '')"
								class="inline-flex items-center justify-center rounded-lg border border-sky-400/40 bg-sky-500/15 px-2 py-1.5 text-[10.5px] font-bold text-sky-200 hover:bg-sky-500/25 transition"
							>
								Buy Hull →
							</a>
							<a
								:href="'/manufacture?q=' + encodeURIComponent(fit.ship_name || '')"
								class="inline-flex items-center justify-center rounded-lg border border-amber-400/40 bg-amber-500/15 px-2 py-1.5 text-[10.5px] font-bold text-amber-200 hover:bg-amber-500/25 transition"
							>
								Craft Hull →
							</a>
						</div>
					</div>
				</aside>
			</main>

			<!-- =============================================================
			     IMPORT EFT MODAL
			     ============================================================= -->
			<div
				x-show="eftModalOpen"
				x-transition.opacity
				@keydown.escape.window="eftModalOpen = false"
				class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm"
			>
				<div @click.away="eftModalOpen = false" class="tactical-panel w-full max-w-xl rounded-2xl p-5 shadow-2xl">
					<div class="flex items-center justify-between mb-3">
						<div>
							<h3 class="text-sm font-bold text-white">Import EVE Fitting Tool (EFT)</h3>
							<p class="text-[11px] text-slate-300">Paste directly from EVE Online Fitting Window, Pyfa, or zKillboard.</p>
						</div>
						<button type="button" @click="eftModalOpen = false" class="rounded-lg p-1 text-slate-400 hover:bg-slate-800 hover:text-white cursor-pointer">✕</button>
					</div>
					<textarea
						x-model="eftInputText"
						rows="10"
						placeholder="[Caracal, L2 Mission Fit]&#10;&#10;Ballistic Control System II&#10;Damage Control II&#10;&#10;Large Shield Extender II&#10;10MN Afterburner II&#10;&#10;Rapid Light Missile Launcher II, Scourge Light Missile"
						class="w-full rounded-xl border border-violet-400/35 bg-slate-950/85 p-3 font-mono text-xs text-slate-100 placeholder-slate-500 focus:border-amber-400 focus:outline-none"
					></textarea>
					<div x-show="eftError" class="mt-2 rounded-lg border border-rose-500/50 bg-rose-500/15 px-3 py-1.5 text-xs text-rose-200" x-text="eftError"></div>
					<div class="mt-4 flex justify-end gap-2">
						<button type="button" @click="eftModalOpen = false" class="rounded-lg border border-slate-600 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:bg-slate-800 cursor-pointer">Cancel</button>
						<button
							type="button"
							@click="importEFT()"
							:disabled="eftImporting"
							class="rounded-lg border border-amber-400/60 bg-amber-500/25 px-4 py-1.5 text-xs font-bold text-amber-100 hover:bg-amber-500/35 cursor-pointer disabled:opacity-50"
						>
							<span x-text="eftImporting ? 'Hydrating Dogma & Prices...' : 'Import & Mount on Wheel'"></span>
						</button>
					</div>
				</div>
			</div>
		</div>
	}
}

package web

import (
	"encoding/json"
	"fmt"
	"strings"
	"time"

	"aura-forge/internal/domain"
	"aura-forge/internal/i18n"
	"aura-forge/internal/service"
)

func piCatalogJSON(items []domain.PICommodity) string {
	type lite struct {
		ID   int32  `json:"id"`
		Name string `json:"name"`
		Tier string `json:"tier"`
	}
	out := make([]lite, 0, len(items))
	for _, it := range items {
		out = append(out, lite{
			ID:   it.TypeID,
			Name: it.Name,
			Tier: string(it.Tier),
		})
	}
	b, err := json.Marshal(out)
	if err != nil {
		return "[]"
	}
	return string(b)
}

func piTierBadgeClass(t domain.PITier) string {
	switch t {
	case domain.PITierP4:
		return "border-amber-400/50 bg-amber-500/20 text-amber-200"
	case domain.PITierP3:
		return "border-violet-400/50 bg-violet-500/25 text-violet-200"
	case domain.PITierP2:
		return "border-sky-400/45 bg-sky-500/20 text-sky-200"
	case domain.PITierP1:
		return "border-emerald-400/45 bg-emerald-500/20 text-emerald-200"
	default:
		return "border-slate-500/40 bg-slate-700/30 text-slate-200"
	}
}

func planetBadgeClass(planet string) string {
	switch planet {
	case "Barren":
		return "border-amber-500/40 bg-amber-900/30 text-amber-200"
	case "Temperate":
		return "border-emerald-500/40 bg-emerald-900/30 text-emerald-200"
	case "Lava":
		return "border-rose-500/45 bg-rose-900/35 text-rose-200"
	case "Plasma":
		return "border-fuchsia-500/45 bg-fuchsia-900/30 text-fuchsia-200"
	case "Gas":
		return "border-yellow-500/40 bg-yellow-900/30 text-yellow-200"
	case "Oceanic":
		return "border-sky-500/45 bg-sky-900/35 text-sky-200"
	case "Storm":
		return "border-indigo-400/45 bg-indigo-900/35 text-indigo-200"
	case "Ice":
		return "border-cyan-400/45 bg-cyan-900/35 text-cyan-200"
	default:
		return "border-slate-500/40 bg-slate-800 text-slate-200"
	}
}

func colonyStatusClass(status string) string {
	switch status {
	case "ACTIVE":
		return "border-emerald-400/45 bg-emerald-500/20 text-emerald-200"
	case "EXPIRING":
		return "border-amber-400/45 bg-amber-500/20 text-amber-200"
	default:
		return "border-rose-400/45 bg-rose-500/20 text-rose-200"
	}
}

templ PIPage(mode service.ModeInfo, items []domain.PICommodity, selectedTree *domain.PIRecipeAnalysis, colonies []domain.PIColony) {
	@Layout("Planetary Industry (PI) Hub", "pi", mode) {
		<div
			class="space-y-6"
			x-data={ fmt.Sprintf(`{
				tab: 'explorer',
				treeViewMode: 'details',
				flowDir: 'output-to-raw',
				tierFilter: 'ALL',
				planetFilter: 'ALL',
				searchQ: '',
				pocoTax: 5.0,
				priceHub: 'jita',
				selectedID: %d,
				showAddColony: false,
				piItems: %s,
				salesRows: [{ uid: 1, typeId: '9832', qty: 1000, open: false, q: '' }],
				salesNextUID: 2,
				showSalesPaste: false,
				getPIItem(tid) {
					const n = Number(tid);
					return this.piItems.find(it => it.id === n) || { id: n, name: 'Select PI Item', tier: 'P2' };
				},
				filterPIItems(q) {
					const s = (q || '').trim().toLowerCase();
					if (!s) return this.piItems;
					return this.piItems.filter(it => it.name.toLowerCase().includes(s) || it.tier.toLowerCase().includes(s));
				},
				piTierColor(t) {
					if (t === 'P4') return 'border-amber-400/50 bg-amber-500/20 text-amber-200';
					if (t === 'P3') return 'border-violet-400/50 bg-violet-500/25 text-violet-200';
					if (t === 'P2') return 'border-sky-400/45 bg-sky-500/20 text-sky-200';
					return 'border-emerald-400/45 bg-emerald-500/20 text-emerald-200';
				},
				addSalesRow(tid) {
					this.salesRows.push({ uid: this.salesNextUID++, typeId: String(tid || '9832'), qty: 1000, open: false, q: '' });
				},
				removeSalesRow(uid) {
					if (this.salesRows.length <= 1) return;
					this.salesRows = this.salesRows.filter(r => r.uid !== uid);
				},
				openSalesWithItem(tid) {
					this.tab = 'sales';
					const strID = String(tid);
					const existing = this.salesRows.find(r => String(r.typeId) === strID);
					if (!existing) {
						if (this.salesRows.length === 1 && this.salesRows[0].qty === 1000) {
							this.salesRows[0].typeId = strID;
						} else {
							this.addSalesRow(strID);
						}
					}
				},
				matchesItem(tier, name) {
					if (this.tierFilter !== 'ALL' && tier !== this.tierFilter) return false;
					if (!this.searchQ.trim()) return true;
					return name.toLowerCase().includes(this.searchQ.trim().toLowerCase());
				},
				openTree(id) {
					this.selectedID = id;
					this.tab = 'explorer';
					htmx.ajax('GET', '/pi/tree?type_id=' + id + '&poco_tax=' + this.pocoTax + '&hub=' + this.priceHub, { target: '#pi-tree-panel', swap: 'innerHTML', indicator: '#pi-tree-spinner' });
				},
				refreshSelectedTree() {
					if (this.selectedID > 0) {
						this.openTree(this.selectedID);
					}
				}
			}`, func() int32 {
				if selectedTree != nil {
					return selectedTree.Commodity.TypeID
				}
				return 0
			}(), piCatalogJSON(items)) }
		>
			<!-- Header & Right-Aligned Tab Switcher -->
			<div class="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
				<div class="min-w-0">
					<h1 class="text-2xl font-bold tracking-tight text-white">Planetary Industry (PI) Hub</h1>
					<p class="text-xs text-slate-300/80 mt-0.5">{ i18n.L(ctx, "Browse all 68 P1–P4 PI items, explore the 8-planet resource catalog, inspect recursive recipe trees, scan live hub margins, and track colony timers.", "Jelajahi 68 item P1–P4 PI, katalog sumber daya 8 planet, pohon resep rekursif, scan margin hub live, dan pantau timer koloni.") }</p>
				</div>

				<div class="ml-auto self-end xl:self-auto shrink-0 inline-flex flex-wrap justify-end rounded-xl border border-violet-400/35 bg-slate-950/65 p-1 backdrop-blur">
					<button
						type="button"
						@click="tab = 'explorer'"
						:class="tab === 'explorer' ? 'bg-amber-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						P1–P4 Recipe Tree
					</button>
					<button
						type="button"
						@click="tab = 'planets'"
						:class="tab === 'planets' ? 'bg-violet-500 text-white shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						Planet Catalog (8)
					</button>
					<button
						type="button"
						@click="tab = 'scanner'"
						:class="tab === 'scanner' ? 'bg-sky-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						PI Profit Scanner
					</button>
					<button
						type="button"
						@click="tab = 'sales'"
						:class="tab === 'sales' ? 'bg-emerald-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
						class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
					>
						PI Sales Calculator
					</button>
					if mode.IsAdmin() {
						<button
							type="button"
							@click="tab = 'colonies'"
							:class="tab === 'colonies' ? 'bg-amber-400 text-slate-950 shadow-sm' : 'text-slate-300 hover:text-white'"
							class="rounded-lg px-3.5 py-1.5 text-xs font-bold tracking-wide transition cursor-pointer"
						>
							My Colonies ({ fmt.Sprintf("%d", len(colonies)) })
						</button>
					}
				</div>
			</div>

			<!-- TAB 1: P1–P4 EXPLORER & RECURSIVE RECIPE TREE -->
			<div x-show="tab === 'explorer'" class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-start">
				<!-- Left Column: Search + P1–P4 Tier Filter + Item Selector -->
				<div class="tactical-panel rounded-xl p-4 lg:col-span-4 space-y-3">
					<div class="flex items-center justify-between gap-2">
						<h2 class="text-xs font-bold uppercase tracking-wider text-amber-300">PI Catalog (P1 – P4)</h2>
						<div class="flex items-center gap-1.5 text-[10px] font-mono text-slate-300">
							<span>POCO:</span>
							<select x-model="pocoTax" @change="refreshSelectedTree()" class="rounded border border-slate-700 bg-slate-900 px-1.5 py-0.5 text-[10px] text-white">
								<option value="0">0%</option>
								<option value="2">2%</option>
								<option value="5">5%</option>
								<option value="10">10%</option>
							</select>
						</div>
					</div>

					<!-- Price Hub Selector (Jita, Amarr, Dodixie, Rens, Hek) -->
					<div class="flex items-center justify-between gap-2 rounded-lg border border-violet-400/20 bg-slate-950/50 px-2.5 py-1.5">
						<span class="text-[10px] font-mono uppercase text-slate-300">Price Hub</span>
						<select x-model="priceHub" @change="refreshSelectedTree()" class="rounded border border-slate-700 bg-slate-900 px-2 py-0.5 text-[11px] font-semibold text-amber-200">
							for _, h := range domain.MajorTradeHubs {
								<option value={ h.Key }>{ h.Name } ({ h.RegionName })</option>
							}
						</select>
					</div>

					<!-- Search Input -->
					<input
						type="text"
						x-model="searchQ"
						placeholder="Search PI item (e.g. Robotics, Coolant, Water)..."
						class="w-full rounded-lg border border-slate-700 bg-slate-900/90 px-3 py-2 text-xs text-white placeholder-slate-500 focus:border-amber-300/70 focus:outline-none"
					/>

					<!-- Tier Filter Pills (P1, P2, P3, P4) -->
					<div class="grid grid-cols-5 gap-1">
						<button type="button" @click="tierFilter = 'ALL'" :class="tierFilter === 'ALL' ? 'bg-violet-600 text-white border-violet-400' : 'bg-slate-900/60 text-slate-300 border-slate-700'" class="rounded-md border py-1 font-mono text-[10px] font-bold transition cursor-pointer">ALL</button>
						<button type="button" @click="tierFilter = 'P1'" :class="tierFilter === 'P1' ? 'bg-emerald-500 text-slate-950 border-emerald-400' : 'bg-slate-900/60 text-emerald-200 border-slate-700'" class="rounded-md border py-1 font-mono text-[10px] font-bold transition cursor-pointer">P1</button>
						<button type="button" @click="tierFilter = 'P2'" :class="tierFilter === 'P2' ? 'bg-sky-500 text-slate-950 border-sky-400' : 'bg-slate-900/60 text-sky-200 border-slate-700'" class="rounded-md border py-1 font-mono text-[10px] font-bold transition cursor-pointer">P2</button>
						<button type="button" @click="tierFilter = 'P3'" :class="tierFilter === 'P3' ? 'bg-violet-500 text-white border-violet-300' : 'bg-slate-900/60 text-violet-200 border-slate-700'" class="rounded-md border py-1 font-mono text-[10px] font-bold transition cursor-pointer">P3</button>
						<button type="button" @click="tierFilter = 'P4'" :class="tierFilter === 'P4' ? 'bg-amber-400 text-slate-950 border-amber-300' : 'bg-slate-900/60 text-amber-200 border-slate-700'" class="rounded-md border py-1 font-mono text-[10px] font-bold transition cursor-pointer">P4</button>
					</div>

					<!-- Scrollable PI Items List -->
					<div class="max-h-[540px] overflow-y-auto space-y-1 pr-1">
						for _, item := range items {
							<button
								type="button"
								x-show={ fmt.Sprintf("matchesItem(%q, %q)", string(item.Tier), item.Name) }
								@click={ fmt.Sprintf("openTree(%d)", item.TypeID) }
								:class={ fmt.Sprintf("selectedID === %d ? 'border-amber-300/60 bg-amber-400/15 text-white' : 'border-violet-400/15 bg-slate-950/40 text-slate-200 hover:bg-white/10'", item.TypeID) }
								class="w-full flex items-center justify-between gap-2 rounded-lg border px-2.5 py-1.5 text-left text-xs transition cursor-pointer"
							>
								<div class="flex items-center gap-2 min-w-0">
									<img src={ EVEItemIconURL(item.TypeID, 32) } alt={ item.Name } loading="lazy" class="h-6 w-6 shrink-0 rounded border border-violet-400/25 bg-slate-950/80 object-contain" onerror="this.style.display='none'"/>
									<span class="font-medium truncate">{ item.Name }</span>
								</div>
								<span class={ "shrink-0 rounded border px-1.5 py-0.5 font-mono text-[9px] font-bold " + piTierBadgeClass(item.Tier) }>
									{ string(item.Tier) }
								</span>
							</button>
						}
					</div>
				</div>

				<!-- Right Column: Recursive PI Recipe Tree + Source Planets + Live Economics (Top-Aligned with Left Card) -->
				<div class="lg:col-span-8 relative">
					<div id="pi-tree-spinner" class="htmx-indicator pointer-events-none absolute inset-x-0 top-0 z-20 rounded-xl border border-amber-400/50 bg-slate-950/90 backdrop-blur px-4 py-3 text-center text-xs font-mono text-amber-200 shadow-lg">
						Loading live hub prices &amp; recursive PI recipe tree...
					</div>
					<div id="pi-tree-panel">
						@PITreePartial(selectedTree, "")
					</div>
				</div>
			</div>

			<!-- TAB 2: PLANET CATALOG (8 COLONIZABLE PLANETS + LARGE RESOURCE ICONS) -->
			<div x-cloak x-show="tab === 'planets'" class="space-y-5">
				{{ planetCatalog := domain.BuildPlanetCatalog() }}
				<div class="tactical-panel rounded-xl p-4 flex flex-wrap items-center justify-between gap-3">
					<div>
						<h2 class="text-sm font-bold uppercase tracking-wider text-violet-200">New Eden Planet &amp; Resource Catalog</h2>
						<p class="text-xs text-slate-300/80 mt-0.5">Each planet yields 5 Raw P0 resources (→ 5 Basic P1) and supports self-contained Single-Planet P2 factories. Click any P1 or P2 icon to open its live Recipe Tree.</p>
					</div>
					<div class="flex flex-wrap gap-1.5">
						<button type="button" @click="planetFilter = 'ALL'" :class="planetFilter === 'ALL' ? 'bg-violet-600 text-white border-violet-400' : 'bg-slate-900/60 text-slate-300 border-slate-700'" class="rounded-lg border px-2.5 py-1 font-mono text-[10px] font-bold cursor-pointer">ALL (8)</button>
						for _, pl := range planetCatalog {
							<button type="button" @click={ fmt.Sprintf("planetFilter = %q", pl.PlanetType) } :class={ fmt.Sprintf("planetFilter === %q ? 'bg-amber-400 text-slate-950 border-amber-300' : 'bg-slate-900/60 text-slate-300 border-slate-700 hover:text-white'", pl.PlanetType) } class="rounded-lg border px-2.5 py-1 font-mono text-[10px] font-bold cursor-pointer">
								{ pl.PlanetType }
							</button>
						}
					</div>
				</div>

				<div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
					for _, pl := range planetCatalog {
						<div
							x-show={ fmt.Sprintf("planetFilter === 'ALL' || planetFilter === %q", pl.PlanetType) }
							class="tactical-panel rounded-xl p-5 space-y-4"
						>
							<!-- Planet Header with Large 64x64 Official EVE Planet Icon -->
							<div class="flex items-start gap-4 border-b border-violet-400/20 pb-4">
								<img
									src={ EVEItemIconURL(pl.PlanetTypeID, 128) }
									alt={ pl.PlanetType + " Planet" }
									loading="lazy"
									class="h-16 w-16 shrink-0 rounded-xl border border-amber-300/45 bg-slate-950/90 p-1 shadow-[0_0_20px_rgba(139,92,246,0.3)] object-cover"
									onerror="this.style.display='none'"
								/>
								<div class="space-y-1">
									<div class="flex items-center gap-2">
										<h3 class="text-lg font-bold text-white">{ pl.PlanetType } Planet</h3>
										<span class={ "rounded-md border px-2 py-0.5 font-mono text-[10px] font-bold " + planetBadgeClass(pl.PlanetType) }>
											5 P0 / 5 P1
										</span>
									</div>
									<p class="text-xs text-slate-300/85 leading-relaxed">{ pl.Description }</p>
								</div>
							</div>

							<!-- 5 Raw P0 -> P1 Resource Tiles with Large 40x40 Icons -->
							<div class="space-y-2">
								<div class="text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-300">Raw Resources (P0) → Basic Products (P1)</div>
								<div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
									for i, p0 := range pl.P0Resources {
										{{ p1 := pl.P1Products[i] }}
										<button
											type="button"
											@click={ fmt.Sprintf("openTree(%d)", p1.TypeID) }
											class="flex items-center gap-3 rounded-lg border border-violet-400/20 bg-slate-950/50 p-2.5 text-left hover:border-amber-300/50 hover:bg-white/5 transition cursor-pointer"
										>
											<img
												src={ EVEItemIconURL(p0.TypeID, 64) }
												alt={ p0.Name }
												loading="lazy"
												class="h-10 w-10 shrink-0 rounded-lg border border-slate-700 bg-slate-900 p-0.5 object-contain"
												onerror="this.style.display='none'"
											/>
											<div class="min-w-0 flex-1">
												<div class="text-xs font-bold text-white truncate">{ p0.Name }</div>
												<div class="mt-0.5 flex items-center gap-1.5 text-[11px] text-emerald-300">
													<span class="text-slate-500">→</span>
													<img
														src={ EVEItemIconURL(p1.TypeID, 32) }
														alt={ p1.Name }
														loading="lazy"
														class="h-5 w-5 shrink-0 rounded border border-emerald-400/30 bg-slate-950 object-contain"
														onerror="this.style.display='none'"
													/>
													<span class="font-medium truncate">{ p1.Name }</span>
												</div>
											</div>
										</button>
									}
								</div>
							</div>

							<!-- Single-Planet P2 Products (100% Self-Contained on 1 Planet!) -->
							<div class="space-y-2 pt-2 border-t border-violet-400/15">
								<div class="text-[10px] font-mono font-bold uppercase tracking-wider text-sky-300">
									Single-Planet P2 Factories ({ fmt.Sprintf("%d", len(pl.SinglePlanetP2)) } Self-Contained Options)
								</div>
								<div class="flex flex-wrap gap-2">
									for _, p2 := range pl.SinglePlanetP2 {
										<button
											type="button"
											@click={ fmt.Sprintf("openTree(%d)", p2.TypeID) }
											class="inline-flex items-center gap-2 rounded-lg border border-sky-400/30 bg-sky-500/10 px-2.5 py-1.5 text-xs font-semibold text-sky-100 hover:border-amber-300/60 hover:bg-amber-400/15 hover:text-amber-100 transition cursor-pointer"
										>
											<img
												src={ EVEItemIconURL(p2.TypeID, 64) }
												alt={ p2.Name }
												loading="lazy"
												class="h-9 w-9 shrink-0 rounded-md border border-sky-400/35 bg-slate-950/90 object-contain"
												onerror="this.style.display='none'"
											/>
											<span>{ p2.Name }</span>
										</button>
									}
								</div>
							</div>
						</div>
					}
				</div>
			</div>

			<!-- TAB 3: PI PROFIT SCANNER (BY TIER P1–P4) -->
			<div x-cloak x-show="tab === 'scanner'" class="space-y-5">
				<div class="tactical-panel rounded-xl p-5 space-y-4">
					<div>
						<h2 class="text-sm font-bold uppercase tracking-wider text-sky-300">PI Tier Profit Scanner (Live Jita Public ESI)</h2>
						<p class="text-xs text-slate-300/80 mt-0.5">Compare every PI commodity in P1, P2, P3, or P4 against live Jita Sell prices after POCO import/export taxes.</p>
					</div>

					<form
						hx-post="/pi/scan"
						hx-target="#pi-scan-results"
						hx-swap="innerHTML"
						hx-indicator="#pi-scan-spinner"
						class="flex flex-wrap items-end gap-3"
					>
						<div class="w-44">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">PI Tier</label>
							<select name="tier" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white">
								<option value="P1">P1 — Basic (15 items)</option>
								<option value="P2" selected>P2 — Refined (24 items)</option>
								<option value="P3">P3 — Specialized (21 items)</option>
								<option value="P4">P4 — Advanced (8 items)</option>
							</select>
						</div>
						<div class="w-48">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Price Hub</label>
							<select name="hub" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white">
								for _, h := range domain.MajorTradeHubs {
									<option value={ h.Key }>{ h.Name } ({ h.RegionName })</option>
								}
							</select>
						</div>
						<div class="w-32">
							<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">POCO Tax (%)</label>
							<input type="number" step="0.5" name="poco_tax" value="5.0" min="0" max="30" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-mono text-white"/>
						</div>
						<button
							type="submit"
							class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-5 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-sky-300 transition cursor-pointer"
						>
							<span id="pi-scan-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
							<span>Scan PI Tier (Live ESI)</span>
						</button>
					</form>
				</div>

				<div id="pi-scan-results">
					<div class="tactical-panel rounded-xl p-8 text-center text-xs text-slate-300/80">
						Choose a PI Tier (P1–P4) and click <strong>Scan PI Tier</strong> to rank the highest-profit PI commodities at your selected Trade Hub.
					</div>
				</div>
			</div>

			<!-- TAB: PI SALES PROFIT CALCULATOR (MULTI-ITEM + HANGAR PASTE) -->
			<div x-cloak x-show="tab === 'sales'" class="space-y-5">
				<div class="tactical-panel relative z-30 rounded-xl p-5 space-y-4">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<div>
							<h2 class="text-sm font-bold uppercase tracking-wider text-emerald-300">PI Sales Profit Calculator (Multi-Item &amp; Epithal Load)</h2>
							<p class="text-xs text-slate-300/80 mt-0.5">Simulate selling any custom quantity of 1 or multiple P1–P4 PI items using live 5-Hub ESI prices, POCO tax, market fees, and Epithal cargo volume.</p>
						</div>
						<button
							type="button"
							@click="showSalesPaste = !showSalesPaste"
							class="rounded-lg border border-sky-400/40 bg-sky-500/15 px-3 py-1.5 text-xs font-semibold text-sky-200 hover:bg-sky-500/25 transition cursor-pointer"
						>
							<span x-show="!showSalesPaste">Paste from EVE Hangar / Epithal</span>
							<span x-show="showSalesPaste">Hide Hangar Paste</span>
						</button>
					</div>

					<form
						hx-post="/pi/sales-calc"
						hx-target="#pi-sales-results"
						hx-swap="innerHTML"
						hx-indicator="#pi-sales-spinner"
						class="space-y-4"
					>
						<!-- Top Options Row -->
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
							<div>
								<label class="block text-[10px] font-mono uppercase text-sky-300 mb-1">Trade Hub</label>
								<select name="hub" x-model="priceHub" class="w-full rounded-lg border border-sky-500/40 bg-slate-900 px-3 py-2 text-xs text-white">
									for _, h := range domain.MajorTradeHubs {
										<option value={ h.Key }>{ h.Name } ({ h.RegionName })</option>
									}
								</select>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Cost Basis</label>
								<select name="cost_mode" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white">
									<option value="self_extracted">Self-Extracted (Planet Harvest — 0 Input Cost)</option>
									<option value="buy_inputs">Factory (Buy Direct Inputs + POCO Import)</option>
								</select>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Sell Execution</label>
								<select name="sell_mode" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white">
									<option value="sell_order">Sell Order (Lowest Sell − Broker + Sales Tax)</option>
									<option value="instant_buy">Instant Sell (Highest Buy − Sales Tax Only)</option>
								</select>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">POCO Tax (%)</label>
								<select name="poco_tax" x-model="pocoTax" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-mono text-white">
									<option value="0">0% (Corp / Zero Tax)</option>
									<option value="2">2%</option>
									<option value="5">5% (Standard Low-Tax)</option>
									<option value="10">10% (NPC / High-Sec)</option>
								</select>
							</div>
						</div>

						<!-- Optional EVE Hangar / Epithal Paste Box -->
						<div x-cloak x-show="showSalesPaste" x-transition class="rounded-lg border border-sky-500/30 bg-slate-950/60 p-3.5 space-y-2">
							<label class="block text-[10px] font-mono uppercase text-sky-300">
								Paste EVE Inventory / Epithal Cargo (Ctrl+A → Ctrl+C from EVE Hangar)
							</label>
							<textarea
								name="paste_text"
								rows="4"
								placeholder="Coolant&#9;2500&#10;Mechanical Parts&#9;1800&#10;Enriched Uranium&#9;1200"
								class="w-full rounded-lg border border-slate-700 bg-slate-900 p-2.5 font-mono text-xs text-emerald-200 placeholder-slate-500 focus:border-sky-400 focus:outline-none"
							></textarea>
							<p class="text-[11px] text-slate-400">Any recognized P1–P4 PI items pasted here are automatically merged with the rows below.</p>
						</div>

						<!-- Multi-Item Row Builder -->
						<div class="space-y-2">
							<div class="flex items-center justify-between">
								<span class="text-[10px] font-mono uppercase tracking-wider text-slate-400">PI Items to Sell</span>
								<button
									type="button"
									@click="addSalesRow('9832')"
									class="rounded-md border border-emerald-400/40 bg-emerald-500/15 px-2.5 py-1 text-[11px] font-bold text-emerald-200 hover:bg-emerald-500/25 transition cursor-pointer"
								>
									+ Add PI Item
								</button>
							</div>

							<template x-for="row in salesRows" :key="row.uid">
								<div class="grid grid-cols-12 gap-2 items-center">
									<div class="col-span-7 sm:col-span-8 relative" @click.outside="row.open = false" @keydown.escape.window="row.open = false">
										<input type="hidden" name="type_id" :value="row.typeId"/>
										<button
											type="button"
											@click="row.open = !row.open; if (row.open) $nextTick(() => $el.parentElement.querySelector('input[type=search]')?.focus())"
											class="flex w-full items-center justify-between gap-2 rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-left text-xs text-white hover:border-sky-400/60 focus:border-sky-400 focus:outline-none transition cursor-pointer"
										>
											<div class="flex items-center gap-2 min-w-0">
												<img
													:src="'https://images.evetech.net/types/' + row.typeId + '/icon?size=32'"
													:alt="getPIItem(row.typeId).name"
													class="h-6 w-6 shrink-0 rounded border border-slate-700/80 bg-slate-950 object-contain"
													onerror="this.style.display='none'"
												/>
												<span
													class="shrink-0 rounded border px-1.5 py-0.5 font-mono text-[9px] font-bold"
													:class="piTierColor(getPIItem(row.typeId).tier)"
													x-text="getPIItem(row.typeId).tier"
												></span>
												<span class="font-medium text-white truncate" x-text="getPIItem(row.typeId).name"></span>
											</div>
											<svg class="h-4 w-4 shrink-0 text-slate-400 transition-transform" :class="row.open ? 'rotate-180' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
											</svg>
										</button>

										<!-- Searchable Dropdown Menu with Official EVE Icons -->
										<div
											x-cloak
											x-show="row.open"
											x-transition.opacity.duration.120ms
											class="absolute left-0 right-0 top-full mt-1 z-50 rounded-xl border border-violet-400/40 bg-slate-950/95 shadow-2xl backdrop-blur-xl overflow-hidden"
										>
											<div class="p-2 border-b border-slate-800/90 bg-slate-900/90">
												<input
													type="search"
													x-model="row.q"
													placeholder="Search PI item or tier (e.g. Coolant, P2, Robotics)..."
													class="w-full rounded-lg border border-slate-700 bg-slate-950 px-2.5 py-1.5 text-xs text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
												/>
											</div>
											<div class="max-h-60 overflow-y-auto divide-y divide-slate-800/60">
												<template x-for="opt in filterPIItems(row.q)" :key="opt.id">
													<button
														type="button"
														@click="row.typeId = String(opt.id); row.open = false; row.q = ''"
														:class="String(opt.id) === String(row.typeId) ? 'bg-sky-500/20 text-white' : 'text-slate-200 hover:bg-white/5'"
														class="flex w-full items-center justify-between gap-2 px-2.5 py-2 text-left text-xs transition cursor-pointer"
													>
														<div class="flex items-center gap-2.5 min-w-0">
															<img
																:src="'https://images.evetech.net/types/' + opt.id + '/icon?size=32'"
																:alt="opt.name"
																loading="lazy"
																class="h-6 w-6 shrink-0 rounded border border-violet-400/25 bg-slate-950 object-contain"
																onerror="this.style.display='none'"
															/>
															<span class="font-medium truncate" x-text="opt.name"></span>
														</div>
														<span
															class="shrink-0 rounded border px-1.5 py-0.5 font-mono text-[9px] font-bold"
															:class="piTierColor(opt.tier)"
															x-text="opt.tier"
														></span>
													</button>
												</template>
												<div x-show="filterPIItems(row.q).length === 0" class="px-3 py-4 text-center text-xs text-slate-400">
													No matching PI items found.
												</div>
											</div>
										</div>
									</div>
									<div class="col-span-4 sm:col-span-3">
										<input
											type="number"
											name="quantity"
											x-model.number="row.qty"
											min="1"
											step="1"
											placeholder="Quantity"
											class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-mono text-white"
										/>
									</div>
									<div class="col-span-1 flex justify-end">
										<button
											type="button"
											@click="removeSalesRow(row.uid)"
											:disabled="salesRows.length <= 1"
											:class="salesRows.length <= 1 ? 'opacity-35 cursor-not-allowed' : 'hover:bg-rose-500/25 cursor-pointer'"
											class="rounded-lg border border-rose-400/35 bg-rose-500/10 px-2.5 py-2 text-xs font-bold text-rose-200 transition"
											title="Remove row"
										>
											✕
										</button>
									</div>
								</div>
							</template>
						</div>

						<div class="flex flex-wrap items-center justify-end gap-3 pt-2 border-t border-slate-800/80">
							<button
								type="submit"
								class="inline-flex items-center gap-2 rounded-lg bg-emerald-400 px-5 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-emerald-300 transition cursor-pointer"
							>
								<span id="pi-sales-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
								<span>Calculate Live Sales Profit</span>
							</button>
						</div>
					</form>
				</div>

				<div id="pi-sales-results">
					<div class="tactical-panel rounded-xl p-8 text-center text-xs text-slate-300/80">
						Add 1 or more PI items with your unit quantities (or paste directly from your EVE Hangar / Epithal) and click <strong>Calculate Live Sales Profit</strong>.
					</div>
				</div>
			</div>

			<!-- TAB 3: MY PI COLONIES & EXTRACTOR TIMERS (EVE SSO AUTO-SYNC) -->
			<div x-cloak x-show="tab === 'colonies'" class="space-y-5">
				if !mode.SSOConnected {
					<div class="tactical-panel rounded-xl border border-amber-400/35 p-8 text-center space-y-4">
						<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl border border-amber-400/45 bg-amber-500/15 text-amber-200">
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
							</svg>
						</div>
						<div class="space-y-1.5 max-w-lg mx-auto">
							<h2 class="text-base font-bold text-white">
								{ i18n.L(ctx, "EVE Online SSO Sign-In Required", "Wajib Login EVE Online SSO") }
							</h2>
							<p class="text-xs text-slate-300/85 leading-relaxed">
								{ i18n.L(ctx, "Connect your EVE Online character via EVE SSO to automatically view your PI planets, solar system locations, active P0–P4 production, launchpad contents, and extractor expiry timers.", "Hubungkan karakter EVE Online Anda melalui EVE SSO untuk otomatis melihat daftar planet PI, lokasi sistem, produksi P0–P4 aktif, isi launchpad, dan timer habis extractor.") }
							</p>
						</div>
						<div class="flex flex-wrap items-center justify-center gap-3 pt-1">
							if mode.SSOEnabled {
								<a
									href="/auth/login"
									hx-boost="false"
									class="inline-flex items-center gap-2 rounded-lg bg-emerald-400 px-4 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-emerald-300 transition"
								>
									<span>{ i18n.L(ctx, "Connect EVE Online SSO →", "Hubungkan EVE Online SSO →") }</span>
								</a>
							} else {
								<a
									href="/settings"
									class="inline-flex items-center gap-2 rounded-lg border border-amber-400/45 bg-amber-500/15 px-4 py-2 text-xs font-bold text-amber-200 hover:bg-amber-500/25 transition"
								>
									<span>{ i18n.L(ctx, "Configure EVE SSO in Settings →", "Atur EVE SSO di Settings →") }</span>
								</a>
							}
						</div>
					</div>
				} else {
					<div class="flex flex-wrap items-center justify-between gap-3">
						<div>
							<h2 class="text-sm font-bold uppercase tracking-wider text-emerald-300">
								{ i18n.L(ctx, "Active PI Colonies & Live Production", "Koloni PI Aktif & Produksi Live") } ({ mode.CharacterName })
							</h2>
							<p class="text-xs text-slate-300/80 mt-0.5">
								{ i18n.L(ctx, "Synced directly from EVE Online ESI (planet location, security status, active P0–P4 factories, launchpad contents, and extractor expiry).", "Disinkronkan langsung dari EVE Online ESI (lokasi planet, status keamanan, pabrik P0–P4 aktif, isi launchpad, dan waktu habis extractor).") }
							</p>
						</div>
						<button
							type="button"
							hx-post="/pi/sync"
							hx-swap="none"
							hx-indicator="#pi-sync-spinner"
							class="inline-flex items-center gap-2 rounded-lg bg-emerald-400 px-3.5 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-emerald-300 transition cursor-pointer"
						>
							<span id="pi-sync-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
							<span>{ i18n.L(ctx, "Sync PI Colonies (EVE SSO)", "Sinkron Koloni PI (EVE SSO)") }</span>
						</button>
					</div>

					<div class="tactical-panel rounded-xl overflow-hidden">
						if len(colonies) == 0 {
							<div class="p-8 text-center space-y-2 text-xs text-slate-300/80">
								<div class="font-semibold text-white">
									{ i18n.L(ctx, "No PI colonies synced yet.", "Belum ada koloni PI yang tersinkron.") }
								</div>
								<p class="text-slate-400 max-w-md mx-auto">
									{ i18n.L(ctx, "Click Sync PI Colonies (EVE SSO) above to fetch your live planets. If you connected SSO earlier, reconnect once in Settings after enabling esi-planets.manage_planets.v1.", "Klik Sinkron Koloni PI (EVE SSO) di atas untuk mengambil data planet live Anda. Jika sudah pernah login SSO sebelumnya, hubungkan ulang sekali di Settings setelah mengaktifkan scope esi-planets.manage_planets.v1.") }
								</p>
							</div>
						} else {
							{{ now := time.Now() }}
							<div class="overflow-x-auto">
								<table class="w-full text-left text-xs">
									<thead class="bg-slate-950/50 font-mono uppercase text-[10px] text-slate-400 border-b border-violet-400/15">
										<tr>
											<th class="px-4 py-3">{ i18n.L(ctx, "Planet / Location", "Planet / Lokasi") }</th>
											<th class="px-3 py-3">{ i18n.L(ctx, "Type & Command Center", "Tipe & Command Center") }</th>
											<th class="px-3 py-3">{ i18n.L(ctx, "Active Production", "Produksi Aktif") }</th>
											<th class="px-3 py-3">{ i18n.L(ctx, "Launchpad / Storage", "Isi Launchpad / Gudang") }</th>
											<th class="px-4 py-3 text-right">{ i18n.L(ctx, "Extractor Status", "Status Extractor") }</th>
										</tr>
									</thead>
									<tbody class="divide-y divide-violet-400/15">
										for _, c := range colonies {
											{{ st, rem := c.StatusLabel(now) }}
											<tr class="hover:bg-white/5 align-top">
												<td class="px-4 py-3">
													<div class="font-semibold text-white">{ c.PlanetName }</div>
													<div class="font-mono text-[10.5px] text-slate-400">
														{ c.SolarSystem }
														if c.SyncedFromSSO {
															<span class={ "ml-1.5 font-bold " + func() string {
																if c.SecurityStatus >= 0.5 {
																	return "text-emerald-300"
																}
																if c.SecurityStatus > 0.0 {
																	return "text-amber-300"
																}
																return "text-rose-300"
															}() }>
																({ fmt.Sprintf("%.1f", c.SecurityStatus) })
															</span>
														}
													</div>
												</td>
												<td class="px-3 py-3">
													<span class={ "inline-block rounded border px-2 py-0.5 font-mono text-[10px] " + planetBadgeClass(c.PlanetType) }>{ c.PlanetType }</span>
													if c.NumPins > 0 || c.UpgradeLevel > 0 {
														<div class="mt-1 font-mono text-[10px] text-slate-400">
															{ fmt.Sprintf("CC Lv %d • %d pins", c.UpgradeLevel, c.NumPins) }
														</div>
													}
												</td>
												<td class="px-3 py-3">
													<div class="flex items-center gap-2">
														if c.ProductTypeID > 0 {
															<img src={ EVEItemIconURL(c.ProductTypeID, 32) } alt={ c.ProductName } loading="lazy" class="h-6 w-6 shrink-0 rounded border border-violet-400/25 bg-slate-950/80 object-contain" onerror="this.style.display='none'"/>
														}
														<span class="font-medium text-white">{ c.ProductName }</span>
														if c.Tier != "" {
															<span class={ "rounded border px-1.5 py-0.5 font-mono text-[9px] font-bold " + piTierBadgeClass(c.Tier) }>{ string(c.Tier) }</span>
														}
													</div>
													if c.Note != "" {
														<div class="mt-1 text-[10.5px] text-slate-400">{ c.Note }</div>
													}
												</td>
												<td class="px-3 py-3 font-mono text-[11px] text-sky-200/90 max-w-xs">
													if c.StorageSummary != "" {
														{ c.StorageSummary }
													} else {
														<span class="text-slate-500">—</span>
													}
												</td>
												<td class="px-4 py-3 text-right font-mono whitespace-nowrap">
													<div>
														<span class={ "inline-block rounded border px-2 py-0.5 text-[10px] font-bold " + colonyStatusClass(st) }>{ st }</span>
														<span class="ml-1.5 text-[11px] text-slate-200">{ rem }</span>
													</div>
													<div class="mt-1 text-[10px] text-slate-400">
														{ FormatTimeCtx(ctx, c.ExtractorExpiresAt, "02 Jan 15:04") }
													</div>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</div>
				}
			</div>
		</div>
	}
}

templ PITreePartial(tree *domain.PIRecipeAnalysis, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl p-5 border-rose-400/40 text-xs text-rose-200">{ errMsg }</div>
	} else if tree == nil {
		<div class="tactical-panel rounded-xl p-10 text-center space-y-2">
			<div class="text-sm font-semibold text-white">Select any P1, P2, P3, or P4 item from the left catalog</div>
			<p class="text-xs text-slate-300/80 max-w-md mx-auto">
				Click an item (for example <strong>Robotics</strong>, <strong>Coolant</strong>, or <strong>Wetware Mainframe</strong>) to reveal its complete recursive recipe tree, exact source planet types, and live Jita factory profit.
			</p>
		</div>
	} else {
		{{ canvas := BuildPIHorizontalCanvasLayout(tree.RootNode) }}
		<div class="space-y-4" x-data="{ copied: false }">
			<!-- Selected Item Banner, View Mode Switcher & Required Source Planets -->
			<div class="tactical-panel rounded-xl p-5 space-y-3">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div class="flex items-center gap-3 min-w-0">
						<img src={ EVEItemIconURL(tree.Commodity.TypeID, 64) } alt={ tree.Commodity.Name } class="h-11 w-11 shrink-0 rounded-lg border border-amber-300/45 bg-slate-950/80 p-0.5 shadow-[0_0_16px_rgba(251,191,36,0.2)] object-contain" onerror="this.style.display='none'"/>
						<div class="flex flex-wrap items-center gap-2 min-w-0">
							<h2 class="text-xl font-bold text-white truncate">{ tree.Commodity.Name }</h2>
							<span class={ "rounded border px-2 py-0.5 font-mono text-[10px] font-bold " + piTierBadgeClass(tree.Commodity.Tier) }>
								{ string(tree.Commodity.Tier) }
							</span>
							<span class="font-mono text-[11px] text-slate-400">
								{ fmt.Sprintf("%d units / %dm cycle", tree.Commodity.OutputQty, tree.Commodity.CycleMinutes) }
							</span>
						</div>
					</div>
					<div class="flex flex-wrap items-center gap-2 ml-auto">
						<!-- View Mode Toggle: Details & Economics vs Recipe-Only Horizontal Canvas -->
						<div class="inline-flex rounded-lg border border-violet-400/35 bg-slate-950/75 p-0.5">
							<button
								type="button"
								@click="treeViewMode = 'details'"
								:class="treeViewMode === 'details' ? 'bg-violet-500 text-white shadow-xs' : 'text-slate-300 hover:text-white'"
								class="rounded-md px-2.5 py-1 text-[11px] font-semibold transition cursor-pointer"
							>
								Details &amp; Economics
							</button>
							<button
								type="button"
								@click="treeViewMode = 'canvas'"
								:class="treeViewMode === 'canvas' ? 'bg-amber-400 text-slate-950 shadow-xs' : 'text-slate-300 hover:text-white'"
								class="inline-flex items-center gap-1 rounded-md px-2.5 py-1 text-[11px] font-semibold transition cursor-pointer"
							>
								<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h4v4H4V6zm12-2h4v4h-4V4zm0 12h4v4h-4v-4zM8 8h4m0 0V6h4m-4 2v10h4"></path>
								</svg>
								<span>Tree Canvas</span>
							</button>
						</div>

						<button
							type="button"
							@click={ fmt.Sprintf("openSalesWithItem(%d)", tree.Commodity.TypeID) }
							class="rounded-lg border border-emerald-400/40 bg-emerald-500/15 px-2.5 py-1 text-[11px] font-semibold text-emerald-200 hover:bg-emerald-500/25 transition cursor-pointer"
						>
							+ Simulate Sales
						</button>

						if tree.MultibuyText != "" {
							<button
								type="button"
								x-show="treeViewMode === 'details'"
								@click="navigator.clipboard.writeText($refs.piMultibuy.value); copied = true; setTimeout(() => copied = false, 2000)"
								class="rounded-md border border-amber-400/45 bg-amber-500/15 px-3 py-1 text-[11px] font-mono font-semibold text-amber-200 hover:bg-amber-500/25 cursor-pointer"
							>
								<span x-show="!copied">Copy Direct Inputs (Multibuy)</span>
								<span x-cloak x-show="copied">Copied!</span>
							</button>
							<textarea x-ref="piMultibuy" class="hidden" readonly>{ tree.MultibuyText }</textarea>
						}
					</div>
				</div>

				<!-- Consolidated Source Planets Required -->
				<div x-show="treeViewMode === 'details'" class="pt-2 border-t border-violet-400/15">
					<div class="text-[10px] font-mono uppercase tracking-wider text-slate-400 mb-1.5">
						Source Planets Yielding Raw Materials ({ fmt.Sprintf("%d planet types available", len(tree.RequiredPlanets)) })
					</div>
					<div class="flex flex-wrap gap-1.5">
						for _, pl := range tree.RequiredPlanets {
							<span class={ "rounded-md border px-2.5 py-0.5 font-mono text-[11px] font-semibold " + planetBadgeClass(pl) }>
								{ pl }
							</span>
						}
					</div>
				</div>
			</div>

			<!-- MODE A: RECIPE-ONLY INTERACTIVE HORIZONTAL TREE CANVAS (PAN, ZOOM, FLIP DIRECTION & BRANCH HIGHLIGHT) -->
			<div
				x-cloak
				x-show="treeViewMode === 'canvas'"
				x-data={ fmt.Sprintf(`{
					scale: 1,
					tx: 20,
					ty: 20,
					dragging: false,
					moved: false,
					downX: 0,
					downY: 0,
					startX: 0,
					startY: 0,
					fullscreen: false,
					cw: %d,
					ch: %d,
					focusedNodeID: '',
					focusedTypeID: 0,
					focusedName: '',
					focusedCanOpen: false,
					branchMap: %s,
					init() {
						this.$watch('treeViewMode', (v) => {
							if (v === 'canvas') {
								this.$nextTick(() => this.fitView());
							}
						});
						if (this.treeViewMode === 'canvas') {
							setTimeout(() => this.fitView(), 30);
						}
					},
					fitView() {
						const vp = this.$refs.canvasViewport;
						if (!vp || vp.clientWidth === 0 || vp.clientHeight === 0) return;
						const pad = 28;
						const sx = (vp.clientWidth - pad) / this.cw;
						const sy = (vp.clientHeight - pad) / this.ch;
						const s = Math.max(0.35, Math.min(1.05, Math.min(sx, sy)));
						this.scale = Math.round(s * 100) / 100;
						this.tx = Math.max(16, Math.round((vp.clientWidth - this.cw * this.scale) / 2));
						this.ty = Math.max(16, Math.round((vp.clientHeight - this.ch * this.scale) / 2));
					},
					resetView() {
						this.scale = 1;
						this.tx = 20;
						this.ty = 20;
					},
					zoomIn() {
						this.scale = Math.min(2.0, Math.round((this.scale + 0.15) * 100) / 100);
					},
					zoomOut() {
						this.scale = Math.max(0.3, Math.round((this.scale - 0.15) * 100) / 100);
					},
					onWheel(e) {
						const delta = e.deltaY < 0 ? 0.1 : -0.1;
						this.scale = Math.max(0.3, Math.min(2.0, Math.round((this.scale + delta) * 100) / 100));
					},
					startDrag(e) {
						this.dragging = true;
						this.moved = false;
						this.downX = e.clientX;
						this.downY = e.clientY;
						this.startX = e.clientX - this.tx;
						this.startY = e.clientY - this.ty;
					},
					onDrag(e) {
						if (!this.dragging) return;
						if (Math.abs(e.clientX - this.downX) > 4 || Math.abs(e.clientY - this.downY) > 4) {
							this.moved = true;
						}
						this.tx = e.clientX - this.startX;
						this.ty = e.clientY - this.startY;
					},
					endDrag() {
						this.dragging = false;
					},
					startTouch(e) {
						if (e.touches.length !== 1) return;
						this.dragging = true;
						this.moved = false;
						this.downX = e.touches[0].clientX;
						this.downY = e.touches[0].clientY;
						this.startX = e.touches[0].clientX - this.tx;
						this.startY = e.touches[0].clientY - this.ty;
					},
					onTouch(e) {
						if (!this.dragging || e.touches.length !== 1) return;
						if (Math.abs(e.touches[0].clientX - this.downX) > 4 || Math.abs(e.touches[0].clientY - this.downY) > 4) {
							this.moved = true;
						}
						this.tx = e.touches[0].clientX - this.startX;
						this.ty = e.touches[0].clientY - this.startY;
					},
					toggleFullscreen() {
						this.fullscreen = !this.fullscreen;
						this.$nextTick(() => this.fitView());
					},
					toggleFlowDir() {
						this.flowDir = this.flowDir === 'output-to-raw' ? 'raw-to-output' : 'output-to-raw';
					},
					selectNode(nodeID, typeID, name, canOpen) {
						if (this.moved) return;
						if (this.focusedNodeID === nodeID) {
							this.clearFocus();
							return;
						}
						this.focusedNodeID = nodeID;
						this.focusedTypeID = typeID;
						this.focusedName = name;
						this.focusedCanOpen = canOpen;
					},
					clearFocus() {
						this.focusedNodeID = '';
						this.focusedTypeID = 0;
						this.focusedName = '';
						this.focusedCanOpen = false;
					},
					isNodeInBranch(nodeID) {
						if (!this.focusedNodeID) return true;
						const list = this.branchMap[this.focusedNodeID];
						return Array.isArray(list) && list.includes(nodeID);
					},
					isEdgeInBranch(fromID, toID) {
						if (!this.focusedNodeID) return true;
						const list = this.branchMap[this.focusedNodeID];
						return Array.isArray(list) && list.includes(fromID) && list.includes(toID);
					}
				}`, canvas.Width, canvas.Height, canvas.BranchMapJSON) }
				@mousemove.window="onDrag($event)"
				@mouseup.window="endDrag()"
				@keydown.escape.window="if (fullscreen) { fullscreen = false; $nextTick(() => fitView()); }"
			>
				<!-- Fullscreen Dark Backdrop (Above App Sidebar & Header) -->
				<div
					x-cloak
					x-show="fullscreen"
					@click="toggleFullscreen()"
					class="fixed inset-0 z-[90] bg-slate-950/80 backdrop-blur-xs"
				></div>

				<!-- Canvas Card Container (Elevates cleanly to z-[100] above App Header & Sidebar in Fullscreen) -->
				<div
					:class="fullscreen ? 'fixed inset-4 z-[100] flex flex-col shadow-2xl border-amber-400/55 bg-[#0b0e1f]' : 'tactical-panel'"
					class="rounded-xl overflow-hidden border border-violet-400/30"
				>
					<!-- Canvas Toolbar -->
					<div class="flex flex-wrap items-center justify-between gap-2 border-b border-violet-400/20 bg-slate-950/90 px-4 py-2.5">
						<div class="flex flex-wrap items-center gap-2 text-xs">
							<span class="font-bold uppercase tracking-wider text-amber-300">
								{ tree.Commodity.Name } — Recipe Tree
							</span>
							<span class="hidden md:inline font-mono text-[10px] text-slate-400">Drag to pan • Scroll to zoom • Click node to highlight branch</span>
						</div>
						<div class="flex flex-wrap items-center gap-1.5 font-mono text-[11px]">
							<!-- Flip Direction Toggle (Output -> Raw vs Raw -> Output) -->
							<button
								type="button"
								@click="toggleFlowDir()"
								title="Flip Horizontal Tree Direction (Output → Raw vs Raw → Output)"
								class="inline-flex items-center gap-1 rounded border border-sky-400/40 bg-sky-500/15 px-2.5 py-1 text-sky-200 hover:bg-sky-500/25 cursor-pointer"
							>
								<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
								</svg>
								<span x-text="flowDir === 'output-to-raw' ? 'Output → Raw' : 'Raw → Output'">Output → Raw</span>
							</button>
							<button type="button" @click="zoomOut()" title="Zoom Out" class="rounded border border-slate-700 bg-slate-900 px-2 py-1 text-slate-200 hover:border-amber-400/50 hover:text-white cursor-pointer">−</button>
							<span class="min-w-[46px] text-center text-amber-200" x-text="Math.round(scale * 100) + '%'">100%</span>
							<button type="button" @click="zoomIn()" title="Zoom In" class="rounded border border-slate-700 bg-slate-900 px-2 py-1 text-slate-200 hover:border-amber-400/50 hover:text-white cursor-pointer">+</button>
							<button type="button" @click="fitView()" title="Fit Tree to Canvas" class="rounded border border-violet-400/35 bg-violet-500/15 px-2.5 py-1 text-violet-200 hover:bg-violet-500/25 cursor-pointer">Fit</button>
							<button type="button" @click="resetView()" title="Reset 100%" class="rounded border border-slate-700 bg-slate-900 px-2.5 py-1 text-slate-300 hover:text-white cursor-pointer">1:1</button>
							<button type="button" @click="toggleFullscreen()" title="Toggle Fullscreen Canvas" class="rounded border border-amber-400/40 bg-amber-500/15 px-2.5 py-1 text-amber-200 hover:bg-amber-500/25 cursor-pointer">
								<span x-show="!fullscreen">Expand</span>
								<span x-cloak x-show="fullscreen">Exit Full</span>
							</button>
						</div>
					</div>

					<!-- Interactive Pan & Zoom Viewport -->
					<div
						x-ref="canvasViewport"
						@mousedown.prevent="startDrag($event)"
						@click="if (!moved && $event.target === $refs.canvasViewport) clearFocus()"
						@wheel.prevent="onWheel($event)"
						@touchstart.passive="startTouch($event)"
						@touchmove.prevent="onTouch($event)"
						@touchend="endDrag()"
						:class="[dragging ? 'cursor-grabbing' : 'cursor-grab', fullscreen ? 'flex-1 min-h-0' : 'h-[560px]']"
						class="relative w-full overflow-hidden select-none bg-[#0a0d1c]"
						style="background-image: radial-gradient(rgba(167, 139, 250, 0.16) 1px, transparent 1px); background-size: 22px 22px;"
					>
						<!-- Transformed Stage -->
						<div
							class="absolute top-0 left-0 origin-top-left will-change-transform"
							:style="`width: ${cw}px; height: ${ch}px; transform: translate3d(${tx}px, ${ty}px, 0) scale(${scale});`"
						>
							<!-- Smooth Cubic Bezier Edges (Supports Instant Flip & Branch Highlight) -->
							<svg
								width={ fmt.Sprintf("%d", canvas.Width) }
								height={ fmt.Sprintf("%d", canvas.Height) }
								viewBox={ fmt.Sprintf("0 0 %d %d", canvas.Width, canvas.Height) }
								class="pointer-events-none absolute inset-0"
								fill="none"
							>
								for _, edge := range canvas.Edges {
									<path
										:d={ fmt.Sprintf("flowDir === 'output-to-raw' ? %q : %q", edge.PathD, edge.RevPathD) }
										:stroke={ fmt.Sprintf("focusedNodeID && isEdgeInBranch(%q, %q) ? '#fbbf24' : %q", edge.FromID, edge.ToID, piCanvasEdgeStroke(edge.Tier)) }
										:stroke-width={ fmt.Sprintf("focusedNodeID && isEdgeInBranch(%q, %q) ? 3 : 2", edge.FromID, edge.ToID) }
										:opacity={ fmt.Sprintf("isEdgeInBranch(%q, %q) ? 1 : 0.18", edge.FromID, edge.ToID) }
										stroke-linecap="round"
									></path>
								}
							</svg>

							<!-- Positioned Recipe Nodes with Official EVE Icons (Click to Highlight Branch, Double-Click to Open Recipe) -->
							for _, n := range canvas.Nodes {
								<div
									@click.stop={ fmt.Sprintf("selectNode(%q, %d, %q, %t)", n.NodeID, n.TypeID, n.Name, n.CanOpenRecipe) }
									if n.CanOpenRecipe {
										@dblclick.stop={ fmt.Sprintf("openTree(%d)", n.TypeID) }
									}
									:class={ fmt.Sprintf("[focusedNodeID === %q ? 'ring-2 ring-amber-300 shadow-[0_0_24px_rgba(251,191,36,0.45)]' : '', isNodeInBranch(%q) ? 'opacity-100' : 'opacity-25']", n.NodeID, n.NodeID) }
									:style={ fmt.Sprintf("`left: ${flowDir === 'output-to-raw' ? %d : %d}px; top: %dpx; width: %dpx; min-height: %dpx;`", n.X, n.RevX, n.Y, n.Width, n.Height) }
									class={ "absolute rounded-xl border px-2.5 py-2 flex items-center gap-2.5 backdrop-blur-xs transition-all duration-150 cursor-pointer hover:border-amber-300/80 hover:shadow-[0_0_16px_rgba(251,191,36,0.28)] " + piCanvasNodeBorderClass(n.Tier, n.IsRoot) }
								>
									<img
										src={ EVEItemIconURL(n.TypeID, 64) }
										alt={ n.Name }
										draggable="false"
										class="h-10 w-10 shrink-0 rounded-lg border border-violet-400/30 bg-slate-950/90 p-0.5 object-contain pointer-events-none"
										onerror="this.style.display='none'"
									/>
									<div class="min-w-0 flex-1">
										<div class="flex items-center justify-between gap-1">
											<span class={ "rounded border px-1.5 py-0.5 font-mono text-[9px] font-bold leading-none " + piTierBadgeClass(n.Tier) }>
												{ string(n.Tier) }
											</span>
											<span class="font-mono text-[11px] font-bold text-amber-200">×{ fmt.Sprintf("%d", n.Quantity) }</span>
										</div>
										<div class="mt-1 text-xs font-semibold text-white truncate" title={ n.Name }>{ n.Name }</div>
										if n.Tier == domain.PITierP0 && len(n.SourcePlanets) > 0 {
											<div class="mt-1 flex flex-wrap gap-1">
												for _, pl := range n.SourcePlanets {
													<span class={ "rounded border px-1 py-0.25 font-mono text-[8.5px] font-semibold leading-tight " + planetBadgeClass(pl) }>
														{ pl }
													</span>
												}
											</div>
										}
									</div>
								</div>
							}
						</div>

						<!-- Floating Focused Branch Action Bar -->
						<div
							x-cloak
							x-show="focusedNodeID !== ''"
							@mousedown.stop
							class="absolute bottom-3 left-3 z-10 flex flex-wrap items-center gap-2 rounded-xl border border-amber-400/45 bg-slate-950/90 backdrop-blur px-3 py-2 text-xs shadow-xl"
						>
							<span class="font-mono text-[10px] uppercase text-amber-300/90">Focused:</span>
							<span class="font-semibold text-white" x-text="focusedName"></span>
							<button
								type="button"
								x-show="focusedCanOpen"
								@click="openTree(focusedTypeID)"
								class="rounded-md border border-amber-400/50 bg-amber-400/20 px-2.5 py-1 font-mono text-[10px] font-bold text-amber-200 hover:bg-amber-400/30 cursor-pointer"
							>
								Open Recipe →
							</button>
							<button
								type="button"
								@click="clearFocus()"
								class="rounded-md border border-slate-700 bg-slate-900 px-2 py-1 font-mono text-[10px] text-slate-300 hover:text-white cursor-pointer"
							>
								Clear
							</button>
						</div>
					</div>
				</div>
			</div>

			<!-- MODE B: DETAILS & ECONOMICS (4 KPIs + Vertical Breakdown + P0 Table) -->
			<div x-show="treeViewMode === 'details'" class="space-y-4">
				<!-- 4 Factory Economics KPIs -->
				<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
					<div class="tactical-panel rounded-xl p-3.5">
						<div class="text-[10px] font-mono uppercase text-amber-300/80">{ tree.PriceHub.Name } Unit Sell</div>
						<div class="mt-1 text-base font-mono font-bold text-amber-200">{ FormatISK(tree.OutputUnitSell) }</div>
						<div class="text-[10px] font-mono text-slate-400">Cycle Rev: { FormatISK(tree.OutputCycleRevenue) }</div>
					</div>
					<div class="tactical-panel rounded-xl p-3.5">
						<div class="text-[10px] font-mono uppercase text-slate-400">Inputs + POCO ({ fmt.Sprintf("%.1f%%", tree.POCOTaxPercent) })</div>
						<div class="mt-1 text-base font-mono font-bold text-white">{ FormatISK(tree.DirectInputCost + tree.POCOTaxISK) }</div>
						<div class="text-[10px] font-mono text-slate-400">POCO Tax: { FormatISK(tree.POCOTaxISK) }</div>
					</div>
					<div class="tactical-panel rounded-xl p-3.5">
						<div class="text-[10px] font-mono uppercase text-emerald-300/80">Net Profit / Cycle</div>
						<div class={ "mt-1 text-base font-mono font-bold " + profitColor(tree.NetProfitPerCycle) }>{ FormatISK(tree.NetProfitPerCycle) }</div>
						<div class="text-[10px] font-mono text-slate-400">Margin: { FormatPercent(tree.NetMarginPercent) }</div>
					</div>
					<div class="tactical-panel rounded-xl p-3.5">
						<div class="text-[10px] font-mono uppercase text-sky-300/80">Estimated Monthly (1 Factory)</div>
						<div class={ "mt-1 text-base font-mono font-bold " + profitColor(tree.EstMonthlyISK) }>{ FormatISK(tree.EstMonthlyISK) }</div>
						<div class="text-[10px] font-mono text-slate-400">Daily: { FormatISK(tree.EstDailyISK) }</div>
					</div>
				</div>

				<!-- Full Recursive Recipe Tree (P4 -> P3 -> P2 -> P1 -> P0 + Planets) -->
				<div class="tactical-panel rounded-xl overflow-hidden">
					<div class="px-4 py-3 border-b border-violet-400/20 flex items-center justify-between">
						<h3 class="text-xs font-bold uppercase tracking-wider text-amber-300">Full Recursive Recipe Tree (With Planet Sources)</h3>
						<span class="text-[10px] font-mono text-slate-400">1 Factory Cycle Breakdown</span>
					</div>
					<div class="p-4 space-y-1.5 font-mono text-xs">
						for _, node := range tree.FlatTree {
							<div
								class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-violet-400/15 bg-slate-950/45 px-3 py-2"
								style={ fmt.Sprintf("margin-left: %dpx", node.Depth*18) }
							>
								<div class="flex flex-wrap items-center gap-2">
									if node.Depth > 0 {
										<span class="text-slate-500">└─</span>
									}
									<img src={ EVEItemIconURL(node.TypeID, 32) } alt={ node.Name } loading="lazy" class="h-6 w-6 shrink-0 rounded border border-violet-400/25 bg-slate-950/80 object-contain" onerror="this.style.display='none'"/>
									<span class={ "rounded border px-1.5 py-0.5 text-[9px] font-bold " + piTierBadgeClass(node.Tier) }>
										{ string(node.Tier) }
									</span>
									<span class="font-sans font-semibold text-white">{ node.Name }</span>
									<span class="text-amber-200">× { fmt.Sprintf("%d", node.Quantity) }</span>
								</div>

								<div class="flex flex-wrap items-center gap-1.5">
									if node.Tier == domain.PITierP0 {
										for _, pl := range node.SourcePlanets {
											<span class={ "rounded border px-1.5 py-0.5 text-[9px] font-semibold " + planetBadgeClass(pl) }>
												{ pl }
											</span>
										}
									} else if node.TotalValue > 0 {
										<span class="text-[11px] text-slate-300">{ FormatISK(node.TotalValue) }</span>
									}
								</div>
							</div>
						}
					</div>
				</div>

				<!-- P0 Raw Material Summary by Planet -->
				if len(tree.P0Requirements) > 0 {
					<div class="tactical-panel rounded-xl overflow-hidden">
						<div class="px-4 py-2.5 border-b border-violet-400/20">
							<h3 class="text-xs font-bold uppercase tracking-wider text-violet-200">Raw P0 Extraction Summary &amp; Compatible Planets</h3>
						</div>
						<div class="overflow-x-auto">
							<table class="w-full text-left text-xs">
								<thead class="bg-slate-950/50 font-mono uppercase text-[10px] text-slate-400 border-b border-violet-400/15">
									<tr>
										<th class="px-4 py-2">Raw P0 Resource</th>
										<th class="px-4 py-2 text-right">Total Quantity / Cycle</th>
										<th class="px-4 py-2">Found On Planet Types</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-violet-400/10">
									for _, p0 := range tree.P0Requirements {
										<tr class="hover:bg-white/5">
											<td class="px-4 py-2">
												<div class="flex items-center gap-2">
													<img src={ EVEItemIconURL(p0.TypeID, 32) } alt={ p0.Name } loading="lazy" class="h-6 w-6 shrink-0 rounded border border-violet-400/25 bg-slate-950/80 object-contain" onerror="this.style.display='none'"/>
													<span class="font-semibold text-white">{ p0.Name }</span>
												</div>
											</td>
											<td class="px-4 py-2 text-right font-mono text-amber-200">{ fmt.Sprintf("%d", p0.TotalQuantity) }</td>
											<td class="px-4 py-2">
												<div class="flex flex-wrap gap-1">
													for _, pl := range p0.SourcePlanets {
														<span class={ "rounded border px-1.5 py-0.5 font-mono text-[9px] font-semibold " + planetBadgeClass(pl) }>{ pl }</span>
													}
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				}
			</div>
		</div>
	}
}

templ PIScanPartial(rows []domain.PIProfitRow, tier string, hub domain.TradeHub, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl p-4 border-rose-400/40 text-xs text-rose-200">{ errMsg }</div>
	} else if len(rows) == 0 {
		<div class="tactical-panel rounded-xl p-8 text-center text-xs text-slate-400">No PI items returned for tier { strings.ToUpper(tier) } at { hub.Name }.</div>
	} else {
		<div class="tactical-panel rounded-xl overflow-hidden">
			<div class="px-4 py-2.5 border-b border-violet-400/20 flex items-center justify-between text-[11px] font-mono text-slate-300">
				<span>Tier <strong class="text-amber-300">{ strings.ToUpper(tier) }</strong> Results</span>
				<span>Price Reference: <strong class="text-sky-300">{ hub.Name } ({ hub.RegionName })</strong></span>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs">
					<thead class="bg-slate-950/50 font-mono uppercase text-[10px] text-slate-400 border-b border-violet-400/15">
						<tr>
							<th class="px-4 py-3">PI Item</th>
							<th class="px-4 py-3 text-right">{ hub.Name } Unit Sell</th>
							<th class="px-4 py-3 text-right">Input + POCO</th>
							<th class="px-4 py-3 text-right">Net Profit / Cycle</th>
							<th class="px-4 py-3 text-right">Margin</th>
							<th class="px-4 py-3 text-right">Estimated Monthly (1 Factory)</th>
							<th class="px-4 py-3">Verdict</th>
							<th class="px-4 py-3 text-right">Tree</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-violet-400/15 font-mono">
						for _, r := range rows {
							<tr class="hover:bg-white/5">
								<td class="px-4 py-2.5 font-sans">
									<div class="flex items-center gap-2">
										<img src={ EVEItemIconURL(r.TypeID, 32) } alt={ r.Name } loading="lazy" class="h-7 w-7 shrink-0 rounded border border-violet-400/25 bg-slate-950/80 object-contain" onerror="this.style.display='none'"/>
										<span class="font-semibold text-white">{ r.Name }</span>
										<span class={ "rounded border px-1.5 py-0.5 font-mono text-[9px] font-bold " + piTierBadgeClass(r.Tier) }>{ string(r.Tier) }</span>
									</div>
								</td>
								<td class="px-4 py-2.5 text-right text-amber-200">{ FormatISK(r.OutputUnitSell) }</td>
								<td class="px-4 py-2.5 text-right text-slate-300">{ FormatISK(r.DirectInputCost + r.POCOTaxISK) }</td>
								<td class={ "px-4 py-2.5 text-right font-bold " + profitColor(r.NetProfitPerCycle) }>{ FormatISK(r.NetProfitPerCycle) }</td>
								<td class={ "px-4 py-2.5 text-right " + profitColor(r.NetMarginPercent) }>{ FormatPercent(r.NetMarginPercent) }</td>
								<td class={ "px-4 py-2.5 text-right font-bold " + profitColor(r.EstMonthlyISK) }>{ FormatISK(r.EstMonthlyISK) }</td>
								<td class="px-4 py-2.5">
									<span class={ "inline-block rounded border px-2 py-0.5 text-[10px] font-bold " + verdictBadgeClass(r.Verdict) }>{ string(r.Verdict) }</span>
								</td>
								<td class="px-4 py-2.5 text-right font-sans">
									<a href={ templ.SafeURL(fmt.Sprintf("/pi?type_id=%d&hub=%s", r.TypeID, hub.Key)) } class="rounded border border-amber-400/40 bg-amber-500/15 px-2.5 py-1 text-[10px] font-semibold text-amber-200 hover:bg-amber-500/25">
										View Tree →
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ PISalesCalcPartial(res *domain.PISalesCalcResult, unmatched []string, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl p-4 border-rose-400/40 text-xs text-rose-200">{ errMsg }</div>
	} else if res != nil {
		<div class="space-y-4">
			if len(unmatched) > 0 {
				<div class="rounded-xl border border-amber-400/40 bg-amber-950/30 px-4 py-3 text-xs text-amber-200">
					<strong>Ignored non-PI lines ({ fmt.Sprintf("%d", len(unmatched)) }):</strong> { strings.Join(unmatched, ", ") }
				</div>
			}

			<!-- 4 Top KPI Summary Cards -->
			<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-emerald-300/90">Total Net Profit ({ res.Options.Hub.Name })</div>
					<div class={ "mt-1 text-2xl font-mono font-bold " + profitColor(res.TotalNetProfit) }>{ FormatISK(res.TotalNetProfit) }</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">Net Margin: <strong class="text-white">{ FormatPercent(res.OverallMarginPct) }</strong></div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-sky-300/90">Gross Sales Revenue</div>
					<div class="mt-1 text-2xl font-mono font-bold text-white">{ FormatISK(res.TotalGrossRevenue) }</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">
						if res.Options.SellMode == "instant_buy" {
							Instant Sell (Highest Buy)
						} else {
							Sell Order (Lowest Sell)
						}
					</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-amber-300/90">Total Costs &amp; Taxes</div>
					<div class="mt-1 text-2xl font-mono font-bold text-amber-200">{ FormatISK(res.TotalInputCost + res.TotalPOCOTax + res.TotalMarketFees) }</div>
					<div class="mt-0.5 text-[10px] font-mono text-slate-400">
						POCO { FormatISK(res.TotalPOCOTax) } • Fees { FormatISK(res.TotalMarketFees) }
						if res.TotalInputCost > 0 {
							• Inputs { FormatISK(res.TotalInputCost) }
						}
					</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-violet-300/90">Total Cargo Volume</div>
					<div class="mt-1 text-2xl font-mono font-bold text-violet-200">{ fmt.Sprintf("%.1f m³", res.TotalVolumeM3) }</div>
					<div class="mt-0.5 text-[11px] font-mono">
						if res.TotalVolumeM3 <= res.EpithalCapacityM3 {
							<span class="text-emerald-300">Fits 1× Epithal IV (63k m³)</span>
						} else {
							<span class="text-amber-300">{ fmt.Sprintf("%d× Epithal IV trips needed", res.EpithalTrips) }</span>
						}
					</div>
				</div>
			</div>

			<!-- Per-Item Breakdown Table -->
			<div class="tactical-panel rounded-xl overflow-hidden">
				<div class="px-4 py-2.5 border-b border-violet-400/20 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-slate-300">
					<span>
						Breakdown ({ fmt.Sprintf("%d item(s) • %d total units", len(res.Lines), res.TotalUnits) })
					</span>
					<span>
						Hub: <strong class="text-sky-300">{ res.Options.Hub.Name }</strong> •
						POCO: <strong class="text-amber-200">{ fmt.Sprintf("%.1f%%", res.Options.POCOTaxPercent) }</strong> •
						if res.Options.SellMode == "instant_buy" {
							Tax: <strong class="text-slate-200">{ fmt.Sprintf("%.2f%%", res.Options.SalesTaxPercent) }</strong>
						} else {
							Broker + Tax: <strong class="text-slate-200">{ fmt.Sprintf("%.2f%%", res.Options.BrokerFeePercent+res.Options.SalesTaxPercent) }</strong>
						}
					</span>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs">
						<thead class="bg-slate-950/50 font-mono uppercase text-[10px] text-slate-400 border-b border-violet-400/15">
							<tr>
								<th class="px-4 py-3">PI Item</th>
								<th class="px-3 py-3 text-right">Quantity</th>
								<th class="px-3 py-3 text-right">Unit Price</th>
								<th class="px-3 py-3 text-right">Gross Revenue</th>
								if res.Options.CostMode == "buy_inputs" {
									<th class="px-3 py-3 text-right">Input Cost</th>
								}
								<th class="px-3 py-3 text-right">POCO + Fees</th>
								<th class="px-3 py-3 text-right">Net Profit</th>
								<th class="px-3 py-3 text-right">Margin</th>
								<th class="px-4 py-3 text-right">Volume</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-violet-400/15 font-mono">
							for _, ln := range res.Lines {
								<tr class="hover:bg-white/5">
									<td class="px-4 py-2.5 font-sans">
										<div class="flex items-center gap-2">
											<img src={ EVEItemIconURL(ln.TypeID, 32) } alt={ ln.Name } loading="lazy" class="h-7 w-7 shrink-0 rounded border border-violet-400/25 bg-slate-950/80 object-contain" onerror="this.style.display='none'"/>
											<span class="font-semibold text-white">{ ln.Name }</span>
											<span class={ "rounded border px-1.5 py-0.5 font-mono text-[9px] font-bold " + piTierBadgeClass(ln.Tier) }>{ string(ln.Tier) }</span>
										</div>
									</td>
									<td class="px-3 py-2.5 text-right text-slate-200">{ fmt.Sprintf("%d", ln.Quantity) }</td>
									<td class="px-3 py-2.5 text-right text-amber-200">{ FormatISK(ln.UnitPrice) }</td>
									<td class="px-3 py-2.5 text-right text-white">{ FormatISK(ln.GrossRevenue) }</td>
									if res.Options.CostMode == "buy_inputs" {
										<td class="px-3 py-2.5 text-right text-slate-300">{ FormatISK(ln.InputCost) }</td>
									}
									<td class="px-3 py-2.5 text-right text-rose-300/90">-{ FormatISK(ln.POCOTax + ln.MarketFees) }</td>
									<td class={ "px-3 py-2.5 text-right font-bold " + profitColor(ln.NetProfit) }>{ FormatISK(ln.NetProfit) }</td>
									<td class={ "px-3 py-2.5 text-right " + profitColor(ln.MarginPct) }>{ FormatPercent(ln.MarginPct) }</td>
									<td class="px-4 py-2.5 text-right text-slate-400">{ fmt.Sprintf("%.1f m³", ln.VolumeM3) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

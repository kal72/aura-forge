package web

import (
	"context"
	"fmt"

	"aura-forge/internal/domain"
	"aura-forge/internal/i18n"
	"aura-forge/internal/service"
)

func bucketDescriptionCtx(ctx context.Context, bt domain.BucketType, fallback string) string {
	switch bt {
	case domain.BucketFastCashflow:
		return i18n.L(ctx, "High daily volume, low-cost items for steady daily ISK velocity.", "Item bervolume harian tinggi dan biaya rendah untuk perputaran ISK harian yang stabil.")
	case domain.BucketMidTier:
		return i18n.L(ctx, "Balanced sales velocity and reliable profit margins.", "Keseimbangan antara kecepatan terjual dan Margin profit yang stabil.")
	case domain.BucketHighROI:
		return i18n.L(ctx, "Higher ROI or profit-per-batch items to accelerate capital compounding.", "Item dengan ROI atau profit per batch lebih tinggi untuk mempercepat compounding modal.")
	case domain.BucketCashBuffer:
		return i18n.L(ctx, "Reserved 10%–15% safety cushion for Broker Fees, Job Install Costs, and Relists.", "Cadangan keamanan 10%–15% untuk Broker Fee, Job Install Cost, dan biaya Relist.")
	default:
		return fallback
	}
}

func allocatorHubName(res *domain.AllocationResult) string {
	if res != nil && res.ActiveHubName != "" {
		return res.ActiveHubName
	}
	return "Primary Hub"
}

func bucketAccentClass(bt domain.BucketType) string {
	switch bt {
	case domain.BucketFastCashflow:
		return "bg-emerald-500"
	case domain.BucketMidTier:
		return "bg-sky-500"
	case domain.BucketHighROI:
		return "bg-violet-500"
	default:
		return "bg-amber-500"
	}
}

func bucketBadgeClass(bt domain.BucketType) string {
	switch bt {
	case domain.BucketFastCashflow:
		return "bg-emerald-500/15 border-emerald-400/30 text-emerald-300"
	case domain.BucketMidTier:
		return "bg-sky-500/15 border-sky-400/30 text-sky-300"
	case domain.BucketHighROI:
		return "bg-violet-500/15 border-violet-400/30 text-violet-300"
	default:
		return "bg-amber-500/15 border-amber-400/30 text-amber-300"
	}
}

func bucketUtilPct(used, budget float64) float64 {
	if budget <= 0 {
		return 0
	}
	pct := (used / budget) * 100.0
	if pct > 100 {
		pct = 100
	}
	if pct < 0 {
		pct = 0
	}
	return pct
}

templ AllocatorPage(mode service.ModeInfo, cfg domain.AllocationConfig, result *domain.AllocationResult, allocErr string) {
	@Layout("Smart Capital Allocator", "allocator", mode) {
		<div class="space-y-6">
			@ProductionWorkflowStepper(2)

			<div class="flex flex-wrap items-center justify-between gap-4">
				<div>
					<div class="flex flex-wrap items-center gap-2">
						<h1 class="text-2xl font-bold tracking-tight text-white">Smart Capital Allocator (4-Bucket Strategy)</h1>
						<span class="rounded-full border border-sky-400/40 bg-sky-500/15 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-sky-200">
							Hub: { allocatorHubName(result) }
						</span>
					</div>
					<p class="text-xs text-slate-400 mt-0.5">{ i18n.L(ctx, "Splits available working capital across 4 risk-managed buckets (Fast Cashflow, Mid-Tier, High ROI, and 10%–15% Cash Buffer) while automatically filtering out TRAP items.", "Membagi modal kerja ke 4 keranjang risiko (Fast Cashflow, Mid-Tier, High ROI, dan 10%–15% Cash Buffer) sambil otomatis menyaring item TRAP.") }</p>
				</div>
				<button type="button" hx-post="/esi/sync-prices" hx-swap="none" class="rounded-md border border-amber-400/40 bg-amber-500/15 px-3 py-1.5 text-xs font-semibold text-amber-200 hover:bg-amber-500/25 transition cursor-pointer">
					{ i18n.L(ctx, "Refresh", "Segarkan Harga") } { allocatorHubName(result) } (Public ESI)
				</button>
			</div>

			<!-- Embedded AI Auto-Build Weekly Plan Card -->
			<div
				class="tactical-panel rounded-2xl p-5 space-y-3.5 border-violet-400/35"
				x-data="{ budget: 150000000, risk: 'balanced' }"
			>
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div>
						<div class="flex items-center gap-2">
							<span class="h-2 w-2 rounded-full bg-amber-300 animate-pulse"></span>
							<h2 class="text-sm font-bold text-white uppercase tracking-wider">⚡ Auto-Build Weekly Plan (Embedded AI)</h2>
						</div>
						<p class="text-xs text-slate-300 mt-0.5">{ i18n.L(ctx, "Enter your ISK budget and risk profile to automatically generate a diversified, ready-to-save Weekly Manufacturing Plan.", "Masukkan budget ISK dan profil risiko Anda untuk otomatis meracik Rencana Produksi Mingguan terdiversifikasi siap simpan.") }</p>
					</div>
					<div class="flex flex-wrap gap-1 text-[10.5px] font-mono">
						<button type="button" @click="budget = 50000000" class="rounded border border-slate-700 bg-slate-900/80 px-2 py-0.5 text-slate-200 hover:border-amber-400/60 cursor-pointer">50M</button>
						<button type="button" @click="budget = 150000000" class="rounded border border-slate-700 bg-slate-900/80 px-2 py-0.5 text-slate-200 hover:border-amber-400/60 cursor-pointer">150M</button>
						<button type="button" @click="budget = 500000000" class="rounded border border-slate-700 bg-slate-900/80 px-2 py-0.5 text-slate-200 hover:border-amber-400/60 cursor-pointer">500M</button>
						<button type="button" @click="budget = 1000000000" class="rounded border border-slate-700 bg-slate-900/80 px-2 py-0.5 text-slate-200 hover:border-amber-400/60 cursor-pointer">1B</button>
					</div>
				</div>

				<form
					hx-post="/allocator/ai-plan"
					hx-target="#ai-weekly-plan-box"
					hx-swap="innerHTML"
					hx-indicator="#ai-plan-spinner"
					class="grid grid-cols-1 gap-3 sm:grid-cols-[1fr_200px_auto] items-end"
				>
					<div>
						<label class="block text-[10.5px] font-mono uppercase text-slate-400 mb-1">Weekly Capital Budget (ISK)</label>
						<input
							type="number"
							name="budget_isk"
							x-model.number="budget"
							min="1000000"
							step="1000000"
							class="w-full rounded-xl border border-violet-400/35 bg-slate-950/80 px-3 py-2 font-mono text-xs text-white focus:border-amber-400 focus:outline-none"
						/>
					</div>
					<div>
						<label class="block text-[10.5px] font-mono uppercase text-slate-400 mb-1">Risk Profile</label>
						<select
							name="risk_profile"
							x-model="risk"
							class="w-full rounded-xl border border-violet-400/35 bg-slate-950/80 px-3 py-2 text-xs font-semibold text-white focus:border-amber-400 focus:outline-none"
						>
							<option value="conservative">Conservative (50/25/10/15)</option>
							<option value="balanced">Balanced (35/30/20/15)</option>
							<option value="aggressive">Aggressive (25/30/35/10)</option>
						</select>
					</div>
					<button
						type="submit"
						class="inline-flex items-center justify-center gap-2 rounded-xl border border-amber-400/60 bg-gradient-to-r from-violet-600/40 to-amber-500/30 px-4 py-2 text-xs font-bold text-amber-100 hover:from-violet-500/50 hover:to-amber-400/40 shadow-[0_0_16px_rgba(139,92,246,0.28)] transition cursor-pointer"
					>
						<span id="ai-plan-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-amber-200 border-t-transparent"></span>
						<span>⚡ Auto-Build Plan</span>
					</button>
				</form>

				<div id="ai-weekly-plan-box"></div>
			</div>

			<!-- Allocation Percentage Controls + Strategy Presets -->
			<div
				class="tactical-panel rounded-xl p-5 space-y-4"
				x-data={ fmt.Sprintf(`{
					fast: %.0f,
					mid: %.0f,
					high: %.0f,
					buf: %.0f,
					get total() {
						return (Number(this.fast)||0) + (Number(this.mid)||0) + (Number(this.high)||0) + (Number(this.buf)||0);
					},
					applyPreset(f, m, h, b) {
						this.fast = f; this.mid = m; this.high = h; this.buf = b;
						this.$nextTick(() => {
							const form = document.getElementById('allocator-form');
							if (form && window.htmx) window.htmx.trigger(form, 'submit');
						});
					}
				}`, cfg.FastCashflowPct, cfg.MidTierPct, cfg.HighROIPct, cfg.CashBufferPct) }
			>
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div class="flex flex-wrap items-center gap-2 text-[11px]">
						<span class="font-mono uppercase text-slate-400">Presets:</span>
						<button type="button" @click="applyPreset(35, 30, 20, 15)" class="rounded border border-slate-700 bg-slate-900/80 px-2.5 py-1 font-mono text-slate-200 hover:border-sky-400/60 hover:text-sky-200 transition cursor-pointer">
							Beginner Safe (35/30/20/15)
						</button>
						<button type="button" @click="applyPreset(50, 25, 10, 15)" class="rounded border border-slate-700 bg-slate-900/80 px-2.5 py-1 font-mono text-slate-200 hover:border-emerald-400/60 hover:text-emerald-200 transition cursor-pointer">
							Fast Turnover (50/25/10/15)
						</button>
						<button type="button" @click="applyPreset(25, 30, 30, 15)" class="rounded border border-slate-700 bg-slate-900/80 px-2.5 py-1 font-mono text-slate-200 hover:border-violet-400/60 hover:text-violet-200 transition cursor-pointer">
							Growth Focus (25/30/30/15)
						</button>
					</div>
					<span
						class="rounded-full border px-2.5 py-0.5 font-mono text-[11px] font-bold"
						:class="total === 100 && Number(buf) >= 10 ? 'border-emerald-500/40 bg-emerald-500/15 text-emerald-300' : 'border-rose-500/40 bg-rose-500/15 text-rose-300'"
					>
						Total: <span x-text="total"></span>%
					</span>
				</div>

				<form
					id="allocator-form"
					hx-post="/allocator/run"
					hx-target="#allocator-result"
					hx-swap="innerHTML"
					class="grid grid-cols-1 gap-4 sm:grid-cols-5 items-end"
				>
					<div>
						<label class="block text-[11px] font-mono uppercase text-emerald-300/90">Fast Cashflow (%)</label>
						<input type="number" step="1" name="fast_cashflow_pct" x-model.number="fast" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
					</div>
					<div>
						<label class="block text-[11px] font-mono uppercase text-sky-300/90">Mid-Tier (%)</label>
						<input type="number" step="1" name="mid_tier_pct" x-model.number="mid" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
					</div>
					<div>
						<label class="block text-[11px] font-mono uppercase text-violet-300/90">High ROI (%)</label>
						<input type="number" step="1" name="high_roi_pct" x-model.number="high" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
					</div>
					<div>
						<label class="block text-[11px] font-mono uppercase text-amber-300/90">Cash Buffer (Min 10%)</label>
						<input type="number" step="1" name="cash_buffer_pct" x-model.number="buf" min="10" class="mt-1 w-full rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-mono text-white"/>
					</div>
					<div>
						<button type="submit" class="w-full rounded-md bg-sky-500 py-2 text-xs font-bold uppercase tracking-wider text-slate-950 hover:bg-sky-400 transition cursor-pointer">
							{ i18n.L(ctx, "Compute Allocation", "Hitung Alokasi") }
						</button>
					</div>
				</form>

				<div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-800 pt-4">
					<p class="text-[11px] text-slate-400">
						{ i18n.L(ctx, "Saves this 4-bucket allocation to your active Weekly Plan so you can verify slot capacity and copy your consolidated EVE Multibuy list.", "Menyimpan alokasi 4 keranjang ini ke Weekly Plan aktif agar Anda bisa cek kapasitas slot dan salin daftar EVE Multibuy.") }
					</p>
					<button
						type="button"
						hx-post="/allocator/to-plan"
						hx-include="#allocator-form"
						hx-swap="none"
						class="rounded-md bg-emerald-500 px-4 py-2 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-emerald-400 transition cursor-pointer"
					>
						{ i18n.L(ctx, "Next: Send to Weekly Planner (Step 3) →", "Lanjut: Kirim ke Weekly Planner (Langkah 3) →") }
					</button>
				</div>
			</div>

			<!-- Allocation Results -->
			<div id="allocator-result">
				@AllocatorResultPartial(result, allocErr)
			</div>
		</div>
	}
}

templ AllocatorResultPartial(res *domain.AllocationResult, errMsg string) {
	if errMsg != "" {
		<div class="rounded-xl border border-rose-500/40 bg-rose-950/40 p-4 text-xs text-rose-200">
			<strong>Allocation Validation Failed:</strong> { errMsg }
		</div>
	} else if res != nil {
		<div class="space-y-5">
			<!-- Summary Banner -->
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-slate-400">{ i18n.L(ctx, "Working Capital", "Modal Kerja") } ({ res.CapitalSource })</div>
					<div class="mt-1 text-xl font-bold font-mono text-white">{ FormatISK(res.TotalCapital) }</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-slate-400">{ i18n.L(ctx, "Capital Allocated", "Modal Dialokasikan") }</div>
					<div class="mt-1 text-xl font-bold font-mono text-sky-300">{ FormatISK(res.TotalAllocatedISK) }</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-slate-400">{ i18n.L(ctx, "Operational Cash Buffer", "Cadangan Kas Operasional") }</div>
					<div class="mt-1 text-xl font-bold font-mono text-amber-300">{ FormatISK(res.CashBufferISK) }</div>
				</div>
				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-slate-400">{ i18n.L(ctx, "Estimated Cycle Profit", "Estimasi Profit Siklus") }</div>
					<div class="mt-1 text-xl font-bold font-mono text-emerald-300">+{ FormatISK(res.TotalEstimatedProfit) }</div>
				</div>
			</div>

			<!-- Visual 4-Bucket Distribution Bar -->
			<div class="tactical-panel rounded-xl p-4 space-y-2.5">
				<div class="flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono">
					<span class="uppercase text-slate-400">{ i18n.L(ctx, "Capital Distribution Breakdown", "Rincian Distribusi Modal") }</span>
					<span class="text-slate-300">
						{ i18n.L(ctx, "Deployable", "Siap Dipakai") }: <strong class="text-white">{ FormatISK(res.DeployableCapital) }</strong> •
						Buffer: <strong class="text-amber-300">{ FormatISK(res.CashBufferISK) }</strong>
					</span>
				</div>
				<div class="flex h-3 w-full overflow-hidden rounded-full bg-slate-900 border border-slate-800">
					for _, b := range res.Buckets {
						<div
							class={ bucketAccentClass(b.Type) }
							style={ fmt.Sprintf("width: %.2f%%;", b.Percent) }
							title={ fmt.Sprintf("%s: %.0f%% (%s)", b.Label, b.Percent, FormatISK(b.BudgetISK)) }
						></div>
					}
				</div>
				<div class="flex flex-wrap gap-4 text-[10px] font-mono text-slate-400">
					for _, b := range res.Buckets {
						<span class="inline-flex items-center gap-1.5">
							<span class={ "inline-block h-2 w-2 rounded-full " + bucketAccentClass(b.Type) }></span>
							<span>{ b.Label } ({ fmt.Sprintf("%.0f%%", b.Percent) })</span>
						</span>
					}
				</div>
			</div>

			<!-- 4 Buckets Grid -->
			<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
				for _, b := range res.Buckets {
					<div class="tactical-panel rounded-xl p-5 space-y-3">
						<div class="flex items-start justify-between gap-2">
							<div>
								<h3 class="text-sm font-bold text-white">{ b.Label }</h3>
								<p class="text-[11px] text-slate-400 mt-0.5">{ bucketDescriptionCtx(ctx, b.Type, b.Description) }</p>
							</div>
							<span class={ "rounded border px-2 py-0.5 font-mono text-xs font-bold " + bucketBadgeClass(b.Type) }>
								{ fmt.Sprintf("%.0f%%", b.Percent) }
							</span>
						</div>

						<div class="space-y-1.5 border-y border-slate-800/80 py-2.5">
							<div class="flex flex-wrap gap-4 text-xs font-mono">
								<span>{ i18n.L(ctx, "Budget", "Anggaran") }: <strong class="text-white">{ FormatISK(b.BudgetISK) }</strong></span>
								if b.Type != domain.BucketCashBuffer {
									<span>{ i18n.L(ctx, "Used", "Terpakai") }: <strong class="text-sky-300">{ FormatISK(b.UsedISK) }</strong></span>
									<span>{ i18n.L(ctx, "Estimated Profit", "Estimasi Profit") }: <strong class="text-emerald-300">+{ FormatISK(b.EstimatedProfit) }</strong></span>
								}
							</div>
							if b.Type != domain.BucketCashBuffer {
								<div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-900">
									<div
										class={ "h-full rounded-full transition-all " + bucketAccentClass(b.Type) }
										style={ fmt.Sprintf("width: %.1f%%;", bucketUtilPct(b.UsedISK, b.BudgetISK)) }
									></div>
								</div>
							}
						</div>

						if b.Type == domain.BucketCashBuffer {
							<div class="rounded-lg border border-amber-500/30 bg-amber-950/20 p-3 text-xs text-amber-200 leading-relaxed">
								{ i18n.L(ctx, "This capital is reserved as an operational safety cushion for Broker Fees, Job Install Costs (SCI), and safe Relist adjustments if undercut at", "Modal ini dicadangkan sebagai pengaman operasional untuk Broker Fee, Job Install Cost (SCI), dan penyesuaian Relist aman jika terkena undercut di") } <strong>{ allocatorHubName(res) }</strong>.
							</div>
						} else if len(b.Items) == 0 {
							<div class="text-xs text-slate-500 italic">
								{ i18n.L(ctx, "No eligible VIABLE items in your", "Belum ada item LAYAK di") } <a href="/catalog" class="text-sky-300 underline hover:text-sky-200">Catalog</a> { i18n.L(ctx, "fit this bucket's budget yet.", "yang sesuai dengan anggaran keranjang ini.") }
							</div>
						} else {
							<div class="space-y-2">
								for _, it := range b.Items {
									<div class="flex items-center justify-between gap-3 rounded-lg border border-slate-800 bg-slate-900/60 px-3 py-2 text-xs">
										<div class="flex items-center gap-2.5 min-w-0">
											if it.TypeID > 0 {
												<img
													src={ fmt.Sprintf("https://images.evetech.net/types/%d/icon?size=32", it.TypeID) }
													alt={ it.Name }
													class="h-7 w-7 rounded border border-slate-700/80 bg-slate-950 object-contain shrink-0"
													loading="lazy"
													onerror="this.style.display='none'"
												/>
											}
											<div class="min-w-0">
												<div class="font-semibold text-white truncate">{ it.Name }</div>
												<div class="text-[10px] font-mono text-slate-400">
													{ fmt.Sprintf("%dx batch • ROI %s • %s", it.RecommendedRuns, FormatPercent(it.ROIPercent), FormatVolumeCtx(ctx, it.DailyVolume)) }
												</div>
											</div>
										</div>
										<div class="text-right font-mono shrink-0">
											<div class="text-slate-200">{ FormatISK(it.TotalCost) }</div>
											<div class="text-[11px] text-emerald-300">+{ FormatISK(it.EstimatedProfit) }</div>
										</div>
									</div>
								}
							</div>
						}
					</div>
				}
			</div>
		</div>
	}
}

package web

import (
	"encoding/json"
	"fmt"
	"sort"
	"strings"

	"aura-forge/internal/domain"
	"aura-forge/internal/service"
)

type mfgShopItem struct {
	TypeID    int32   `json:"id"`
	Name      string  `json:"name"`
	Quantity  int64   `json:"qty"`
	UnitPrice float64 `json:"unit_price"`
	TotalCost float64 `json:"total_cost"`
	Checked   bool    `json:"checked"`
}

func calcTreeJobInstallTotal(tree *domain.IndustryTreeAnalysis) float64 {
	if tree == nil {
		return 0
	}
	total := 0.0
	for _, n := range tree.FlatNodes {
		if n.ActiveDecision == domain.DecisionMake {
			total += n.JobInstallCost
		}
	}
	return domain.RoundISK(total)
}

func buildShoppingModeItems(tree *domain.IndustryTreeAnalysis, mode string) []mfgShopItem {
	if tree == nil {
		return nil
	}
	byID := make(map[int32]*mfgShopItem)
	addNode := func(n domain.IndustryTreeNode) {
		if n.TypeID <= 0 || n.Quantity <= 0 {
			return
		}
		if existing, ok := byID[n.TypeID]; ok {
			existing.Quantity += n.Quantity
			existing.TotalCost = domain.RoundISK(existing.TotalCost + n.BuyCost)
		} else {
			byID[n.TypeID] = &mfgShopItem{
				TypeID:    n.TypeID,
				Name:      n.Name,
				Quantity:  n.Quantity,
				UnitPrice: n.UnitPrice,
				TotalCost: n.BuyCost,
				Checked:   true,
			}
		}
	}

	switch mode {
	case "direct":
		for _, ch := range tree.RootNode.Children {
			addNode(ch)
		}
	case "raw":
		var walkRaw func(n domain.IndustryTreeNode)
		walkRaw = func(n domain.IndustryTreeNode) {
			if len(n.Children) == 0 {
				if n.Depth > 0 {
					addNode(n)
				}
				return
			}
			for _, ch := range n.Children {
				walkRaw(ch)
			}
		}
		walkRaw(tree.RootNode)
	default: // "active" (respects MAKE/BUY decisions)
		var walkActive func(n domain.IndustryTreeNode)
		walkActive = func(n domain.IndustryTreeNode) {
			if n.Depth > 0 && (n.ActiveDecision != domain.DecisionMake || len(n.Children) == 0) {
				addNode(n)
				return
			}
			for _, ch := range n.Children {
				walkActive(ch)
			}
		}
		walkActive(tree.RootNode)
	}

	out := make([]mfgShopItem, 0, len(byID))
	for _, it := range byID {
		out = append(out, *it)
	}
	sort.Slice(out, func(i, j int) bool {
		if out[i].TotalCost == out[j].TotalCost {
			return out[i].Name < out[j].Name
		}
		return out[i].TotalCost > out[j].TotalCost
	})
	return out
}

func buildNodeIngredientsJSON(root domain.IndustryTreeNode) string {
	ingMap := make(map[string]string)
	var walk func(n domain.IndustryTreeNode)
	walk = func(n domain.IndustryTreeNode) {
		if len(n.Children) > 0 {
			lines := make([]string, 0, len(n.Children))
			for _, ch := range n.Children {
				lines = append(lines, fmt.Sprintf("%s\t%d", ch.Name, ch.Quantity))
			}
			key := fmt.Sprintf("%d", n.TypeID)
			if _, exists := ingMap[key]; !exists {
				ingMap[key] = strings.Join(lines, "\n")
			}
			for _, ch := range n.Children {
				walk(ch)
			}
		}
	}
	walk(root)
	b, err := json.Marshal(ingMap)
	if err != nil {
		return "{}"
	}
	return string(b)
}

func buildShoppingPresetsJSON(tree *domain.IndustryTreeAnalysis) string {
	payload := map[string][]mfgShopItem{
		"active": buildShoppingModeItems(tree, "active"),
		"direct": buildShoppingModeItems(tree, "direct"),
		"raw":    buildShoppingModeItems(tree, "raw"),
	}
	b, err := json.Marshal(payload)
	if err != nil {
		return `{"active":[],"direct":[],"raw":[]}`
	}
	return string(b)
}

templ ManufacturePage(mode service.ModeInfo, settings domain.UserSettings, blueprints []domain.SDEBlueprint, initialResult *domain.BlueprintCalcResult) {
	@Layout("Manufacture", "manufacture", mode) {
		<div
			class="space-y-6"
			x-data={ fmt.Sprintf(`{
				isAdmin: %t,
				aiEnabled: %t,
				mfgFlowDir: 'output-to-raw',
				mfgOverrides: '',
				mfgME: %d,
				bpModalOpen: false,
				bpSearch: '',
				bpCategory: 'ALL',
				bpTech: 0,
				bpPage: 1,
				bpTotal: %d,
				bpTotalPages: 1,
				bpCategories: [],
				bpItems: [],
				bpLoading: false,
				bpSearchTimer: null,
				selectedBP: {
					blueprint_type_id: %d,
					product_type_id: %d,
					product_name: %q,
					category: %q,
					tech_level: %d,
					product_qty_per_run: %d
				},
				openBPModal() {
					this.bpModalOpen = true;
					this.fetchBlueprints(this.bpPage);
				},
				onBPSearchInput() {
					clearTimeout(this.bpSearchTimer);
					this.bpSearchTimer = setTimeout(() => {
						this.bpPage = 1;
						this.fetchBlueprints(1);
					}, 200);
				},
				setBPCategory(cat) {
					this.bpCategory = cat;
					this.bpPage = 1;
					this.fetchBlueprints(1);
				},
				setBPTech(t) {
					this.bpTech = t;
					this.bpPage = 1;
					this.fetchBlueprints(1);
				},
				async fetchBlueprints(page) {
					this.bpLoading = true;
					try {
						const params = new URLSearchParams({
							q: this.bpSearch.trim(),
							category: this.bpCategory === 'ALL' ? '' : this.bpCategory,
							tech: String(this.bpTech),
							page: String(page || 1),
							limit: '24'
						});
						const res = await fetch('/calculator/blueprints/search?' + params.toString());
						if (res.ok) {
							const data = await res.json();
							this.bpItems = data.items || [];
							this.bpTotal = data.total || 0;
							this.bpPage = data.page || 1;
							this.bpTotalPages = data.total_pages || 1;
							if (Array.isArray(data.categories) && data.categories.length > 0) {
								this.bpCategories = data.categories;
							}
						}
					} catch (e) {
						console.error('Blueprint search failed:', e);
					} finally {
						this.bpLoading = false;
					}
				},
				submitTree() {
					this.$nextTick(() => {
						const form = document.getElementById('mfg-tree-form');
						if (form && window.htmx) window.htmx.trigger(form, 'submit');
					});
				},
				chooseBlueprint(bp) {
					this.selectedBP = bp;
					this.mfgOverrides = '';
					this.mfgME = (bp.tech_level >= 2) ? 2 : 10;
					this.bpModalOpen = false;
					this.submitTree();
				},
				toggleMakeBuy(typeID, nextDecision) {
					const map = {};
					if (this.mfgOverrides) {
						this.mfgOverrides.split(',').forEach(p => {
							const kv = p.split(':');
							if (kv.length === 2 && kv[0]) map[kv[0]] = kv[1];
						});
					}
					map[String(typeID)] = nextDecision;
					this.mfgOverrides = Object.entries(map).map(([k, v]) => k + ':' + v).join(',');
					this.submitTree();
				},
				resetMakeBuyOverrides() {
					this.mfgOverrides = '';
					this.submitTree();
				}
			}`,
				mode.IsAdmin(),
				mode.AI.Enabled,
				func() int {
					if initialResult != nil {
						return initialResult.ME
					}
					return 10
				}(),
				len(blueprints),
				func() int32 {
					if initialResult != nil {
						return initialResult.Blueprint.BlueprintTypeID
					}
					return 0
				}(),
				func() int32 {
					if initialResult != nil {
						return initialResult.Blueprint.ProductTypeID
					}
					return 0
				}(),
				func() string {
					if initialResult != nil {
						return initialResult.Blueprint.ProductName
					}
					return ""
				}(),
				func() string {
					if initialResult != nil {
						return initialResult.Blueprint.Category
					}
					return ""
				}(),
				func() int {
					if initialResult != nil {
						return initialResult.Blueprint.TechLevel
					}
					return 0
				}(),
				func() int {
					if initialResult != nil {
						return initialResult.Blueprint.ProductQtyPerRun
					}
					return 1
				}(),
			) }
		>
			<!-- Header -->
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div>
					<div class="flex flex-wrap items-center gap-2">
						<h1 class="text-2xl font-bold tracking-tight text-white">Manufacture &amp; Profit</h1>
						<span class="rounded-full border border-sky-400/40 bg-sky-500/15 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-sky-200">
							Default Hub: { settings.ActiveTradeHub().Name }
						</span>
						<a
							href="/settings"
							title="Configured in Settings"
							class="rounded-full border border-slate-700 bg-slate-900/80 px-2.5 py-0.5 font-mono text-[10px] text-slate-300 hover:border-amber-400/50 hover:text-amber-200 transition"
						>
							{ fmt.Sprintf("SCI %.2f%% • Facility %.2f%% • Broker %.2f%% • Tax %.2f%%", settings.SystemCostIndex*100.0, settings.FacilityTaxPercent, settings.BrokerFeePercent, settings.SalesTaxPercent) }
						</a>
					</div>
					<p class="text-xs text-slate-300/80 mt-0.5">Unified CCP SDE Blueprint Workbench &amp; Profit Calculator: horizontal recipe tree, MAKE/BUY toggles, net profit after taxes &amp; fees, Break-Even Floor, ISK/Hour, and 1-click EVE Multibuy.</p>
				</div>
			</div>

			<!-- Compact 1-Row Control Bar -->
			<div class="tactical-panel rounded-xl p-4">
				<form
					id="mfg-tree-form"
					hx-post="/manufacture/tree"
					hx-target="#mfg-tree-panel"
					hx-swap="innerHTML"
					hx-indicator="#mfg-tree-spinner"
					class="grid grid-cols-1 gap-3 md:grid-cols-12 items-end"
				>
					<input type="hidden" name="make_buy_overrides" x-model="mfgOverrides"/>
					<input type="hidden" name="blueprint_type_id" :value="selectedBP.blueprint_type_id" required/>

					<!-- Blueprint Picker -->
					<div class="md:col-span-3">
						<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Blueprint (T1 / T2 / T3 / Reactions)</label>
						<button
							type="button"
							@click="openBPModal()"
							class="w-full min-h-[42px] flex items-center justify-between gap-2.5 rounded-lg border border-amber-400/45 bg-slate-900/90 px-3 py-1.5 text-left hover:border-amber-300/80 hover:bg-slate-900 transition cursor-pointer"
						>
							<div x-show="selectedBP.blueprint_type_id > 0" class="flex items-center gap-2.5 min-w-0">
								<img
									x-show="selectedBP.product_type_id > 0"
									:src="'https://images.evetech.net/types/' + selectedBP.product_type_id + '/icon?size=64'"
									:alt="selectedBP.product_name"
									class="h-8 w-8 shrink-0 rounded-lg border border-violet-400/35 bg-slate-950 p-0.5 object-contain"
									onerror="this.style.display='none'"
								/>
								<div class="min-w-0">
									<div class="text-xs font-bold text-white truncate" x-text="selectedBP.product_name"></div>
									<div class="flex items-center gap-1.5 text-[10px] font-mono text-slate-400">
										<span class="rounded border border-violet-400/35 bg-violet-500/20 px-1 text-violet-200 font-bold" x-text="'T' + (selectedBP.tech_level || 1)"></span>
										<span class="truncate" x-text="selectedBP.category || 'Catalog'"></span>
									</div>
								</div>
							</div>
							<span x-show="selectedBP.blueprint_type_id <= 0" class="text-xs text-slate-500 truncate"></span>
							<span class="ml-auto shrink-0 rounded border border-amber-400/45 bg-amber-500/15 px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-amber-200">
								Browse
							</span>
						</button>
					</div>

					<!-- Trade Hub -->
					<div class="md:col-span-2">
						<label class="block text-[10px] font-mono uppercase text-sky-300 mb-1">Price Hub</label>
						<select
							name="hub_key"
							@change="submitTree()"
							class="w-full rounded-lg border border-sky-500/40 bg-slate-900 px-2.5 py-2.5 text-xs font-semibold text-amber-200"
						>
							for _, h := range domain.MajorTradeHubs {
								<option value={ h.Key } selected?={ (initialResult != nil && initialResult.PriceHub.Key == h.Key) || ((initialResult == nil || initialResult.PriceHub.Key == "") && h.Key == settings.ActiveTradeHub().Key) }>{ h.Name }</option>
							}
						</select>
					</div>

					<!-- Price Source -->
					<div class="md:col-span-2">
						<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Material Pricing</label>
						<select
							name="material_price_source"
							@change="submitTree()"
							class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-2.5 text-xs text-white"
						>
							<option value="jita_sell">Lowest Sell (Instant)</option>
							<option value="jita_buy">Highest Buy (Orders)</option>
						</select>
					</div>

					<!-- Runs -->
					<div class="md:col-span-1">
						<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Runs</label>
						<input
							type="number"
							name="runs"
							value={ func() string {
								if initialResult != nil && initialResult.Runs > 0 {
									return fmt.Sprintf("%d", initialResult.Runs)
								}
								return "1"
							}() }
							min="1"
							max="10000"
							class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-2.5 text-xs font-mono text-white"
						/>
					</div>

					<!-- Material Efficiency -->
					<div class="md:col-span-1">
						<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">ME (0–10)</label>
						<input
							type="number"
							name="me"
							x-model.number="mfgME"
							min="0"
							max="10"
							class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-2.5 text-xs font-mono text-white"
						/>
					</div>

					<!-- Time Efficiency -->
					<div class="md:col-span-1">
						<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">TE (0–20)</label>
						<input
							type="number"
							name="te"
							value={ func() string {
								if initialResult != nil {
									return fmt.Sprintf("%d", initialResult.TE)
								}
								return "20"
							}() }
							min="0"
							max="20"
							class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-2.5 text-xs font-mono text-white"
						/>
					</div>

					<!-- Load Button -->
					<div class="md:col-span-2">
						<button
							type="submit"
							:disabled="selectedBP.blueprint_type_id <= 0"
							class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-amber-400 px-4 py-2.5 text-xs font-extrabold uppercase tracking-wider text-slate-950 hover:bg-amber-300 disabled:opacity-45 disabled:cursor-not-allowed transition cursor-pointer"
						>
							<span id="mfg-tree-spinner" class="htmx-indicator h-3.5 w-3.5 animate-spin rounded-full border-2 border-slate-950 border-t-transparent"></span>
							<span>Calculate &amp; Load Tree</span>
						</button>
					</div>

					<!-- Structure Row + Collapsible Auto-Determined Advanced Overrides -->
					<div
						x-data="{ showAdv: false }"
						class="md:col-span-12 space-y-3 pt-2 border-t border-violet-400/15"
					>
						<div class="flex flex-wrap items-center justify-between gap-3">
							<div class="flex flex-wrap items-center gap-2 text-xs">
								<span class="font-mono text-[10px] uppercase text-slate-400">Structure Profile:</span>
								<select
									name="structure_key"
									@change="submitTree()"
									class="rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-slate-200"
								>
									for _, st := range domain.DefaultStructureProfiles {
										<option value={ st.Key }>{ st.Name }</option>
									}
								</select>
								<span class="rounded border border-emerald-400/35 bg-emerald-500/15 px-1.5 py-0.5 font-mono text-[9.5px] font-bold text-emerald-200">
									AUTO FEES &amp; RELISTS
								</span>
							</div>
							<button
								type="button"
								@click="showAdv = !showAdv"
								class="rounded-md border border-violet-400/35 bg-violet-500/15 px-2.5 py-1 font-mono text-[10px] font-bold text-violet-200 hover:bg-violet-500/25 transition cursor-pointer"
							>
								<span x-text="showAdv ? 'Hide Advanced Overrides ▲' : 'Advanced Overrides (Sell, BPC, Fees) ▼'"></span>
							</button>
						</div>

						<!-- Collapsible What-If Override Inputs (leave blank = System Auto) -->
						<div x-cloak x-show="showAdv" class="grid grid-cols-2 gap-3 sm:grid-cols-4 rounded-lg border border-violet-400/20 bg-slate-950/50 p-3">
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Sell Price Override</label>
								<input type="number" step="0.01" min="0" name="product_sell_override" value="" placeholder="Auto (Live Hub)" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs font-mono text-white placeholder-slate-500"/>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Extra BPC / Setup (ISK)</label>
								<input type="number" step="0.01" min="0" name="extra_setup_cost" value="" placeholder="Auto (0 ISK)" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs font-mono text-white placeholder-slate-500"/>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Estimated Relists</label>
								<input type="number" min="0" name="estimated_relists" value="" placeholder="Auto (Jita 2x / Hub 1x)" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs font-mono text-white placeholder-slate-500"/>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Batches / Week</label>
								<input type="number" min="1" name="batches_per_week" value="" placeholder="Auto (4/wk)" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs font-mono text-white placeholder-slate-500"/>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">System Cost Index</label>
								<input type="number" step="0.0001" min="0" name="system_cost_index" value="" placeholder={ fmt.Sprintf("Auto (%.4f)", settings.SystemCostIndex) } class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs font-mono text-white placeholder-slate-500"/>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Freight (ISK / m³)</label>
								<input type="number" step="0.01" min="0" name="freight_cost_per_m3" value="" placeholder="Auto (0 ISK/m³)" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs font-mono text-white placeholder-slate-500"/>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Broker Fee (%)</label>
								<input type="number" step="0.01" min="0" name="broker_fee_percent" value="" placeholder={ fmt.Sprintf("Auto (%.2f%%)", settings.BrokerFeePercent) } class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs font-mono text-white placeholder-slate-500"/>
							</div>
							<div>
								<label class="block text-[10px] font-mono uppercase text-slate-300 mb-1">Sales Tax (%)</label>
								<input type="number" step="0.01" min="0" name="sales_tax_percent" value="" placeholder={ fmt.Sprintf("Auto (%.2f%%)", settings.SalesTaxPercent) } class="w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs font-mono text-white placeholder-slate-500"/>
							</div>
							<div class="col-span-2 sm:col-span-4 flex items-center justify-between text-[10.5px] text-slate-400 pt-1">
								<span>Leave any field blank to let aura-forge apply optimal automatic values from Settings &amp; Hub competition.</span>
								<button
									type="button"
									onclick="this.closest('form').querySelectorAll('input[name=product_sell_override],input[name=extra_setup_cost],input[name=estimated_relists],input[name=batches_per_week],input[name=system_cost_index],input[name=freight_cost_per_m3],input[name=broker_fee_percent],input[name=sales_tax_percent]').forEach(i=>i.value='')"
									class="rounded border border-slate-600 bg-slate-800 px-2 py-0.5 font-mono text-[10px] text-slate-200 hover:bg-slate-700 cursor-pointer"
								>
									Reset to Auto
								</button>
							</div>
						</div>
					</div>
				</form>
			</div>

			<!-- Full-Width Recipe Cost Summary + Horizontal Blueprint Tree Canvas -->
			<div id="mfg-tree-panel">
				if initialResult != nil {
					@ManufactureTreePartial(initialResult, "")
				} else {
					<div class="tactical-panel rounded-xl p-10 text-center space-y-3">
						<div class="text-sm font-bold text-white">Ready to Inspect Blueprint Recipe Tree</div>
						<p class="text-xs text-slate-400 max-w-lg mx-auto">
							Click <strong>Browse</strong> above to pick any EVE Online Blueprint (T1, T2, T3, or Reactions) or click <strong>Load Tree</strong> to visualize its horizontal recipe tree and total recipe cost at <strong>{ settings.ActiveTradeHub().Name }</strong>.
						</p>
					</div>
				}
			</div>

			<!-- Blueprint Catalog Browser Modal (Teleported to body with margin-top: 0) -->
			<template x-teleport="body">
				<div
					x-cloak
					x-show="bpModalOpen"
					x-transition.opacity.duration.150ms
					@keydown.escape.window="bpModalOpen = false"
					style="margin-top: 0;"
					class="fixed inset-0 z-[95] flex items-center justify-center p-4"
				>
					<div @click="bpModalOpen = false" class="fixed inset-0 bg-slate-950/80 backdrop-blur-xs"></div>

					<div class="relative z-10 flex max-h-[85vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-amber-400/45 bg-[#0e1026] shadow-2xl">
						<div class="flex items-center justify-between gap-3 border-b border-violet-400/20 bg-slate-950/90 px-5 py-3.5">
							<div>
								<h2 class="text-sm font-bold uppercase tracking-wider text-amber-300">EVE Online Blueprint Catalog (CCP SDE)</h2>
								<p class="text-[11px] font-mono text-slate-400 mt-0.5">
									Showing <span class="text-white font-bold" x-text="bpTotal"></span> blueprint(s) • Click any blueprint to immediately load its horizontal tree
								</p>
							</div>
							<button type="button" @click="bpModalOpen = false" class="rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1 text-xs text-slate-300 hover:text-white cursor-pointer">
								✕ Close
							</button>
						</div>

						<div class="space-y-3 border-b border-violet-400/15 bg-slate-950/60 px-5 py-3">
							<div class="flex flex-wrap items-center gap-2">
								<input
									type="search"
									x-model="bpSearch"
									@input="onBPSearchInput()"
									placeholder="Search any blueprint (e.g. Hobgoblin II, Caracal, Muninn, Fullerides)..."
									class="min-w-[220px] flex-1 rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white placeholder-slate-500 focus:border-amber-400 focus:outline-none"
								/>
								<div class="inline-flex rounded-lg border border-slate-700 bg-slate-900 p-0.5 font-mono text-[10px]">
									<button type="button" @click="setBPTech(0)" :class="bpTech === 0 ? 'bg-amber-400 text-slate-950 font-bold' : 'text-slate-300 hover:text-white'" class="rounded px-2.5 py-1 cursor-pointer">All Tech</button>
									<button type="button" @click="setBPTech(1)" :class="bpTech === 1 ? 'bg-sky-400 text-slate-950 font-bold' : 'text-slate-300 hover:text-white'" class="rounded px-2.5 py-1 cursor-pointer">T1</button>
									<button type="button" @click="setBPTech(2)" :class="bpTech === 2 ? 'bg-violet-400 text-slate-950 font-bold' : 'text-slate-300 hover:text-white'" class="rounded px-2.5 py-1 cursor-pointer">T2</button>
									<button type="button" @click="setBPTech(3)" :class="bpTech === 3 ? 'bg-emerald-400 text-slate-950 font-bold' : 'text-slate-300 hover:text-white'" class="rounded px-2.5 py-1 cursor-pointer">T3</button>
								</div>
							</div>

							<div class="flex flex-wrap gap-1.5" x-show="bpCategories.length > 0">
								<button
									type="button"
									@click="setBPCategory('ALL')"
									:class="bpCategory === 'ALL' ? 'border-amber-400/70 bg-amber-400/20 text-amber-200 font-bold' : 'border-slate-700 bg-slate-900/70 text-slate-300 hover:text-white'"
									class="rounded-md border px-2 py-0.5 font-mono text-[10px] cursor-pointer"
								>ALL</button>
								<template x-for="cat in bpCategories" :key="cat">
									<button
										type="button"
										@click="setBPCategory(cat)"
										:class="bpCategory === cat ? 'border-amber-400/70 bg-amber-400/20 text-amber-200 font-bold' : 'border-slate-700 bg-slate-900/70 text-slate-300 hover:text-white'"
										class="rounded-md border px-2 py-0.5 font-mono text-[10px] cursor-pointer"
										x-text="cat"
									></button>
								</template>
							</div>
						</div>

						<div class="flex-1 overflow-y-auto p-4">
							<div x-show="bpLoading" class="py-12 text-center font-mono text-xs text-amber-300">Loading SDE blueprints...</div>
							<div x-show="!bpLoading && bpItems.length === 0" class="py-12 text-center text-xs text-slate-400">No matching blueprints found.</div>
							<div x-show="!bpLoading && bpItems.length > 0" class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
								<template x-for="bp in bpItems" :key="bp.blueprint_type_id">
									<button
										type="button"
										@click="chooseBlueprint(bp)"
										class="flex items-center gap-3 rounded-xl border border-violet-400/20 bg-slate-900/70 p-2.5 text-left hover:border-amber-400/65 hover:bg-slate-900 transition cursor-pointer"
									>
										<img
											:src="'https://images.evetech.net/types/' + bp.product_type_id + '/icon?size=64'"
											:alt="bp.product_name"
											loading="lazy"
											class="h-10 w-10 shrink-0 rounded-lg border border-slate-700/80 bg-slate-950 p-0.5 object-contain"
											onerror="this.style.display='none'"
										/>
										<div class="min-w-0 flex-1">
											<div class="text-xs font-bold text-white truncate" x-text="bp.product_name"></div>
											<div class="mt-0.5 flex items-center gap-1.5 font-mono text-[10px] text-slate-400">
												<span class="rounded border border-violet-400/35 bg-violet-500/15 px-1 text-violet-200 font-bold" x-text="'T' + (bp.tech_level || 1)"></span>
												<span class="truncate" x-text="bp.category"></span>
											</div>
										</div>
									</button>
								</template>
							</div>
						</div>

						<div class="flex items-center justify-between border-t border-violet-400/20 bg-slate-950/90 px-5 py-2.5 font-mono text-[11px] text-slate-300">
							<span>Page <strong class="text-white" x-text="bpPage"></strong> of <strong class="text-white" x-text="bpTotalPages"></strong></span>
							<div class="flex gap-2">
								<button type="button" @click="if (bpPage > 1) fetchBlueprints(bpPage - 1)" :disabled="bpPage <= 1" class="rounded border border-slate-700 bg-slate-900 px-3 py-1 disabled:opacity-40 cursor-pointer">← Prev</button>
								<button type="button" @click="if (bpPage < bpTotalPages) fetchBlueprints(bpPage + 1)" :disabled="bpPage >= bpTotalPages" class="rounded border border-slate-700 bg-slate-900 px-3 py-1 disabled:opacity-40 cursor-pointer">Next →</button>
							</div>
						</div>
					</div>
				</div>
			</template>
		</div>
	}
}

templ ManufactureTreePartial(res *domain.BlueprintCalcResult, errMsg string) {
	if errMsg != "" {
		<div class="tactical-panel rounded-xl border-rose-500/40 bg-rose-950/30 p-4 text-xs text-rose-200">
			<strong>Recipe Tree Error:</strong> { errMsg }
		</div>
	} else if res != nil && res.IndustryTree != nil {
		{{
			tree := res.IndustryTree
			canvas := BuildIndustryHorizontalCanvasLayout(tree.RootNode)
			outputValue := res.ProductUnitSellPrice * float64(res.TotalOutputQty)
			grossSpread := outputValue - tree.OptimalCost
			jobInstallTotal := calcTreeJobInstallTotal(tree)
			materialsOnly := tree.OptimalCost - jobInstallTotal
			if materialsOnly < 0 {
				materialsOnly = 0
			}
			presetsJSON := buildShoppingPresetsJSON(tree)
			nodeIngJSON := buildNodeIngredientsJSON(tree.RootNode)
			multibuy := tree.OptimalMultibuy
			if multibuy == "" {
				multibuy = res.MultibuyText
			}
		}}
		<div
			class="space-y-5"
			x-data={ fmt.Sprintf(`{
				copiedKey: '',
				shopMode: 'active',
				presets: %s,
				nodeIngredients: %s,
				multibuy: %q,
				get currentItems() {
					return this.presets[this.shopMode] || [];
				},
				get checkedItems() {
					return this.currentItems.filter(it => it.checked);
				},
				get checkedTotalCost() {
					return this.checkedItems.reduce((sum, it) => sum + (Number(it.total_cost) || 0), 0);
				},
				get checkedMultibuy() {
					return this.checkedItems.map(it => it.name + '\t' + it.qty).join('\n');
				},
				formatISKShort(v) {
					const n = Number(v) || 0;
					if (Math.abs(n) >= 1e9) return (n / 1e9).toFixed(2) + 'B ISK';
					if (Math.abs(n) >= 1e6) return (n / 1e6).toFixed(2) + 'M ISK';
					if (Math.abs(n) >= 1e3) return (n / 1e3).toFixed(1) + 'K ISK';
					return n.toFixed(2) + ' ISK';
				},
				setAllChecked(val) {
					this.currentItems.forEach(it => { it.checked = val; });
				},
				copyText(text, key, label) {
					if (!text) return;
					navigator.clipboard.writeText(text).then(() => {
						this.copiedKey = key;
						window.dispatchEvent(new CustomEvent('showToast', { detail: { level: 'success', message: label + ' copied to clipboard!' } }));
						setTimeout(() => { if (this.copiedKey === key) this.copiedKey = ''; }, 2200);
					});
				},
				copyMultibuy() {
					this.copyText(this.multibuy, 'optimal', 'Active MAKE/BUY Multibuy');
				},
				copyChecked() {
					const modeLabel = this.shopMode === 'direct' ? 'Direct Inputs' : (this.shopMode === 'raw' ? 'Base/Raw' : 'Active Plan');
					this.copyText(this.checkedMultibuy, 'checked', modeLabel + ' (' + this.checkedItems.length + ' items)');
				},
				copyNodeIngredients(typeID, name) {
					const text = this.nodeIngredients[String(typeID)];
					if (!text) return;
					this.copyText(text, 'node-' + typeID, name + ' Ingredients');
				}
			}`, presetsJSON, nodeIngJSON, multibuy) }
		>
			<!-- 4 Top Recipe Cost KPI Cards -->
			<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
				<div class="tactical-panel rounded-xl p-4 border-emerald-400/35">
					<div class="text-[10px] font-mono uppercase text-emerald-300/90">Total Recipe Cost ({ res.PriceHub.Name })</div>
					<div class="mt-1 text-2xl font-mono font-bold text-white">{ FormatISK(tree.OptimalCost) }</div>
					<div class="mt-0.5 text-[10.5px] font-mono text-slate-300">
						Materials: <span class="text-white">{ FormatISK(materialsOnly) }</span> • Job Install: <span class="text-amber-200">{ FormatISK(jobInstallTotal) }</span>
					</div>
					if tree.OptimalSavingsISK > 0 {
						<div class="mt-0.5 text-[10px] font-mono text-emerald-300">
							Saves { FormatISK(tree.OptimalSavingsISK) } ({ FormatPercent(tree.OptimalSavingsPct) }) vs Buy Direct
						</div>
					} else {
						<div class="mt-0.5 text-[10px] font-mono text-slate-400">
							{ fmt.Sprintf("%dx runs • %d units • SCI + Facility Tax from Settings", res.Runs, res.TotalOutputQty) }
						</div>
					}
				</div>

				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-sky-300/90">Buy All Direct ({ res.PriceHub.Name })</div>
					<div class="mt-1 text-2xl font-mono font-bold text-sky-200">{ FormatISK(tree.BuyAllDirectCost) }</div>
					<div class="mt-0.5 text-[11px] font-mono text-slate-400">
						Make All: <span class="text-slate-200">{ FormatISK(tree.MakeAllCost) }</span>
					</div>
				</div>

				<div class="tactical-panel rounded-xl p-4">
					<div class="text-[10px] font-mono uppercase text-amber-300/90">Output Sell Value ({ res.PriceHub.Name })</div>
					<div class="mt-1 text-2xl font-mono font-bold text-amber-200">{ FormatISK(outputValue) }</div>
					<div class={ "mt-0.5 text-[11px] font-mono " + profitColor(grossSpread) }>
						Spread: { FormatISK(grossSpread) } ({ FormatISK(res.ProductUnitSellPrice) }/unit)
					</div>
				</div>

				<div class="tactical-panel rounded-xl p-4 flex flex-col justify-between gap-2">
					<div>
						<div class="text-[10px] font-mono uppercase text-violet-300/90">Material Volume &amp; Quick Actions</div>
						<div class="mt-1 text-xl font-mono font-bold text-violet-200">{ fmt.Sprintf("%.1f m³", tree.OptimalVolumeM3) }</div>
					</div>
					<div class="flex flex-wrap gap-1.5">
						<button
							type="button"
							@click="copyMultibuy()"
							class="flex-1 rounded-md border border-emerald-400/50 bg-emerald-500/20 px-2.5 py-1.5 text-[11px] font-bold text-emerald-200 hover:bg-emerald-500/30 transition cursor-pointer"
						>
							<span x-show="copiedKey !== 'optimal'">Copy Multibuy</span>
							<span x-cloak x-show="copiedKey === 'optimal'">Copied!</span>
						</button>
						<form
							x-show="isAdmin"
							hx-post="/calculator/blueprint/save-catalog"
							hx-swap="none"
							class="flex-1"
						>
							<input type="hidden" name="product_type_id" value={ fmt.Sprintf("%d", res.Blueprint.ProductTypeID) }/>
							<input type="hidden" name="product_name" value={ res.Blueprint.ProductName }/>
							<input type="hidden" name="category" value={ res.Blueprint.Category }/>
							<input type="hidden" name="output_qty" value={ fmt.Sprintf("%d", res.TotalOutputQty) }/>
							<input type="hidden" name="unit_sell_price" value={ fmt.Sprintf("%.2f", res.ProductUnitSellPrice) }/>
							<input type="hidden" name="unit_buy_price" value={ fmt.Sprintf("%.2f", res.ProductUnitBuyPrice) }/>
							<input type="hidden" name="material_cost" value={ fmt.Sprintf("%.2f", tree.OptimalCost) }/>
							<button
								type="submit"
								class="w-full rounded-md border border-amber-400/50 bg-amber-400/20 px-2.5 py-1.5 text-[11px] font-bold text-amber-200 hover:bg-amber-400/30 transition cursor-pointer"
							>
								+ Catalog
							</button>
						</form>
					</div>
				</div>
			</div>

			<!-- Integrated Net Profit, Tax, Break-Even Floor & ISK/Hour Analysis -->
			{{ recSell := domain.RoundEVETick(res.ProductUnitSellPrice * 0.999) }}
			<div class="tactical-panel rounded-xl p-4 space-y-3 border-violet-400/30">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div class="flex items-center gap-2">
						<span class="rounded border border-amber-400/40 bg-amber-500/15 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-200">PROFIT &amp; TAX AUDIT</span>
						<span class="text-xs font-semibold text-white">True Net Margin, Break-Even Floor &amp; Build Time</span>
					</div>
					<span class="font-mono text-[10.5px] text-slate-400">
						Duration: <strong class="text-white">{ res.DurationFormatted }</strong> • { fmt.Sprintf("ME %d / TE %d", res.ME, res.TE) }
					</span>
				</div>

				<div class="grid grid-cols-2 gap-3 lg:grid-cols-4 font-mono">
					<div class="rounded-lg border border-violet-400/20 bg-slate-950/60 p-3">
						<div class="text-[10px] uppercase text-slate-400">Net Profit (After Fees)</div>
						<div class={ "mt-1 text-lg font-bold " + profitColor(res.Profit.NetProfitPerBatch) }>{ FormatISK(res.Profit.NetProfitPerBatch) }</div>
						<div class="mt-0.5 text-[10px] text-slate-300">
							Margin <strong class={ profitColor(res.Profit.NetMarginPercent) }>{ FormatPercent(res.Profit.NetMarginPercent) }</strong> • ROI <strong class={ profitColor(res.Profit.ROIPercent) }>{ FormatPercent(res.Profit.ROIPercent) }</strong>
						</div>
					</div>
					<div class="rounded-lg border border-violet-400/20 bg-slate-950/60 p-3">
						<div class="text-[10px] uppercase text-slate-400">Rec. Sell / Anti-Undercut Floor</div>
						<div class="mt-1 text-lg font-bold text-amber-200">
							if recSell > 0 {
								{ FormatISK(recSell) }
							} else {
								{ FormatISK(res.ProductUnitSellPrice) }
							}
						</div>
						<div class={ "mt-0.5 text-[10px] " + func() string {
							if res.Profit.BreakEvenUnitPrice > 0 && res.ProductUnitSellPrice <= res.Profit.BreakEvenUnitPrice {
								return "text-rose-300 font-bold"
							}
							return "text-slate-400"
						}() }>
							Break-Even Floor: <strong class="text-slate-200">{ FormatISK(res.Profit.BreakEvenUnitPrice) }</strong>/u
						</div>
					</div>
					<div class="rounded-lg border border-violet-400/20 bg-slate-950/60 p-3">
						<div class="text-[10px] uppercase text-slate-400">ISK / Hour Efficiency</div>
						<div class={ "mt-1 text-lg font-bold " + profitColor(res.ISKPerHour) }>{ FormatISK(res.ISKPerHour) }/h</div>
						<div class="mt-0.5 text-[10px] text-slate-400">
							Per Unit Net: <span class={ profitColor(res.Profit.NetProfitPerUnit) }>{ FormatISK(res.Profit.NetProfitPerUnit) }</span>
						</div>
					</div>
					<div class="rounded-lg border border-violet-400/20 bg-slate-950/60 p-3">
						<div class="text-[10px] uppercase text-slate-400">Taxes, Fees &amp; Freight</div>
						<div class="mt-1 text-lg font-bold text-rose-200">{ FormatISK(res.Profit.TotalMarketFees + res.FreightCost) }</div>
						<div class="mt-0.5 text-[10px] text-slate-400">
							Broker { FormatISK(res.Profit.BrokerFee) } • Tax { FormatISK(res.Profit.SalesTax) } • Relist { FormatISK(res.Profit.RelistFee) }
						</div>
					</div>
				</div>
			</div>

			<!-- FULL-WIDTH HORIZONTAL BLUEPRINT TREE CANVAS -->
			<div
				x-data={ fmt.Sprintf(`{
					scale: 1,
					tx: 24,
					ty: 24,
					cw: %d,
					ch: %d,
					dragging: false,
					moved: false,
					startX: 0,
					startY: 0,
					fullscreen: false,
					focusedNodeID: '',
					focusedTypeID: 0,
					focusedName: '',
					focusedDecision: '',
					focusedCanToggle: false,
					branchMap: %s,
					init() {
						this.$nextTick(() => this.fitView());
					},
					fitView() {
						const vp = this.$refs.mfgViewport;
						if (!vp || vp.clientWidth <= 0) return;
						const pad = 32;
						const sx = (vp.clientWidth - pad) / this.cw;
						const sy = (vp.clientHeight - pad) / this.ch;
						this.scale = Math.max(0.30, Math.min(1.05, Math.min(sx, sy)));
						this.tx = Math.max(16, (vp.clientWidth - this.cw * this.scale) / 2);
						this.ty = Math.max(16, (vp.clientHeight - this.ch * this.scale) / 2);
					},
					resetView() { this.scale = 1; this.tx = 24; this.ty = 24; },
					zoomIn() { this.scale = Math.min(2.2, +(this.scale * 1.18).toFixed(3)); },
					zoomOut() { this.scale = Math.max(0.25, +(this.scale / 1.18).toFixed(3)); },
					toggleFullscreen() {
						this.fullscreen = !this.fullscreen;
						this.$nextTick(() => this.fitView());
					},
					toggleFlowDir() {
						mfgFlowDir = (mfgFlowDir === 'output-to-raw') ? 'raw-to-output' : 'output-to-raw';
					},
					onWheel(e) {
						const vp = this.$refs.mfgViewport;
						if (!vp) return;
						const rect = vp.getBoundingClientRect();
						const mx = e.clientX - rect.left;
						const my = e.clientY - rect.top;
						const factor = e.deltaY < 0 ? 1.12 : 1 / 1.12;
						const next = Math.max(0.25, Math.min(2.2, this.scale * factor));
						const ratio = next / this.scale;
						this.tx = mx - (mx - this.tx) * ratio;
						this.ty = my - (my - this.ty) * ratio;
						this.scale = +next.toFixed(3);
					},
					startDrag(e) {
						this.dragging = true;
						this.moved = false;
						this.startX = e.clientX - this.tx;
						this.startY = e.clientY - this.ty;
					},
					onDrag(e) {
						if (!this.dragging) return;
						const nx = e.clientX - this.startX;
						const ny = e.clientY - this.startY;
						if (Math.abs(nx - this.tx) > 3 || Math.abs(ny - this.ty) > 3) this.moved = true;
						this.tx = nx;
						this.ty = ny;
					},
					endDrag() {
						if (!this.dragging) return;
						this.dragging = false;
						setTimeout(() => { this.moved = false; }, 20);
					},
					selectNode(nodeID, typeID, name, decision, canToggle) {
						if (this.moved) return;
						if (this.focusedNodeID === nodeID) {
							this.clearFocus();
							return;
						}
						this.focusedNodeID = nodeID;
						this.focusedTypeID = typeID;
						this.focusedName = name;
						this.focusedDecision = decision;
						this.focusedCanToggle = canToggle;
					},
					clearFocus() {
						this.focusedNodeID = '';
						this.focusedTypeID = 0;
						this.focusedName = '';
						this.focusedDecision = '';
						this.focusedCanToggle = false;
					},
					isNodeInBranch(id) {
						if (!this.focusedNodeID) return true;
						const list = this.branchMap[this.focusedNodeID];
						return Array.isArray(list) && list.includes(id);
					},
					isEdgeInBranch(fromID, toID) {
						if (!this.focusedNodeID) return true;
						const list = this.branchMap[this.focusedNodeID];
						return Array.isArray(list) && list.includes(fromID) && list.includes(toID);
					}
				}`, canvas.Width, canvas.Height, canvas.BranchMapJSON) }
				@mousemove.window="onDrag($event)"
				@mouseup.window="endDrag()"
				@keydown.escape.window="if (fullscreen) { fullscreen = false; $nextTick(() => fitView()); }"
			>
				<div x-cloak x-show="fullscreen" @click="toggleFullscreen()" class="fixed inset-0 z-[90] bg-slate-950/80 backdrop-blur-xs"></div>

				<div
					:class="fullscreen ? 'fixed inset-4 z-[100] flex flex-col shadow-2xl border-amber-400/55 bg-[#0b0e1f]' : 'rounded-xl border border-violet-400/30 bg-[#0b0e1f]/90'"
					class="rounded-xl overflow-hidden border"
				>
					<!-- Canvas Toolbar -->
					<div class="flex flex-wrap items-center justify-between gap-2 border-b border-violet-400/20 bg-slate-950/90 px-4 py-2.5">
						<div class="flex flex-wrap items-center gap-2.5 text-xs">
							<span class="font-bold uppercase tracking-wider text-amber-300">{ res.Blueprint.ProductName } — Horizontal Recipe Tree</span>
							<span class="rounded-full border border-emerald-400/40 bg-emerald-500/15 px-2.5 py-0.5 font-mono text-[10.5px] font-bold text-emerald-200">
								Total ({ res.PriceHub.Name }): { FormatISK(tree.OptimalCost) }
							</span>
							<button
								type="button"
								x-show="aiEnabled"
								@click={ fmt.Sprintf("window.dispatchEvent(new CustomEvent('open-aura-ai', { detail: { prompt: %q } }))", fmt.Sprintf("Review the manufacturing recipe tree for %dx %s at %s (Optimal cost %s, Output value %s). Should I MAKE or BUY sub-components, and is it worth running for my capital?", res.Runs, res.Blueprint.ProductName, res.PriceHub.Name, FormatISK(tree.OptimalCost), FormatISK(outputValue))) }
								class="rounded border border-violet-400/50 bg-violet-500/20 px-2.5 py-0.5 font-mono text-[10px] font-bold text-violet-100 hover:bg-violet-500/35 cursor-pointer"
							>
								⚡ AI Build Strategy
							</button>
							if len(tree.ActiveOverrides) > 0 {
								<button type="button" @click="resetMakeBuyOverrides()" class="rounded border border-rose-400/45 bg-rose-500/15 px-2 py-0.5 font-mono text-[10px] font-bold text-rose-200 hover:bg-rose-500/25 cursor-pointer">
									Reset Overrides ({ fmt.Sprintf("%d", len(tree.ActiveOverrides)) })
								</button>
							}
						</div>
						<div class="flex flex-wrap items-center gap-1.5 font-mono text-[11px]">
							<button type="button" @click="toggleFlowDir()" class="inline-flex items-center gap-1 rounded border border-sky-400/40 bg-sky-500/15 px-2.5 py-1 text-sky-200 hover:bg-sky-500/25 cursor-pointer">
								<span x-text="mfgFlowDir === 'output-to-raw' ? 'Output → Raw' : 'Raw → Output'">Output → Raw</span>
							</button>
							<button type="button" @click="zoomOut()" class="rounded border border-slate-700 bg-slate-900 px-2 py-1 text-slate-200 hover:text-white cursor-pointer">−</button>
							<span class="min-w-[44px] text-center text-amber-200" x-text="Math.round(scale * 100) + '%'">100%</span>
							<button type="button" @click="zoomIn()" class="rounded border border-slate-700 bg-slate-900 px-2 py-1 text-slate-200 hover:text-white cursor-pointer">+</button>
							<button type="button" @click="fitView()" class="rounded border border-violet-400/35 bg-violet-500/15 px-2.5 py-1 text-violet-200 hover:bg-violet-500/25 cursor-pointer">Fit</button>
							<button type="button" @click="resetView()" class="rounded border border-slate-700 bg-slate-900 px-2 py-1 text-slate-300 hover:text-white cursor-pointer">1:1</button>
							<button type="button" @click="toggleFullscreen()" class="rounded border border-amber-400/40 bg-amber-500/15 px-2.5 py-1 text-amber-200 hover:bg-amber-500/25 cursor-pointer">
								<span x-show="!fullscreen">Expand</span>
								<span x-cloak x-show="fullscreen">Exit Full</span>
							</button>
						</div>
					</div>

					<!-- Viewport -->
					<div
						x-ref="mfgViewport"
						@mousedown.prevent="startDrag($event)"
						@click="if (!moved && $event.target === $refs.mfgViewport) clearFocus()"
						@wheel.prevent="onWheel($event)"
						:class="[dragging ? 'cursor-grabbing' : 'cursor-grab', fullscreen ? 'flex-1 min-h-0' : 'h-[560px]']"
						class="relative w-full overflow-hidden select-none bg-[#0a0d1c]"
						style="background-image: radial-gradient(rgba(167, 139, 250, 0.16) 1px, transparent 1px); background-size: 22px 22px;"
					>
						<div
							class="absolute top-0 left-0 origin-top-left will-change-transform"
							:style="`width: ${cw}px; height: ${ch}px; transform: translate3d(${tx}px, ${ty}px, 0) scale(${scale});`"
						>
							<svg width={ fmt.Sprintf("%d", canvas.Width) } height={ fmt.Sprintf("%d", canvas.Height) } viewBox={ fmt.Sprintf("0 0 %d %d", canvas.Width, canvas.Height) } class="pointer-events-none absolute inset-0" fill="none">
								for _, edge := range canvas.Edges {
									<path
										:d={ fmt.Sprintf("mfgFlowDir === 'output-to-raw' ? %q : %q", edge.PathD, edge.RevPathD) }
										:stroke={ fmt.Sprintf("focusedNodeID && isEdgeInBranch(%q, %q) ? '#fbbf24' : %q", edge.FromID, edge.ToID, indCanvasEdgeStroke(edge.Decision)) }
										:stroke-width={ fmt.Sprintf("focusedNodeID && isEdgeInBranch(%q, %q) ? 3 : 2", edge.FromID, edge.ToID) }
										:opacity={ fmt.Sprintf("isEdgeInBranch(%q, %q) ? 1 : 0.18", edge.FromID, edge.ToID) }
										stroke-linecap="round"
									></path>
								}
							</svg>

							for _, n := range canvas.Nodes {
								<div
									@click.stop={ fmt.Sprintf("selectNode(%q, %d, %q, %q, %t)", n.NodeID, n.TypeID, n.Name, string(n.Decision), n.CanToggleMake) }
									:class={ fmt.Sprintf("[focusedNodeID === %q ? 'ring-2 ring-amber-300 shadow-[0_0_24px_rgba(251,191,36,0.45)]' : '', isNodeInBranch(%q) ? 'opacity-100' : 'opacity-25']", n.NodeID, n.NodeID) }
									:style={ fmt.Sprintf("`left: ${mfgFlowDir === 'output-to-raw' ? %d : %d}px; top: %dpx; width: %dpx; min-height: %dpx;`", n.X, n.RevX, n.Y, n.Width, n.Height) }
									class={ "absolute rounded-xl border px-2.5 py-2 flex items-center gap-2.5 backdrop-blur-xs transition-all duration-150 cursor-pointer hover:border-amber-300/80 " + indCanvasNodeBorderClass(n.Decision, n.IsRoot) }
								>
									<img src={ EVEItemIconURL(n.TypeID, 64) } alt={ n.Name } draggable="false" class="h-10 w-10 shrink-0 rounded-lg border border-violet-400/30 bg-slate-950/90 p-0.5 object-contain pointer-events-none" onerror="this.style.display='none'"/>
									<div class="min-w-0 flex-1">
										<div class="flex items-center justify-between gap-1">
											<span class={ "rounded border px-1.5 py-0.5 font-mono text-[9px] font-bold leading-none " + indDecisionBadgeClass(n.Decision) }>
												{ string(n.Decision) }
											</span>
											<span class="font-mono text-[10.5px] font-bold text-amber-200">×{ fmt.Sprintf("%d", n.Quantity) }</span>
										</div>
										<div class="mt-1 text-xs font-semibold text-white truncate" title={ n.Name }>{ n.Name }</div>
										<div class="mt-0.5 font-mono text-[10px] text-slate-300">{ FormatISK(n.ActiveCost) }</div>
									</div>
								</div>
							}
						</div>

						<!-- Floating Action Bar when clicking a node -->
						<div
							x-cloak
							x-show="focusedNodeID !== ''"
							x-transition.opacity.duration.150ms
							class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex flex-wrap items-center gap-2 rounded-xl border border-amber-400/45 bg-slate-950/95 px-3.5 py-2 text-xs shadow-2xl backdrop-blur"
						>
							<span class="font-bold text-white" x-text="focusedName"></span>
							<span class="rounded border border-slate-700 bg-slate-900 px-1.5 py-0.5 font-mono text-[10px] text-amber-200" x-text="focusedDecision"></span>
							<template x-if="nodeIngredients[String(focusedTypeID)]">
								<button
									type="button"
									@click="copyNodeIngredients(focusedTypeID, focusedName)"
									class="rounded-md border border-sky-400/50 bg-sky-500/20 px-2.5 py-1 font-mono text-[10.5px] font-bold text-sky-200 hover:bg-sky-500/35 cursor-pointer"
								>
									<span x-show="copiedKey !== ('node-' + focusedTypeID)">Copy Ingredients (Multibuy)</span>
									<span x-cloak x-show="copiedKey === ('node-' + focusedTypeID)">Copied!</span>
								</button>
							</template>
							<template x-if="focusedCanToggle">
								<button
									type="button"
									@click="toggleMakeBuy(focusedTypeID, focusedDecision === 'MAKE' ? 'BUY' : 'MAKE')"
									class="rounded-md border border-emerald-400/50 bg-emerald-500/20 px-2.5 py-1 font-mono text-[10.5px] font-bold text-emerald-200 hover:bg-emerald-500/35 cursor-pointer"
									x-text="focusedDecision === 'MAKE' ? 'Switch to BUY' : 'Switch to MAKE'"
								></button>
							</template>
							<button type="button" @click="clearFocus()" class="rounded border border-slate-700 px-2 py-1 font-mono text-[10px] text-slate-300 hover:text-white cursor-pointer">Clear</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Smart Shopping List (3 Copy Presets + Hangar Checklist) -->
			<div class="tactical-panel rounded-xl p-5 space-y-4">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div>
						<h3 class="text-xs font-bold uppercase tracking-wider text-emerald-300">Smart Shopping List &amp; Hangar Checklist ({ res.PriceHub.Name })</h3>
						<p class="text-[11px] text-slate-400 mt-0.5">Choose your build strategy, uncheck items you already own in your hangar, and copy the exact EVE Multibuy list in 1 click. Click any craftable node in the tree above to copy its individual ingredients.</p>
					</div>
					<button
						type="button"
						@click="copyChecked()"
						:disabled="checkedItems.length === 0"
						class="rounded-md border border-emerald-400/50 bg-emerald-500/20 px-3.5 py-2 font-mono text-xs font-bold text-emerald-200 hover:bg-emerald-500/30 disabled:opacity-40 transition cursor-pointer"
					>
						<span x-show="copiedKey !== 'checked'">Copy Checked (<span x-text="checkedItems.length"></span> items • <span x-text="formatISKShort(checkedTotalCost)"></span>)</span>
						<span x-cloak x-show="copiedKey === 'checked'">Copied to Clipboard!</span>
					</button>
				</div>

				<!-- 3 Smart Copy Strategy Presets + Check All / None -->
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
					<div class="flex flex-wrap items-center gap-1.5">
						<button
							type="button"
							@click="shopMode = 'active'"
							:class="shopMode === 'active' ? 'border-emerald-400/70 bg-emerald-500/20 text-emerald-200 font-bold' : 'border-slate-700 bg-slate-900/70 text-slate-300 hover:text-white'"
							class="rounded-lg border px-3 py-1.5 font-mono text-[11px] transition cursor-pointer"
						>
							Active Plan (MAKE/BUY)
						</button>
						<button
							type="button"
							@click="shopMode = 'direct'"
							:class="shopMode === 'direct' ? 'border-sky-400/70 bg-sky-500/20 text-sky-200 font-bold' : 'border-slate-700 bg-slate-900/70 text-slate-300 hover:text-white'"
							class="rounded-lg border px-3 py-1.5 font-mono text-[11px] transition cursor-pointer"
						>
							Buy Direct Inputs (Layer 1)
						</button>
						<button
							type="button"
							@click="shopMode = 'raw'"
							:class="shopMode === 'raw' ? 'border-amber-400/70 bg-amber-400/20 text-amber-200 font-bold' : 'border-slate-700 bg-slate-900/70 text-slate-300 hover:text-white'"
							class="rounded-lg border px-3 py-1.5 font-mono text-[11px] transition cursor-pointer"
						>
							All Base / Raw (Make Everything)
						</button>
					</div>

					<div class="flex items-center gap-2 font-mono text-[10.5px]">
						<button type="button" @click="setAllChecked(true)" class="text-sky-300 hover:text-sky-200 underline cursor-pointer">Check All</button>
						<span class="text-slate-600">•</span>
						<button type="button" @click="setAllChecked(false)" class="text-slate-400 hover:text-slate-200 underline cursor-pointer">Uncheck All</button>
					</div>
				</div>

				<!-- Checklist Table + Live EVE Multibuy Preview -->
				<div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
					<div class="overflow-x-auto lg:col-span-8">
						<table class="w-full text-left text-xs">
							<thead class="border-b border-slate-800 font-mono uppercase text-[10px] text-slate-400">
								<tr>
									<th class="py-2 pr-2 w-8">Buy</th>
									<th class="py-2 pr-3">Material</th>
									<th class="py-2 px-3 text-right">Qty</th>
									<th class="py-2 px-3 text-right">Unit ({ res.PriceHub.Name })</th>
									<th class="py-2 pl-3 text-right">Total Cost</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-800/70 font-mono">
								<template x-for="m in currentItems" :key="shopMode + '-' + m.id">
									<tr :class="m.checked ? 'hover:bg-slate-800/30' : 'opacity-45 hover:bg-slate-800/20'">
										<td class="py-2 pr-2">
											<input
												type="checkbox"
												x-model="m.checked"
												class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-emerald-400 focus:ring-emerald-400 cursor-pointer"
											/>
										</td>
										<td class="py-2 pr-3 font-sans font-semibold text-white">
											<label class="flex items-center gap-2 cursor-pointer" @click="m.checked = !m.checked">
												<img
													:src="'https://images.evetech.net/types/' + m.id + '/icon?size=32'"
													:alt="m.name"
													loading="lazy"
													class="h-6 w-6 shrink-0 rounded border border-slate-700/80 bg-slate-950 object-contain"
													onerror="this.style.display='none'"
												/>
												<span :class="m.checked ? '' : 'line-through text-slate-400'" x-text="m.name"></span>
											</label>
										</td>
										<td class="py-2 px-3 text-right text-amber-200" x-text="Number(m.qty).toLocaleString()"></td>
										<td class="py-2 px-3 text-right text-slate-400" x-text="formatISKShort(m.unit_price)"></td>
										<td class="py-2 pl-3 text-right font-bold text-white" x-text="formatISKShort(m.total_cost)"></td>
									</tr>
								</template>
							</tbody>
						</table>
					</div>
					<div class="lg:col-span-4 space-y-2">
						<div class="flex items-center justify-between">
							<label class="text-[10px] font-mono uppercase text-slate-400">EVE Multibuy (Checked Items)</label>
							<span class="font-mono text-[10px] text-emerald-300" x-text="formatISKShort(checkedTotalCost)"></span>
						</div>
						<textarea
							readonly
							rows="8"
							x-model="checkedMultibuy"
							placeholder="Check at least 1 material on the left to generate EVE Multibuy..."
							class="w-full rounded-lg border border-slate-700 bg-slate-950 p-3 font-mono text-xs text-emerald-300"
						></textarea>
					</div>
				</div>
			</div>
		</div>
	}
}
